      src=""
      alt="Full size infographic"
      class="max-w-full max-h-full rounded-sm shadow-2xl object-contain"
    />
  </div>

  <script>
    function setupLightbox() {
      const figure = document.getElementById("thesis-figure");
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img");

      if (figure && lightbox && lightboxImg) {
        figure.onclick = () => {
          lightboxImg.setAttribute("src", figure.getAttribute("src") || "");
          lightbox.classList.remove("hidden");
          lightbox.classList.add("flex");
        };
        lightbox.onclick = () => {
          lightbox.classList.remove("flex");
          lightbox.classList.add("hidden");
        };
      }
    }

    function setupPrint() {
      const button = document.getElementById("print-cv");
      if (button) {
        button.onclick = () => window.print();
      }
    }

    // A browser names the saved PDF after the document title. Swap it for the
    // dialog only, so the tab and the search result keep the page title.
    function setupPrintTitle() {
      const pageTitle = document.title;
      const fileTitle = "At\u0131l \u0130lerialkan - CV";
      window.addEventListener("beforeprint", () => {
        document.title = fileTitle;
      });
      window.addEventListener("afterprint", () => {
        document.title = pageTitle;
      });
    }

    document.addEventListener("astro:page-load", setupLightbox);
    setupLightbox();
    document.addEventListener("astro:page-load", setupPrint);
    setupPrint();
    setupPrintTitle();
  </script>

  <!-- Print sheet: the browser turns this page into an A4 PDF. -->
  <style is:global>
    @media print {
      @page {
        size: A4;
        margin: 12mm;
      }

      /* Always print on white, even when the reader uses the dark theme. */
      html,
      html.dark {
        --color-surface: #ffffff;
        --color-background: #ffffff;
        --color-on-surface: #111111;
        --color-primary: #00327d;
      }

      html,
      body {
        background: #ffffff !important;
        color: #111111 !important;
      }

      body {
        font-size: 9pt;
      }

      /* The identity block uses screen-sized breathing room. Close it, so the
         document holds three pages once the break rules take their share. */
      #cv-meta,
      #cv-contact,
      #cv-summary {
        margin-top: 0.4rem !important;
      }

      #cv-languages {
        margin-top: 0.2rem !important;
      }

      #cv-summary {
        max-width: none !important;
      }

      * {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        box-shadow: none !important;
      }

      /* Drop the site chrome and the screen-only controls. */
      nav,
      footer,
      #lightbox,
      #print-cv {
        display: none !important;
      }

      main {
        padding-top: 0 !important;
      }

      #cv {
        max-width: none !important;
        padding: 0 !important;
      }

      /* One column on paper. Some ATS parsers read a two-column PDF in the
         wrong order and interleave a section heading with its content. */
      #cv .grid {
        display: block !important;
      }

      /* Screen-only blocks. This sits after the one-column rule above on
         purpose: both selectors carry the same specificity, so the later one
         wins, and hiding must win over laying out. */
      #cv [data-screen-only] {
        display: none !important;
      }

      #cv h2 {
        border-bottom: 1px solid #111111;
        padding-bottom: 0.15rem;
        margin-bottom: 0.6rem !important;
      }

      /* The two oldest roles keep their title and dates, and drop the rest. */
      #cv [data-compact-in-print] > p,
      #cv [data-compact-in-print] > div:last-child {
        display: none !important;
      }

      #cv [data-compact-in-print] > div {
        border-bottom: none !important;
        padding-bottom: 0 !important;
      }

      /* A parser reads no picture, and this one costs most of a page. */
      #thesis-figure {
        display: none !important;
      }

      /* Close the screen rhythm, which wastes paper. */
      #cv section {
        min-height: 0 !important;
        margin-bottom: 0.9rem !important;
      }

      #cv .h-px {
        margin-bottom: 0.6rem !important;
      }

      #cv ul li {
        padding-bottom: 0.15rem !important;
      }

      #cv .gap-3 {
        gap: 0.35rem !important;
      }

      #cv .gap-4 {
        gap: 0.5rem !important;
      }

      #cv h1 {
        font-size: 26pt !important;
        margin-bottom: 0.25rem !important;
      }

      #cv h2 {
        font-size: 14pt !important;
        margin-bottom: 0.5rem !important;
      }

      #cv h3 {
        font-size: 11pt !important;
      }

      #cv h4 {
        margin-bottom: 0.5rem !important;
      }

      #cv .gap-16 {
        gap: 1.25rem !important;
      }

      #cv .gap-12 {
        gap: 1rem !important;
      }

      /* The screen caps line length; paper is narrower already. */
      #cv .max-w-2xl,
      #cv .max-w-\[250px\] {
        max-width: none !important;
      }

      /* Opacity utilities print as grey mush. Use solid ink. */
      #cv p,
      #cv li,
      #cv span {
        color: #111111 !important;
      }

      /* A date must never break across two lines. */
      #cv .tabular-nums {
        white-space: nowrap;
      }

      #cv a {
        color: #00327d !important;
        text-decoration: none;
      }

      /* Keep one job, one degree or one list on a single page. */
      #cv section > div > div,
      #cv li {
        break-inside: avoid;
      }
    }
  </style>
