---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contact } from "../data/contact";

// The printed page is a job-search instrument, so the opening text is written
// for a recruiter and for the parser that reads the PDF first. See
// docs/adr/0002-the-cv-page-is-the-pdf.md.
const summary =
  "Software design engineer with over a decade in safety-critical systems — avionics, medical imaging and semiconductor lithography. At ASML since 2022 on DUV image align software in C, C++, Python and Julia, and Scrum Master for the team. Earlier, led teams and architected products: a model-based design suite, and a neural-network system for early breast-cancer detection. MSc in multimedia computing, with published work on deep learning for speech signals.";
---

<BaseLayout title="Curriculum Vitae" currentPath="/cv/">
  <div
    id="cv"
    class="pb-32 px-6 md:px-12 max-w-[1440px] mx-auto w-full min-w-0 overflow-x-clip"
  >
    <!-- Identity: name, contact, summary. The parser reads this block first. -->
    <section
      class="grid grid-cols-12 gap-6 md:gap-8 mb-16 items-end [&>*]:min-w-0"
    >
      <div class="col-span-12 flex flex-col justify-end">
        <h1
          class="max-w-full text-[clamp(2.5rem,11vw,4rem)] md:text-[8rem] font-black leading-[0.9] tracking-tighter uppercase mb-4 [overflow-wrap:break-word]"
        >
          {contact.nameUpper}
        </h1>
        <div
          id="cv-meta"
          class="flex flex-col md:flex-row gap-8 md:gap-24 mt-8 lg:mt-12"
        >
          <p
            class="text-[0.75rem] md:text-sm uppercase tracking-[0.2em] font-bold text-primary"
          >
            {contact.role}
          </p>
          <p
            class="text-[0.75rem] md:text-sm uppercase tracking-[0.2em] font-bold text-on-surface/50"
          >
            {contact.city}
          </p>
          <button
            id="print-cv"
            type="button"
            class="print:hidden whitespace-nowrap self-start md:ml-auto flex items-center gap-2 border border-on-surface/20 px-4 py-2 text-[0.75rem] uppercase tracking-[0.2em] font-bold cursor-pointer hover:bg-on-surface hover:text-surface transition-colors"
          >
            <span class="material-symbols-outlined text-[1rem]">download</span>
            Download PDF
          </button>
        </div>

        <!-- Addresses print as text, so a reader on paper can type them. -->
        <ul
          id="cv-contact"
          class="flex flex-wrap gap-x-6 gap-y-2 mt-8 text-sm text-on-surface/70"
        >
          <li>
            <a class="hover:text-primary transition-colors" href={`mailto:${contact.email}`}
              >{contact.email}</a
            >
          </li>
          {
            contact.links.map((link) => (
              <li>
                <a class="hover:text-primary transition-colors" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <p id="cv-summary" class="mt-8 max-w-3xl text-sm leading-relaxed">
          {summary}
        </p>

        <p id="cv-languages" class="mt-4 text-sm text-on-surface/70">
          <span class="font-bold uppercase tracking-[0.1em] text-[0.7rem]"
            >Languages</span
          > — {contact.languages}
        </p>
      </div>
    </section>

    <div class="h-px w-full bg-on-surface/10 mb-24"></div>

    <!-- Experience Section -->
    <section class="grid grid-cols-12 gap-6 md:gap-8 mb-32 [&>*]:min-w-0">
      <div class="col-span-12 md:col-span-4 mb-8 md:mb-0">
        <h2 class="text-[2rem] font-black tracking-tighter uppercase mb-8">
          Experience
        </h2>
        <p
          data-screen-only
          class="text-[0.75rem] uppercase tracking-[0.1em] text-on-surface/40 leading-relaxed max-w-[250px]"
        >
          Specializing in safety-critical systems, avionics and embedded
          software architectures. <br /><br /> Actively learning and applying <strong
            >Artificial Intelligence</strong
          > across personal and professional projects.
        </p>
      </div>

      <div class="col-span-12 md:col-span-8 flex flex-col gap-16">
        <!-- Job 1 -->
        <div class="flex flex-col gap-4">
          <div
            class="flex justify-between items-baseline border-b border-on-surface/5 pb-4"
          >
            <h3 class="text-[1.5rem] font-bold tracking-tight">
              Software Design Engineer / ASML
            </h3>
            <span class="text-[1rem] font-black tabular-nums"
              >07.2022 — PRESENT</span
            >
          </div>
          <p class="text-on-surface/70 leading-relaxed max-w-2xl text-sm">
            Spearheaded software development and engineering within the MX
            Exposure Imaging division, focusing on <strong
              >DUV (Deep Ultraviolet) Image Align Software</strong
            >. Designed and implemented robust solutions utilizing <strong
              >C</strong>, <strong
              >C++</strong>, <strong>Python</strong>, and <strong>Julia</strong>.
            Additionally, served as <strong>Scrum Master</strong>, facilitating <strong
              >agile methodologies</strong
            > and optimizing team delivery pipelines.
          </p>
          <div class="flex flex-wrap gap-2 mt-2">
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >C</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Python</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Julia</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Scrum</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >DUV Exposure</span
            >
          </div>
        </div>

        <!-- Job 2 -->
        <div class="flex flex-col gap-4">
          <div
            class="flex justify-between items-baseline border-b border-on-surface/5 pb-4"
          >
            <h3 class="text-[1.5rem] font-bold tracking-tight">
              MIDAS Team Lead & Architect / ICterra
            </h3>
            <span class="text-[1rem] font-black tabular-nums"
              >11.2021 — 06.2022</span
            >
          </div>
          <p class="text-on-surface/70 leading-relaxed max-w-2xl text-sm">
            Led a cross-functional team in the research and development of <strong
              >MIDAS</strong
            >, an early diagnosis and tracking system for breast cancer,
            developed in collaboration with Hacettepe University Hospital.
            Engineered a <strong>multi-stage neural network classifier</strong> to
            detect malignant sections in mammogram images, effectively handling <strong
              >multi-view</strong
            >, <strong>multi-class</strong>, and <strong
              >imbalanced datasets</strong
            >. Designed and deployed a <strong
              >containerized, remote-execution architecture</strong
            > maximizing <strong>multi-GPU Unix workstations</strong> for intensive
            model training. Also managed the maintenance of mission-critical firmware
            for the <strong>Mobile Digital XRAY System (MXRAY)</strong> project on
            behalf of Aselsan.
          </p>
          <div class="flex flex-wrap gap-2 mt-2">
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Python</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Deep Learning</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Neural Networks</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >TensorFlow</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Keras</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Docker</span
            >
          </div>
        </div>

        <!-- Job 3 -->
        <div class="flex flex-col gap-4">
          <div
            class="flex justify-between items-baseline border-b border-on-surface/5 pb-4"
          >
            <h3 class="text-[1.5rem] font-bold tracking-tight">
              IMODE Team Lead & Senior SDE / Turkish Aerospace
            </h3>
            <span class="text-[1rem] font-black tabular-nums"
              >03.2019 — 11.2021</span
            >
          </div>
          <p class="text-on-surface/70 leading-relaxed max-w-2xl text-sm">
            Directed the <strong>IMODE</strong> (Integrated Model-Based Design Environment)
            product lifecycle, a proprietary <strong
              >model-based design suite</strong
            > competing with <strong>VAPS</strong> and <strong>SCADE</strong>.
            Managed the development of critical modules including the <strong
              >ARINC 661 Toolkit</strong
            >, <strong>AADL Architecture Design Toolkit</strong>, and <strong
              >DO-178C Tool Qualification Kits</strong
            >. Engineered core system components using <strong>C++</strong> and <strong
              >Qt Framework</strong
            >, developing a multilingual <strong>code generator</strong> and orchestrating
            <strong>GUI model designs</strong> for the Advanced Jet Trainer. Served
            as <strong>Scrum Master</strong> and Co-instructor for the Model-Based
            Design course at Yildiz Technical University.
          </p>
          <div class="flex flex-wrap gap-2 mt-2">
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >C++</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Qt Framework</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >System Architecture</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >DO-330</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Code Generation</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >ARINC 661</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Agile</span
            >
          </div>
        </div>

        <!-- Job 4 -->
        <div class="flex flex-col gap-4">
          <div
            class="flex justify-between items-baseline border-b border-on-surface/5 pb-4"
          >
            <h3 class="text-[1.5rem] font-bold tracking-tight">
              Software Design Engineer / Aselsan (via Turkish Aerospace)
            </h3>
            <span class="text-[1rem] font-black tabular-nums"
              >08.2017 — 03.2019</span
            >
          </div>
          <p class="text-on-surface/70 leading-relaxed max-w-2xl text-sm">
            Developed <strong>Operational Flight Program (OFP)</strong> software for
            the New Generation Trainer Aircraft. Produced <strong
              >safety-critical system requirements</strong
            > and <strong>C++</strong> source code utilizing <strong
              >IBM Rational Rhapsody</strong
            >. Key engineering contributions included the design and
            implementation of the <strong
              >Identification Friend or Foe (IFF) Transponder</strong
            >, <strong>Cockpit Voice Recorder (CVR)</strong>, and <strong
              >Flight Data Recorder (FDR)</strong
            > modules. Orchestrated the initial development of advanced radar display
            pages utilizing <strong>VAPS</strong> and actively participated in rigorous
            <strong>software verification</strong> processes.
          </p>
          <div class="flex flex-wrap gap-2 mt-2">
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >C++</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Embedded Software</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Avionics</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >RTOS</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >IBM Rational Rhapsody</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >DO-178C</span
            >
          </div>
        </div>

        <!-- Job 5 -->
        <div class="flex flex-col gap-4">
          <div
            class="flex justify-between items-baseline border-b border-on-surface/5 pb-4"
          >
            <h3 class="text-[1.5rem] font-bold tracking-tight">
              Software Design Engineer / Turkish Aerospace
            </h3>
            <span class="text-[1rem] font-black tabular-nums"
              >08.2016 — 08.2017</span
            >
          </div>
          <p class="text-on-surface/70 leading-relaxed max-w-2xl text-sm">
            Built low-level <strong>Line Replaceable Unit (LRU) firmware</strong
            > for the New Generation Trainer Aircraft. Developed robust <strong
              >Bootloader</strong
            > applications and <strong>I2C device drivers</strong> in <strong
              >C</strong
            > for the <strong>Symbol Generator (SG)</strong> and <strong
              >Rudder Assistant System (RAS)</strong
            > hardware. For the Avionics Modernization of Military Transport Aircraft,
            engineered an <strong>ARINC 429</strong> data simulator tool in <strong
              >C# (.NET Framework)</strong
            > to streamline <strong>verification environments</strong>.
          </p>
          <div class="flex flex-wrap gap-2 mt-2">
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >C</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >C#</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >.NET Framework</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Bootloader</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >I2C</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >ARINC 429</span
            >
          </div>
        </div>

        <!-- Job 6 -->
        <div class="flex flex-col gap-4" data-compact-in-print>
          <div
            class="flex justify-between items-baseline border-b border-on-surface/5 pb-4"
          >
            <h3 class="text-[1.5rem] font-bold tracking-tight">
              Software Engineer / AYESAŞ
            </h3>
            <span class="text-[1rem] font-black tabular-nums"
              >08.2014 — 08.2016</span
            >
          </div>
          <p class="text-on-surface/70 leading-relaxed max-w-2xl text-sm">
            Established firmware requirements via <strong
              >IBM Rational DOORS</strong
            > for critical <strong>Line Replaceable Units (LRUs)</strong> on the New
            Generation Trainer Aircraft. Separately, for a MALE-class Unmanned Aerial
            Vehicle project, authored primary lifecycle documentation and implemented
            <strong>C/Assembly</strong> source code for <strong
              >Board Support Packages (BSPs)</strong
            > and <strong>IO Drivers</strong>. This included the primary <strong
              >Bootloader</strong
            > for configuring the <strong>Minimum Processing Environment</strong
            >, <strong>Dataloader</strong> modules, and robust <strong
              >device drivers</strong
            > for <strong>Ethernet, Serial, Flash, and NVRAM</strong> hardware.
          </p>
          <div class="flex flex-wrap gap-2 mt-2">
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >C</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Assembly</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Embedded Software</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >BSP & IO Drivers</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >DO-178C</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >DOORS</span
            >
          </div>
        </div>

        <!-- Job 7 -->
        <div class="flex flex-col gap-4" data-compact-in-print>
          <div
            class="flex justify-between items-baseline border-b border-on-surface/5 pb-4"
          >
            <h3 class="text-[1.5rem] font-bold tracking-tight">
              Software Engineer / Bilişim AŞ
            </h3>
            <span class="text-[1rem] font-black tabular-nums"
              >06.2013 — 08.2014</span
            >
          </div>
          <p class="text-on-surface/70 leading-relaxed max-w-2xl text-sm">
            Contributed to the development, maintenance, and technical support
            of the Directorate General of Civil Aviation (DGCA) Information
            Administration System using <strong>JavaServer Faces (JSF)</strong>.
            Additionally, engaged in an R&D initiative to build a comprehensive <strong
              >Business Intelligence Application</strong
            > utilizing a diversified technology stack including <strong
              >PHP, Java, and JavaScript</strong
            > across multiple database management systems.
          </p>
          <div class="flex flex-wrap gap-2 mt-2">
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >Java</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >PHP</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >JavaScript</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >OracleDB</span
            >
            <span
              class="text-[0.65rem] border border-on-surface/10 px-2 py-1 uppercase tracking-wider font-bold"
              >MySQL</span
            >
          </div>
        </div>
      </div>
    </section>

    <div class="h-px w-full bg-on-surface/10 mb-24"></div>

    <!-- Skills Section. Screen only — see docs/adr/0002. -->
    <section
      data-screen-only
      class="grid grid-cols-12 gap-6 md:gap-8 mb-32 [&>*]:min-w-0"
    >
      <div class="col-span-12 md:col-span-4 mb-8 md:mb-0">
        <h2 class="text-[2rem] font-black tracking-tighter uppercase mb-8">
          Technical Stack
        </h2>
      </div>

      <div
        class="col-span-12 md:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-12 text-sm"
      >
        <div>
          <h4
            class="text-[0.75rem] uppercase tracking-[0.2em] font-black mb-6 text-primary"
          >
            Core Engineering
          </h4>
          <ul class="flex flex-col gap-3">
            <li
              class="flex justify-between items-center font-medium border-b border-on-surface/5 pb-2 hover:text-primary transition-colors"
            >
              <span>Safety Critical Systems</span>
              <span class="text-[0.75rem] font-black opacity-30">01</span>
            </li>
            <li
              class="flex justify-between items-center font-medium border-b border-on-surface/5 pb-2 hover:text-primary transition-colors"
            >
              <span>Avionics Architecture</span>
              <span class="text-[0.75rem] font-black opacity-30">02</span>
            </li>
            <li
              class="flex justify-between items-center font-medium border-b border-on-surface/5 pb-2 hover:text-primary transition-colors"
            >
              <span>Embedded Software (BSP/IO)</span>
              <span class="text-[0.75rem] font-black opacity-30">03</span>
            </li>
            <li
              class="flex justify-between items-center font-medium border-b border-on-surface/5 pb-2 hover:text-primary transition-colors"
            >
              <span>Machine Learning & AI</span>
              <span class="text-[0.75rem] font-black opacity-30">04</span>
            </li>
            <li
              class="flex justify-between items-center font-medium border-b border-on-surface/5 pb-2 hover:text-primary transition-colors"
            >
              <span>Graphical User Interfaces</span>
              <span class="text-[0.75rem] font-black opacity-30">05</span>
            </li>
          </ul>
        </div>
        <div>
          <h4
            class="text-[0.75rem] uppercase tracking-[0.2em] font-black mb-6 text-primary"
          >
            Standards & Ops
          </h4>
          <ul class="flex flex-col gap-3">
            <li
              class="flex justify-between items-center font-medium border-b border-on-surface/5 pb-2 hover:text-primary transition-colors"
            >
              <span>DO-178C / DO-330 / DO-331</span>
              <span class="text-[0.75rem] font-black opacity-30">06</span>
            </li>
            <li
              class="flex justify-between items-center font-medium border-b border-on-surface/5 pb-2 hover:text-primary transition-colors"
            >
              <span>ARINC 661 / 653 / 429</span>
              <span class="text-[0.75rem] font-black opacity-30">07</span>
            </li>
            <li
              class="flex justify-between items-center font-medium border-b border-on-surface/5 pb-2 hover:text-primary transition-colors"
            >
              <span>Docker & CI/CD Tooling</span>
              <span class="text-[0.75rem] font-black opacity-30">08</span>
            </li>
            <li
              class="flex justify-between items-center font-medium border-b border-on-surface/5 pb-2 hover:text-primary transition-colors"
            >
              <span>Agile / SCRUM / V-Model</span>
              <span class="text-[0.75rem] font-black opacity-30">09</span>
            </li>
            <li
              class="flex justify-between items-center font-medium border-b border-on-surface/5 pb-2 hover:text-primary transition-colors"
            >
              <span>IBM Rhapsody / DOORS</span>
              <span class="text-[0.75rem] font-black opacity-30">10</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <div data-screen-only class="h-px w-full bg-on-surface/10 mb-24"></div>

    <!-- Education Section -->
    <section class="grid grid-cols-12 gap-6 md:gap-8 mb-32 [&>*]:min-w-0">
      <div class="col-span-12 md:col-span-4 mb-8 md:mb-0">
        <h2 class="text-[2rem] font-black tracking-tighter uppercase mb-8">
          Education
        </h2>
      </div>

      <div class="col-span-12 md:col-span-8 flex flex-col gap-12">
        <div
          class="flex flex-col md:flex-row justify-between gap-4 border-b border-on-surface/5 pb-6"
        >
          <div>
            <h3 class="text-[1.25rem] font-bold">
              MSc. in Multimedia Computing
            </h3>
            <p class="text-on-surface/60 text-sm mt-1">
              Middle East Technical University / Machine Learning, Signal
              Processing
            </p>
            <p class="text-on-surface/40 text-[0.75rem] italic mt-2">
              Thesis: Speaker and Posture Classification using Instantaneous
              Acoustic Features of Breath Signals
            </p>
            <div class="mt-6">
              <img
                id="thesis-figure"
                src="/images/thesis-infographic.png"
                alt="Master's Thesis Infographic: The Science of Breath"
                class="w-full max-w-2xl rounded-sm border border-on-surface/10 shadow-sm cursor-zoom-in hover:opacity-90 transition-opacity"
              />
            </div>
            <p
