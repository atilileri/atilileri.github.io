---
/**
 * PROTOTYPE — throwaway. Wayfinder ticket #24.
 *
 * ANSWERED: slide 3 of map #20 ("The model never sees your words") uses a
 * hand-rolled SVG perspective projection, with pure hash scatter — no faked
 * semantic clustering. The rejected alternatives (CSS 3D transforms; a
 * hand-seeded cluster table) were built and compared, and live in this
 * branch's first commit.
 *
 * Mounted inside a real reveal.js slide at the deck's real 1600×900 canvas
 * with the real ASML Editorial theme, so "does it read on a projector" is a
 * fair question here. Copy is verbatim from #23, minus the clustering claim.
 *
 * Route: /decks/asml-ai/prototype-tokenizer-3d — delete before merge to main.
 */
import "reveal.js/dist/reveal.css";
import "./theme-asml.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>PROTOTYPE · tokenizer + 3D embedding space</title>
  </head>
  <body>
    <div class="reveal">
      <div class="slides">
        <section data-section="03 — Tokens" data-embed>
          <span class="eyebrow">The vocabulary &middot; live, type anything</span>
          <h2 class="h-set">
            <span class="h-line"><span>The model never</span></span>
            <span class="h-line"><span>sees your words.</span></span>
          </h2>
          <p class="lede">
            Every token is just an index into a fixed vocabulary &mdash; around
            200,000 entries for a current frontier model.
          </p>

          <div class="embed">
            <!-- ── left panel: typing → chips with IDs ── -->
            <div class="embed-left">
              <textarea
                class="emb-input"
                spellcheck="false"
                data-emb-input>The engineer asked the model about budget, then wrote a function.</textarea
              >
              <div class="emb-chips" data-emb-chips></div>
              <div class="emb-meter">
                <span class="emb-count"><b data-emb-n>0</b> tokens</span>
                <table class="emb-price" data-emb-price></table>
              </div>
              <p class="emb-cap">
                IDs are addresses, not values. Meaning lives in what they point at. &rarr;
              </p>
            </div>

            <!-- ── right panel: the 3D cloud (variant-swapped) ── -->
            <div class="embed-right">
              <div class="cloud" data-cloud>
                <!-- variant A renders an <svg> here; variant B a CSS-3D stage -->
              </div>
              <p class="emb-cap emb-cap-right">
                A 3D shadow of a 1,536-dimensional space.
              </p>
            </div>
          </div>

          <p class="emb-note">
            Approximate tokenizer (&asymp; chars &divide; 4), illustrative embedding
            space. The counting is real; the geometry is a sketch.
          </p>
        </section>
      </div>
    </div>

    <!-- ── prototype switcher (obviously not part of the design) ── -->
    <div class="proto-bar">
      <span class="proto-label" data-proto-label></span>
      <span class="proto-sep"></span>
      <span class="proto-fps" data-proto-fps>&mdash;</span>
    </div>

    <style is:global>
      /* ───────── prototype-only styling (throwaway) ───────── */
      .reveal .lede {
        font-size: clamp(0.95rem, 1.35vw, 1.3rem);
        max-width: 46ch;
        color: #1b1b1bcc;
        margin: 0.4rem 0 1.1rem;
      }
      .embed {
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: clamp(1.2rem, 3vw, 2.6rem);
        align-items: start;
        flex: 1;
        min-height: 0;
      }
      .embed-left {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-height: 0;
      }
      .emb-input {
        font-family: var(--font-body);
        font-size: clamp(0.85rem, 1.15vw, 1.05rem);
        line-height: 1.5;
        color: var(--navy);
        background: var(--card);
        border: 1px solid var(--hair);
        border-radius: 4px;
        padding: 0.85rem 1rem;
        height: 5.4em;
        resize: none;
        outline: none;
        box-shadow: var(--shadow);
      }
      .emb-input:focus {
        border-color: var(--signal);
      }
      .emb-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        align-content: flex-start;
        overflow: hidden;
        flex: 1;
        min-height: 0;
      }
      .chip {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 1px;
        padding: 0.2rem 0.42rem 0.16rem;
        border-radius: 3px;
        background: #0066cc12;
        border: 1px solid #0066cc2e;
        font-family: var(--font-mono);
        line-height: 1.1;
        animation: chipIn 260ms var(--ease) both;
      }
      .chip .t {
        font-size: clamp(0.72rem, 0.95vw, 0.92rem);
        color: var(--navy);
        white-space: pre;
      }
      .chip .id {
        font-size: clamp(0.5rem, 0.62vw, 0.62rem);
        color: #0066cc;
        opacity: 0.75;
        letter-spacing: 0.04em;
      }
      @keyframes chipIn {
        from {
          opacity: 0;
          transform: translateY(4px) scale(0.94);
        }
      }
      .reveal .emb-meter {
        display: flex;
        align-items: flex-start;
        gap: 1.4rem;
        font-family: var(--font-mono);
        font-size: clamp(0.66rem, 0.85vw, 0.82rem);
        color: #1b1b1b99;
      }
      .reveal .emb-count {
        white-space: nowrap;
      }
      .reveal .emb-meter b {
        font-size: clamp(1.1rem, 1.7vw, 1.6rem);
        color: var(--orange);
        font-weight: 700;
      }
      /* one model per row — a price list, not a run-on sentence */
      .emb-price {
        border-collapse: collapse;
        font-variant-numeric: tabular-nums;
      }
      .emb-price th {
        font-weight: 400;
        font-size: 0.82em;
        color: #1b1b1b66;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        text-align: right;
        padding: 0 0 0.25rem 0.9rem;
      }
      .emb-price th:first-child {
        text-align: left;
        padding-left: 0;
      }
      .emb-price td {
        padding: 0.1rem 0 0.1rem 0.9rem;
        text-align: right;
        white-space: nowrap;
      }
      .emb-price td:first-child {
        text-align: left;
        padding-left: 0;
        color: var(--navy);
      }
      .emb-price .eur {
        color: var(--orange);
        font-weight: 700;
      }
      .emb-price .aic {
        color: #1b1b1b8c;
      }
      .reveal .emb-cap {
        font-family: var(--font-mono);
        font-size: clamp(0.6rem, 0.78vw, 0.76rem);
        letter-spacing: 0.03em;
        color: #1b1b1b8c;
        margin: 0;
      }
      .reveal .emb-cap-right {
        text-align: right;
      }
      .reveal .emb-note {
        font-family: var(--font-mono);
        font-size: clamp(0.55rem, 0.7vw, 0.68rem);
        color: #1b1b1b73;
        margin: 0.9rem 0 0;
      }
      .embed-right {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-height: 0;
        height: 100%;
      }
      .cloud {
        flex: 1;
        min-height: 0;
        position: relative;
        background: var(--card);
        border: 1px solid var(--hair);
        border-radius: 4px;
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      /* ───────── switcher bar ───────── */
      .proto-bar {
        position: fixed;
        z-index: 99;
        left: 50%;
        bottom: 14px;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 7px 12px;
        border-radius: 999px;
        background: #10141c;
        color: #fff;
        font: 500 12px/1 ui-monospace, monospace;
        box-shadow: 0 10px 30px -8px #000a;
      }
      .proto-bar button {
        background: #ffffff1a;
        color: #fff;
        border: 0;
        border-radius: 999px;
        padding: 5px 10px;
        font: inherit;
        cursor: pointer;
      }
      .proto-bar button:hover {
        background: #ffffff33;
      }
      .proto-label {
        min-width: 20ch;
        text-align: center;
        color: #ffcda6;
      }
      .proto-sep {
        width: 1px;
        height: 18px;
        background: #ffffff33;
      }
      .proto-fps {
        color: #9fe6a0;
        min-width: 7ch;
        text-align: right;
      }
    </style>

    <script>
      import Reveal from "reveal.js";

      const deck = new Reveal({
        width: 1600,
        height: 900,
        margin: 0.04,
        center: false,
        controls: false,
        progress: false,
        hash: false,
        keyboard: false, // prototype: arrows drive the variant switcher
      });
      deck.initialize();

      /* ══════════════════ shared: hand-rolled pseudo-tokenizer ══════════════════
         Not BPE. Whitespace/punctuation split, peel common affixes, chop long
         stems, stable hashed ID into a ~200k vocab. Must look convincing on
         arbitrary typed prose — that is the whole bar. */

      const PREFIX = ["un", "re", "pre", "dis", "non", "over", "under", "inter", "sub", "mis"];
      const SUFFIX = ["ing", "tion", "ness", "ment", "able", "ible", "ally", "ed", "ly", "er", "est", "ful", "ize", "ise", "ity", "es", "s"];

      function hash32(s: string): number {
        let h = 2166136261;
        for (let i = 0; i < s.length; i++) {
          h ^= s.charCodeAt(i);
          h = Math.imul(h, 16777619);
        }
        return h >>> 0;
      }
      const tokenId = (piece: string) => hash32(piece) % 199_998; // ~200k vocab

      function splitWord(word: string): string[] {
        const out: string[] = [];
        let w = word;
        if (w.length > 6) {
          for (const p of PREFIX) {
            if (w.toLowerCase().startsWith(p) && w.length - p.length >= 3) {
              out.push(w.slice(0, p.length));
              w = w.slice(p.length);
              break;
            }
          }
        }
        let tail = "";
        if (w.length > 5) {
          for (const s of SUFFIX) {
            if (w.toLowerCase().endsWith(s) && w.length - s.length >= 3) {
              tail = w.slice(w.length - s.length);
              w = w.slice(0, w.length - s.length);
              break;
            }
          }
        }
        // chop what's left into believable 4–6 char stems
        while (w.length > 7) {
          const n = 4 + (hash32(w) % 3);
          out.push(w.slice(0, n));
          w = w.slice(n);
        }
        if (w) out.push(w);
        if (tail) out.push(tail);
        return out;
      }

      type Tok = { text: string; id: number };

      function tokenize(text: string): Tok[] {
        const toks: Tok[] = [];
        // a leading space rides with its word, GPT-style
        const parts = text.match(/\s+|[A-Za-z]+|\d+|[^\sA-Za-z\d]/g) ?? [];
        let pendingSpace = "";
        for (const part of parts) {
          if (/^\s+$/.test(part)) {
            // newlines are their own token; a single space rides along
            if (part.includes("\n")) {
              toks.push({ text: "\\n", id: tokenId("\n") });
              pendingSpace = "";
            } else {
              pendingSpace = " ";
              if (part.length > 1) {
                toks.push({ text: "␣".repeat(part.length - 1), id: tokenId(part) });
              }
            }
            continue;
          }
          const pieces = /^[A-Za-z]+$/.test(part) ? splitWord(part) : [part];
          pieces.forEach((p, i) => {
            const text = i === 0 ? pendingSpace + p : p;
            toks.push({ text, id: tokenId(text.trim().toLowerCase()) });
          });
          pendingSpace = "";
        }
        return toks;
      }

      /* ══════════════════ shared: pseudo-embedding positions ══════════════════
         DECIDED (#24): pure hash scatter, no faked semantic clustering. The
         seed-table version was built and rejected — it only clusters words it
         was seeded with, so it silently degrades to this the moment Atil types
         something unrehearsed, while the caption keeps claiming otherwise. */

      // The cloud is a landscape volume, matching the panel it sits in:
      // wide and deep, shallow in height.
      const R = 150; // base radius in cloud-space units
      // Sized for the *worst* rotation: corner-on, the box's projected width is
      // ~1.4x its face-on width, so these leave that much headroom.
      const SPREAD_XZ = R * 1.29;
      const SPREAD_Y = R * 0.58;

      /** deterministic position for a token — same text, same point, every replay */
      function place(tok: Tok): [number, number, number] {
        const word = tok.text.trim().toLowerCase();
        const h = hash32(word || tok.text);
        const u = ((h >>> 0) % 1000) / 1000;
        const v = ((h >>> 10) % 1000) / 1000;
        const w = ((h >>> 20) % 1000) / 1000;
        const th = u * Math.PI * 2;
        const ph = Math.acos(2 * v - 1);
        const rad = 0.58 + 0.42 * Math.cbrt(w); // 0..1, pushed outward: a hollow
        // shell reads as a *volume*; a solid ball just clumps at the centre
        return [
          rad * Math.sin(ph) * Math.cos(th) * SPREAD_XZ,
          rad * Math.cos(ph) * SPREAD_Y,
          rad * Math.sin(ph) * Math.sin(th) * SPREAD_XZ,
        ];
      }

      /* ══════════════════ shared: price readout ══════════════════
         AIC per 1M input tokens, #21-verified rates (see #23's table).
         1 AIC = 1 US cent (#21, verbatim current). Euros are a conversion we
         do ourselves — GitHub publishes USD only — so the rate is stated. */
      const RATES: [string, number][] = [
        ["Gemini 3 Flash", 50],
        ["GPT-5.4", 250],
        ["Sonnet 4.5", 300],
        ["Opus 4.6", 500],
      ];
      const USD_PER_EUR = 1.08; // NEEDS A DECISION — see #24 follow-up
      const eurPerMillion = (aicPerM: number) => (aicPerM * 0.01) / USD_PER_EUR;

      /* ══════════════════ the cloud — SVG perspective projection ══════════════════ */

      /* ── A. hand-rolled SVG perspective projection ── */
      function cloudRenderer() {
        const NS = "http://www.w3.org/2000/svg";
        let svg: SVGSVGElement;
        let gBox: SVGGElement;
        let gPts: SVGGElement;
        let pts: { p: [number, number, number]; label: string }[] = [];
        let W = 800;
        let H = 480;
        // Camera tuned so the (deliberately roomy) box fills the panel without
        // clipping, with the cloud floating inside it. CAM is deliberately far
        // back: closer, and the near face distorts into a funnel.
        // FOCAL/CAM are tuned together with SPREAD_* so the box lands at ~92%
        // of the panel: any bigger and its edges clip and it stops reading as
        // a closed volume. Label size is independent of these, so the tokens
        // stay large regardless.
        const FOCAL = 700;
        const CAM = 760;
        const TILT = 0.32;

        function project(p: [number, number, number], a: number) {
          const [x, y, z] = p;
          const cx = Math.cos(a), sx = Math.sin(a);
          let X = x * cx - z * sx;
          let Z = x * sx + z * cx;
          const cy = Math.cos(TILT), sy = Math.sin(TILT);
          let Y = y * cy - Z * sy;
          Z = y * sy + Z * cy;
          const d = CAM + Z;
          const s = FOCAL / Math.max(60, d);
          return { x: W / 2 + X * s, y: H / 2 + Y * s, s, z: Z };
        }

        // The box sits outside the point ball so the cloud reads as *inside a
        // space* rather than bursting out of a tight crate.
        const BOX_XZ = SPREAD_XZ * 1.16;
        const BOX_Y = SPREAD_Y * 1.22;
        const CUBE: [number, number, number][] = [];
        for (const sx of [-1, 1]) for (const sy of [-1, 1]) for (const sz of [-1, 1])
          CUBE.push([sx * BOX_XZ, sy * BOX_Y, sz * BOX_XZ]);
        const EDGES: [number, number][] = [];
        CUBE.forEach((a, i) => CUBE.forEach((b, j) => {
          if (j <= i) return;
          const diff = a.filter((v, k) => v !== b[k]).length;
          if (diff === 1) EDGES.push([i, j]);
        }));

        return {
          mount(host: HTMLElement) {
            host.innerHTML = "";
            const r = host.getBoundingClientRect();
            W = Math.max(400, r.width);
            H = Math.max(280, r.height);
            svg = document.createElementNS(NS, "svg") as SVGSVGElement;
            svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
            svg.setAttribute("width", "100%");
            svg.setAttribute("height", "100%");
            gBox = document.createElementNS(NS, "g") as SVGGElement;
            gPts = document.createElementNS(NS, "g") as SVGGElement;
            svg.append(gBox, gPts);
            host.append(svg);
          },
          set(toks: Tok[]) {
            pts = toks
              .filter((t) => t.text.trim())
              .slice(-48)
              .map((t) => ({ p: place(t), label: t.text.trim() }));
          },
          frame(a: number) {
            // axis box
            let box = "";
            for (const [i, j] of EDGES) {
              const p1 = project(CUBE[i], a), p2 = project(CUBE[j], a);
              box += `<line x1="${p1.x.toFixed(1)}" y1="${p1.y.toFixed(1)}" x2="${p2.x.toFixed(1)}" y2="${p2.y.toFixed(1)}" stroke="#0066cc" stroke-opacity="0.10" stroke-width="1"/>`;
            }
            gBox.innerHTML = box;

            const proj = pts
              .map((pt) => ({ ...project(pt.p, a), label: pt.label }))
              .sort((m, n) => n.z - m.z); // far first
            let out = "";
            for (const p of proj) {
              // p.s runs ~0.54 (far face) to ~1.08 (near face) at this camera
              const depth = Math.max(0.28, Math.min(1, (p.s - 0.5) / 0.52));
              const fs = (15 + depth * 10).toFixed(1);
              const col = "#00327d";
              out +=
                `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="${(1.6 + depth * 2.6).toFixed(1)}" fill="#0066CC" fill-opacity="${(depth * 0.85).toFixed(2)}"/>` +
                // white halo under the glyphs — the cheap win SVG gives us:
                // labels stay readable where the cloud crowds.
                `<text x="${(p.x + 6).toFixed(1)}" y="${(p.y + 4).toFixed(1)}" font-family="JetBrains Mono, monospace" font-size="${fs}" fill="${col}" fill-opacity="${(depth * 0.95).toFixed(2)}" stroke="#ffffff" stroke-width="3" stroke-opacity="${(depth * 0.8).toFixed(2)}" paint-order="stroke" stroke-linejoin="round">${escapeXml(p.label)}</text>`;
            }
            gPts.innerHTML = out;
          },
          destroy() {},
        };
      }

      function escapeXml(s: string) {
        return s.replace(/[<>&"]/g, (c) => ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;" })[c]!);
      }

      /* ══════════════════ wiring ══════════════════ */

      const input = document.querySelector<HTMLTextAreaElement>("[data-emb-input]")!;
      const chipHost = document.querySelector<HTMLElement>("[data-emb-chips]")!;
      const cloudHost = document.querySelector<HTMLElement>("[data-cloud]")!;
      const nEl = document.querySelector<HTMLElement>("[data-emb-n]")!;
      const priceEl = document.querySelector<HTMLElement>("[data-emb-price]")!;
      const label = document.querySelector<HTMLElement>("[data-proto-label]")!;
      const fpsEl = document.querySelector<HTMLElement>("[data-proto-fps]")!;

      const cloud = cloudRenderer();
      let toks: Tok[] = [];
      label.textContent = "SVG perspective projection";

      function renderChips() {
        chipHost.innerHTML = "";
        for (const t of toks.slice(-60)) {
          const el = document.createElement("span");
          el.className = "chip";
          el.innerHTML = `<span class="t">${t.text.replace(/ /g, "·")}</span><span class="id">${t.id}</span>`;
          chipHost.append(el);
        }
        nEl.textContent = String(toks.length);
        const n = toks.length;
        priceEl.innerHTML =
          `<tr><th>model</th><th>this text</th><th>per 1M tokens</th></tr>` +
          RATES.map(
            ([m, r]) =>
              `<tr><td>${m}</td>` +
              `<td class="aic">${((n * r) / 1e6).toFixed(4)} AIC</td>` +
              `<td class="eur">&euro;${eurPerMillion(r).toFixed(2)}</td></tr>`,
          ).join("");
      }

      function update() {
        toks = tokenize(input.value);
        renderChips();
        cloud.set(toks);
      }

      input.addEventListener("input", update);

      // auto-rotation + fps meter
      let angle = 0;
      let last = performance.now();
      let frames = 0;
      let acc = 0;
      function loop(now: number) {
        const dt = now - last;
        last = now;
        angle += dt * 0.00022;
        cloud.frame(angle);
        acc += dt;
        frames++;
        if (acc > 500) {
          fpsEl.textContent = `${Math.round((frames * 1000) / acc)} fps`;
          acc = 0;
          frames = 0;
        }
        requestAnimationFrame(loop);
      }
      requestAnimationFrame(loop);

      // the deck's headline wipe: the controller adds .is-live on entry
      function armHeadline() {
        const s = document.querySelector<HTMLElement>(".reveal section")!;
        s.classList.remove("is-live");
        void s.offsetWidth;
        s.classList.add("is-live");
      }

      cloud.mount(cloudHost);
      update();
      deck.on("ready", armHeadline);
      // deterministic replay on (re-)entry, like every other slide in the deck
      deck.on("slidechanged", () => {
        angle = 0;
        cloud.mount(cloudHost);
        update();
        armHeadline();
      });
    </script>
  </body>
</html>
