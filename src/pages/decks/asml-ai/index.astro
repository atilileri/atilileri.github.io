    <script>
      // Read by the input-billing ladder below, the last inline user of them:
      // the cost dial took `eurDecimals` and `fmtAicWhole` with it (#117).
      import {
        MODELS as RATES,
        eurOfAic,
        eurSigDecimals,
        fmtEur,
        fmtInt,
      } from "../../../lib/asml-ai/rates";
      // The Widget contract and its registry (#109, spec #106, ADR 0002). It
      // owns EVERY Widget in the Deck, and since #118 it is the only thing that
      // does: the two `if` chains are deleted.
      import { mountWidgets } from "../../../lib/asml-ai/deck-widgets";
      import Reveal from "reveal.js";
      import RevealHighlight from "reveal.js/plugin/highlight/highlight.esm.js";
      import RevealNotes from "reveal.js/plugin/notes/notes.esm.js";
      import RevealZoom from "reveal.js/plugin/zoom/zoom.esm.js";

      const deck = new Reveal({
        hash: true,
        // Standard reveal layout: a wide 16:9 canvas that reveal scales to fit
        // the viewport. (An earlier disableLayout:true left slides unpositioned
        // and registered zero slides — the blank-page bug.) The theme's fluid
        // clamp() type keys off the real viewport, so it still reads as a
        // responsive "web presentation" rather than a rigid fixed deck.
        width: 1600,
        height: 900,
        margin: 0.04,
        minScale: 0.2,
        maxScale: 2.0,
        transition: "slide", // advance right → left; verticals slide down
        transitionSpeed: "default",
        controls: true,
        controlsLayout: "bottom-right",
        progress: true,
        center: false, // hard-left editorial grid
        hideInactiveCursor: true,
        plugins: [RevealHighlight, RevealNotes, RevealZoom],
      });
      deck.initialize();
      // Expose the instance (debugging / headless verification navigation).
      (window as any).__deck = deck;

      // ── Presenter notes: "s" toggles an inline overlay (native-proto style),
      //    "p" opens reveal's separate presenter window. We override reveal's
      //    default "s" binding (keyCode 83, normally the speaker view). ──────
      const notesEl = document.querySelector<HTMLElement>("[data-notes]");
      const notesBody = document.querySelector<HTMLElement>("[data-notes-body]");
      function syncNotes() {
        if (!notesBody) return;
        const cur = deck.getCurrentSlide() as HTMLElement | undefined;
        const raw = cur?.querySelector("aside.notes")?.textContent ?? "";
        // A blank line in the source aside is a paragraph break. Rebuilding
        // them as real <p> elements is what lets the two-column overlay break
        // between thoughts instead of mid-sentence.
        const paras = raw
          .split(/\n\s*\n/)
          .map((t) => t.replace(/\s+/g, " ").trim())
          .filter(Boolean);
        notesBody.textContent = "";
        if (!paras.length) {
          notesBody.textContent = "— no notes for this slide —";
          return;
        }
        for (const t of paras) {
          const para = document.createElement("p");
          para.textContent = t;
          notesBody.append(para);
        }
      }
      function toggleNotes() {
        if (!notesEl) return;
        notesEl.toggleAttribute("hidden");
        if (!notesEl.hasAttribute("hidden")) syncNotes();
      }
      deck.addKeyBinding(
        { keyCode: 83, key: "S", description: "Toggle presenter notes (inline)" },
        toggleNotes,
      );
      // "n" is the second hand for the same overlay. It overrides reveal's
      // default "next slide" binding on purpose: → and SPACE already move the
      // deck, so the letter is free and reads as "notes".
      deck.addKeyBinding(
        { keyCode: 78, key: "N", description: "Toggle presenter notes (inline)" },
        toggleNotes,
      );
      deck.addKeyBinding(
        { keyCode: 80, key: "P", description: "Open presenter view (window)" },
        () => (deck.getPlugin("notes") as any)?.open?.(),
      );
      // "h" opens reveal's own key-map overlay. It overrides reveal's vim-style
      // "left" binding; the arrow keys keep that job.
      deck.addKeyBinding(
        { keyCode: 72, key: "H", description: "Toggle the keyboard help overlay" },
        () => (deck as any).toggleHelp(),
      );
      // ── Laser pointer: "l" toggles a red dot that follows the mouse.
      //    Same idea as PowerPoint's laser. The dot is one fixed element; the
      //    real cursor hides while the laser is on. Nothing else changes, so
      //    every widget on the Slide stays clickable. ────────────────────────
      const laserDot = document.createElement("div");
      laserDot.className = "laser-dot";
      document.body.appendChild(laserDot);
      let laserOn = false;
      function moveLaser(e: MouseEvent) {
        laserDot.dataset.seen = "";
        laserDot.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
      }
      function setLaser(on: boolean) {
        laserOn = on;
        document.documentElement.classList.toggle("laser-on", on);
        if (on) {
          window.addEventListener("mousemove", moveLaser);
        } else {
          window.removeEventListener("mousemove", moveLaser);
          delete laserDot.dataset.seen;
        }
      }
      deck.addKeyBinding(
        { keyCode: 76, key: "L", description: "Toggle laser pointer" },
        () => setLaser(!laserOn),
      );
      // The overview and the presenter's exit both want the arrow back.
      deck.on("overviewshown", () => setLaser(false));

      // "q" quits the deck and returns to the website's main page.
      deck.addKeyBinding(
        { keyCode: 81, key: "Q", description: "Quit deck → site home" },
        () => {
          window.location.href = "/";
        },
      );

      // ── Instrument chrome: section label + slide counter ──────────
      const chromeSection = document.querySelector("[data-chrome-section]");
      const chromeNow = document.querySelector("[data-chrome-now]");
      const chromeTotal = document.querySelector("[data-chrome-total]");
      const wash = document.querySelector<HTMLElement>("[data-wash]");
      const pad = (n: number) => String(n).padStart(2, "0");

      function updateChrome() {
        const cur = deck.getCurrentSlide() as HTMLElement | undefined;
        const label =
          cur?.getAttribute("data-section") ??
          cur?.parentElement?.getAttribute("data-section");
        if (label && chromeSection) chromeSection.textContent = label;
        const idx = deck.getIndices();
        // The index slide is 00, so the counter is the raw horizontal index
        // and the total is the last index, not the slide count.
        if (chromeNow) chromeNow.textContent = pad(idx.h);
        if (chromeTotal)
          chromeTotal.textContent = pad(deck.getHorizontalSlides().length - 1);
      }

      // ── Signature headline replay: re-arm .is-live on the live slide ──
      function armHeadline(slide: HTMLElement) {
        document
          .querySelectorAll(".reveal section.is-live")
          .forEach((s) => s.classList.remove("is-live"));
        // force reflow so the wipe restarts from baseline every entry
        void slide.offsetWidth;
        slide.classList.add("is-live");
      }

      // ── Chapter wash on entering a chapter divider ────────────────
      function runWash() {
        if (!wash) return;
        wash.classList.remove("run");
        void wash.offsetWidth;
        wash.classList.add("run");
      }

      /* ══════════════════════════════════════════════════════════════════
         CHAPTER A — tokens, credits, the cost dial (wayfinder #27)

         One thing still inline here: the input-billing ladder, which writes
         four figures into markup once and binds nothing. It answers to no
         Slide attribute and it never had a branch in either chain, so it is
         not a Widget and the registry has nothing to offer it (ADR 0002). It
         goes when its markup becomes a component.

         The chapter's three Widgets are all modules now — the vocabulary
         Slide's chips and counter in `lib/asml-ai/token-live.widget.ts`
         (#114), the bill table with its cost dial in
         `lib/asml-ai/cost-dial.widget.ts` and the benchmark chart in
         `lib/asml-ai/bench.widget.ts` (both #117). The glossary asks for
         Widget rather than island: island is Astro's word for a build
         concern, not for what the room sees.
         ══════════════════════════════════════════════════════════════════ */

      // ── The input-billing ladder ──────────────────────────────────
      // Text lives in components/deck/BillLadder.astro; only the figures come
      // from here, so the ladder can never disagree with the bill table two
      // slides later. One ladder now — the vocabulary slide's only fragment
      // — but the write stays a querySelectorAll, so a second copy would fill
      // itself.
      (() => {
        const model = RATES[1]; // GPT-5.4 — the middle of the lineup
        const tokens = 1240;
        const aic = (tokens * model.input) / 1e6;
        const eur = eurOfAic(aic);
        const set = (sel: string, v: string) =>
          document
            .querySelectorAll<HTMLElement>(sel)
            .forEach((el) => (el.textContent = v));
        set("[data-bill-tokens]", fmtInt(tokens));
        set("[data-bill-rate]", `× ${fmtInt(model.input)} AIC per 1M · ${model.name}`);
        set("[data-bill-aic]", aic.toFixed(2));
        // Well below the capped decimal rule, so this uses the uncapped one —
        // same reasoning as slide 3's euro column.
        set("[data-bill-eur]", fmtEur(eur, eurSigDecimals(eur)));
      })();

      // ── What arrival does that is not a Widget ────────────────────
      // The Headline, the Chrome, the Wash and the notes overlay. All four run
      // on every Slide unconditionally, so the registry buys them nothing and
      // ADR 0002 keeps them here. This is not a dispatch chain: it holds no
      // `if` on a Slide attribute and it asks no question about which Slide
      // arrived, apart from the one flag that fires the Wash.
      function onArrival(slide: HTMLElement) {
        armHeadline(slide);
        updateChrome();
        if (slide.hasAttribute("data-chapter")) runWash();
        // Keep the inline notes overlay in sync while it's open.
        if (notesEl && !notesEl.hasAttribute("hidden")) syncNotes();
      }

      deck.on("slidechanged", (e: any) => onArrival(e.currentSlide as HTMLElement));
      deck.on("ready", (e: any) => onArrival(e.currentSlide as HTMLElement));

      // Every Widget in the Deck, wired to reveal.js in one call. `WIDGETS` in
      // `deck-widgets.ts` is the list, and reading it there beats a number here
      // that has to be re-edited: this comment carried a count until #115, it
      // went stale on all three migration commits before it, and three reviews
      // caught it.
      //
      // The two `if` chains this replaced are gone as of #118. A new Widget is
      // now declared in its own module and appended to `WIDGETS`; there is no
      // second place to forget.
      mountWidgets(deck);
    </script>
  </body>
</html>
