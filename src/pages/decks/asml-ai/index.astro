              </div>
            </div>

            <div class="prim-frag-row" data-prim-frag-row aria-hidden="true">
              {primitives.map(() => <span class="fragment" />)}
            </div>
          </section>
        </section>

        <!-- 2.3 — vertical stack, 2 sub-slides -->
