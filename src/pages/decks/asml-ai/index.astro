---
/**
 * /decks/asml-ai — the REAL presentation deck ("Getting the Most from AI").
 *
 * Hard copy of the capability showcase (/decks/showcase-for-asml), taken as the
 * starting point for the real slides: same approach (thin Astro shell + embedded
 * reveal.js, single-deck spine — wayfinder #11) and the same "ASML Editorial"
 * light theme (#12). The showcase stays put as the reference gallery; this deck
 * is the one that gets presented, so edit slide copy here, not there.
 *
 * Standalone, full-viewport, no site chrome — deliberately does NOT use
 * BaseLayout. Decks are first-class routes: src/pages/decks/<slug>. This is /decks/asml-ai.
 * Fully static: reveal.js@5 + plugins bundle into the Astro JS chunk via Vite;
 * fonts self-hosted under /public/fonts. No CDN, no server, no secrets.
 */

// reveal.js base + our fresh light theme (import order = cascade order).
import "reveal.js/dist/reveal.css";
import "./theme-asml.css";
// PROTOTYPE (#35) — chapter 2's stochastic slide, three variants. Throwaway;
// dies with the branch `prototype/stochastic-slide`.
import "./prototype-stochastic.css";

const promptCode = `// Token-aware prompt assembly
export function assemblePrompt(sections: Section[], budget: number) {
  const ranked = sections.sort((a, b) => b.priority - a.priority);
  let used = 0;
  const kept: Section[] = [];
  for (const s of ranked) {
    const cost = estimateTokens(s.body);   // ~chars / 4
    if (used + cost > budget) continue;    // drop low-priority overflow
    kept.push(s);
    used += cost;
  }
  return { prompt: kept.map((s) => s.body).join("\\n\\n"), used, budget };
}`;

const helperCode = `// The estimate every budget leans on
export function estimateTokens(text: string): number {
  // Cheap client-side proxy: ~4 chars per token for English prose.
  // A shipping deck would swap in a real BPE tokenizer here.
  return Math.ceil(text.length / 4);
}`;
// Chapter 3, second half ("Where the tokens go" — the deck's former chapter
// 04, folded in by #30). The agent loop's step script and number
// model live in src/lib so the markup below and the controller at the bottom
// read the SAME table. See the file header for what is locked and why.
import { SCRIPT, FINAL } from "../../../lib/asml-ai/agent-loop";

// The deck's navigation spine (#29/#30): chapter 1's roadmap slide and the
// dividers entering chapters 2–5 are the SAME component, so the four factors
// can never drift apart. Their labels live in src/lib/asml-ai/roadmap.ts —
// edit them there, not in the markup below.
import RoadmapDivider from "../../../components/deck/RoadmapDivider.astro";

/**
 * Slide 7 — the context primitives. Eight blocks in three groups, copy taken
 * verbatim from wayfinder #23's resolution. Two things here are decisions, not
 * wording, and must survive edits:
 *
 * 1. The first block is `Harness bundle`, not "system prompt" — it echoes the
 *    deck's Model / Harness / Skills / Environment rings slide, so `Harness`
 *    joins `Skills` as a term appearing at two altitudes, both true. That
 *    double appearance is the bridge, not a contradiction to fix.
 * 2. Token cost is QUALITATIVE — framed by *when* you pay, never a number.
 *    No first-party figure exists for the size of a harness bundle, a tool
 *    definition or a skill (#22), and #21 publishes rates but never volumes.
 *    Any number here would be invented.
 */
type PrimBlock = {
  label: string;
  /** parenthetical qualifier, e.g. "incl. reasoning" */
  sub?: string;
  contains: string;
  why: string;
  cost: string;
};
const primitiveGroups: { group: string; note: string; blocks: PrimBlock[] }[] = [
  {
    group: "Static",
    note: "Loaded before you say a word, and re-sent unchanged every turn.",
    blocks: [
      {
        label: "Harness bundle",
        contains:
          "The instructions that turn a model into an agent — how to use tools, when to stop, house rules.",
        why: "Without it you have a model, not an agent.",
        cost: "Paid on every single turn.",
      },
      {
        label: "Tools",
        contains:
          "A written description of every tool the agent may call, with its parameters.",
        why: "The model can only call what it’s been described.",
        cost: "Paid every turn — whether you use them or not.",
      },
      {
        label: "Skills",
        contains:
          "Your team’s procedures, loaded so the agent works the same way twice.",
        why: "This is what makes the output consistent instead of a lottery.",
        cost: "Paid on every turn it stays loaded.",
      },
      {
        label: "Project prompt",
        contains:
          "Facts about this project — conventions, architecture, what not to touch.",
        why: "Stops the agent rediscovering your codebase from scratch.",
        cost: "Paid on every turn.",
      },
    ],
  },
  {
    group: "Dynamic",
    note: "Produced by the turns themselves. It only ever grows.",
    blocks: [
      {
        label: "User prompt",
        contains: "What you actually asked for.",
        why: "The only part most people think they’re paying for.",
        cost: "Almost always the smallest block here.",
      },
      {
        label: "The conversation",
        contains: "Every previous turn, question and answer, replayed in full.",
        why: "The model has no memory. The transcript <em>is</em> the memory.",
        cost: "Grows every turn. Never shrinks.",
      },
      {
        label: "Tool results",
        contains:
          "Every file read, search result and command output the agent pulled in.",
        why: "The agent has to see what it found.",
        cost: "Usually the largest block, and the fastest-growing.",
      },
    ],
  },
  {
    group: "Reserved",
    note: "Room held back, so there is somewhere to answer.",
    blocks: [
      {
        label: "The answer",
        sub: "incl. reasoning",
        contains:
          "Room held back for the reply — and for the thinking that precedes it.",
        why: "The window has to have space left to answer in.",
        cost: "Billed as output — 5–6× the price of input.",
      },
    ],
  },
];

// Flat, in click / fragment order — the panel cards and the fragment spine are
// indexed off this, so the two can never drift apart.
const primitives = primitiveGroups.flatMap((g) =>
  g.blocks.map((b) => ({ ...b, group: g.group })),
);

// Slide 8 — pre-rendered ledger rows and context strata. The geometry is
// deterministic (it comes straight out of the model), so it is server-rendered
// and the controller only toggles visibility and repaints the numbers.
const loopRows = SCRIPT.map((s, i) => ({
  step: i,
  role: s.role,
  text: s.text,
  billed: !!s.call,
  cost: s.call
    ? `call ${SCRIPT.slice(0, i + 1).filter((x) => x.call).length}`
    : s.out
      ? `+${s.out} out`
      : "free",
}));
// Heights are a true proportion of the final 2,715-token window — no
// compression. That is what makes the harness bundle read as 68% of it.
const loopStrata = SCRIPT.flatMap((s, i) =>
  s.block.map((b) => ({
    ...b,
    step: i,
    heightPct: (b.tokens / FINAL.contextTokens) * 100,
  })),
);
