import { hash32, tokenize } from "../../../lib/asml-ai/tokenize";

/**
 * Chapter 3's vocabulary slide, right panel (#24 revised, Atil 2026-08-23).
 *
 * The rotating hash cloud is gone: its placement was a hash, so it could never
 * show WHY a position carries meaning, and the room spent the slide watching
 * it turn. What replaces it is one word traced all the way down — token, its
 * ID, the numbers that ID points at, and the words that sit nearest. Static,
 * one screen, no motion.
 *
 * Both the ID and the numbers are derived here at build time from the same
 * `hash32` the chips use, so the ID on the right always matches the chip on
 * the left. The neighbours are written by hand: a hash cannot produce them,
 * and inventing them in code would be the same dishonesty the cloud had.
 */
const EMBED_DIMS = 1536;
/** Six numbers of the 1,536, five head and one tail — the vector is elided. */
function pseudoVector(word: string): { head: string[]; tail: string } {
  const v = (i: number) => {
    const h = hash32(word + ":" + i);
    return (((h % 2000) / 1000 - 1) * 0.92).toFixed(2).replace("-0.00", "0.00");
  };
  return { head: [0, 1, 2, 3, 4].map(v), tail: v(EMBED_DIMS - 1) };
}
const embedWord = (word: string, near: string[]) => ({
  word,
  id: tokenize(word)[0].id,
  vec: pseudoVector(word),
  near,
});
/** The word is `budget`, because it is in the prompt the room is reading. */
const EMBED_A = embedWord("budget", ["cost", "spend", "invoice"]);

/**
 * Slide 7 — the context primitives. Eight blocks in three groups, text taken
 * verbatim from wayfinder #23's resolution. Two things here are decisions, not
 * wording, and must survive edits:
 *
 * 1. The first block is `Harness bundle`, not "system prompt" — it echoes the
 *    deck's Model / Harness / Skills / Environment rings slide, so `Harness`
 *    joins `Skills` as a term appearing at two altitudes, both true. That
 *    double appearance is the bridge, not a contradiction to fix.
 * 2. Token cost is QUALITATIVE — framed by *when* you pay, never a number.
 *    No first-party figure exists for the size of a harness bundle, a tool
 *    definition or a skill (#22), and #21 publishes rates but never volumes.
 *    Any number here would be invented.
 */
type PrimBlock = {
  label: string;
  /** parenthetical qualifier, e.g. "incl. reasoning" */
  sub?: string;
  contains: string;
  why: string;
  cost: string;
};
const primitiveGroups: { group: string; note: string; blocks: PrimBlock[] }[] = [
  {
    group: "Static",
    note: "Loaded before you say a word, and re-sent unchanged every turn.",
    blocks: [
      {
        label: "Harness bundle",
        contains:
          "The instructions that turn a model into an agent — how to use tools, when to stop, house rules.",
        why: "Without it you have a model, not an agent.",
        cost: "Paid on every single turn.",
      },
      {
        label: "Tools",
        contains:
          "A written description of every tool the agent may call, with its parameters.",
        why: "The model can only call what it’s been described.",
        cost: "Paid every turn — whether you use them or not.",
      },
      {
        label: "Skills",
        contains:
          "Your team’s procedures, loaded so the agent works the same way twice.",
        why: "This is what makes the output consistent instead of a lottery.",
        cost: "Paid on every turn it stays loaded.",
      },
      {
        label: "Project prompt",
        contains:
          "Facts about this project — conventions, architecture, what not to touch.",
        why: "Stops the agent rediscovering your codebase from scratch.",
        cost: "Paid on every turn.",
      },
    ],
  },
  {
    group: "Dynamic",
    note: "Produced by the turns themselves. It only ever grows.",
    blocks: [
      {
        label: "User prompt",
        contains: "What you actually asked for.",
        why: "The only part most people think they’re paying for.",
        cost: "Almost always the smallest block here.",
      },
      {
        label: "The conversation",
        contains: "Every previous turn, question and answer, replayed in full.",
        why: "The model has no memory. The transcript <em>is</em> the memory.",
        cost: "Grows every turn. Never shrinks.",
      },
      {
        label: "Tool results",
        contains:
          "Every file read, search result and command output the agent pulled in.",
        why: "The agent has to see what it found.",
        cost: "Usually the largest block, and the fastest-growing.",
      },
    ],
  },
  {
    group: "Reserved",
    note: "Room held back, so there is somewhere to answer.",
    blocks: [
      {
        label: "The answer",
        sub: "incl. reasoning",
        contains:
          "Room held back for the reply — and for the thinking that precedes it.",
        why: "The window has to have space left to answer in.",
        cost: "Billed as output — 5–6× the price of input.",
      },
    ],
  },
];

// Flat, in click / fragment order — the panel cards and the fragment row are
// indexed off this, so the two can never drift apart.
const primitives = primitiveGroups.flatMap((g) =>
  g.blocks.map((b) => ({ ...b, group: g.group })),
);

// Slide 8 — the session. The blocks and the transcript are server-rendered;
// their HEIGHTS are not, because they are solved against the frame the
// projector actually gives us (see segSizer in lib/asml-ai/session.ts).
const baselineBlocks = BASELINE.length;

