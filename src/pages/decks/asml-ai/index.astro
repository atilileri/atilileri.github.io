          <span class="eyebrow">The statement</span>
          <h2 class="h-set">
            <span class="h-line"><span>Optimize</span></span>
            <span class="h-line"><span>on <em class="hot">purpose.</em></span></span>
          </h2>
          <aside class="notes">
            Cinematic device #1: the slide floods to solid signal-blue with one
            huge white sentence. The palette-break moment.
          </aside>
        </section>

        <!-- 12 ──────────────────── OUTRO -->
        <section class="hero" data-section="Closing">
          <span class="eyebrow">Thank you</span>
          <h1 class="h-set"><span class="h-line"><span class="accent">LET'S BUILD.</span></span></h1>
          <p class="byline">
            <kbd>S</kbd> presenter view · <kbd>ESC</kbd> overview · <kbd>F</kbd> fullscreen
          </p>
          <aside class="notes">
            Close. Everything shown is one static bundle on GitHub Pages — no
            backend, presentable from any machine.
          </aside>
        </section>
      </div>
    </div>

    <script>
      import {
        MODELS as RATES,
        eurOfAic,
        eurDecimals,
        eurSigDecimals,
        fmtEur,
        fmtAic,
        fmtInt,
        USD_PER_EUR,
      } from "../../../lib/asml-ai/rates";
      import {
        tokenize,
        place,
        SPREAD_XZ,
        SPREAD_Y,
        type Tok,
      } from "../../../lib/asml-ai/tokenize";
      import { frameAt, FINAL, MAX_TOKENS } from "../../../lib/asml-ai/agent-loop";
      // PROTOTYPE (#35) — the stochastic slide's data table, read by all three
      // variants so they can only disagree about presentation.
      import * as STOCH from "../../../lib/asml-ai/prototype-stochastic";
      import Reveal from "reveal.js";
      import RevealHighlight from "reveal.js/plugin/highlight/highlight.esm.js";
      import RevealNotes from "reveal.js/plugin/notes/notes.esm.js";
      import RevealZoom from "reveal.js/plugin/zoom/zoom.esm.js";

      // ══ PROTOTYPE (#35) — variant pruning, BEFORE reveal counts slides ══
      //    Three variants of the stochastic slide sit in the DOM; exactly one
      //    survives, so the deck walks at its real length in every variant and
      //    the slide is judged in its real neighbourhood (rings before it,
      //    the Agent/MCP gap after).
      const protoParams = new URLSearchParams(window.location.search);
      const protoVariant = (protoParams.get("variant") ?? "B").toUpperCase();
      document
        .querySelectorAll<HTMLElement>("[data-stoch]")
        .forEach((s) => {
          if (s.dataset.stochVariant !== protoVariant) s.remove();
        });
      document.body.classList.toggle("proto-honesty", protoParams.get("honesty") === "1");

      const deck = new Reveal({
        hash: true,
        // Standard reveal layout: a wide 16:9 canvas that reveal scales to fit
        // the viewport. (An earlier disableLayout:true left slides unpositioned
        // and registered zero slides — the blank-page bug.) The theme's fluid
        // clamp() type keys off the real viewport, so it still reads as a
        // responsive "web presentation" rather than a rigid fixed deck.
        width: 1600,
        height: 900,
        margin: 0.04,
        minScale: 0.2,
        maxScale: 2.0,
        transition: "slide", // advance right → left; verticals slide down
        transitionSpeed: "default",
        controls: true,
        controlsLayout: "bottom-right",
        progress: true,
        center: false, // hard-left editorial grid
        hideInactiveCursor: true,
        plugins: [RevealHighlight, RevealNotes, RevealZoom],
      });
      deck.initialize();
      // Expose the instance (debugging / headless verification navigation).
      (window as any).__deck = deck;

      // ── Presenter notes: "s" toggles an inline overlay (native-proto style),
      //    "p" opens reveal's separate presenter window. We override reveal's
      //    default "s" binding (keyCode 83, normally the speaker view). ──────
      const notesEl = document.querySelector<HTMLElement>("[data-notes]");
      const notesBody = document.querySelector<HTMLElement>("[data-notes-body]");
      function syncNotes() {
        if (!notesBody) return;
        const cur = deck.getCurrentSlide() as HTMLElement | undefined;
        const note = cur?.querySelector("aside.notes")?.textContent?.trim();
        notesBody.textContent = note && note.length ? note : "— no notes for this slide —";
      }
      deck.addKeyBinding(
        { keyCode: 83, key: "S", description: "Toggle presenter notes (inline)" },
        () => {
          if (!notesEl) return;
          notesEl.toggleAttribute("hidden");
          if (!notesEl.hasAttribute("hidden")) syncNotes();
        },
      );
      deck.addKeyBinding(
        { keyCode: 80, key: "P", description: "Open presenter view (window)" },
        () => (deck.getPlugin("notes") as any)?.open?.(),
      );
      // "q" quits the deck and returns to the website's main page.
      deck.addKeyBinding(
        { keyCode: 81, key: "Q", description: "Quit deck → site home" },
        () => {
          window.location.href = "/";
        },
      );

      // ── Instrument chrome: section label + slide counter ──────────
      const chromeSection = document.querySelector("[data-chrome-section]");
      const chromeNow = document.querySelector("[data-chrome-now]");
      const chromeTotal = document.querySelector("[data-chrome-total]");
      const wash = document.querySelector<HTMLElement>("[data-wash]");
      const pad = (n: number) => String(n).padStart(2, "0");

      function updateChrome() {
        const cur = deck.getCurrentSlide() as HTMLElement | undefined;
        const label =
          cur?.getAttribute("data-section") ??
          cur?.parentElement?.getAttribute("data-section");
        if (label && chromeSection) chromeSection.textContent = label;
        const idx = deck.getIndices();
        if (chromeNow) chromeNow.textContent = pad(idx.h + 1);
        if (chromeTotal)
          chromeTotal.textContent = pad(deck.getHorizontalSlides().length);
      }

      // ── Signature headline replay: re-arm .is-live on the live slide ──
      function armHeadline(slide: HTMLElement) {
        document
          .querySelectorAll(".reveal section.is-live")
          .forEach((s) => s.classList.remove("is-live"));
        // force reflow so the wipe restarts from baseline every entry
        void slide.offsetWidth;
        slide.classList.add("is-live");
      }

      // ── Animated data-viz (deterministic — resets & regrows on entry) ──
      function resetBars(slide: HTMLElement) {
        slide
          .querySelectorAll<HTMLElement>("[data-bars] .bar-fill")
          .forEach((el) => (el.style.width = "0%"));
      }
      function growBars(slide: HTMLElement) {
        slide
          .querySelectorAll<HTMLElement>("[data-bars] .bar-fill")
          .forEach((el) => {
            const w = el.getAttribute("data-w") ?? "0";
            el.style.width = w + "%";
          });
      }

      // ── Reliability scatter (result quality × spend) ──────────────
      //    Deterministic, presenter-driven: on entry the same dots sit
      //    scattered; a reveal fragment collapses them into the target box.
      const LOT = {
        VB: { w: 980, h: 600 },
        // plot frame (x grows right = more tokens; y grows down = worse).
        // Y0 sits high enough to leave room for the x-axis label beneath it.
        X0: 130, XN: 930, Y0: 470, YN: 60,
        xBudget: 530, yShip: 265, // thresholds at the MIDDLE of each axis
        // 18 attempts. Both populations share the same truth — more tokens
        // roughly buys more quality (a positive trend). before = a wide,
        // noisy spray touching all four quadrants. after = the SAME truth
        // shifted: high quality reached at far fewer tokens, spend narrowed
        // toward the left, spread tightened. It's a distribution shift, not
        // a collapse — a couple of attempts still miss.
        before: [
          [230, 400], [300, 340], [190, 300],
          [380, 300], [450, 250], [500, 240], [430, 360], [560, 200], [610, 300],
          [700, 180], [780, 140], [850, 120], [720, 240], [900, 160], [820, 220],
          [300, 150], [840, 380], [560, 430],
        ],
        // still a positive trend — quality rises with tokens — but a flatter
        // slope, pulled left and tightened. Best quality still costs a little
        // more (right edge of the band); two attempts still miss.
        after: [
          [205, 250], [220, 200], [240, 255],
          [255, 190], [270, 235], [290, 168], [300, 225], [315, 150], [330, 205],
          [350, 140], [365, 215], [465, 120], [380, 150], [400, 195], [420, 120],
          [445, 180], [560, 175], [455, 300],
        ],
        // strategically chosen attempts leave a dotted trail along their
        // path, each teaching a distinct vector: up (quality at same spend),
        // left (quality kept, tokens slashed), up-left (a dear miss rescued).
        TRACE: [0, 11, 16],
      };
      function buildLottery(slide: HTMLElement) {
        const svg = slide.querySelector<SVGSVGElement>("[data-lottery-svg]");
        if (!svg || svg.dataset.built) return;
        const NS = "http://www.w3.org/2000/svg";
        const mk = (t: string, a: Record<string, string | number>) => {
          const n = document.createElementNS(NS, t);
          for (const k in a) n.setAttribute(k, String(a[k]));
          return n;
        };
        const { X0, XN, Y0, YN, xBudget, yShip } = LOT;
        // target zone
        svg.append(mk("rect", {
          x: X0, y: YN, width: xBudget - X0, height: yShip - YN,
          rx: 10, class: "lot-zone",
        }));
        const zl = mk("text", { x: X0 + 14, y: YN + 30, class: "lot-zone-lbl" });
        zl.textContent = "SHIP-READY · ON BUDGET";
        svg.append(zl);
        // axes
        svg.append(mk("line", { x1: X0, y1: Y0, x2: XN, y2: Y0, class: "lot-axis" }));
        svg.append(mk("line", { x1: X0, y1: Y0, x2: X0, y2: YN, class: "lot-axis" }));
        // threshold guides
        svg.append(mk("line", { x1: X0, y1: yShip, x2: XN, y2: yShip, class: "lot-guide" }));
        svg.append(mk("line", { x1: xBudget, y1: Y0, x2: xBudget, y2: YN, class: "lot-guide" }));
        // axis titles
        const yt = mk("text", { x: X0 - 40, y: (Y0 + YN) / 2, class: "lot-axtitle",
          transform: `rotate(-90 ${X0 - 40} ${(Y0 + YN) / 2})` });
        yt.textContent = "Result quality →";
        svg.append(yt);
        const xt = mk("text", { x: (X0 + XN) / 2, y: Y0 + 42, class: "lot-axtitle" });
        xt.textContent = "Tokens spent →";
        svg.append(xt);
        // threshold indicators, sat where each guide line meets its axis
        const qb = mk("text", { x: X0 + 12, y: yShip - 12, class: "lot-thresh" });
        qb.textContent = "acceptable quality";
        svg.append(qb);
        const bb = mk("text", {
          x: xBudget - 12, y: Y0 - 14, class: "lot-thresh", "text-anchor": "end",
        });
        bb.textContent = "monthly budget";
        svg.append(bb);
        // ── Fitted trend lines, one per state ────────────────────────────
        // Ordinary least squares over each cloud, computed here rather than
        // hard-coded so the lines cannot drift if the point sets are ever
        // retuned. Both slopes are NEGATIVE in SVG space (y grows downward),
        // i.e. both clouds really do trend "more tokens → better results".
        //
        // OUTLIERS ARE EXCLUDED FROM THE FIT (Atil, 2026-08-02) — the last
        // three "before" points and the last two "after" points. That is not
        // arbitrary trimming: those points are the deliberately odd ones the
        // set was built with — before's lucky win, dear miss and bad miss
        // (the "touches all four quadrants" tail), and after's two attempts
        // that still miss. They stay ON SCREEN, because the honest picture
        // includes them; they are just kept out of the line so the fit
        // describes the body of the distribution rather than being dragged by
        // its tail. Both counts are tied to the tail's length, so anything
        // appended to these arrays lands INSIDE the fit unless this changes.
        //
        // Each line spans only its own fitted points' x-range, so it reads as
        // a fit of those points rather than a prediction beyond them.
        const FIT_DROP = { before: 3, after: 2 };
        const fit = (pts: number[][]) => {
          const n = pts.length;
          const mx = pts.reduce((s, p) => s + p[0], 0) / n;
          const my = pts.reduce((s, p) => s + p[1], 0) / n;
          let num = 0, den = 0;
          for (const [x, y] of pts) {
            num += (x - mx) * (y - my);
            den += (x - mx) * (x - mx);
          }
          const slope = den === 0 ? 0 : num / den;
          const xs = pts.map((p) => p[0]);
          const x1 = Math.min(...xs), x2 = Math.max(...xs);
          return {
            x1, x2,
            y1: my + slope * (x1 - mx),
            y2: my + slope * (x2 - mx),
          };
        };
        for (const [pts, drop, cls] of [
          [LOT.before, FIT_DROP.before, "lot-fit lot-fit-before"],
          [LOT.after, FIT_DROP.after, "lot-fit lot-fit-after"],
        ] as const) {
          const body = (pts as number[][]).slice(0, pts.length - drop);
          const f = fit(body);
          svg.append(mk("line", {
            x1: f.x1, y1: f.y1, x2: f.x2, y2: f.y2, class: cls,
          }));
        }

        // dotted traces for the chosen few — drawn first so they sit BEHIND
        // the dots; they fade in as the attempts travel (.go).
        LOT.TRACE.forEach((i) => {
          const [bx, by] = LOT.before[i];
          const [ax, ay] = LOT.after[i];
          svg.append(mk("line", {
            x1: bx, y1: by, x2: ax, y2: ay, class: "lot-trace",
          }));
        });
        // dots — base position is the AFTER coord; a per-dot translate offsets
        // them out to the scattered BEFORE coord until the box collapses (.go).
        LOT.before.forEach(([bx, by], i) => {
          const [ax, ay] = LOT.after[i];
          const c = mk("circle", { cx: ax, cy: ay, r: 12, class: "lot-dot" });
          (c as SVGElement).setAttribute(
            "style",
            `--tf:translate(${bx - ax}px,${by - ay}px);--d:${(i % 6) * 40}ms`,
          );
          svg.append(c);
        });
        svg.dataset.built = "1";
      }
      // The slide is now purely the scatter: its caption block was removed
      // (Atil, 2026-08-02) and the 3-of-18 / 16-of-18 figures moved into the
      // presenter note, so there is no on-screen text to swap — only the
      // class that moves the cloud.
      function setLottery(slide: HTMLElement, collapsed: boolean) {
        const svg = slide.querySelector<SVGSVGElement>("[data-lottery-svg]");
        if (!svg) return;
        svg.classList.toggle("go", collapsed);
      }

      // ── "The one number" count-up ─────────────────────────────────
      let countTimer: number | undefined;
      function playCount(slide: HTMLElement) {
        const el = slide.querySelector<HTMLElement>("[data-count-to]");
        if (!el) return;
        const to = Number(el.getAttribute("data-count-to") ?? "0");
        const suffix = el.getAttribute("data-count-suffix") ?? "";
        const start = performance.now();
        const dur = 900;
        if (countTimer) cancelAnimationFrame(countTimer);
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = String(Math.round(eased * to)) + suffix;
          if (t < 1) countTimer = requestAnimationFrame(tick);
        };
        countTimer = requestAnimationFrame(tick);
      }

      // ── Live tokenizer ────────────────────────────────────────────
      const tokInput = document.querySelector<HTMLTextAreaElement>("[data-tok-input]");
      function updateTokens() {
        if (!tokInput) return;
        const text = tokInput.value;
        const chars = text.length;
        const words = text.trim() ? text.trim().split(/\s+/).length : 0;
        const tokens = Math.max(0, Math.ceil(chars / 4));
        const cost = ((tokens / 1_000_000) * 15).toFixed(6);
        const set = (sel: string, v: string) => {
          const el = document.querySelector(sel);
          if (el) el.textContent = v;
        };
        set("[data-tok-chars]", String(chars));
        set("[data-tok-words]", String(words));
        set("[data-tok-tokens]", String(tokens));
        set("[data-tok-cost]", "$" + cost);
      }
      tokInput?.addEventListener("input", updateTokens);
      updateTokens();

      // ── Terminal / CLI replay (deterministic) ─────────────────────
      const replay: { t: string; d: number; cls?: string; type?: boolean }[] = [
        { t: "$ ", d: 250 },
        { t: "claude /wayfinder issue-13\n", d: 40, type: true },
        { t: "→ claiming ticket · assigning @atilileri\n", d: 420, cls: "sig" },
        { t: "→ building the exemplary showcase\n", d: 360, cls: "sig" },
        { t: "  ✓ hero   ✓ scrollytelling   ✓ tokenizer\n", d: 300, cls: "ok" },
        { t: "  ✓ data-viz   ✓ code demo   ✓ terminal\n", d: 300, cls: "ok" },
        { t: "  ✓ sub-slides ✓ chapter wash  ✓ one-number\n", d: 300, cls: "ok" },
        { t: "→ astro build … static, no server\n", d: 460, cls: "sig" },
        { t: "  ✓ dist/ ready for GitHub Pages\n", d: 360, cls: "ok" },
        { t: "$ ", d: 250 },
      ];
      let termTimer: number | undefined;
      function playTerminal(slide: HTMLElement) {
        const body = slide.querySelector<HTMLElement>("[data-term-body]");
        if (!body) return;
        if (termTimer) clearTimeout(termTimer);
        body.innerHTML = "";
        let i = 0;
        const step = () => {
          if (i >= replay.length) {
            body.insertAdjacentHTML("beforeend", '<span class="term-cursor">&nbsp;</span>');
            return;
          }
          const { t, d, cls, type } = replay[i++];
          if (type) {
            let c = 0;
            const typeChar = () => {
              if (c < t.length) {
                body.append(t[c++]);
                termTimer = window.setTimeout(typeChar, 42);
              } else {
                termTimer = window.setTimeout(step, d);
              }
            };
            typeChar();
          } else {
            const span = document.createElement("span");
            if (cls) span.className = cls;
            span.textContent = t;
            body.appendChild(span);
            termTimer = window.setTimeout(step, d);
          }
        };
        step();
      }

      // ── Interactive benchmark chart (DeepSWE v1.1) ────────────────
      // Hand-rolled SVG — no charting library, so the deck palette reaches
      // inside the chart. Two views over one dataset: a cost/pass-rate scatter
      // and ranked bars with 95% CI whiskers. Data transcribed from the public
      // leaderboard at deepswe.datacurve.ai/blog/deepswe-v1-1 (113 tasks).
      type Model = {
        name: string;
        fam: string;
        rate: number; // pass@1 %
        ci: number; // ± percentage points
        cost: number; // avg $ / task
        tok: string; // output tokens
        steps: number;
        effort?: string; // reasoning effort — set only for scatter points
      };
      const MODELS: Model[] = [
        { name: "gpt-5.6-sol", fam: "OpenAI", rate: 73, ci: 3, cost: 8.39, tok: "60k", steps: 61 },
        { name: "claude-fable-5", fam: "Anthropic", rate: 70, ci: 4, cost: 21.63, tok: "119k", steps: 88 },
        { name: "gpt-5.6-terra", fam: "OpenAI", rate: 70, ci: 3, cost: 4.95, tok: "72k", steps: 76 },
        { name: "kimi-k3", fam: "Moonshot", rate: 69, ci: 5, cost: 4.65, tok: "81k", steps: 98 },
        { name: "gpt-5.6-luna", fam: "OpenAI", rate: 67, ci: 4, cost: 3.03, tok: "73k", steps: 102 },
        { name: "gpt-5.5", fam: "OpenAI", rate: 67, ci: 6, cost: 7.23, tok: "46k", steps: 82 },
        { name: "claude-opus-4.8", fam: "Anthropic", rate: 59, ci: 2, cost: 13.22, tok: "135k", steps: 120 },
        { name: "claude-sonnet-5", fam: "Anthropic", rate: 54, ci: 4, cost: 26.4, tok: "214k", steps: 268 },
        { name: "grok-4.5", fam: "Other", rate: 54, ci: 2, cost: 2.42, tok: "36k", steps: 61 },
        { name: "muse-spark-1.1", fam: "Other", rate: 53, ci: 3, cost: 2.36, tok: "74k", steps: 96 },
        { name: "gpt-5.4", fam: "OpenAI", rate: 52, ci: 2, cost: 5.65, tok: "71k", steps: 70 },
        { name: "gemini-3.6-flash", fam: "Google", rate: 49, ci: 5, cost: 3.53, tok: "97k", steps: 108 },
        { name: "glm-5.2", fam: "Other", rate: 44, ci: 2, cost: 3.92, tok: "78k", steps: 129 },
        { name: "gemini-3.5-flash", fam: "Google", rate: 37, ci: 2, cost: 7.34, tok: "276k", steps: 86 },
        { name: "kimi-k2.7-code", fam: "Moonshot", rate: 31, ci: 1, cost: 2.82, tok: "59k", steps: 149 },
        { name: "claude-sonnet-4.6", fam: "Anthropic", rate: 30, ci: 4, cost: 5.52, tok: "76k", steps: 134 },
        { name: "gemini-3.1-pro", fam: "Google", rate: 12, ci: 2, cost: 9.48, tok: "196k", steps: 81 },
      ];
      // Fixed hue order, never cycled — validated for CVD separation on this
      // light surface (scripts/validate_palette.js, all six checks pass).
      const FAMS: { key: string; color: string }[] = [
        { key: "OpenAI", color: "#1a6fd4" },
        { key: "Anthropic", color: "#e0620d" },
        { key: "Google", color: "#0f8f6f" },
        { key: "Moonshot", color: "#8a4fd0" },
        { key: "Other", color: "#c2185b" },
      ];
      const famColor = (f: string) =>
        FAMS.find((x) => x.key === f)?.color ?? "#c2185b";

      // The scatter is per reasoning-effort, not per leaderboard row: one model
      // traces a curve as you spend more on it. Points and label placements are
      // transcribed from the published chart; label dx/dy are its own collision
      // solve, kept so 15 callouts sit clean at any size.
      type Curve = {
        name: string;
        fam: string;
        eff: string; // effort level of the labelled point
        anchor: string;
        dx: number;
        dy: number;
        lx: number;
        ly: number;
        at: number; // index of the labelled point
        pts: [number, number][]; // [avg $ / task, pass@1 %], cheapest first
      };
      const CURVES: Curve[] = [
        { name: "gpt-5.6-sol", fam: "OpenAI", eff: "MEDIUM", anchor: "start", dx: 11, dy: 4, lx: 10, ly: 0, at: 1,
          pts: [[1.08, 45.4], [1.86, 61.1], [3.47, 69.4], [4.7, 70.7], [8.39, 72.7]] },
        { name: "claude-fable-5", fam: "Anthropic", eff: "HIGH", anchor: "end", dx: -11, dy: 4, lx: -10, ly: 0, at: 2,
          pts: [[3.76, 59.6], [6.09, 65.4], [9.18, 68.6], [13.41, 69.9], [21.64, 69.7]] },
        { name: "gpt-5.5", fam: "OpenAI", eff: "MEDIUM", anchor: "start", dx: 18, dy: 4, lx: 17, ly: 0, at: 1,
          pts: [[1.2, 27.0], [2.75, 54.0], [5.1, 64.4], [7.23, 67.0]] },
        { name: "claude-opus-4.8", fam: "Anthropic", eff: "HIGH", anchor: "start", dx: 36, dy: 16, lx: 35, ly: 12, at: 2,
          pts: [[2.29, 40.8], [3.44, 48.7], [4.28, 51.8], [8.01, 54.4], [13.22, 59.0]] },
        { name: "claude-sonnet-5", fam: "Anthropic", eff: "HIGH", anchor: "end", dx: -11, dy: -10, lx: -10, ly: -14, at: 2,
          pts: [[2.19, 30.5], [4.08, 39.8], [7.42, 48.2], [11.89, 49.7], [26.4, 53.8]] },
        { name: "glm-5.2", fam: "Other", eff: "MAX", anchor: "end", dx: -11, dy: 28, lx: -10, ly: 24, at: 1,
          pts: [[2.84, 36.3], [3.92, 43.8]] },
        { name: "kimi-k3", fam: "Moonshot", eff: "MAX", anchor: "end", dx: -11, dy: -10, lx: -10, ly: -14, at: 0, pts: [[4.65, 68.5]] },
        { name: "grok-4.5", fam: "Other", eff: "HIGH", anchor: "end", dx: -18, dy: -10, lx: -17, ly: -14, at: 0, pts: [[2.42, 53.8]] },
        { name: "muse-spark-1.1", fam: "Other", eff: "XHIGH", anchor: "end", dx: -48, dy: -46, lx: -47, ly: -50, at: 0, pts: [[2.36, 53.3]] },
        { name: "gpt-5.4", fam: "OpenAI", eff: "XHIGH", anchor: "end", dx: -11, dy: 40, lx: -10, ly: 36, at: 0, pts: [[5.65, 51.8]] },
        { name: "gemini-3.6-flash", fam: "Google", eff: "HIGH", anchor: "start", dx: 36, dy: 52, lx: 35, ly: 48, at: 0, pts: [[3.53, 48.6]] },
        { name: "gemini-3.5-flash", fam: "Google", eff: "MEDIUM", anchor: "end", dx: -11, dy: 4, lx: -10, ly: 0, at: 0, pts: [[7.34, 37.4]] },
        { name: "kimi-k2.7-code", fam: "Moonshot", eff: "", anchor: "start", dx: 11, dy: -10, lx: 10, ly: -14, at: 0, pts: [[2.82, 30.5]] },
        { name: "claude-sonnet-4.6", fam: "Anthropic", eff: "HIGH", anchor: "end", dx: -11, dy: 4, lx: -10, ly: 0, at: 0, pts: [[5.52, 29.9]] },
        { name: "gemini-3.1-pro", fam: "Google", eff: "HIGH", anchor: "start", dx: 11, dy: 4, lx: 10, ly: 0, at: 0, pts: [[9.48, 11.8]] },
      ];

      const benchSvg = document.querySelector<SVGSVGElement>("[data-bench-svg]");
      const benchTip = document.querySelector<HTMLElement>("[data-bench-tip]");
      const benchLegend = document.querySelector<HTMLElement>("[data-bench-legend]");
      const benchPlot = benchSvg?.closest<HTMLElement>(".bench-plot");
      let benchView: "scatter" | "bars" = "scatter";
      // Empty = show every family; otherwise only the picked ones.
      const benchOn = new Set<string>();

      const NS = "http://www.w3.org/2000/svg";
      function el(tag: string, attrs: Record<string, string | number>) {
        const n = document.createElementNS(NS, tag);
        for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
        return n;
      }
      const visible = (m: Model) => benchOn.size === 0 || benchOn.has(m.fam);
      const dim = (m: Model) => (visible(m) ? "1" : "0.12");

      function showTip(m: Model, ev: MouseEvent) {
        if (!benchTip || !benchPlot) return;
        // Scatter points carry an effort level and their own cost/score; the
        // token and step counts are the leaderboard row's, so they only show
        // where the whole row is what's on screen.
        benchTip.innerHTML =
          `<b style="color:${famColor(m.fam)}">${m.name}</b>` +
          (m.effort ? `<span class="e">${m.effort.toLowerCase()}</span>` : "") +
          `<span class="r">${m.rate}%${m.effort ? "" : `<i>±${m.ci}</i>`}</span>` +
          `<span class="k">avg cost<b>$${m.cost.toFixed(2)}</b></span>` +
          (m.effort
            ? ""
            : `<span class="k">output<b>${m.tok}</b></span>` +
              `<span class="k">steps<b>${m.steps}</b></span>`);
        benchTip.hidden = false;
        const box = benchPlot.getBoundingClientRect();
        const x = ev.clientX - box.left;
        const y = ev.clientY - box.top;
        benchTip.style.left = Math.min(x + 16, box.width - 210) + "px";
        benchTip.style.top = Math.max(y - 12, 0) + "px";
      }
      function hideTip() {
        if (benchTip) benchTip.hidden = true;
      }
      benchPlot?.addEventListener("mouseleave", hideTip);

      /** Attach hover affordances to one mark. */
      function wireMark(g: SVGElement, m: Model) {
        g.addEventListener("mousemove", (e) => showTip(m, e as MouseEvent));
        g.addEventListener("mouseleave", hideTip);
      }

      // Cost runs LEFT-to-RIGHT: $0 at the left edge, spend increasing
      // rightward — the conventional reading, and the same direction as the
      // stop-point slide that follows (Atil, 2026-08-02). The chart used to
      // run the other way, which put two consecutive slides on opposite cost
      // axes. "Cheap and good" is now the top-LEFT corner.
      // The px-per-dollar scale is UNCHANGED from the original (28.9192), and
      // the labels are mirrored along with the points — together those two
      // facts preserve the 15-callout collision solve exactly, because a
      // reflection cannot introduce a label-label overlap that wasn't already
      // there. All the flip needed was somewhere for the now-leftward labels
      // to go: hence the 175px left margin, and the wider viewBox below that
      // pays for it. The SVG scales to the slide, so a wider canvas just
      // renders slightly smaller rather than clipping.
      const CX = (c: number) => 175 + c * 28.9192;
      const CY = (s: number) => 511 - s * 5.8875;

      function drawCurves() {
        if (!benchSvg) return;
        const T = 40, B = 511, L = 115, R = 980;
        for (let s = 0; s <= 80; s += 10) {
          benchSvg.append(el("line", { x1: L, x2: R, y1: CY(s), y2: CY(s), class: "grid" }));
          const t = el("text", { x: L - 10, y: CY(s) + 4, class: "tick end" });
          t.textContent = s + "%";
          benchSvg.append(t);
        }
        for (let c = 0; c <= 25; c += 5) {
          if (c) benchSvg.append(el("line", { x1: CX(c), x2: CX(c), y1: T, y2: B, class: "grid" }));
          const t = el("text", { x: CX(c), y: B + 22, class: "tick mid" });
          t.textContent = "$" + c;
          benchSvg.append(t);
        }
        benchSvg.append(el("line", { x1: L, x2: R, y1: B, y2: B, class: "axis" }));

        // THE CEILING (#33). One of the chart's two proofs — the other, the
        // stop-point, belongs to the next slide, so nothing here draws it.
        // 72.7 is gpt-5.6-sol's top point, i.e. what the scatter actually
        // plots; MODELS' `rate: 73` is the rounded leaderboard row the ranked
        // bars use. Same fact, two precisions — draw against the plot's own.
        const CEIL = 72.7;
        benchSvg.append(
          el("line", { x1: L, x2: R, y1: CY(CEIL), y2: CY(CEIL), class: "ceiling" }),
        );
        // Right-anchored: since the flip, the top-LEFT band belongs to the
        // "most efficient" pointer, and two annotations in one corner read as
        // clutter. The expensive end of the ceiling is also the more damning
        // place to say it.
        const ceilLbl = el("text", { x: R - 8, y: CY(CEIL) - 12, class: "ceiling-lbl end" });
        ceilLbl.textContent = "nothing clears this";
        benchSvg.append(ceilLbl);
        const xl = el("text", { x: (L + R) / 2, y: B + 44, class: "axis-label mid" });
        xl.textContent = "avg cost per task";
        const head = el("text", { x: L, y: 22, class: "plot-title" });
        head.textContent = "DeepSWE score";
        // Cheap AND good is now the top-LEFT corner, so the pointer flips with
        // the axis. It is also promoted out of the whispered italic it used to
        // be: it names the quadrant the whole slide is asking the room to look
        // at, and at 12px muted grey nobody ever did.
        const eff = el("text", { x: L + 10, y: 50, class: "efficient" });
        eff.textContent = "↖ most efficient";
        benchSvg.append(xl, head, eff);

        for (const cv of CURVES) {
          const m = MODELS.find((x) => x.name === cv.name);
          const on = benchOn.size === 0 || benchOn.has(cv.fam);
          const g = el("g", { class: "curve", opacity: on ? 1 : 0.12 }) as SVGGElement;
          const color = famColor(cv.fam);
          if (cv.pts.length > 1) {
            g.append(
              el("path", {
                d: cv.pts.map(([c, s], i) => `${i ? "L" : "M"} ${CX(c)} ${CY(s)}`).join(" "),
                fill: "none", stroke: color, "stroke-width": 2.5,
                "stroke-linecap": "round", "stroke-linejoin": "round", opacity: 0.75,
              }),
            );
          }
          cv.pts.forEach(([c, s], i) => {
            g.append(
              el("circle", {
                cx: CX(c), cy: CY(s), r: i === cv.at ? 4.5 : 3.5,
                fill: color, class: "dot",
              }),
            );
          });
          const [lc, ls] = cv.pts[cv.at];
          const x = CX(lc), y = CY(ls);
          // The dx/lx/anchor triplet in CURVES is a collision solve done
          // against the ORIGINAL right-to-left axis. The plot is mirrored, so
          // the labels mirror with it — negate the horizontal offsets, swap
          // the anchor — and all 15 callouts keep exactly the spacing they
          // were tuned for. Vertical offsets are untouched. Do not "fix" this
          // by leaving the offsets as authored: that puts every label on the
          // wrong side of its own curve.
          const dx = -cv.dx, lx = -cv.lx;
          const anchor = cv.anchor === "end" ? "start" : "end";
          g.append(
            el("line", {
              x1: x, y1: y, x2: x + lx, y2: y + cv.ly,
              stroke: color, "stroke-width": 1, opacity: 0.35,
            }),
          );
          const name = el("text", {
            x: x + dx, y: y + cv.dy, "text-anchor": anchor,
            fill: color, class: "curve-label",
          });
          name.textContent = cv.name;
          g.append(name);
          if (cv.eff) {
            const e2 = el("text", {
              x: x + dx, y: y + cv.dy + 11, "text-anchor": anchor,
              fill: color, class: "curve-eff",
            });
            e2.textContent = cv.eff;
            g.append(e2);
          }
          // One generous hit target per point, over the top of the labels.
          if (on && m) {
            cv.pts.forEach(([c, s], i) => {
              const hit = el("circle", { cx: CX(c), cy: CY(s), r: 11, fill: "transparent" });
              const at: Model = {
                ...m,
                cost: c,
                rate: s,
                effort: i === cv.at ? cv.eff : `effort ${i + 1} of ${cv.pts.length}`,
              };
              hit.addEventListener("mousemove", (ev) => showTip(at, ev as MouseEvent));
              hit.addEventListener("mouseleave", hideTip);
              g.append(hit);
            });
          }
          benchSvg.append(g);
        }
      }

      function drawBars() {
        if (!benchSvg) return;
        const L = 250, R = 1090, T = 14;
        const rowH = 25;
        const bw = (r: number) => (r / 80) * (R - L);
        MODELS.forEach((m, i) => {
          const y = T + i * rowH;
          const g = el("g", { class: "row", opacity: dim(m) }) as SVGGElement;
          const name = el("text", { x: L - 16, y: y + 14, class: "row-name end" });
          name.textContent = m.name;
          const track = el("rect", { x: L, y: y + 3, width: R - L, height: 15, class: "row-track" });
          const fill = el("rect", {
            x: L, y: y + 3, width: bw(m.rate), height: 15, rx: 4,
            fill: famColor(m.fam),
          });
          const lo = L + bw(m.rate - m.ci), hi = L + bw(m.rate + m.ci);
          const whisk = el("line", { x1: lo, x2: hi, y1: y + 10.5, y2: y + 10.5, class: "ci" });
          const cap1 = el("line", { x1: lo, x2: lo, y1: y + 5, y2: y + 16, class: "ci" });
          const cap2 = el("line", { x1: hi, x2: hi, y1: y + 5, y2: y + 16, class: "ci" });
          const val = el("text", { x: R + 14, y: y + 14, class: "row-val" });
          val.textContent = `${m.rate}% ±${m.ci}`;
          const hit = el("rect", { x: 0, y, width: 1180, height: rowH, fill: "transparent" });
          g.append(name, track, fill, whisk, cap1, cap2, val, hit);
          if (visible(m)) wireMark(g, m);
          benchSvg!.append(g);
        });
      }

      function drawBench() {
        if (!benchSvg) return;
        hideTip();
        benchSvg.textContent = "";
        // Each view owns its coordinate space; the SVG scales to the slide.
        benchSvg.setAttribute(
          "viewBox",
          benchView === "scatter" ? "0 0 1000 570" : "0 0 1180 470",
        );
        if (benchView === "scatter") drawCurves();
        else drawBars();
      }

      // Legend doubles as the family filter (click to isolate, click to release).
      FAMS.forEach((f) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "chip";
        b.style.setProperty("--c", f.color);
        b.textContent = f.key;
        b.addEventListener("click", () => {
          if (benchOn.has(f.key)) benchOn.delete(f.key);
          else benchOn.add(f.key);
          benchLegend
            ?.querySelectorAll<HTMLElement>(".chip")
            .forEach((c) =>
              c.classList.toggle("on", benchOn.has(c.textContent ?? "")),
            );
          benchLegend?.classList.toggle("filtered", benchOn.size > 0);
          drawBench();
        });
        benchLegend?.append(b);
      });
      document
        .querySelectorAll<HTMLButtonElement>(".bench-toggle button")
        .forEach((b) =>
          b.addEventListener("click", () => {
            benchView = b.dataset.view as "scatter" | "bars";
            document
              .querySelectorAll(".bench-toggle button")
              .forEach((o) => o.classList.toggle("on", o === b));
            drawBench();
          }),
        );
      drawBench();

      /* ══════════ CHAPTER 01 — the stop-point (#33) ═══════════════════════
         The bench chart reduced to one line and one number. It reads off the
         SAME `CURVES` array as the slide before it, deliberately: there is no
         second dataset to keep in sync, and if the chart's numbers ever move,
         this slide moves with them.

         The whole argument is MARGINAL, not cumulative — "this step cost you
         €X more and bought you Y" — because cumulative spend is the claim the
         previous slide already made. The last step is the slide: 61% more
         money, 0.2 points less.

         Step is DERIVED from reveal's visible fragment count (#26), never
         counted locally, so → and ← are symmetric and entering backwards from
         the roadmap lands on the final frame rather than replaying. */
      const STOP_CURVE = CURVES.find((c) => c.name === "claude-fable-5")!;
      const STOP = {
        VB: { w: 900, h: 468 },
        X0: 120, XN: 840, Y0: 408, YN: 52,
        // The plot is framed on this curve alone, so the shape of ONE model's
        // diminishing return fills the slide; the bench chart's shared scale
        // would squash it into the top-right corner. The y-range is tight on
        // purpose — the whole slide turns on a 0.2-point drop, and on the
        // previous slide's 0–80% axis that drop is under three pixels. The
        // axis is labelled and starts at a non-zero score, which is honest
        // here because the slide compares steps of one curve, not models.
        cMin: 0, cMax: 24, sMin: 58, sMax: 71,
      };
      const stopEur = (usd: number) => usd / USD_PER_EUR;
      const SX = (c: number) =>
        STOP.X0 + ((c - STOP.cMin) / (STOP.cMax - STOP.cMin)) * (STOP.XN - STOP.X0);
      const SY = (s: number) =>
        STOP.Y0 - ((s - STOP.sMin) / (STOP.sMax - STOP.sMin)) * (STOP.Y0 - STOP.YN);

      function buildStop(slide: HTMLElement) {
        const svg = slide.querySelector<SVGSVGElement>("[data-stop-svg]");
        if (!svg || svg.dataset.built) return;
        const pts = STOP_CURVE.pts;

        // Axis furniture, deliberately thin: two labelled ends per axis, no
        // grid. The slide is a shape, not a chart to read values off.
        for (const c of [0, 5, 10, 15, 20]) {
          const t = el("text", { x: SX(c), y: STOP.Y0 + 24, class: "tick mid" });
          t.textContent = "€" + Math.round(stopEur(c));
          svg.append(t);
        }
        for (const s of [60, 62, 64, 66, 68, 70]) {
          svg.append(
            el("line", { x1: STOP.X0, x2: STOP.XN, y1: SY(s), y2: SY(s), class: "grid" }),
          );
          const t = el("text", { x: STOP.X0 - 12, y: SY(s) + 5, class: "tick end" });
          t.textContent = s + "%";
          svg.append(t);
        }
        svg.append(
          el("line", {
            x1: STOP.X0, x2: STOP.XN, y1: STOP.Y0, y2: STOP.Y0, class: "axis",
          }),
        );
        const xl = el("text", {
          x: (STOP.X0 + STOP.XN) / 2, y: STOP.Y0 + 48, class: "axis-label mid",
        });
        xl.textContent = "cost per task";
        const head = el("text", { x: STOP.X0, y: 30, class: "plot-title" });
        head.textContent = "claude-fable-5 — one model, five levels of effort";
        svg.append(xl, head);

        // The path is drawn once and revealed by dash-offset, so the line
        // GROWS to the marker instead of redrawing on every step.
        const d = pts.map(([c, s], i) => `${i ? "L" : "M"} ${SX(c)} ${SY(s)}`).join(" ");
        const path = el("path", {
          d, fill: "none", class: "stop-line",
          "stroke-linecap": "round", "stroke-linejoin": "round",
        }) as SVGPathElement;
        svg.append(path);
        const len = path.getTotalLength();
        path.style.setProperty("--len", String(len));

        // Per-segment lengths, so the reveal stops exactly on each point.
        const cum = [0];
        for (let i = 1; i < pts.length; i++) {
          const [pc, ps] = pts[i - 1];
          const [c, s] = pts[i];
          cum.push(cum[i - 1] + Math.hypot(SX(c) - SX(pc), SY(s) - SY(ps)));
        }
        svg.dataset.cum = cum.join(",");
        svg.dataset.len = String(len);

        pts.forEach(([c, s], i) => {
          const dot = el("circle", {
            cx: SX(c), cy: SY(s), r: 5, class: "stop-dot", "data-stop-dot": i,
          });
          svg.append(dot);
        });
        svg.append(el("circle", { cx: SX(pts[0][0]), cy: SY(pts[0][1]), r: 9, class: "stop-marker", "data-stop-marker": "" }));
        svg.dataset.built = "1";
      }

      /** step 0–4 = which point the marker sits on; `landed` greys the curve. */
      function paintStop(slide: HTMLElement, step: number, landed: boolean) {
        const svg = slide.querySelector<SVGSVGElement>("[data-stop-svg]");
        const read = slide.querySelector<HTMLElement>("[data-stop-read]");
        if (!svg) return;
        const pts = STOP_CURVE.pts;
        const i = Math.max(0, Math.min(pts.length - 1, step));
        const cum = (svg.dataset.cum ?? "0").split(",").map(Number);
        const len = Number(svg.dataset.len ?? "0");

        const path = svg.querySelector<SVGPathElement>(".stop-line");
        if (path) path.style.strokeDashoffset = String(len - cum[i]);

        const marker = svg.querySelector<SVGCircleElement>("[data-stop-marker]");
        if (marker) {
          marker.setAttribute("cx", String(SX(pts[i][0])));
          marker.setAttribute("cy", String(SY(pts[i][1])));
        }
        svg.querySelectorAll<SVGCircleElement>("[data-stop-dot]").forEach((d) => {
          d.classList.toggle("is-on", Number(d.dataset.stopDot) <= i);
        });
        // The turn-over is the point of the slide, so the last step is marked
        // as a loss in the deck's own accent rather than left to the eye.
        svg.classList.toggle("is-down", i === pts.length - 1);
        svg.classList.toggle("is-landed", landed);

        if (read) {
          if (i === 0) {
            read.innerHTML =
              `<span class="k">lowest effort</span>` +
              `<span class="v">${fmtEur(stopEur(pts[0][0]))} per task &middot; ${pts[0][1]}%</span>`;
            read.classList.remove("is-loss");
          } else {
            const dC = stopEur(pts[i][0]) - stopEur(pts[i - 1][0]);
            const dS = pts[i][1] - pts[i - 1][1];
            const pct = Math.round((pts[i][0] / pts[i - 1][0] - 1) * 100);
            const loss = dS < 0;
            read.innerHTML =
              `<span class="k">+${fmtEur(dC)} per task <i>(${pct}% more)</i></span>` +
              `<span class="v">${dS > 0 ? "+" : "&minus;"}${Math.abs(dS).toFixed(1)} points</span>`;
            read.classList.toggle("is-loss", loss);
          }
        }
      }

      /** Derive the frame from reveal's fragment state — never from a counter. */
      function syncStop(slide: HTMLElement) {
        const shown = slide.querySelectorAll(".stop-step.visible").length;
        // 5 fragments: the first four walk points 1–4, the fifth lands the
        // turn without moving the marker.
        paintStop(slide, Math.min(shown, STOP_CURVE.pts.length - 1), shown >= 5);
        slide.classList.toggle("has-landed", shown >= 5);
      }

      // Sanity net: this slide's entire argument is that the LAST step costs
      // more and scores less. If the chart's data is ever re-transcribed and
      // that stops being true, the copy is wrong and the slide must be redone.
      if (import.meta.env.DEV) {
        const p = STOP_CURVE.pts;
        const last = p[p.length - 1], prev = p[p.length - 2];
        if (!(last[0] > prev[0] && last[1] < prev[1]))
          console.warn("#33's stop-point slide: the curve no longer turns over");
      }

      // ── Chapter wash on entering a chapter divider ────────────────
      function runWash() {
        if (!wash) return;
        wash.classList.remove("run");
        void wash.offsetWidth;
        wash.classList.add("run");
      }

      // ── Scroll-driven narrative reveals ───────────────────────────
      document.querySelectorAll<HTMLElement>("[data-scroll-frame]").forEach((frame) => {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) =>
              e.target.classList.toggle("in", e.isIntersecting),
            );
          },
          { root: frame, threshold: 0.55 },
        );
        frame
          .querySelectorAll("[data-scroll-step]")
          .forEach((s) => io.observe(s));
      });

      /* ══════════════════════════════════════════════════════════════════
         CHAPTER A — tokens, credits, the cost dial (wayfinder #27)

         Three vanilla-TS islands, no new runtime dependency. Every one is a
         pure function of its markup plus module constants, so slide entry
         replays them identically with no stored state.
         ══════════════════════════════════════════════════════════════════ */

      const escapeHtml = (s: string) =>
        s.replace(/[<>&"]/g, (c) =>
          ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;" })[c]!,
        );
      const reducedMotion = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /** Count a number into place. Formatter is fixed by the caller so the
          decimal width can't change mid-animation. */
      const countShown = new WeakMap<HTMLElement, number>();
      function countUp(
        el: HTMLElement,
        target: number,
        fmt: (n: number) => string,
        dur = 420,
      ) {
        const from = countShown.get(el) ?? 0;
        countShown.set(el, target);
        if (reducedMotion()) {
          el.textContent = fmt(target);
          return;
        }
        const t0 = performance.now();
        const step = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          el.textContent = fmt(from + (target - from) * (1 - Math.pow(1 - p, 3)));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }

      // ── A4: the credit rate table ─────────────────────────────────
      // Static, but generated — the rates live in one module and nothing else
      // in the deck is allowed to know a number.
      const creditRates = document.querySelector<HTMLElement>("[data-credit-rates]");
      if (creditRates) {
        creditRates.innerHTML =
          `<tr><th>model</th><th>input</th><th>cached</th><th>output</th></tr>` +
          RATES.map(
            (m) =>
              `<tr><td>${m.name}</td><td>${fmtInt(m.input)}</td>` +
              `<td>${fmtInt(m.cached)}</td><td>${fmtInt(m.output)}</td></tr>`,
          ).join("") +
          `<tr class="unit"><td colspan="4">AI credits per 1M tokens</td></tr>`;
      }

      // ── A4: the input-billing ladder ──────────────────────────────
      // Copy lives in the markup; only the figures come from here, so the
      // ladder can never disagree with the rate table above it.
      (() => {
        const model = RATES[1]; // GPT-5.4 — the middle of the lineup
        const tokens = 1240;
        const aic = (tokens * model.input) / 1e6;
        const eur = eurOfAic(aic);
        const set = (sel: string, v: string) => {
          const el = document.querySelector<HTMLElement>(sel);
          if (el) el.textContent = v;
        };
        set("[data-bill-tokens]", fmtInt(tokens));
        set("[data-bill-rate]", `× ${fmtInt(model.input)} AIC per 1M · ${model.name}`);
        set("[data-bill-aic]", aic.toFixed(2));
        // Well below the capped decimal rule, so this uses the uncapped one —
        // same reasoning as slide 3's euro column.
        set("[data-bill-eur]", fmtEur(eur, eurSigDecimals(eur)));
      })();

      // ── A3: live tokenizer + the 3D embedding space ───────────────
      // Hand-rolled SVG perspective projection (#24 variant A). A 12-edge
      // wireframe box is what makes the panel read as a space with things
      // inside it rather than words sprayed on a card; the white halo under
      // each glyph (paint-order: stroke) keeps labels legible where it crowds.
      function cloudRenderer() {
        const SVGNS = "http://www.w3.org/2000/svg";
        let svg: SVGSVGElement;
        let gBox: SVGGElement;
        let gPts: SVGGElement;
        let pts: { p: [number, number, number]; label: string }[] = [];
        let W = 800;
        let H = 480;
        // CAM is far back on purpose — closer and the near face distorts into
        // a funnel. `fit` is solved at mount so the box lands at ~92% of
        // whatever panel it gets *at its widest rotation*: corner-on it
        // projects ~1.4x its face-on width, and sizing to the face-on view
        // clips the edges so the volume stops reading as closed.
        const FOCAL = 700;
        const CAM = 760;
        const TILT = 0.32;
        let fit = 1;

        function project(p: [number, number, number], a: number) {
          const [x, y, z] = p;
          const cx = Math.cos(a), sx = Math.sin(a);
          const X = x * cx - z * sx;
          let Z = x * sx + z * cx;
          const cy = Math.cos(TILT), sy = Math.sin(TILT);
          const Y = y * cy - Z * sy;
          Z = y * sy + Z * cy;
          const s = FOCAL / Math.max(60, CAM + Z);
          return { x: W / 2 + X * s * fit, y: H / 2 + Y * s * fit, s, z: Z };
        }

        /** FOCAL/CAM/SPREAD_* were calibrated against a panel this size. */
        const REF_W = 800;
        const REF_H = 480;
        const solveFit = () => (fit = Math.min(W / REF_W, H / REF_H));

        // The box sits outside the point shell, so the cloud reads as inside a
        // space rather than bursting out of a tight crate.
        const BOX_XZ = SPREAD_XZ * 1.16;
        const BOX_Y = SPREAD_Y * 1.22;
        const CUBE: [number, number, number][] = [];
        for (const sx of [-1, 1])
          for (const sy of [-1, 1])
            for (const sz of [-1, 1]) CUBE.push([sx * BOX_XZ, sy * BOX_Y, sz * BOX_XZ]);
        const EDGES: [number, number][] = [];
        CUBE.forEach((a, i) =>
          CUBE.forEach((b, j) => {
            if (j <= i) return;
            if (a.filter((v, k) => v !== b[k]).length === 1) EDGES.push([i, j]);
          }),
        );

        return {
          mount(host: HTMLElement) {
            host.innerHTML = "";
            const r = host.getBoundingClientRect();
            W = Math.max(400, r.width);
            H = Math.max(280, r.height);
            solveFit();
            svg = document.createElementNS(SVGNS, "svg");
            svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
            svg.setAttribute("width", "100%");
            svg.setAttribute("height", "100%");
            svg.setAttribute("aria-hidden", "true");
            gBox = document.createElementNS(SVGNS, "g");
            gPts = document.createElementNS(SVGNS, "g");
            svg.append(gBox, gPts);
            host.append(svg);
          },
          set(toks: Tok[]) {
            pts = toks
              .filter((t) => t.text.trim())
              .slice(-48)
              .map((t) => ({ p: place(t), label: t.text.trim() }));
          },
          frame(a: number) {
            if (!gBox) return;
            let box = "";
            for (const [i, j] of EDGES) {
              const p1 = project(CUBE[i], a), p2 = project(CUBE[j], a);
              box += `<line x1="${p1.x.toFixed(1)}" y1="${p1.y.toFixed(1)}" x2="${p2.x.toFixed(1)}" y2="${p2.y.toFixed(1)}" stroke="#0066cc" stroke-opacity="0.10" stroke-width="1"/>`;
            }
            gBox.innerHTML = box;
            let out = "";
            for (const p of pts
              .map((pt) => ({ ...project(pt.p, a), label: pt.label }))
              .sort((m, n) => n.z - m.z)) {
              // s runs ~0.54 (far face) to ~1.08 (near face) at this camera
              const depth = Math.max(0.28, Math.min(1, (p.s - 0.5) / 0.52));
              // No orange in the cloud: the slide's one hot accent is already
              // spent on the token count.
              out +=
                `<circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="${(1.6 + depth * 2.6).toFixed(1)}" fill="#0066CC" fill-opacity="${(depth * 0.85).toFixed(2)}"/>` +
                `<text x="${(p.x + 6).toFixed(1)}" y="${(p.y + 4).toFixed(1)}" font-family="JetBrains Mono, monospace" font-size="${(15 + depth * 10).toFixed(1)}" fill="#00327d" fill-opacity="${(depth * 0.95).toFixed(2)}" stroke="#ffffff" stroke-width="3" stroke-opacity="${(depth * 0.8).toFixed(2)}" paint-order="stroke" stroke-linejoin="round">${escapeHtml(p.label)}</text>`;
            }
            gPts.innerHTML = out;
          },
        };
      }

      const tkInput = document.querySelector<HTMLTextAreaElement>("[data-tk-input]");
      const tkChips = document.querySelector<HTMLElement>("[data-tk-chips]");
      const tkCloudHost = document.querySelector<HTMLElement>("[data-tk-cloud]");
      const tkLiveN = document.querySelector<HTMLElement>("[data-tk-live-n]");
      const tkPrice = document.querySelector<HTMLElement>("[data-tk-price]");
      const cloud = cloudRenderer();
      let cloudRaf = 0;
      let cloudAngle = 0;

      // The entry animation: chips start flush and read as the sentence, then
      // break apart while the counter ticks up.
      // It plays *once*, on slide entry — typing after that updates instantly,
      // because re-shattering on every keystroke would make the widget feel
      // slow and would bury the thing the room is actually watching.
      let liveIntroTimer = 0;
      function renderLive(intro = false) {
        if (!tkInput || !tkChips || !tkLiveN || !tkPrice) return;
        const toks = tokenize(tkInput.value);
        tkChips.innerHTML = toks
          .slice(-60)
          .map((t, i) => {
            const sp = t.text.startsWith(" ") ? " data-sp" : "";
            return `<span class="tk-chip"${sp} style="--i:${i}"><span class="t">${escapeHtml(
              t.text.trimStart(),
            )}</span><span class="id">${t.id}</span></span>`;
          })
          .join("");
        window.clearTimeout(liveIntroTimer);
        if (intro) {
          tkChips.classList.add("intro");
          void tkChips.offsetWidth; // reflow, so the break starts from flush
          tkLiveN.textContent = "0";
          countShown.set(tkLiveN, 0);
          // The count and the break start together — holding the sentence
          // intact while the number has already finished counting is what
          // made the two read as unrelated.
          liveIntroTimer = window.setTimeout(
            () => {
              tkChips.classList.remove("intro");
              countUp(tkLiveN, toks.length, (n) => String(Math.round(n)), 1400);
            },
            reducedMotion() ? 0 : 520,
          );
        } else {
          tkChips.classList.remove("intro");
          tkLiveN.textContent = String(toks.length);
          countShown.set(tkLiveN, toks.length);
        }
        // The typed text in euros is ~EUR 0.000007, far below the capped
        // decimal rule — so it gets the uncapped one, and the whole column
        // shares the width the *cheapest* model needs, or the figures don't
        // line up. The orange accent stays on the per-1M rate: that is the
        // stable number the room can hold, and it only lands once.
        const textEur = RATES.map((m) => eurOfAic((toks.length * m.input) / 1e6));
        const dp = eurSigDecimals(Math.min(...textEur));
        tkPrice.innerHTML =
          `<tr><th>model</th><th>this text</th><th>in euros</th><th>per 1M tokens</th></tr>` +
          RATES.map(
            (m, i) =>
              `<tr><td>${m.name}</td>` +
              `<td class="aic">${((toks.length * m.input) / 1e6).toFixed(4)} AIC</td>` +
              `<td class="aic">${fmtEur(textEur[i], dp)}</td>` +
              `<td class="eur">${fmtEur(eurOfAic(m.input))}</td></tr>`,
          ).join("");
        cloud.set(toks);
      }
      tkInput?.addEventListener("input", () => renderLive());

      function startCloud() {
        if (!tkCloudHost || cloudRaf) return;
        cloudAngle = 0;
        cloud.mount(tkCloudHost);
        renderLive(true);
        if (reducedMotion()) {
          cloud.frame(0);
          return;
        }
        let last = performance.now();
        const loop = (now: number) => {
          cloudAngle += (now - last) * 0.00022;
          last = now;
          cloud.frame(cloudAngle);
          cloudRaf = requestAnimationFrame(loop);
        };
        cloudRaf = requestAnimationFrame(loop);
      }
      function stopCloud() {
        if (cloudRaf) cancelAnimationFrame(cloudRaf);
        cloudRaf = 0;
      }

      // ── A5: the cost dial ─────────────────────────────────────────
      type DialKey = "input" | "cached" | "output";
      const DIAL_MAX: Record<DialKey, number> = {
        input: 200_000,
        cached: 200_000,
        output: 20_000,
      };
      // Flash is the default and Opus is the reach: on the locked rates
      // GPT-5.4 → Opus is only 1.9x, but Flash → Opus is 9.3x. Cached is
      // non-zero so a third of the widget isn't dead on arrival.
      const DIAL_PRESET: Record<DialKey, number> = {
        input: 20_000,
        cached: 60_000,
        output: 3_000,
      };
      const dial = { ...DIAL_PRESET, model: 0 };
      const dialAic = () => {
        const m = RATES[dial.model];
        return (
          (dial.input * m.input + dial.cached * m.cached + dial.output * m.output) /
          1e6
        );
      };

      const dialModelHost = document.querySelector<HTMLElement>("[data-dial-models]");
      RATES.forEach((m, i) => {
        const b = document.createElement("button");
        b.type = "button";
        b.innerHTML = `${m.name} <span class="m-mult" data-mult></span>`;
        b.addEventListener("click", () => {
          dial.model = i;
          renderDial();
        });
        dialModelHost?.append(b);
      });

      document.querySelectorAll<HTMLElement>("[data-knob]").forEach((el) => {
        const key = el.dataset.knob as DialKey;
        el.tabIndex = 0;
        let dragging = false;
        let startY = 0;
        let startV = 0;
        el.addEventListener("pointerdown", (e) => {
          dragging = true;
          startY = e.clientY;
          startV = dial[key];
          el.setPointerCapture(e.pointerId);
        });
        el.addEventListener("pointermove", (e) => {
          if (!dragging) return;
          const delta = ((startY - e.clientY) / 220) * DIAL_MAX[key];
          dial[key] = Math.max(
            0,
            Math.min(DIAL_MAX[key], Math.round((startV + delta) / 500) * 500),
          );
          renderDial(key);
        });
        el.addEventListener("pointerup", () => (dragging = false));
        // A focused knob owns the arrows and stops them reaching reveal, so an
        // unfocused → still advances the slide and the clicker behaves.
        el.addEventListener("keydown", (e) => {
          const d =
            e.key === "ArrowRight" || e.key === "ArrowUp"
              ? 1
              : e.key === "ArrowLeft" || e.key === "ArrowDown"
                ? -1
                : 0;
          if (!d) return;
          const coarse = e.key === "ArrowUp" || e.key === "ArrowDown" ? 4 : 1;
          dial[key] = Math.max(
            0,
            Math.min(DIAL_MAX[key], dial[key] + (d * DIAL_MAX[key] * coarse) / 40),
          );
          renderDial(key);
          e.preventDefault();
          e.stopPropagation();
        });
      });

      /** "1×", "9.3×" — trailing .0 dropped so the cheapest reads as a clean 1. */
      const fmtMult = (n: number) => n.toFixed(1).replace(/\.0$/, "") + "×";

      let dialLitTimer = 0;
      function renderDial(touched?: DialKey) {
        const m = RATES[dial.model];
        // Each model carries what it costs relative to the cheapest one *at the
        // current mix* — so the spread widens and narrows as the knobs move,
        // which is the point: the gap is a property of the work, not the badge.
        const costs = RATES.map((r) =>
          (dial.input * r.input + dial.cached * r.cached + dial.output * r.output) / 1e6,
        );
        const cheapest = Math.min(...costs);
        dialModelHost?.querySelectorAll("button").forEach((b, i) => {
          b.setAttribute("aria-pressed", String(i === dial.model));
          const mult = b.querySelector<HTMLElement>("[data-mult]");
          // With every knob at zero every model costs nothing and the ratio is
          // undefined — show nothing rather than a made-up 1×.
          if (mult) mult.textContent = cheapest > 0 ? fmtMult(costs[i] / cheapest) : "";
        });
        document.querySelectorAll<HTMLElement>("[data-knob]").forEach((el) => {
          const key = el.dataset.knob as DialKey;
          const frac = dial[key] / DIAL_MAX[key];
          el.querySelector<SVGElement>("[data-knob-arc]")!.style.strokeDasharray =
            `${frac * 188} 251`;
          el.querySelector<SVGElement>("[data-knob-ptr]")!.style.transform =
            `rotate(${135 + frac * 270}deg)`;
          el.querySelector<HTMLElement>("[data-knob-val]")!.textContent = fmtInt(dial[key]);
          el.toggleAttribute("data-hot", touched === key);
        });
        document.querySelectorAll<HTMLElement>("[data-term]").forEach((el) => {
          const key = el.dataset.term as DialKey;
          el.querySelector<HTMLElement>("[data-t-tok]")!.textContent = fmtInt(dial[key]);
          el.querySelector<HTMLElement>("[data-t-rate]")!.textContent = String(m[key]);
          el.classList.toggle("lit", touched === key);
        });
        window.clearTimeout(dialLitTimer);
        dialLitTimer = window.setTimeout(() => {
          document
            .querySelectorAll(".dial-eq .t.lit")
            .forEach((e) => e.classList.remove("lit"));
          document
            .querySelectorAll("[data-knob]")
            .forEach((e) => e.removeAttribute("data-hot"));
        }, 900);

        const aic = dialAic();
        const eurEl = document.querySelector<HTMLElement>("[data-dial-eur]");
        const aicEl = document.querySelector<HTMLElement>("[data-dial-aic]");
        if (aicEl) countUp(aicEl, aic, fmtAic);
        if (eurEl) {
          // Decimals are pinned to the target, so the width can't change
          // mid-count; tabular numerals keep the columns from jittering.
          const eur = eurOfAic(aic);
          const dp = eurDecimals(eur);
          countUp(eurEl, eur, (n) => fmtEur(n, dp));
        }
      }
      function resetDial() {
        Object.assign(dial, DIAL_PRESET);
        dial.model = 0;
        document
          .querySelectorAll<HTMLElement>("[data-dial-aic],[data-dial-eur]")
          .forEach((el) => countShown.set(el, 0));
        renderDial();
      }

      /* ══════════ CHAPTER 03 (2nd half) — context primitives ══════════════
         Fragment index selects the block: -1 is the summary panel, 0-7 pick a
         block. That makes the clicker's → walk the eight blocks with no custom
         binding, and clicking a block simply navigates to its fragment — so
         pointer and clicker share one state and can never disagree. ────── */

      function paintPrimitives(slide: HTMLElement, index: number) {
        slide.querySelectorAll<HTMLElement>("[data-prim-block]").forEach((b) => {
          const on = Number(b.dataset.primBlock) === index;
          b.classList.toggle("is-on", on);
          b.setAttribute("aria-pressed", String(on));
        });
        const key = index < 0 ? "summary" : String(index);
        slide
          .querySelectorAll<HTMLElement>("[data-prim-card]")
          .forEach((c) => c.classList.toggle("is-on", c.dataset.primCard === key));
        slide.classList.toggle("has-selection", index >= 0);
      }

      function syncPrimitives(slide: HTMLElement) {
        const shown = slide.querySelectorAll(
          "[data-prim-spine] .fragment.visible",
        ).length;
        paintPrimitives(slide, shown - 1);
      }

      /** Move reveal to the fragment that selects `index` (-1 = summary). */
      function selectPrimitive(slide: HTMLElement, index: number) {
        const idx = deck.getIndices(slide);
        deck.slide(idx.h, idx.v, index);
      }

      document.querySelectorAll<HTMLElement>("[data-primitives]").forEach((slide) => {
        slide.querySelectorAll<HTMLElement>("[data-prim-block]").forEach((b) =>
          b.addEventListener("click", () =>
            selectPrimitive(slide, Number(b.dataset.primBlock)),
          ),
        );
        slide
          .querySelector("[data-prim-clear]")
          ?.addEventListener("click", () => selectPrimitive(slide, -1));
      });

      /* ══════════ CHAPTER 03 (2nd half) — the agent loop ═════════════════
         Variant C, the ledger (#26): twelve rows always on screen, the context
         window as a strata gutter, a credit odometer over the three token bars.
         12 step fragments + a 13th for the bridge; the step is DERIVED from
         reveal's fragment state, never counted, which is what makes stepping
         back and re-entering replay correctly. ─────────────────────────── */

      function paintLoop(slide: HTMLElement, step: number, bridge: boolean) {
        // step -1 (no fragments yet) is a genuinely empty window, so the first
        // → lands the harness bundle and the tool schemas — 2,460 tokens on the
        // clock before anyone has said a word. The prototype clamped to step 0
        // here, which made the first click do nothing visible.
        const f = frameAt(step);

        slide.querySelectorAll<HTMLElement>("[data-al-row]").forEach((row) => {
          row.classList.toggle("is-on", Number(row.dataset.alRow) <= f.step);
        });

        slide.querySelectorAll<HTMLElement>("[data-al-seg]").forEach((seg, i) => {
          // The gutter stays colour-keyed by role for the whole run — it is the
          // window, not the bill. What is cached and what is fresh is the bars'
          // job; tinting the gutter too flattened it to one colour by step 12.
          seg.classList.toggle("is-on", !!f.blocks[i]);
        });

        const q = (sel: string) => slide.querySelector<HTMLElement>(sel);
        const bar = (
          k: "input" | "cached" | "output",
          v: number,
        ) => {
          const n = q(`[data-al-${k}]`);
          if (n) n.textContent = v.toLocaleString("en-US");
          const fill = q(`[data-al-bar-${k}]`);
          if (fill) fill.style.width = `${(v / MAX_TOKENS) * 100}%`;
        };
        bar("input", f.billedInput);
        bar("cached", f.billedCached);
        bar("output", f.billedOutput);

        // Euro is the currency a delegate reads; AIC stays on screen because it
        // is what the allowance and the admin console are denominated in.
        // Widths are pinned to the largest value the run reaches (€0.0096 →
        // 4 dp, €0.024 → 3 dp) so no digit appears mid-run.
        const eurNode = q("[data-al-eur]");
        if (eurNode) eurNode.textContent = fmtEur(eurOfAic(f.credits), 4);
        const aicNode = q("[data-al-aic]");
        if (aicNode) aicNode.textContent = f.credits.toFixed(2);
        const ctxNode = q("[data-al-ctx]");
        if (ctxNode) ctxNode.textContent = f.contextTokens.toLocaleString("en-US");
        const callsNode = q("[data-al-calls]");
        if (callsNode) callsNode.textContent = String(f.callIndex);
        const ghost = q("[data-al-ghost]");
        if (ghost)
          ghost.textContent = f.billedCached
            ? `Cold cache: ${fmtEur(eurOfAic(f.creditsNoCache), 3)} · ${f.creditsNoCache.toFixed(2)} AIC — the cache is doing ${Math.round((1 - f.credits / f.creditsNoCache) * 100)}% of the work.`
            : "";

        slide.classList.toggle("bridge-on", bridge);
      }

      function syncLoop(slide: HTMLElement) {
        const shown = slide.querySelectorAll(
          "[data-al-spine] .fragment.visible:not([data-al-bridge-frag])",
        ).length;
        const bridge = !!slide
          .querySelector("[data-al-bridge-frag]")
          ?.classList.contains("visible");
        paintLoop(slide, shown - 1, bridge);
      }

      // Sanity net for the two figures the slide's whole argument rests on.
      if (import.meta.env.DEV && FINAL.contextTokens !== 2715)
        console.warn("agent-loop model drifted from #26's locked numbers");

      // ══════════════════════════════════════════════════════════════════════
      //  PROTOTYPE (#35) — the stochastic / hallucination slide, 3 variants.
      //  Throwaway. Every variant reads the same table and derives its frame
      //  from reveal's fragment state (#26's rule), never from a counter, so
      //  → and ← replay identically and re-entry from either direction lands
      //  on the right frame.
      //
      //  Three fragments in every variant, and they mean the same thing in
      //  each: 1 the five answers arrive, uncoloured · 2 the labels land and
      //  three of five go orange · 3 the tells + the definitions.
      // ══════════════════════════════════════════════════════════════════════

      function ph(tag: string, cls?: string, txt?: string) {
        const n = document.createElement(tag);
        if (cls) n.className = cls;
        if (txt != null) n.textContent = txt;
        return n;
      }
      function phDelay(n: HTMLElement, i: number) {
        n.style.transitionDelay = i * 80 + "ms";
        return n;
      }
      const isBad = (k: string) => k !== "legit";

      /** The trace, with the line the faithfulness answer contradicts wrapped
       *  so it can light up later. Nothing is highlighted before that. */
      function buildStochAsk(slide: HTMLElement) {
        const t = slide.querySelector<HTMLElement>("[data-stoch-trace]");
        if (t) {
          t.textContent = "";
          STOCH.TRACE.forEach((ln, i) => {
            if (i) t.append(document.createTextNode("\n"));
            // Second frame carries "manifest.ts:42" — the fact answer 3 gets
            // wrong. Bolding it up front would tip the room off, so the
            // element exists from the start and only takes colour at the tell.
            if (ln.includes("manifest.ts:42")) {
              const [pre, post] = ln.split("manifest.ts:42");
              t.append(document.createTextNode(pre));
              t.append(ph("b", undefined, "manifest.ts:42"));
              t.append(document.createTextNode(post));
            } else t.append(document.createTextNode(ln));
          });
        }
        const q = slide.querySelector<HTMLElement>("[data-stoch-q]");
        if (q) q.textContent = '"' + STOCH.PROMPT + '"';
      }

      /** The two definitions, landing on the last fragment (A and C). */
      function buildStochDefs(slide: HTMLElement) {
        const d = slide.querySelector<HTMLElement>("[data-stoch-defs]");
        if (!d) return;
        d.textContent = "";
        (["faithfulness", "factuality"] as const).forEach((k) => {
          const box = ph("div", "def");
          box.append(ph("span", "k", STOCH.KINDS[k].tag));
          box.append(ph("p", undefined, STOCH.KINDS[k].def));
          d.append(box);
        });
      }

      /** A — the ladder. One ranked list; three rows go orange in place. */
      function buildStochLadder(slide: HTMLElement) {
        const l = slide.querySelector<HTMLElement>("[data-stoch-ladder]");
        if (!l) return;
        l.textContent = "";
        STOCH.ANSWERS.forEach((a, i) => {
          const bad = isBad(a.kind);
          const bar = ph("div", "rowbar row stoch-fade" + (bad ? " bad" : ""));
          const fill = ph("i");
          fill.style.setProperty("--r", Math.round(STOCH.RANK[i] * 100) + "%");
          bar.append(fill);
          const txt = ph("p", "txt row stoch-fade" + (bad ? " bad" : ""), a.text);
          // NOT .stoch-fade: that class wins on specificity and would show
          // the tag with the row. The tag has its own reveal — it waits for
          // the fold, which is the whole point of the frame.
          const tag = ph("span", "tag row" + (bad ? " bad" : ""), STOCH.KINDS[a.kind].tag);
          l.append(phDelay(bar, i), phDelay(txt, i), phDelay(tag, i));
          l.append(ph("span", "tell", a.tell));
        });
      }

      /** B — the sort. One pile that splits into two lanes. */
      function buildStochSort(slide: HTMLElement) {
        const heads = slide.querySelector<HTMLElement>("[data-stoch-lane-heads]");
        if (heads) {
          heads.textContent = "";
          heads.append(ph("span", undefined, STOCH.COPY.lanes.legit));
          heads.append(ph("span", "bad", STOCH.COPY.lanes.halluc));
        }
        const s = slide.querySelector<HTMLElement>("[data-stoch-sorted]");
        if (!s) return;
        s.textContent = "";
        STOCH.ANSWERS.forEach((a, i) => {
          const bad = isBad(a.kind);
          const card = ph("div", "card" + (bad ? " bad" : ""));
          card.dataset.bad = bad ? "1" : "";
          // One slot above the answer, holding two things that never coexist:
          // the rank bar while the five are still an undifferentiated pile,
          // and the category once they have been sorted. Both are absolutely
          // placed inside a fixed-height row, so the swap costs no reflow and
          // the card heights are identical in both states.
          const slot = ph("div", "slot");
          const bar = ph("span", "bar" + (bad ? " bad" : ""));
          const fill = ph("i");
          fill.style.setProperty("--r", Math.round(STOCH.RANK[i] * 100) + "%");
          bar.append(fill);
          slot.append(bar, ph("span", "tag", STOCH.KINDS[a.kind].tag));
          card.append(slot);
          card.append(ph("p", undefined, a.text));
          card.append(ph("span", "tell", a.tell));
          card.style.transitionDelay = i * 80 + "ms";
          s.append(card);
        });
      }

      /** B's whole argument is the MOVE, so it cannot be a grid-column swap —
       *  that is a hard cut. Measure the cards once they are laid out, then
       *  write both positions as CSS vars and let one transform transition
       *  carry them: a centred pile that splits into two stacked lanes.
       *
       *  Heights are read AFTER layout (rAF), so this must run on slide entry
       *  and not at import time. Positions are in px against the container's
       *  own box, which is fixed by reveal's 1600x900 canvas. */
      function layoutStochSort(slide: HTMLElement) {
        const s = slide.querySelector<HTMLElement>("[data-stoch-sorted]");
        if (!s) return;
        const cards = [...s.querySelectorAll<HTMLElement>(".card")];
        if (!cards.length) return;
        const half = s.clientWidth / 2 + 11; // lane width + the CSS gutter

        // Two measurements, because the two states are different heights: the
        // pile is measured with the tells COLLAPSED (they don't exist yet at
        // that fragment) and the lanes with them EXPANDED, so an opening tell
        // can never overlap the card beneath it. `is-measuring` forces the
        // expanded box without firing any transition.
        const heights = (expanded: boolean) => {
          if (expanded) slide.classList.add("is-measuring");
          const h = cards.map((c) => c.offsetHeight);
          slide.classList.remove("is-measuring");
          return h;
        };
        const hPile = heights(false);
        const hLane = heights(true);

        // The pile is tighter than the lanes: five cards stacked have to clear
        // the bottom edge at 900, and there is nothing between them to read.
        const gapPile = 9;
        const gapLane = 16;
        let pile = 0;
        const lane = [0, 0];
        cards.forEach((c, i) => {
          c.style.setProperty("--x0", half / 2 + "px");
          c.style.setProperty("--y0", pile + "px");
          pile += hPile[i] + gapPile;
          // Grounded left, hallucinated right, each packed from the top so
          // neither lane carries a hole where the other has a card.
          const l = c.dataset.bad ? 1 : 0;
          c.style.setProperty("--x1", (l ? half : 0) + "px");
          c.style.setProperty("--y1", lane[l] + "px");
          lane[l] += hLane[i] + gapLane;
        });
        // The container is absolutely populated, so it carries its own height
        // — and the block below (the beat line) rises as the lanes pack.
        s.style.setProperty("--h0", pile - gapPile + "px");
        s.style.setProperty("--h1", Math.max(lane[0], lane[1]) - gapLane + "px");
      }

      /** C — the draw. One bar = the whole distribution, keyed underneath. */
      function buildStochDraw(slide: HTMLElement) {
        const bar = slide.querySelector<HTMLElement>("[data-stoch-bar]");
        const total = STOCH.RANK.reduce((s, r) => s + r, 0);
        if (bar) {
          bar.textContent = "";
          STOCH.ANSWERS.forEach((a, i) => {
            const seg = ph("div", "seg" + (isBad(a.kind) ? " bad" : ""));
            seg.style.setProperty("--w", (STOCH.RANK[i] / total) * 100 + "%");
            seg.style.transitionDelay = i * 80 + "ms";
            seg.append(ph("span", "n", String(i + 1)));
            bar.append(seg);
          });
        }
        const cap = slide.querySelector<HTMLElement>("[data-stoch-cap]");
        if (cap) {
          cap.textContent = "";
          cap.append(ph("span", undefined, "most likely"));
          cap.append(ph("span", undefined, "least likely"));
        }
        const key = slide.querySelector<HTMLElement>("[data-stoch-key]");
        if (!key) return;
        key.textContent = "";
        STOCH.ANSWERS.forEach((a, i) => {
          const row = ph("div", "k stoch-fade" + (isBad(a.kind) ? " bad" : ""));
          row.append(ph("span", "n", String(i + 1)));
          const body = ph("div");
          body.append(ph("p", undefined, a.text));
          body.append(ph("span", "tag", STOCH.KINDS[a.kind].tag));
          row.append(body);
          key.append(phDelay(row, i));
        });
      }

      function buildStoch(slide: HTMLElement) {
        if (slide.dataset.built === "1") return;
        const set = (sel: string, txt: string) => {
          const n = slide.querySelector<HTMLElement>(sel);
          if (n) n.textContent = txt;
        };
        set("[data-stoch-eyebrow]", STOCH.COPY.eyebrow);
        set("[data-stoch-headline]", STOCH.COPY.headline);
        set("[data-stoch-beat]", STOCH.COPY.labelBeat);
        set("[data-stoch-honesty]", STOCH.COPY.honesty);
        buildStochAsk(slide);
        buildStochDefs(slide);
        const v = slide.dataset.stochVariant;
        if (v === "A") buildStochLadder(slide);
        if (v === "B") buildStochSort(slide);
        if (v === "C") buildStochDraw(slide);
        slide.dataset.built = "1";
        // B measures itself, so it has to happen after the browser has laid
        // the cards out — one frame later, not in the same tick.
        if (v === "B") requestAnimationFrame(() => layoutStochSort(slide));
      }

      /** Derive the frame from reveal's fragment state — never from a counter. */
      function syncStoch(slide: HTMLElement) {
        const shown = slide.querySelectorAll(".stoch-step.visible").length;
        // The answers are present from the moment the slide opens — `is-fanned`
        // now only arms the entry stagger, it is not a frame. The single
        // fragment carries labels AND tells together.
        slide.classList.add("is-fanned");
        slide.classList.toggle("is-labelled", shown >= 1);
        slide.classList.toggle("is-told", shown >= 1);
      }

      // ── The prototype switcher bar. DEV only: a stray merge can't ship it,
      //    and the ?variant= param is inert without these three sections. ──
      if (import.meta.env.DEV) {
        const NAMES: Record<string, string> = {
          A: "the ladder",
          B: "the sort",
          C: "the draw",
        };
        const keys = ["A", "B", "C"]; // B is the default — Atil picked it
        const go = (patch: Record<string, string | null>) => {
          const p = new URLSearchParams(window.location.search);
          for (const [k, val] of Object.entries(patch)) {
            if (val === null) p.delete(k);
            else p.set(k, val);
          }
          // Keep the hash so the reload lands on the same slide.
          window.location.search = p.toString();
        };
        const cycle = (d: number) =>
          go({ variant: keys[(keys.indexOf(protoVariant) + d + 3) % 3] });

        const bar = ph("div", "proto-bar");
        const prev = ph("button", undefined, "‹");
        const next = ph("button", undefined, "›");
        const name = ph(
          "span",
          "name",
          `#35 · ${protoVariant} — ${NAMES[protoVariant] ?? "?"} · v to cycle`,
        );
        prev.onclick = () => cycle(-1);
        next.onclick = () => cycle(1);
        const toggle = (
          label: string,
          param: string,
          on: boolean,
        ) => {
          const b = ph("button", undefined, label);
          b.setAttribute("aria-pressed", String(on));
          b.onclick = () => go({ [param]: on ? null : "1" });
          return b;
        };
        bar.append(prev, name, next, ph("span", "sep"));
        bar.append(
          toggle(
            "honesty label",
            "honesty",
            document.body.classList.contains("proto-honesty"),
          ),
        );
        document.body.append(bar);

        // "v" cycles variants. ← / → are deliberately NOT bound: they belong
        // to the fragments, which are the thing being judged.
        window.addEventListener("keydown", (e) => {
          if (e.key === "v" || e.key === "V") cycle(1);
        });
      }

      // ── Wire the per-slide lifecycle (deterministic replay on entry) ──
      function onShow(slide: HTMLElement) {
        armHeadline(slide);
        updateChrome();
        if (slide.hasAttribute("data-chapter")) runWash();
        if (slide.hasAttribute("data-viz")) {
          resetBars(slide);
          window.setTimeout(() => growBars(slide), 160);
        }
        if (slide.hasAttribute("data-one-number")) playCount(slide);
        if (slide.hasAttribute("data-terminal")) playTerminal(slide);
        // Chapter 1's stop-point reads its frame off the fragments, so it
        // replays from the cheapest point forwards and lands on the turn-over
        // when you walk back into it from the roadmap.
        if (slide.hasAttribute("data-stop")) {
          buildStop(slide);
          syncStop(slide);
        }
        // PROTOTYPE #35 — chapter 2's stochastic slide.
        if (slide.hasAttribute("data-stoch")) {
          buildStoch(slide);
          syncStoch(slide);
        }
        if (slide.hasAttribute("data-lottery")) {
          buildLottery(slide);
          // Match the visual to reveal's fragment state. Entering forward the
          // collapse fragment isn't shown yet (→ scattered); entering backward
          // from the next slide it's already shown (→ collapsed). Forcing
          // "before" here would desync the arrows (right would find no
          // fragment and skip the slide).
          const frag = slide.querySelector<HTMLElement>("[data-lottery-collapse]");
          setLottery(slide, !!frag?.classList.contains("visible"));
        }
        // Chapter 3. The cloud's rAF loop only runs while its slide is live.
        if (slide.hasAttribute("data-token-live")) startCloud();
        else stopCloud();
        if (slide.hasAttribute("data-cost-dial")) resetDial();
        // Chapter 3's two islands read reveal's fragment state on entry, so
        // they replay from step 0 forwards and from the last step backwards.
        if (slide.hasAttribute("data-primitives")) syncPrimitives(slide);
        if (slide.hasAttribute("data-agentloop")) syncLoop(slide);
        if (slide.hasAttribute("data-scrolly")) {
          const frame = slide.querySelector<HTMLElement>("[data-scroll-frame]");
          if (frame) frame.scrollTop = 0;
        }
        // Keep the inline notes overlay in sync while it's open.
        if (notesEl && !notesEl.hasAttribute("hidden")) syncNotes();
      }

      deck.on("slidechanged", (e: any) => onShow(e.currentSlide as HTMLElement));
      deck.on("ready", (e: any) => onShow(e.currentSlide as HTMLElement));

      // The reliability scatter collapses on a fragment, replays on step-back.
      // Chapter 3's islands re-derive their whole state from the fragments on
      // every change, in both directions.
      function onFragment(e: any, shown: boolean) {
        const f = e.fragment as HTMLElement;
        if (f?.hasAttribute("data-lottery-collapse"))
          setLottery(f.closest("section") as HTMLElement, shown);
        const section = f?.closest("section") as HTMLElement | null;
        if (section?.hasAttribute("data-stop")) syncStop(section);
        if (section?.hasAttribute("data-stoch")) syncStoch(section);
        if (section?.hasAttribute("data-primitives")) syncPrimitives(section);
        if (section?.hasAttribute("data-agentloop")) syncLoop(section);
      }
      deck.on("fragmentshown", (e: any) => onFragment(e, true));
      deck.on("fragmenthidden", (e: any) => onFragment(e, false));
    </script>
  </body>
</html>
