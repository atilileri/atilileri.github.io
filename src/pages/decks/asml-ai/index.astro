                    ))
                  }
                  <span class="se-hairline" data-se-hairline data-se-baseline={baselineBlocks}></span>
                </div>
              </div>

              <div class="se-rows">
                {
                  LINES.map((l) => (
                    <div class={`se-row ${l.role}`} data-se-row={l.turn}>
                      <span class={`se-role ${l.role}`}>{l.role}</span>
                      <span class="txt">
                        <span set:html={l.text} />
                        {l.file && (
                          <span class="se-file">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path
                                d="M20.5 11.5 12 20a5.5 5.5 0 0 1-7.8-7.8l8.5-8.5a3.7 3.7 0 0 1 5.2 5.2l-8.5 8.5a1.8 1.8 0 0 1-2.6-2.6l7.9-7.9"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.6"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <b>{l.file.name}</b>
                          </span>
                        )}
                      </span>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="se-frag-row" data-se-frag-row aria-hidden="true">
              {TURNS.map(() => <span class="fragment" />)}
            </div>
          </section>

          <!-- 2.2.3 — .primitives -->
          <section class="primitives" data-section="02 — Terminology" data-primitives>
            <span class="eyebrow">The anatomy &middot; interactive, click a block</span>
            <h2 class="h-set">
              <span class="h-line"><span>Data blocks in a session</span></span>
            </h2>
            <div class="prim-stage">
              <div class="prim-window">
                {
                  primitiveGroups.map((g) => (
                    <div class="prim-group" style={`flex:${g.blocks.length}`}>
                      <span class="prim-group-label">{g.group}</span>
                      {g.blocks.map((b) => (
                        <button
                          type="button"
                          class="prim-block"
                          data-prim-block={primitives.findIndex(
                            (p) => p.label === b.label,
                          )}
                          aria-controls="prim-panel"
                          aria-pressed="false"
                        >
                          <span class="lbl">{b.label}</span>
                          {b.sub && <span class="sub">{b.sub}</span>}
                        </button>
                      ))}
                    </div>
                  ))
                }
              </div>

              <div class="prim-panel" id="prim-panel" data-prim-panel aria-live="polite">
                <article class="prim-card is-on" data-prim-card="summary">
                  <span class="al-tag">The context window</span>
                  <h3>Every block here is sent again, in full, every turn.</h3>
                  {
                    primitiveGroups.map((g) => (
                      <p class="prim-region">
                        <b>{g.group}</b> {g.note}
                      </p>
                    ))
                  }
                  <p class="prim-hint">
                    Press <kbd>&rarr;</kbd> to walk the blocks, or click one.
                  </p>
                </article>

                {
                  primitives.map((p, i) => (
                    <article class="prim-card" data-prim-card={i}>
                      <span class="al-tag">{p.group}</span>
                      <h3>
                        {p.label}
                        {p.sub && <em> ({p.sub})</em>}
                      </h3>
                      <dl class="prim-facts">
                        <dt>Contains</dt>
                        <dd set:html={p.contains} />
                        <dt>Why it exists</dt>
                        <dd set:html={p.why} />
                        <dt>Token cost</dt>
                        <dd class="cost" set:html={p.cost} />
                      </dl>
                    </article>
                  ))
                }

                <button type="button" class="prim-clear" data-prim-clear>
                  &larr; clear
                </button>
              </div>
            </div>

            <div class="prim-frag-row" data-prim-frag-row aria-hidden="true">
              {primitives.map(() => <span class="fragment" />)}
            </div>
          </section>
        </section>

        <!-- 2.3 — vertical stack, 2 sub-slides -->
