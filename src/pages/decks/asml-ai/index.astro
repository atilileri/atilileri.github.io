 *
 * A duplicate of the capability showcase (/decks/showcase-for-asml), taken as the
 * starting point for the real slides: same approach (thin Astro shell + embedded
 * reveal.js, single-deck structure — wayfinder #11) and the same "ASML Editorial"
 * light theme (#12). The showcase stays put as the reference gallery; this deck
 * is the one that gets presented, so edit slide text here, not there.
 *
 * Standalone, full-viewport, no site chrome — deliberately does NOT use
 * BaseLayout. Decks are first-class routes: src/pages/decks/<slug>. This is /decks/asml-ai.
 * Fully static: reveal.js@5 + plugins bundle into the Astro JS chunk via Vite;
 * fonts self-hosted under /public/fonts. No CDN, no server, no secrets.
 */

// reveal.js base + our fresh light theme (import order = cascade order).
import "reveal.js/dist/reveal.css";
