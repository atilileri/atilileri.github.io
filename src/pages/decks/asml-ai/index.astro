---
/**
 * /decks/asml-ai — the REAL presentation deck ("Getting the Most from AI").
 *
 * Hard copy of the capability showcase (/decks/showcase-for-asml), taken as the
 * starting point for the real slides: same approach (thin Astro shell + embedded
 * reveal.js, single-deck spine — wayfinder #11) and the same "ASML Editorial"
 * light theme (#12). The showcase stays put as the reference gallery; this deck
 * is the one that gets presented, so edit slide copy here, not there.
 *
 * Standalone, full-viewport, no site chrome — deliberately does NOT use
 * BaseLayout. Decks are first-class routes: src/pages/decks/<slug>. This is /decks/asml-ai.
 * Fully static: reveal.js@5 + plugins bundle into the Astro JS chunk via Vite;
 * fonts self-hosted under /public/fonts. No CDN, no server, no secrets.
 */

// reveal.js base + our fresh light theme (import order = cascade order).
import "reveal.js/dist/reveal.css";
import "./theme-asml.css";

const promptCode = `// Token-aware prompt assembly
export function assemblePrompt(sections: Section[], budget: number) {
  const ranked = sections.sort((a, b) => b.priority - a.priority);
  let used = 0;
  const kept: Section[] = [];
  for (const s of ranked) {
    const cost = estimateTokens(s.body);   // ~chars / 4
    if (used + cost > budget) continue;    // drop low-priority overflow
    kept.push(s);
    used += cost;
  }
  return { prompt: kept.map((s) => s.body).join("\\n\\n"), used, budget };
}`;

const helperCode = `// The estimate every budget leans on
export function estimateTokens(text: string): number {
  // Cheap client-side proxy: ~4 chars per token for English prose.
  // A shipping deck would swap in a real BPE tokenizer here.
  return Math.ceil(text.length / 4);
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Getting the Most from AI · Atil Ilerialkan</title>
    <meta
      name="description"
      content="Reference capability deck — every slide kind this web-presentation system can build, exercised once."
    />
  </head>
  <body>
    <!-- Persistent mono "instrument" chrome + keyboard legend + chapter wash.
         Populated / driven by the controller below. -->
    <div class="deck-chrome" aria-hidden="true">
      <div class="chrome-section">
        <b>&#9632;</b> <span data-chrome-section>Getting more from AI</span>
      </div>
      <div class="chrome-progress">
        <span class="now" data-chrome-now>01</span> / <span data-chrome-total>00</span>
      </div>
    </div>
    <div class="deck-legend">
      <kbd>&larr;</kbd><kbd>&rarr;</kbd> move ·
      <kbd>&darr;</kbd> sub-slide ·
      <kbd>ESC</kbd> overview ·
      <kbd>s</kbd> notes ·
      <kbd>p</kbd> presenter ·
      <kbd>f</kbd> full ·
      <kbd>q</kbd> quit
    </div>
    <div class="chapter-wash" data-wash aria-hidden="true"></div>

    <!-- Inline presenter-notes overlay (native-proto style), toggled by "s".
         Shows the current slide's <aside class="notes"> text without leaving
         the deck. reveal's separate presenter window moves to "p". -->
    <aside class="deck-notes" data-notes hidden>
      <div class="deck-notes__head">
        <span>Presenter notes</span>
        <span><kbd>S</kbd> close · <kbd>P</kbd> presenter view</span>
      </div>
      <div class="deck-notes__body" data-notes-body>
        Notes for the current slide appear here.
      </div>
    </aside>

    <div class="reveal">
      <div class="slides">
        <!-- 1 ───────────────────────────── HERO (eyebrow + big headline) -->
        <section class="hero" data-section="Opening">
          <span class="eyebrow">Getting the Most from AI</span>
          <h1 class="h-set">
            <span class="h-line"><span>GETTING MORE</span></span>
            <span class="h-line"><span class="accent">FROM AI.</span></span>
          </h1>
          <p>Token optimization &amp; the skills that compound it.</p>
          <p class="byline">Atil Ilerialkan · live from atilileri.github.io</p>
          <aside class="notes">
            Welcome. This deck is the reference capability gallery — every kind of
            slide we can build, exercised once. Real decks are designed against it.
            Press S any time for these inline notes; P opens the separate presenter
            window.
          </aside>
        </section>

        <!-- 2 ───────────────────── CHAPTER divider (triggers chapter-wash) -->
        <section class="chapter" data-section="01 — The cost" data-chapter>
          <span class="chapter-no">CHAPTER 01</span>
          <h2>The cost of<br />thinking out loud.</h2>
          <aside class="notes">
            A chapter wash (signal-blue panel sweeping the screen) divides sections.
            One of the three cinematic devices; use it 2–3× in the real talk.
          </aside>
        </section>

        <!-- 3 ───────────────────── SCROLL-DRIVEN NARRATIVE (in-slide overflow) -->
        <section class="scrolly" data-section="01 — The cost" data-scrolly>
          <span class="eyebrow">Scroll-driven narrative</span>
          <div class="scroll-hint">&darr; scroll inside this slide</div>
          <div class="scroll-frame" data-scroll-frame>
            <div class="scroll-step" data-scroll-step>
              <h3>Every token has a price.</h3>
              <p>
                At scale, the gap between a lean prompt and a bloated one is a
                budget line — not a rounding error.
              </p>
            </div>
            <div class="scroll-step" data-scroll-step>
              <h3>Context is not free real estate.</h3>
              <p>
                Filling the window degrades attention long before it errors. More
                context is not more signal.
              </p>
            </div>
            <div class="scroll-step" data-scroll-step>
              <h3>Structure beats volume.</h3>
              <p>
                Prioritized, deduplicated, budgeted — the same answer for a
                fraction of the cost.
              </p>
            </div>
            <div class="scroll-step finale" data-scroll-step>
              <h3>So we optimize on purpose.</h3>
            </div>
          </div>
          <aside class="notes">
            A long downward-scrolling section presented as ONE slide. The active
            step brightens as it enters; the rest dim. Scroll is occasional here —
            reveal owns the between-slide nav.
          </aside>
        </section>

        <!-- 4 ───────────────────── CINEMATIC: "the one number" -->
        <section class="one-number" data-section="01 — The cost" data-one-number>
          <span class="eyebrow">The punchline, in one figure</span>
          <div class="fig">
            <span data-count-to="8" data-count-suffix="">0</span><span class="unit"
              >&times;</span
            >
          </div>
          <div class="caption">cheaper — same task, optimized on purpose</div>
          <aside class="notes">
            Cinematic device #2: an oversized figure fills the viewport and counts
            into place, orange unit tick. Save it for the number that matters.
          </aside>
        </section>

        <!-- 5 ───────────────────── ANIMATED DATA-VIZ (hand-rolled CSS, no lib) -->
        <section class="viz" data-section="01 — The cost" data-viz>
          <span class="eyebrow">Animated data-viz</span>
          <h2 class="h-set"><span class="h-line"><span>Cost per 1M tokens</span></span></h2>
          <div class="bars" data-bars>
            <div class="bar-row">
              <span class="bar-label">Naive dump</span>
              <div class="bar-track"><div class="bar-fill" data-w="100">$15.00</div></div>
            </div>
            <div class="bar-row">
              <span class="bar-label">+ dedupe</span>
              <div class="bar-track"><div class="bar-fill" data-w="64">$9.60</div></div>
            </div>
            <div class="bar-row">
              <span class="bar-label">+ budget</span>
              <div class="bar-track"><div class="bar-fill" data-w="38">$5.70</div></div>
            </div>
            <div class="bar-row hot">
              <span class="bar-label">+ caching</span>
              <div class="bar-track"><div class="bar-fill" data-w="12">$1.80</div></div>
            </div>
          </div>
          <p class="viz fragment rise">
            Same task, <em class="hot">8&times; cheaper</em>. Bars grow on slide
            enter — and replay every time you return.
          </p>
          <aside class="notes">
            Bars are hand-rolled CSS/SVG — no charting library, so the deck palette
            reaches inside the chart. Deterministic replay: re-enter and they re-grow.
          </aside>
        </section>

        <!-- 5b ──────────────────── INTERACTIVE BENCHMARK CHART (DeepSWE v1.1) -->
        <section class="bench" data-section="01 — The cost" data-bench>
          <span class="eyebrow">Interactive · hover a model, click a family</span>
          <h2 class="h-set">
            <span class="h-line"><span>DeepSWE v1.1 &mdash; capability vs. cost</span></span>
          </h2>
          <div class="bench-bar">
            <div class="bench-toggle" role="group" aria-label="Chart view">
              <button type="button" data-view="scatter" class="on">Score vs. cost</button>
              <button type="button" data-view="bars">Ranked pass rate</button>
            </div>
            <div class="bench-legend" data-bench-legend></div>
          </div>
          <div class="bench-plot">
            <svg data-bench-svg viewBox="0 0 900 570" role="img"
              aria-label="DeepSWE v1.1 results: pass rate against average cost per task, one curve per model across reasoning-effort levels."
            ></svg>
            <div class="bench-tip" data-bench-tip hidden></div>
          </div>
          <p class="bench-note">
            113 tasks · one line per model across reasoning-effort levels · source:
            <span class="mono">deepswe.datacurve.ai/blog/deepswe-v1-1</span>
          </p>
          <aside class="notes">
            The live leaderboard, rebuilt inside the deck — same data, our palette.
            Hover any point for cost, output tokens and steps; click a family chip to
            isolate it; the toggle swaps the scatter for the ranked bars with error
            bars. Point to the bottom-left quadrant: cheap and good is now a real
            option, and the expensive models are not the top of the board.
          </aside>
        </section>

        <!-- 5c ──────────────────── MENTAL MODEL: the four layers (rings) -->
        <section class="layers" data-section="02 — How" data-layers>
          <span class="eyebrow">The mental model · after Matt Pocock</span>
          <h2 class="h-set">
            <span class="h-line"><span>The model is only the engine</span></span>
          </h2>
          <div class="layers-grid">
            <div class="layers-diagram">
              <svg viewBox="0 0 460 460" role="img"
                aria-label="Three composable layers acting in an environment: the model at the centre, wrapped by the harness, wrapped by the skills you add, all of it running inside the environment. Together, in a loop, they are the agent."
              >
                <circle class="ring env" cx="230" cy="230" r="205" />
                <circle class="ring skills" cx="230" cy="230" r="150" />
                <circle class="ring harness" cx="230" cy="230" r="100" />
                <circle class="ring model" cx="230" cy="230" r="50" />
                <text class="lbl env" x="230" y="43" text-anchor="middle">ENVIRONMENT</text>
                <text class="lbl skills" x="230" y="97" text-anchor="middle">SKILLS</text>
                <text class="lbl harness" x="230" y="147" text-anchor="middle">HARNESS</text>
                <text class="lbl model" x="230" y="236" text-anchor="middle">MODEL</text>
              </svg>
            </div>
            <ol class="layers-defs">
              <li class="model">
                <span class="k">Model</span>
                <p>The core intelligence engine — Opus, GPT. Given; you swap it, you don't build it.</p>
              </li>
              <li class="harness">
                <span class="k">Harness</span>
                <p>The wrapper that drives it — Claude Code, ChatGPT, Copilot.</p>
              </li>
              <li class="skills">
                <span class="k">Skills</span>
                <p><em>Yours</em> — the reusable playbooks you write and install on top of the harness. Capture a procedure once, reuse it for free.</p>
              </li>
              <li class="env">
                <span class="k">Environment</span>
                <p>Your codebase — the source of truth. Skills are only as good as it is: accurate, well-structured, well-documented.</p>
              </li>
            </ol>
            <p class="layers-agent">
              <span class="k">Agent</span> — not a layer. It's what these
              <em>become</em> when you run them in a loop, acting in the
              environment.
            </p>
            <p class="layers-take">
              The model and the harness are <em>given</em>. What you actually
              own is the <strong>skills</strong> you write and the
              <strong>environment</strong> they act in.
            </p>
          </div>
          <aside class="notes">
            After Matt Pocock's model / harness / agent / environment framing —
            but adjusted for a coding room, and the adjustment is the point.
            Work outward from the centre: the model is the engine (given — you
            pick one, you don't build it); the harness is the wrapper that
            drives it, and here it's also given — we're on a Copilot
            subscription, so don't dwell on it; skills are the reusable
            instruction packages you install on top, and they're already
            working well — no change needed, just keep building them; the
            environment is the codebase itself, and it's the one lever with
            the most headroom: the more accurate and well-structured it is,
            the better every skill performs on top of it. Note the swap out
            loud: in every primary definition — Anthropic, OpenAI, Pocock's own
            words — "agent" isn't a component, it's the NAME for these running
            together in a loop. Pocock even defines the harness as "everything
            that turns the model into an agent" — so agent is the output, not
            an ingredient. The landing line: model and harness are given; what
            you control — and what's worth the room's attention — are skills
            and the environment they read from. And phrase the compounding as
            "you build a reusable skill library on a codebase that's actually
            true," not "the agent teaches itself" — self-authoring skills is
            still aspirational (Anthropic). See docs/research for sourcing.
          </aside>
        </section>

        <!-- 6 ───────────────────── CODE DEMO + VERTICAL SUB-SLIDE stack -->
        <section data-section="02 — How">
          <section class="code" data-section="02 — How">
            <span class="eyebrow">Code demo · stepped focus</span>
            <h2 class="h-set"><span class="h-line"><span>Budgeted assembly</span></span></h2>
            <pre><code class="language-typescript" data-trim data-line-numbers="2|3-4|6-11|13">{promptCode}</code></pre>
            <aside class="notes">
              Press &rarr; to step the focus: signature → the ranking → the budget
              loop → the return. Then press &darr; to drop into the helper it leans on.
            </aside>
          </section>
          <section class="code" data-section="02 — How">
            <span class="eyebrow">Sub-slide · vertical stack</span>
            <h2 class="h-set"><span class="h-line"><span>The estimate underneath</span></span></h2>
            <pre><code class="language-typescript" data-trim data-line-numbers="4|5">{helperCode}</code></pre>
            <aside class="notes">
              Vertical sub-slides let one topic go deep without cluttering the main
              line — the bottom-right arrows go 4-directional when a stack exists.
            </aside>
          </section>
        </section>

        <!-- 7 ───────────────────── LIVE TOKENIZER WIDGET (vanilla TS island) -->
        <section data-section="02 — How" data-tokenizer>
          <span class="eyebrow">Live · type &amp; watch the token bill</span>
          <h2 class="h-set"><span class="h-line"><span>The token counter</span></span></h2>
          <div class="tokenizer">
            <textarea class="tok-input" spellcheck="false" data-tok-input
              >Rewrite this paragraph to be shorter while keeping every fact intact.</textarea
            >
            <div class="tok-stats">
              <div class="tok-stat">
                <span class="n" data-tok-chars>0</span><span class="l">chars</span>
              </div>
              <div class="tok-stat">
                <span class="n" data-tok-words>0</span><span class="l">words</span>
              </div>
              <div class="tok-stat hot">
                <span class="n" data-tok-tokens>0</span><span class="l">&asymp; tokens</span>
              </div>
              <div class="tok-stat">
                <span class="n" data-tok-cost>$0</span><span class="l">est. in-cost</span>
              </div>
            </div>
            <p class="tok-note">
              Client-side estimate (&asymp; chars &divide; 4). A shipping deck swaps
              in a real BPE tokenizer.
            </p>
          </div>
          <aside class="notes">
            Genuinely live and client-side — as live as a static host allows.
            Typing here never leaves the browser.
          </aside>
        </section>

        <!-- 8 ───────────────────── TERMINAL / CLI REPLAY (deterministic) -->
        <section data-section="02 — How" data-terminal>
          <span class="eyebrow">Pre-recorded · replays on demand</span>
          <h2 class="h-set"><span class="h-line"><span>A skills session, captured</span></span></h2>
          <div class="terminal">
            <div class="term-bar">
              <i></i><i></i><i></i><span class="term-title">claude-code — zsh</span>
            </div>
            <pre class="term-body" data-term-body></pre>
          </div>
          <p class="term-note">
            Deterministic replay — no server, plays every time the slide opens.
          </p>
          <aside class="notes">
            A captured skills session, replayed. Nothing runs live; the transcript
            is baked in, so it is reliable in any venue.
          </aside>
        </section>

        <!-- 8b ─────────────────── RELIABILITY SCATTER (result quality × spend) -->
        <section class="lottery" data-section="03 — The compound" data-lottery>
          <span class="eyebrow">Animated · press &rarr; to level up</span>
          <h2 class="h-set">
            <span class="h-line"><span>Your results don&rsquo;t have to be a lottery</span></span>
          </h2>
          <div class="lottery-plot">
            <svg data-lottery-svg viewBox="0 0 980 600" role="img"
              aria-label="Result quality against tokens spent. A regular user's outputs are scattered across the whole field — some ship, most miss, several overshoot the budget. After the training, the same attempts converge into a tight cluster in the ship-ready, on-budget corner: consistent quality at a consistent, minimal spend."
            ></svg>
          </div>
          <p class="lottery-cap">
            <span data-lottery-stat class="stat">On&nbsp;target &mdash; ship-ready &amp; on&nbsp;budget:
              <b class="stat-n">3</b> of 18</span>
            <span class="lottery-sub" data-lottery-sub>Random prompts in, random results out. More tokens roughly buys more quality &mdash; but the spread is huge and much of the spend is wasted.</span>
          </p>
          <span class="fragment lottery-trigger" data-lottery-collapse aria-hidden="true"></span>
          <aside class="notes">
            The pay-off of the whole talk, in one motion. On entry the field is a
            wide scatter with a real trend: more tokens roughly buys more quality
            (bottom-left up to top-right), but the spread is enormous and it touches
            all four quadrants — cheap misses, dear misses, lucky wins, expensive
            wins. Narrate the lottery here before advancing: the correlation is real,
            yet the outcome is a gamble and much of the spend is wasted. Press &rarr;
            and the SAME attempts shift — this is a distribution moving, not a
            collapse, and not two archetypes: it's you, after the best practices. The
            whole cloud slides up and to the left — top quality now reached at a
            fraction of the tokens, spend pulled left, spread tightened. A couple
            still miss; that's honest. Land it: you stop paying for quality you can
            now get cheaply, and you hit the mark far more often. On-target goes
            3-of-18 to 16-of-18. Press &larr; to replay the scatter.
          </aside>
        </section>

        <!-- 9 ───────────────────── TWO-COLUMN SPLIT (nice-to-have) -->
        <section data-section="03 — The compound">
          <span class="eyebrow">Two-column layout</span>
          <h2 class="h-set"><span class="h-line"><span>Two levers, one system</span></span></h2>
          <div class="split">
            <div class="card">
              <h3>Token optimization</h3>
              <p>
                Rank, dedupe, budget, cache. Every prompt earns its place in the
                window. The floor of good AI economics.
              </p>
            </div>
            <div class="card">
              <h3>Compounding skills</h3>
              <p>
                Matt Pocock's skills repository, installed here. Each captured
                skill makes the next task cheaper — optimization that persists.
              </p>
            </div>
          </div>
          <aside class="notes">
            The two ideas the talk braids together — set side by side.
          </aside>
        </section>

        <!-- 9b ──────────────────── VERTICAL SUB-SLIDE STACK (3 deep) -->
        <!-- A dedicated stack: press ↓ to drill from the overview down through
             three levels. Bottom-right arrows go 4-directional inside a stack. -->
        <section data-section="03 — The compound">
          <section class="stack" data-stack data-section="03 — The compound">
            <span class="eyebrow">Vertical sub-slides · press &darr;</span>
            <h2 class="h-set"><span class="h-line"><span>Compounding, three levels deep</span></span></h2>
            <p>
              One topic, drilled without cluttering the main line. Each
              <kbd>&darr;</kbd> goes a level deeper; <kbd>&uarr;</kbd> climbs back.
            </p>
            <div class="stack-depth"><span class="on"></span><span></span><span></span></div>
            <aside class="notes">
              This is the sub-slide capability on its own. The horizontal line
              stays clean; the depth lives underneath. Press ↓ to demo it live.
            </aside>
          </section>
          <section class="stack" data-stack data-section="03 — The compound">
            <span class="eyebrow">Level 1 · prompt</span>
            <h2 class="h-set"><span class="h-line"><span>Optimize the prompt</span></span></h2>
            <p>
              Rank, dedupe, budget every request. The immediate win — cheaper
              tokens on the very next call.
            </p>
            <div class="stack-depth"><span></span><span class="on"></span><span></span></div>
            <aside class="notes">Level one: the single-prompt economics.</aside>
          </section>
          <section class="stack" data-stack data-section="03 — The compound">
            <span class="eyebrow">Level 2 · session</span>
            <h2 class="h-set"><span class="h-line"><span>Optimize the session</span></span></h2>
            <p>
              Cache, reuse, prune context across a run. The savings start
              compounding turn over turn.
            </p>
            <div class="stack-depth"><span></span><span></span><span class="on"></span></div>
            <aside class="notes">Level two: the whole session, not one call.</aside>
          </section>
        </section>

        <!-- 10 ──────────────────── FRAGMENT / PROGRESSIVE REVEAL -->
        <section data-section="03 — The compound" data-frags>
          <span class="eyebrow">Fragment reveal</span>
          <h2 class="h-set"><span class="h-line"><span>What a reference deck needs</span></span></h2>
          <ul class="build">
            <li class="fragment rise">Static, high-impact hero slides</li>
            <li class="fragment rise">Scrollable narrative pages</li>
            <li class="fragment rise">Live, interactive demos</li>
            <li class="fragment rise">Animated data &amp; code walk-throughs</li>
            <li class="fragment rise">Terminal &amp; CLI replays</li>
            <li class="fragment rise signal">&hellip; all in one deck.</li>
          </ul>
          <aside class="notes">
            Generic click-to-build: press &rarr; to reveal each item; the last turns
            signal-blue as the current fragment.
          </aside>
        </section>

        <!-- 10a ─────────────── ALT A: numbered editorial rows (hairline grid) -->
        <section class="alt-rows" data-section="03 — The compound" data-frags>
          <span class="eyebrow">Alt A · Numbered rows</span>
          <h2 class="h-set"><span class="h-line"><span>What a reference deck needs</span></span></h2>
          <ol class="rows">
            <li class="fragment rise"><span class="n">01</span><span class="t">Static, high-impact hero slides</span></li>
            <li class="fragment rise"><span class="n">02</span><span class="t">Scrollable narrative pages</span></li>
            <li class="fragment rise"><span class="n">03</span><span class="t">Live, interactive demos</span></li>
            <li class="fragment rise"><span class="n">04</span><span class="t">Animated data &amp; code walk-throughs</span></li>
            <li class="fragment rise"><span class="n">05</span><span class="t">Terminal &amp; CLI replays</span></li>
            <li class="fragment rise sum"><span class="n">&#8721;</span><span class="t">&hellip; all in one deck.</span></li>
          </ol>
          <aside class="notes">
            Alternative A. Full-width hairline rows, oversized mono index, one line
            of text each — the list reads as an editorial index, not bullets.
          </aside>
        </section>

        <!-- 10b ─────────────── ALT B: card grid (floating cards, 3 × 2) -->
        <section class="alt-cards" data-section="03 — The compound" data-frags>
          <span class="eyebrow">Alt B · Card grid</span>
          <h2 class="h-set"><span class="h-line"><span>What a reference deck needs</span></span></h2>
          <div class="cardgrid">
            <div class="fragment rise card"><span class="k">Hero</span><p>Static, high-impact hero slides</p></div>
            <div class="fragment rise card"><span class="k">Narrative</span><p>Scrollable narrative pages</p></div>
            <div class="fragment rise card"><span class="k">Demo</span><p>Live, interactive demos</p></div>
            <div class="fragment rise card"><span class="k">Motion</span><p>Animated data &amp; code walk-throughs</p></div>
            <div class="fragment rise card"><span class="k">Terminal</span><p>Terminal &amp; CLI replays</p></div>
            <div class="fragment rise card hot"><span class="k">Together</span><p>&hellip; all in one deck.</p></div>
          </div>
          <aside class="notes">
            Alternative B. Each capability becomes a card with a mono kicker; the
            sixth flips to signal-blue as the payoff. Scans as a gallery.
          </aside>
        </section>

        <!-- 10c ─────────────── ALT C: big-type spotlight stack -->
        <section class="alt-stack" data-section="03 — The compound" data-frags>
          <span class="eyebrow">Alt C · Big-type stack</span>
          <ul class="stack">
            <li class="fragment rise">Hero slides</li>
            <li class="fragment rise">Scroll narrative</li>
            <li class="fragment rise">Live demos</li>
            <li class="fragment rise">Animated data</li>
            <li class="fragment rise">Terminal replays</li>
            <li class="fragment rise last">All in one deck.</li>
          </ul>
          <aside class="notes">
            Alternative C. No headline — the list IS the headline. Display type at
            hero scale, revealed items dim back so the current one holds the room.
          </aside>
        </section>

        <!-- 10d ─────────────── ALT D: split — anchored headline / right column -->
        <section class="alt-split" data-section="03 — The compound" data-frags>
          <div class="split-left">
            <span class="eyebrow">Alt D · Split</span>
            <h2 class="h-set">
              <span class="h-line"><span>What a</span></span>
              <span class="h-line"><span>reference</span></span>
              <span class="h-line"><span>deck needs</span></span>
            </h2>
            <p class="lede">Five slide kinds, one spine.</p>
          </div>
          <ul class="split-right">
            <li class="fragment rise">Static, high-impact hero slides</li>
            <li class="fragment rise">Scrollable narrative pages</li>
            <li class="fragment rise">Live, interactive demos</li>
            <li class="fragment rise">Animated data &amp; code walk-throughs</li>
            <li class="fragment rise">Terminal &amp; CLI replays</li>
            <li class="fragment rise total">&hellip; all in one deck.</li>
          </ul>
          <aside class="notes">
            Alternative D. Headline anchored left, items building down the right —
            the classic keynote split. Most forgiving of long item text.
          </aside>
        </section>

        <!-- 10e ─────────────── ALT E: colour bands (full-bleed, fills on reveal) -->
        <section class="alt-bands" data-section="03 — The compound" data-frags>
          <span class="eyebrow">Alt E · Colour bands</span>
          <div class="bands">
            <div class="fragment rise band"><span class="n">01</span><span class="t">Static, high-impact hero slides</span></div>
            <div class="fragment rise band"><span class="n">02</span><span class="t">Scrollable narrative pages</span></div>
            <div class="fragment rise band"><span class="n">03</span><span class="t">Live, interactive demos</span></div>
            <div class="fragment rise band"><span class="n">04</span><span class="t">Animated data &amp; code walk-throughs</span></div>
            <div class="fragment rise band"><span class="n">05</span><span class="t">Terminal &amp; CLI replays</span></div>
            <div class="fragment rise band all"><span class="n">&#9632;</span><span class="t">&hellip; all in one deck.</span></div>
          </div>
          <aside class="notes">
            Alternative E. Full-bleed bands whose blue fill wipes in left-to-right
            as each is revealed — the most kinetic of the five.
          </aside>
        </section>

        <!-- 11 ──────────────────── CINEMATIC: COLOUR FLOOD (full-bleed) -->
        <section class="flood" data-section="Closing">
          <span class="eyebrow">The statement</span>
          <h2 class="h-set">
            <span class="h-line"><span>Optimize</span></span>
            <span class="h-line"><span>on <em class="hot">purpose.</em></span></span>
          </h2>
          <aside class="notes">
            Cinematic device #1: the slide floods to solid signal-blue with one
            huge white sentence. The palette-break moment.
          </aside>
        </section>

        <!-- 12 ──────────────────── OUTRO -->
        <section class="hero" data-section="Closing">
          <span class="eyebrow">Thank you</span>
          <h1 class="h-set"><span class="h-line"><span class="accent">LET'S BUILD.</span></span></h1>
          <p class="byline">
            <kbd>S</kbd> presenter view · <kbd>ESC</kbd> overview · <kbd>F</kbd> fullscreen
          </p>
          <aside class="notes">
            Close. Everything shown is one static bundle on GitHub Pages — no
            backend, presentable from any machine.
          </aside>
        </section>
      </div>
    </div>

    <script>
      import Reveal from "reveal.js";
      import RevealHighlight from "reveal.js/plugin/highlight/highlight.esm.js";
      import RevealNotes from "reveal.js/plugin/notes/notes.esm.js";
      import RevealZoom from "reveal.js/plugin/zoom/zoom.esm.js";

      const deck = new Reveal({
        hash: true,
        // Standard reveal layout: a wide 16:9 canvas that reveal scales to fit
        // the viewport. (An earlier disableLayout:true left slides unpositioned
        // and registered zero slides — the blank-page bug.) The theme's fluid
        // clamp() type keys off the real viewport, so it still reads as a
        // responsive "web presentation" rather than a rigid fixed deck.
        width: 1600,
        height: 900,
        margin: 0.04,
        minScale: 0.2,
        maxScale: 2.0,
        transition: "slide", // advance right → left; verticals slide down
        transitionSpeed: "default",
        controls: true,
        controlsLayout: "bottom-right",
        progress: true,
        center: false, // hard-left editorial grid
        hideInactiveCursor: true,
        plugins: [RevealHighlight, RevealNotes, RevealZoom],
      });
      deck.initialize();
      // Expose the instance (debugging / headless verification navigation).
      (window as any).__deck = deck;

      // ── Presenter notes: "s" toggles an inline overlay (native-proto style),
      //    "p" opens reveal's separate presenter window. We override reveal's
      //    default "s" binding (keyCode 83, normally the speaker view). ──────
      const notesEl = document.querySelector<HTMLElement>("[data-notes]");
      const notesBody = document.querySelector<HTMLElement>("[data-notes-body]");
      function syncNotes() {
        if (!notesBody) return;
        const cur = deck.getCurrentSlide() as HTMLElement | undefined;
        const note = cur?.querySelector("aside.notes")?.textContent?.trim();
        notesBody.textContent = note && note.length ? note : "— no notes for this slide —";
      }
      deck.addKeyBinding(
        { keyCode: 83, key: "S", description: "Toggle presenter notes (inline)" },
        () => {
          if (!notesEl) return;
          notesEl.toggleAttribute("hidden");
          if (!notesEl.hasAttribute("hidden")) syncNotes();
        },
      );
      deck.addKeyBinding(
        { keyCode: 80, key: "P", description: "Open presenter view (window)" },
        () => (deck.getPlugin("notes") as any)?.open?.(),
      );
      // "q" quits the deck and returns to the website's main page.
      deck.addKeyBinding(
        { keyCode: 81, key: "Q", description: "Quit deck → site home" },
        () => {
          window.location.href = "/";
        },
      );

      // ── Instrument chrome: section label + slide counter ──────────
      const chromeSection = document.querySelector("[data-chrome-section]");
      const chromeNow = document.querySelector("[data-chrome-now]");
      const chromeTotal = document.querySelector("[data-chrome-total]");
      const wash = document.querySelector<HTMLElement>("[data-wash]");
      const pad = (n: number) => String(n).padStart(2, "0");

      function updateChrome() {
        const cur = deck.getCurrentSlide() as HTMLElement | undefined;
        const label =
          cur?.getAttribute("data-section") ??
          cur?.parentElement?.getAttribute("data-section");
        if (label && chromeSection) chromeSection.textContent = label;
        const idx = deck.getIndices();
        if (chromeNow) chromeNow.textContent = pad(idx.h + 1);
        if (chromeTotal)
          chromeTotal.textContent = pad(deck.getHorizontalSlides().length);
      }

      // ── Signature headline replay: re-arm .is-live on the live slide ──
      function armHeadline(slide: HTMLElement) {
        document
          .querySelectorAll(".reveal section.is-live")
          .forEach((s) => s.classList.remove("is-live"));
        // force reflow so the wipe restarts from baseline every entry
        void slide.offsetWidth;
        slide.classList.add("is-live");
      }

      // ── Animated data-viz (deterministic — resets & regrows on entry) ──
      function resetBars(slide: HTMLElement) {
        slide
          .querySelectorAll<HTMLElement>("[data-bars] .bar-fill")
          .forEach((el) => (el.style.width = "0%"));
      }
      function growBars(slide: HTMLElement) {
        slide
          .querySelectorAll<HTMLElement>("[data-bars] .bar-fill")
          .forEach((el) => {
            const w = el.getAttribute("data-w") ?? "0";
            el.style.width = w + "%";
          });
      }

      // ── Reliability scatter (result quality × spend) ──────────────
      //    Deterministic, presenter-driven: on entry the same dots sit
      //    scattered; a reveal fragment collapses them into the target box.
      const LOT = {
        VB: { w: 980, h: 600 },
        // plot frame (x grows right = more tokens; y grows down = worse).
        // Y0 sits high enough to leave room for the x-axis label beneath it.
        X0: 130, XN: 930, Y0: 470, YN: 60,
        xBudget: 530, yShip: 265, // thresholds at the MIDDLE of each axis
        // 18 attempts. Both populations share the same truth — more tokens
        // roughly buys more quality (a positive trend). before = a wide,
        // noisy spray touching all four quadrants. after = the SAME truth
        // shifted: high quality reached at far fewer tokens, spend narrowed
        // toward the left, spread tightened. It's a distribution shift, not
        // a collapse — a couple of attempts still miss.
        before: [
          [230, 400], [300, 340], [190, 300],
          [380, 300], [450, 250], [500, 240], [430, 360], [560, 200], [610, 300],
          [700, 180], [780, 140], [850, 120], [720, 240], [900, 160], [820, 220],
          [300, 150], [840, 380], [560, 430],
        ],
        // still a positive trend — quality rises with tokens — but a flatter
        // slope, pulled left and tightened. Best quality still costs a little
        // more (right edge of the band); two attempts still miss.
        after: [
          [205, 250], [220, 200], [240, 255],
          [255, 190], [270, 235], [290, 168], [300, 225], [315, 150], [330, 205],
          [350, 140], [365, 215], [465, 120], [380, 150], [400, 195], [420, 120],
          [445, 180], [560, 175], [455, 300],
        ],
        // strategically chosen attempts leave a dotted trail along their
        // path, each teaching a distinct vector: up (quality at same spend),
        // left (quality kept, tokens slashed), up-left (a dear miss rescued).
        TRACE: [0, 11, 16],
      };
      function buildLottery(slide: HTMLElement) {
        const svg = slide.querySelector<SVGSVGElement>("[data-lottery-svg]");
        if (!svg || svg.dataset.built) return;
        const NS = "http://www.w3.org/2000/svg";
        const mk = (t: string, a: Record<string, string | number>) => {
          const n = document.createElementNS(NS, t);
          for (const k in a) n.setAttribute(k, String(a[k]));
          return n;
        };
        const { X0, XN, Y0, YN, xBudget, yShip } = LOT;
        // target zone
        svg.append(mk("rect", {
          x: X0, y: YN, width: xBudget - X0, height: yShip - YN,
          rx: 10, class: "lot-zone",
        }));
        const zl = mk("text", { x: X0 + 14, y: YN + 30, class: "lot-zone-lbl" });
        zl.textContent = "SHIP-READY · ON BUDGET";
        svg.append(zl);
        // axes
        svg.append(mk("line", { x1: X0, y1: Y0, x2: XN, y2: Y0, class: "lot-axis" }));
        svg.append(mk("line", { x1: X0, y1: Y0, x2: X0, y2: YN, class: "lot-axis" }));
        // threshold guides
        svg.append(mk("line", { x1: X0, y1: yShip, x2: XN, y2: yShip, class: "lot-guide" }));
        svg.append(mk("line", { x1: xBudget, y1: Y0, x2: xBudget, y2: YN, class: "lot-guide" }));
        // axis titles
        const yt = mk("text", { x: X0 - 40, y: (Y0 + YN) / 2, class: "lot-axtitle",
          transform: `rotate(-90 ${X0 - 40} ${(Y0 + YN) / 2})` });
        yt.textContent = "Result quality →";
        svg.append(yt);
        const xt = mk("text", { x: (X0 + XN) / 2, y: Y0 + 42, class: "lot-axtitle" });
        xt.textContent = "Tokens spent →";
        svg.append(xt);
        // threshold indicators, sat where each guide line meets its axis
        const qb = mk("text", { x: X0 + 12, y: yShip - 12, class: "lot-thresh" });
        qb.textContent = "acceptable quality";
        svg.append(qb);
        const bb = mk("text", {
          x: xBudget - 12, y: Y0 - 14, class: "lot-thresh", "text-anchor": "end",
        });
        bb.textContent = "monthly budget";
        svg.append(bb);
        // dotted traces for the chosen few — drawn first so they sit BEHIND
        // the dots; they fade in as the attempts travel (.go).
        LOT.TRACE.forEach((i) => {
          const [bx, by] = LOT.before[i];
          const [ax, ay] = LOT.after[i];
          svg.append(mk("line", {
            x1: bx, y1: by, x2: ax, y2: ay, class: "lot-trace",
          }));
        });
        // dots — base position is the AFTER coord; a per-dot translate offsets
        // them out to the scattered BEFORE coord until the box collapses (.go).
        LOT.before.forEach(([bx, by], i) => {
          const [ax, ay] = LOT.after[i];
          const c = mk("circle", { cx: ax, cy: ay, r: 12, class: "lot-dot" });
          (c as SVGElement).setAttribute(
            "style",
            `--tf:translate(${bx - ax}px,${by - ay}px);--d:${(i % 6) * 40}ms`,
          );
          svg.append(c);
        });
        svg.dataset.built = "1";
      }
      function setLottery(slide: HTMLElement, collapsed: boolean) {
        const svg = slide.querySelector<SVGSVGElement>("[data-lottery-svg]");
        const stat = slide.querySelector<HTMLElement>("[data-lottery-stat] .stat-n");
        const sub = slide.querySelector<HTMLElement>("[data-lottery-sub]");
        if (!svg) return;
        svg.classList.toggle("go", collapsed);
        if (stat) stat.textContent = collapsed ? "16" : "3";
        if (sub)
          sub.textContent = collapsed
            ? "Better practice in → top quality at a fraction of the tokens, spend pulled to the left, spread tightened. You aim, not gamble."
            : "Random prompts in, random results out. More tokens roughly buys more quality — but the spread is huge and much of the spend is wasted.";
      }

      // ── "The one number" count-up ─────────────────────────────────
      let countTimer: number | undefined;
      function playCount(slide: HTMLElement) {
        const el = slide.querySelector<HTMLElement>("[data-count-to]");
        if (!el) return;
        const to = Number(el.getAttribute("data-count-to") ?? "0");
        const suffix = el.getAttribute("data-count-suffix") ?? "";
        const start = performance.now();
        const dur = 900;
        if (countTimer) cancelAnimationFrame(countTimer);
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = String(Math.round(eased * to)) + suffix;
          if (t < 1) countTimer = requestAnimationFrame(tick);
        };
        countTimer = requestAnimationFrame(tick);
      }

      // ── Live tokenizer ────────────────────────────────────────────
      const tokInput = document.querySelector<HTMLTextAreaElement>("[data-tok-input]");
      function updateTokens() {
        if (!tokInput) return;
        const text = tokInput.value;
        const chars = text.length;
        const words = text.trim() ? text.trim().split(/\s+/).length : 0;
        const tokens = Math.max(0, Math.ceil(chars / 4));
        const cost = ((tokens / 1_000_000) * 15).toFixed(6);
        const set = (sel: string, v: string) => {
          const el = document.querySelector(sel);
          if (el) el.textContent = v;
        };
        set("[data-tok-chars]", String(chars));
        set("[data-tok-words]", String(words));
        set("[data-tok-tokens]", String(tokens));
        set("[data-tok-cost]", "$" + cost);
      }
      tokInput?.addEventListener("input", updateTokens);
      updateTokens();

      // ── Terminal / CLI replay (deterministic) ─────────────────────
      const replay: { t: string; d: number; cls?: string; type?: boolean }[] = [
        { t: "$ ", d: 250 },
        { t: "claude /wayfinder issue-13\n", d: 40, type: true },
        { t: "→ claiming ticket · assigning @atilileri\n", d: 420, cls: "sig" },
        { t: "→ building the exemplary showcase\n", d: 360, cls: "sig" },
        { t: "  ✓ hero   ✓ scrollytelling   ✓ tokenizer\n", d: 300, cls: "ok" },
        { t: "  ✓ data-viz   ✓ code demo   ✓ terminal\n", d: 300, cls: "ok" },
        { t: "  ✓ sub-slides ✓ chapter wash  ✓ one-number\n", d: 300, cls: "ok" },
        { t: "→ astro build … static, no server\n", d: 460, cls: "sig" },
        { t: "  ✓ dist/ ready for GitHub Pages\n", d: 360, cls: "ok" },
        { t: "$ ", d: 250 },
      ];
      let termTimer: number | undefined;
      function playTerminal(slide: HTMLElement) {
        const body = slide.querySelector<HTMLElement>("[data-term-body]");
        if (!body) return;
        if (termTimer) clearTimeout(termTimer);
        body.innerHTML = "";
        let i = 0;
        const step = () => {
          if (i >= replay.length) {
            body.insertAdjacentHTML("beforeend", '<span class="term-cursor">&nbsp;</span>');
            return;
          }
          const { t, d, cls, type } = replay[i++];
          if (type) {
            let c = 0;
            const typeChar = () => {
              if (c < t.length) {
                body.append(t[c++]);
                termTimer = window.setTimeout(typeChar, 42);
              } else {
                termTimer = window.setTimeout(step, d);
              }
            };
            typeChar();
          } else {
            const span = document.createElement("span");
            if (cls) span.className = cls;
            span.textContent = t;
            body.appendChild(span);
            termTimer = window.setTimeout(step, d);
          }
        };
        step();
      }

      // ── Interactive benchmark chart (DeepSWE v1.1) ────────────────
      // Hand-rolled SVG — no charting library, so the deck palette reaches
      // inside the chart. Two views over one dataset: a cost/pass-rate scatter
      // and ranked bars with 95% CI whiskers. Data transcribed from the public
      // leaderboard at deepswe.datacurve.ai/blog/deepswe-v1-1 (113 tasks).
      type Model = {
        name: string;
        fam: string;
        rate: number; // pass@1 %
        ci: number; // ± percentage points
        cost: number; // avg $ / task
        tok: string; // output tokens
        steps: number;
        effort?: string; // reasoning effort — set only for scatter points
      };
      const MODELS: Model[] = [
        { name: "gpt-5.6-sol", fam: "OpenAI", rate: 73, ci: 3, cost: 8.39, tok: "60k", steps: 61 },
        { name: "claude-fable-5", fam: "Anthropic", rate: 70, ci: 4, cost: 21.63, tok: "119k", steps: 88 },
        { name: "gpt-5.6-terra", fam: "OpenAI", rate: 70, ci: 3, cost: 4.95, tok: "72k", steps: 76 },
        { name: "kimi-k3", fam: "Moonshot", rate: 69, ci: 5, cost: 4.65, tok: "81k", steps: 98 },
        { name: "gpt-5.6-luna", fam: "OpenAI", rate: 67, ci: 4, cost: 3.03, tok: "73k", steps: 102 },
        { name: "gpt-5.5", fam: "OpenAI", rate: 67, ci: 6, cost: 7.23, tok: "46k", steps: 82 },
        { name: "claude-opus-4.8", fam: "Anthropic", rate: 59, ci: 2, cost: 13.22, tok: "135k", steps: 120 },
        { name: "claude-sonnet-5", fam: "Anthropic", rate: 54, ci: 4, cost: 26.4, tok: "214k", steps: 268 },
        { name: "grok-4.5", fam: "Other", rate: 54, ci: 2, cost: 2.42, tok: "36k", steps: 61 },
        { name: "muse-spark-1.1", fam: "Other", rate: 53, ci: 3, cost: 2.36, tok: "74k", steps: 96 },
        { name: "gpt-5.4", fam: "OpenAI", rate: 52, ci: 2, cost: 5.65, tok: "71k", steps: 70 },
        { name: "gemini-3.6-flash", fam: "Google", rate: 49, ci: 5, cost: 3.53, tok: "97k", steps: 108 },
        { name: "glm-5.2", fam: "Other", rate: 44, ci: 2, cost: 3.92, tok: "78k", steps: 129 },
        { name: "gemini-3.5-flash", fam: "Google", rate: 37, ci: 2, cost: 7.34, tok: "276k", steps: 86 },
        { name: "kimi-k2.7-code", fam: "Moonshot", rate: 31, ci: 1, cost: 2.82, tok: "59k", steps: 149 },
        { name: "claude-sonnet-4.6", fam: "Anthropic", rate: 30, ci: 4, cost: 5.52, tok: "76k", steps: 134 },
        { name: "gemini-3.1-pro", fam: "Google", rate: 12, ci: 2, cost: 9.48, tok: "196k", steps: 81 },
      ];
      // Fixed hue order, never cycled — validated for CVD separation on this
      // light surface (scripts/validate_palette.js, all six checks pass).
      const FAMS: { key: string; color: string }[] = [
        { key: "OpenAI", color: "#1a6fd4" },
        { key: "Anthropic", color: "#e0620d" },
        { key: "Google", color: "#0f8f6f" },
        { key: "Moonshot", color: "#8a4fd0" },
        { key: "Other", color: "#c2185b" },
      ];
      const famColor = (f: string) =>
        FAMS.find((x) => x.key === f)?.color ?? "#c2185b";

      // The scatter is per reasoning-effort, not per leaderboard row: one model
      // traces a curve as you spend more on it. Points and label placements are
      // transcribed from the published chart; label dx/dy are its own collision
      // solve, kept so 15 callouts sit clean at any size.
      type Curve = {
        name: string;
        fam: string;
        eff: string; // effort level of the labelled point
        anchor: string;
        dx: number;
        dy: number;
        lx: number;
        ly: number;
        at: number; // index of the labelled point
        pts: [number, number][]; // [avg $ / task, pass@1 %], cheapest first
      };
      const CURVES: Curve[] = [
        { name: "gpt-5.6-sol", fam: "OpenAI", eff: "MEDIUM", anchor: "start", dx: 11, dy: 4, lx: 10, ly: 0, at: 1,
          pts: [[1.08, 45.4], [1.86, 61.1], [3.47, 69.4], [4.7, 70.7], [8.39, 72.7]] },
        { name: "claude-fable-5", fam: "Anthropic", eff: "HIGH", anchor: "end", dx: -11, dy: 4, lx: -10, ly: 0, at: 2,
          pts: [[3.76, 59.6], [6.09, 65.4], [9.18, 68.6], [13.41, 69.9], [21.64, 69.7]] },
        { name: "gpt-5.5", fam: "OpenAI", eff: "MEDIUM", anchor: "start", dx: 18, dy: 4, lx: 17, ly: 0, at: 1,
          pts: [[1.2, 27.0], [2.75, 54.0], [5.1, 64.4], [7.23, 67.0]] },
        { name: "claude-opus-4.8", fam: "Anthropic", eff: "HIGH", anchor: "start", dx: 36, dy: 16, lx: 35, ly: 12, at: 2,
          pts: [[2.29, 40.8], [3.44, 48.7], [4.28, 51.8], [8.01, 54.4], [13.22, 59.0]] },
        { name: "claude-sonnet-5", fam: "Anthropic", eff: "HIGH", anchor: "end", dx: -11, dy: -10, lx: -10, ly: -14, at: 2,
          pts: [[2.19, 30.5], [4.08, 39.8], [7.42, 48.2], [11.89, 49.7], [26.4, 53.8]] },
        { name: "glm-5.2", fam: "Other", eff: "MAX", anchor: "end", dx: -11, dy: 28, lx: -10, ly: 24, at: 1,
          pts: [[2.84, 36.3], [3.92, 43.8]] },
        { name: "kimi-k3", fam: "Moonshot", eff: "MAX", anchor: "end", dx: -11, dy: -10, lx: -10, ly: -14, at: 0, pts: [[4.65, 68.5]] },
        { name: "grok-4.5", fam: "Other", eff: "HIGH", anchor: "end", dx: -18, dy: -10, lx: -17, ly: -14, at: 0, pts: [[2.42, 53.8]] },
        { name: "muse-spark-1.1", fam: "Other", eff: "XHIGH", anchor: "end", dx: -48, dy: -46, lx: -47, ly: -50, at: 0, pts: [[2.36, 53.3]] },
        { name: "gpt-5.4", fam: "OpenAI", eff: "XHIGH", anchor: "end", dx: -11, dy: 40, lx: -10, ly: 36, at: 0, pts: [[5.65, 51.8]] },
        { name: "gemini-3.6-flash", fam: "Google", eff: "HIGH", anchor: "start", dx: 36, dy: 52, lx: 35, ly: 48, at: 0, pts: [[3.53, 48.6]] },
        { name: "gemini-3.5-flash", fam: "Google", eff: "MEDIUM", anchor: "end", dx: -11, dy: 4, lx: -10, ly: 0, at: 0, pts: [[7.34, 37.4]] },
        { name: "kimi-k2.7-code", fam: "Moonshot", eff: "", anchor: "start", dx: 11, dy: -10, lx: 10, ly: -14, at: 0, pts: [[2.82, 30.5]] },
        { name: "claude-sonnet-4.6", fam: "Anthropic", eff: "HIGH", anchor: "end", dx: -11, dy: 4, lx: -10, ly: 0, at: 0, pts: [[5.52, 29.9]] },
        { name: "gemini-3.1-pro", fam: "Google", eff: "HIGH", anchor: "start", dx: 11, dy: 4, lx: 10, ly: 0, at: 0, pts: [[9.48, 11.8]] },
      ];

      const benchSvg = document.querySelector<SVGSVGElement>("[data-bench-svg]");
      const benchTip = document.querySelector<HTMLElement>("[data-bench-tip]");
      const benchLegend = document.querySelector<HTMLElement>("[data-bench-legend]");
      const benchPlot = benchSvg?.closest<HTMLElement>(".bench-plot");
      let benchView: "scatter" | "bars" = "scatter";
      // Empty = show every family; otherwise only the picked ones.
      const benchOn = new Set<string>();

      const NS = "http://www.w3.org/2000/svg";
      function el(tag: string, attrs: Record<string, string | number>) {
        const n = document.createElementNS(NS, tag);
        for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
        return n;
      }
      const visible = (m: Model) => benchOn.size === 0 || benchOn.has(m.fam);
      const dim = (m: Model) => (visible(m) ? "1" : "0.12");

      function showTip(m: Model, ev: MouseEvent) {
        if (!benchTip || !benchPlot) return;
        // Scatter points carry an effort level and their own cost/score; the
        // token and step counts are the leaderboard row's, so they only show
        // where the whole row is what's on screen.
        benchTip.innerHTML =
          `<b style="color:${famColor(m.fam)}">${m.name}</b>` +
          (m.effort ? `<span class="e">${m.effort.toLowerCase()}</span>` : "") +
          `<span class="r">${m.rate}%${m.effort ? "" : `<i>±${m.ci}</i>`}</span>` +
          `<span class="k">avg cost<b>$${m.cost.toFixed(2)}</b></span>` +
          (m.effort
            ? ""
            : `<span class="k">output<b>${m.tok}</b></span>` +
              `<span class="k">steps<b>${m.steps}</b></span>`);
        benchTip.hidden = false;
        const box = benchPlot.getBoundingClientRect();
        const x = ev.clientX - box.left;
        const y = ev.clientY - box.top;
        benchTip.style.left = Math.min(x + 16, box.width - 210) + "px";
        benchTip.style.top = Math.max(y - 12, 0) + "px";
      }
      function hideTip() {
        if (benchTip) benchTip.hidden = true;
      }
      benchPlot?.addEventListener("mouseleave", hideTip);

      /** Attach hover affordances to one mark. */
      function wireMark(g: SVGElement, m: Model) {
        g.addEventListener("mousemove", (e) => showTip(m, e as MouseEvent));
        g.addEventListener("mouseleave", hideTip);
      }

      // Cost runs RIGHT-to-LEFT: $0 at the right edge, so "cheap and good" is
      // the top-right corner and every curve reads as "what more money buys".
      const CX = (c: number) => 840 - c * 28.9192;
      const CY = (s: number) => 511 - s * 5.8875;

      function drawCurves() {
        if (!benchSvg) return;
        const T = 40, B = 511, L = CX(28.5), R = 855;
        for (let s = 0; s <= 80; s += 10) {
          benchSvg.append(el("line", { x1: L, x2: R, y1: CY(s), y2: CY(s), class: "grid" }));
          const t = el("text", { x: L - 10, y: CY(s) + 4, class: "tick end" });
          t.textContent = s + "%";
          benchSvg.append(t);
        }
        for (let c = 0; c <= 25; c += 5) {
          if (c) benchSvg.append(el("line", { x1: CX(c), x2: CX(c), y1: T, y2: B, class: "grid" }));
          const t = el("text", { x: CX(c), y: B + 22, class: "tick mid" });
          t.textContent = "$" + c;
          benchSvg.append(t);
        }
        benchSvg.append(el("line", { x1: L, x2: R, y1: B, y2: B, class: "axis" }));
        const xl = el("text", { x: (L + R) / 2, y: B + 44, class: "axis-label mid" });
        xl.textContent = "avg cost per task";
        const head = el("text", { x: L, y: 22, class: "plot-title" });
        head.textContent = "DeepSWE score";
        const eff = el("text", { x: R - 6, y: 52, class: "efficient end" });
        eff.textContent = "most efficient ↗";
        benchSvg.append(xl, head, eff);

        for (const cv of CURVES) {
          const m = MODELS.find((x) => x.name === cv.name);
          const on = benchOn.size === 0 || benchOn.has(cv.fam);
          const g = el("g", { class: "curve", opacity: on ? 1 : 0.12 }) as SVGGElement;
          const color = famColor(cv.fam);
          if (cv.pts.length > 1) {
            g.append(
              el("path", {
                d: cv.pts.map(([c, s], i) => `${i ? "L" : "M"} ${CX(c)} ${CY(s)}`).join(" "),
                fill: "none", stroke: color, "stroke-width": 2.5,
                "stroke-linecap": "round", "stroke-linejoin": "round", opacity: 0.75,
              }),
            );
          }
          cv.pts.forEach(([c, s], i) => {
            g.append(
              el("circle", {
                cx: CX(c), cy: CY(s), r: i === cv.at ? 4.5 : 3.5,
                fill: color, class: "dot",
              }),
            );
          });
          const [lc, ls] = cv.pts[cv.at];
          const x = CX(lc), y = CY(ls);
          g.append(
            el("line", {
              x1: x, y1: y, x2: x + cv.lx, y2: y + cv.ly,
              stroke: color, "stroke-width": 1, opacity: 0.35,
            }),
          );
          const name = el("text", {
            x: x + cv.dx, y: y + cv.dy, "text-anchor": cv.anchor,
            fill: color, class: "curve-label",
          });
          name.textContent = cv.name;
          g.append(name);
          if (cv.eff) {
            const e2 = el("text", {
              x: x + cv.dx, y: y + cv.dy + 11, "text-anchor": cv.anchor,
              fill: color, class: "curve-eff",
            });
            e2.textContent = cv.eff;
            g.append(e2);
          }
          // One generous hit target per point, over the top of the labels.
          if (on && m) {
            cv.pts.forEach(([c, s], i) => {
              const hit = el("circle", { cx: CX(c), cy: CY(s), r: 11, fill: "transparent" });
              const at: Model = {
                ...m,
                cost: c,
                rate: s,
                effort: i === cv.at ? cv.eff : `effort ${i + 1} of ${cv.pts.length}`,
              };
              hit.addEventListener("mousemove", (ev) => showTip(at, ev as MouseEvent));
              hit.addEventListener("mouseleave", hideTip);
              g.append(hit);
            });
          }
          benchSvg.append(g);
        }
      }

      function drawBars() {
        if (!benchSvg) return;
        const L = 250, R = 1090, T = 14;
        const rowH = 25;
        const bw = (r: number) => (r / 80) * (R - L);
        MODELS.forEach((m, i) => {
          const y = T + i * rowH;
          const g = el("g", { class: "row", opacity: dim(m) }) as SVGGElement;
          const name = el("text", { x: L - 16, y: y + 14, class: "row-name end" });
          name.textContent = m.name;
          const track = el("rect", { x: L, y: y + 3, width: R - L, height: 15, class: "row-track" });
          const fill = el("rect", {
            x: L, y: y + 3, width: bw(m.rate), height: 15, rx: 4,
            fill: famColor(m.fam),
          });
          const lo = L + bw(m.rate - m.ci), hi = L + bw(m.rate + m.ci);
          const whisk = el("line", { x1: lo, x2: hi, y1: y + 10.5, y2: y + 10.5, class: "ci" });
          const cap1 = el("line", { x1: lo, x2: lo, y1: y + 5, y2: y + 16, class: "ci" });
          const cap2 = el("line", { x1: hi, x2: hi, y1: y + 5, y2: y + 16, class: "ci" });
          const val = el("text", { x: R + 14, y: y + 14, class: "row-val" });
          val.textContent = `${m.rate}% ±${m.ci}`;
          const hit = el("rect", { x: 0, y, width: 1180, height: rowH, fill: "transparent" });
          g.append(name, track, fill, whisk, cap1, cap2, val, hit);
          if (visible(m)) wireMark(g, m);
          benchSvg!.append(g);
        });
      }

      function drawBench() {
        if (!benchSvg) return;
        hideTip();
        benchSvg.textContent = "";
        // Each view owns its coordinate space; the SVG scales to the slide.
        benchSvg.setAttribute(
          "viewBox",
          benchView === "scatter" ? "0 0 900 570" : "0 0 1180 470",
        );
        if (benchView === "scatter") drawCurves();
        else drawBars();
      }

      // Legend doubles as the family filter (click to isolate, click to release).
      FAMS.forEach((f) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "chip";
        b.style.setProperty("--c", f.color);
        b.textContent = f.key;
        b.addEventListener("click", () => {
          if (benchOn.has(f.key)) benchOn.delete(f.key);
          else benchOn.add(f.key);
          benchLegend
            ?.querySelectorAll<HTMLElement>(".chip")
            .forEach((c) =>
              c.classList.toggle("on", benchOn.has(c.textContent ?? "")),
            );
          benchLegend?.classList.toggle("filtered", benchOn.size > 0);
          drawBench();
        });
        benchLegend?.append(b);
      });
      document
        .querySelectorAll<HTMLButtonElement>(".bench-toggle button")
        .forEach((b) =>
          b.addEventListener("click", () => {
            benchView = b.dataset.view as "scatter" | "bars";
            document
              .querySelectorAll(".bench-toggle button")
              .forEach((o) => o.classList.toggle("on", o === b));
            drawBench();
          }),
        );
      drawBench();

      // ── Chapter wash on entering a chapter divider ────────────────
      function runWash() {
        if (!wash) return;
        wash.classList.remove("run");
        void wash.offsetWidth;
        wash.classList.add("run");
      }

      // ── Scroll-driven narrative reveals ───────────────────────────
      document.querySelectorAll<HTMLElement>("[data-scroll-frame]").forEach((frame) => {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) =>
              e.target.classList.toggle("in", e.isIntersecting),
            );
          },
          { root: frame, threshold: 0.55 },
        );
        frame
          .querySelectorAll("[data-scroll-step]")
          .forEach((s) => io.observe(s));
      });

      // ── Wire the per-slide lifecycle (deterministic replay on entry) ──
      function onShow(slide: HTMLElement) {
        armHeadline(slide);
        updateChrome();
        if (slide.hasAttribute("data-chapter")) runWash();
        if (slide.hasAttribute("data-viz")) {
          resetBars(slide);
          window.setTimeout(() => growBars(slide), 160);
        }
        if (slide.hasAttribute("data-one-number")) playCount(slide);
        if (slide.hasAttribute("data-terminal")) playTerminal(slide);
        if (slide.hasAttribute("data-lottery")) {
          buildLottery(slide);
          // Match the visual to reveal's fragment state. Entering forward the
          // collapse fragment isn't shown yet (→ scattered); entering backward
          // from the next slide it's already shown (→ collapsed). Forcing
          // "before" here would desync the arrows (right would find no
          // fragment and skip the slide).
          const frag = slide.querySelector<HTMLElement>("[data-lottery-collapse]");
          setLottery(slide, !!frag?.classList.contains("visible"));
        }
        if (slide.hasAttribute("data-scrolly")) {
          const frame = slide.querySelector<HTMLElement>("[data-scroll-frame]");
          if (frame) frame.scrollTop = 0;
        }
        // Keep the inline notes overlay in sync while it's open.
        if (notesEl && !notesEl.hasAttribute("hidden")) syncNotes();
      }

      deck.on("slidechanged", (e: any) => onShow(e.currentSlide as HTMLElement));
      deck.on("ready", (e: any) => onShow(e.currentSlide as HTMLElement));

      // The reliability scatter collapses on a fragment, replays on step-back.
      deck.on("fragmentshown", (e: any) => {
        const f = e.fragment as HTMLElement;
        if (f?.hasAttribute("data-lottery-collapse"))
          setLottery(f.closest("section") as HTMLElement, true);
      });
      deck.on("fragmenthidden", (e: any) => {
        const f = e.fragment as HTMLElement;
        if (f?.hasAttribute("data-lottery-collapse"))
          setLottery(f.closest("section") as HTMLElement, false);
      });
    </script>
  </body>
</html>
