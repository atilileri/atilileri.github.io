        Notes for the current slide appear here.
      </div>
    </aside>

    <div class="reveal">
      <div class="slides">

        <!-- ═══════════════ OPENING · 1 slide ═══════════════ -->
        <!-- OPENING — .hero -->
        <section class="hero" data-section="Opening">
          <span class="eyebrow">Same licence. Different results.</span>
          <h1 class="h-set">
            <span class="h-line"><span>How to better use</span></span>
            <span class="h-line"><span class="accent">COPILOT</span></span>
          </h1>
          <p class="hero-sub">How it works, what it costs, consistently better outcome.</p>
          <p class="byline">Atil Ilerialkan · live from atilileri.github.io</p>
        </section>

        <!-- ═══════════════ CHAPTER 01 · 2 slides ═══════════════ -->
        <!-- 1.1 — .chapter -->
        <section class="chapter" data-section="01 — Why optimize" data-chapter>
          <span class="chapter-no">CHAPTER 01</span>
          <h2>How can we optimize<br />Copilot usage?</h2>
          <ul class="chapter-sub chapter-sub-list">
            <li>How to achieve more with same AI budget?</li>
          </ul>
        </section>

        <!-- 1.2 — RoadmapDivider -->
        <RoadmapDivider
          section="01 — Why optimize"
          heading="Chapters"
        >
        </RoadmapDivider>

        <!-- ═══════════════ CHAPTER 02 · 3 slides ═══════════════ -->
        <!-- 2.1 — RoadmapDivider -->
        <RoadmapDivider section="02 — Terminology" chapter={2}>
        </RoadmapDivider>

        <!-- 2.2 — vertical stack, 3 sub-slides -->
        <section data-section="02 — Terminology">
          <!-- 2.2.1 — .layers -->
          <section class="layers" data-section="02 — Terminology" data-layers>
            <span class="eyebrow">The mental model</span>
            <h2 class="h-set">
              <span class="h-line"><span>Layers of the Agent</span></span>
            </h2>
            <div class="layers-grid">
