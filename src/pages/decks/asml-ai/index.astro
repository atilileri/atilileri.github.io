        const suffix = el.getAttribute("data-count-suffix") ?? "";
        const start = performance.now();
        const dur = 900;
        if (countTimer) cancelAnimationFrame(countTimer);
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = String(Math.round(eased * to)) + suffix;
          if (t < 1) countTimer = requestAnimationFrame(tick);
        };
        countTimer = requestAnimationFrame(tick);
      }

      // ── Live tokenizer ────────────────────────────────────────────
      const tokInput = document.querySelector<HTMLTextAreaElement>("[data-tok-input]");
      function updateTokens() {
        if (!tokInput) return;
        const text = tokInput.value;
        const chars = text.length;
        const words = text.trim() ? text.trim().split(/\s+/).length : 0;
        const tokens = Math.max(0, Math.ceil(chars / 4));
        const cost = ((tokens / 1_000_000) * 15).toFixed(6);
        const set = (sel: string, v: string) => {
          const el = document.querySelector(sel);
          if (el) el.textContent = v;
        };
        set("[data-tok-chars]", String(chars));
        set("[data-tok-words]", String(words));
        set("[data-tok-tokens]", String(tokens));
        set("[data-tok-cost]", "$" + cost);
      }
      tokInput?.addEventListener("input", updateTokens);
      updateTokens();

      // ── Terminal / CLI replay (deterministic) ─────────────────────
      const replay: { t: string; d: number; cls?: string; type?: boolean }[] = [
        { t: "$ ", d: 250 },
        { t: "claude /wayfinder issue-13\n", d: 40, type: true },
        { t: "→ claiming ticket · assigning @atilileri\n", d: 420, cls: "sig" },
        { t: "→ building the exemplary showcase\n", d: 360, cls: "sig" },
        { t: "  ✓ hero   ✓ scrollytelling   ✓ tokenizer\n", d: 300, cls: "ok" },
        { t: "  ✓ data-viz   ✓ code demo   ✓ terminal\n", d: 300, cls: "ok" },
        { t: "  ✓ sub-slides ✓ chapter wash  ✓ one-number\n", d: 300, cls: "ok" },
        { t: "→ astro build … static, no server\n", d: 460, cls: "sig" },
        { t: "  ✓ dist/ ready for GitHub Pages\n", d: 360, cls: "ok" },
        { t: "$ ", d: 250 },
      ];
      let termTimer: number | undefined;
      function playTerminal(slide: HTMLElement) {
        const body = slide.querySelector<HTMLElement>("[data-term-body]");
        if (!body) return;
        if (termTimer) clearTimeout(termTimer);
        body.innerHTML = "";
        let i = 0;
        const step = () => {
          if (i >= replay.length) {
            body.insertAdjacentHTML("beforeend", '<span class="term-cursor">&nbsp;</span>');
            return;
          }
          const { t, d, cls, type } = replay[i++];
          if (type) {
            let c = 0;
            const typeChar = () => {
              if (c < t.length) {
                body.append(t[c++]);
                termTimer = window.setTimeout(typeChar, 42);
              } else {
                termTimer = window.setTimeout(step, d);
              }
            };
            typeChar();
          } else {
            const span = document.createElement("span");
            if (cls) span.className = cls;
            span.textContent = t;
            body.appendChild(span);
            termTimer = window.setTimeout(step, d);
          }
        };
        step();
      }

      // ── Interactive benchmark chart (DeepSWE v1.1) ────────────────
      // Hand-rolled SVG — no charting library, so the deck palette reaches
      // inside the chart. Two views over one dataset: a cost/pass-rate scatter
      // and ranked bars with 95% CI whiskers. Data transcribed from the public
      // leaderboard at deepswe.datacurve.ai/blog/deepswe-v1-1 (113 tasks).
      // ── Interactive benchmark chart (DeepSWE v1.1) ────────────────
      // Hand-rolled SVG — no charting library, so the deck palette reaches
      // inside the chart. ONE view: pass rate against average cost per task.
      // The ranked-bars view was cut (Atil, 2026-08-25) — the room only ever
      // read the scatter, and a toggle with one option is furniture.
      //
      // The unit here is a CONFIGURATION, not a model: one point is one model
      // run at one reasoning-effort level, so a model with five levels traces
      // a five-point curve as you spend more on it. Effort levels carry the
      // provider's own name — low, medium, high, xhigh, max — never a
      // position ("level 3 of 5"), because the name is what you type into an
      // API call. A model that publishes only one level gets one point.
      // Transcribed from the public leaderboard at
      // deepswe.datacurve.ai/blog/deepswe-v1-1 (113 tasks, 2026-08-25).
      type Pt = {
        cost: number; // avg $ / task
        rate: number; // pass@1 %
        eff: string; // reasoning effort, the provider's own name
        tok: string; // mean output tokens
        steps: number; // mean agent steps
        ci: number; // ± percentage points, 95% run-to-run
      };
      type Curve = {
        name: string;
        fam: string;
        at: number; // index of the labelled point — the model's best score
        pts: Pt[]; // cheapest first
      };
      /** Rows straight off the leaderboard: cost, score, effort, tokens, steps, ±CI. */
      const curve = (
        name: string,
        fam: string,
        rows: [number, number, string, string, number, number][],
      ): Curve => {
        const pts = rows.map(([cost, rate, eff, tok, steps, ci]) => ({
          cost, rate, eff, tok, steps, ci,
        }));
        // The labelled point is the model's best score, resolved here rather
        // than transcribed, so re-transcribing the data can never leave a
        // callout pointing at a level that is no longer the model's best.
        let at = 0;
        pts.forEach((pt, i) => {
          if (pt.rate > pts[at].rate) at = i;
        });
        return { name, fam, at, pts };
      };
      const CURVES: Curve[] = [
        curve("claude-opus-5", "Anthropic", [
          [1.66, 58.1, "LOW", "20k", 36, 2.3], [3.29, 68.9, "MEDIUM", "37k", 52, 1.2],
          [6.08, 72.8, "HIGH", "64k", 73, 1.9], [9.07, 73.2, "XHIGH", "92k", 89, 3.1],
          [11.84, 73.6, "MAX", "118k", 99, 3.9]]),
        curve("gpt-5.6-sol", "OpenAI", [
          [0.82, 45.4, "LOW", "11k", 23, 2.4], [1.42, 61.1, "MEDIUM", "18k", 31, 1.6],
          [2.66, 69.4, "HIGH", "28k", 37, 1.4], [3.6, 70.7, "XHIGH", "41k", 44, 0.8],
          [6.46, 72.7, "MAX", "60k", 61, 2.8]]),
        curve("claude-fable-5", "Anthropic", [
          [3.76, 59.6, "LOW", "25k", 38, 2.8], [6.09, 65.4, "MEDIUM", "40k", 48, 4.4],
          [9.18, 68.6, "HIGH", "57k", 59, 1.1], [13.41, 69.9, "XHIGH", "80k", 68, 3.2],
          [21.63, 69.7, "MAX", "119k", 88, 4.0]]),
        curve("glm-5.3", "Other", [[3.99, 69.0, "MAX", "80k", 124, 3.0]]),
        curve("kimi-k3", "Moonshot", [[4.65, 68.5, "MAX", "81k", 98, 4.5]]),
        curve("gpt-5.6-luna", "OpenAI", [
          [0.01, 1.5, "LOW", "3k", 12, 0.8], [0.04, 11.3, "MEDIUM", "8k", 24, 0.8],
          [0.16, 44.2, "HIGH", "26k", 49, 2.9], [0.31, 56.9, "XHIGH", "45k", 71, 2.2],
          [0.61, 67.2, "MAX", "73k", 102, 4.0]]),
        curve("gpt-5.5", "OpenAI", [
          [1.2, 27.0, "LOW", "9k", 28, 2.3], [2.75, 54.0, "MEDIUM", "20k", 46, 2.6],
          [5.1, 64.4, "HIGH", "31k", 62, 3.1], [7.23, 67.0, "XHIGH", "46k", 82, 6.5]]),
        curve("grok-4.6", "Other", [
          [1.04, 41.6, "LOW", "16k", 44, 2.3], [3.45, 67.5, "MEDIUM", "50k", 70, 2.3],
          [4.38, 65.2, "HIGH", "61k", 79, 1.5], [5.5, 66.7, "XHIGH", "71k", 87, 2.2]]),
        curve("gemini-3.7-flash", "Google", [
          [1.83, 53.8, "LOW", "73k", 130, 2.6], [2.03, 65.5, "MEDIUM", "94k", 117, 3.1],
          [2.18, 65.3, "HIGH", "107k", 125, 1.8]]),
        curve("deepseek-v4-pro", "Other", [[1.67, 62.8, "MAX", "106k", 155, 6.3]]),
        curve("claude-opus-4.8", "Anthropic", [
          [2.29, 40.8, "LOW", "29k", 54, 1.5], [3.44, 48.7, "MEDIUM", "41k", 66, 2.2],
          [4.28, 51.8, "HIGH", "50k", 72, 4.6], [8.01, 54.4, "XHIGH", "86k", 95, 3.7],
          [13.22, 59.0, "MAX", "135k", 120, 1.8]]),
        curve("qwen3.8-max", "Other", [[3.73, 57.5, "XHIGH", "95k", 111, 2.7]]),
        curve("muse-spark-1.2", "Other", [[3.7, 54.9, "XHIGH", "99k", 101, 2.1]]),
        curve("claude-sonnet-5", "Anthropic", [
          [4.08, 39.8, "MEDIUM", "57k", 108, 3.1], [7.43, 48.2, "HIGH", "87k", 147, 4.5],
          [11.89, 49.7, "XHIGH", "121k", 186, 3.5], [26.4, 53.8, "MAX", "214k", 268, 4.2]]),
        curve("deepseek-v4-flash", "Other", [[0.46, 53.3, "MAX", "108k", 153, 3.6]]),
        curve("gemini-3.6-flash", "Google", [[2.21, 46.7, "HIGH", "96k", 117, 3.7]]),
        curve("glm-5.2", "Other", [
          [2.84, 36.3, "HIGH", "54k", 122, 4.8], [3.92, 43.8, "MAX", "78k", 129, 1.7]]),
        curve("gemini-3.5-flash", "Google", [[3.45, 36.1, "HIGH", "76k", 105, 4.0]]),
      ];
      // Fixed hue order, never cycled — validated for CVD separation on this
      // light surface (scripts/validate_palette.js, all six checks pass).
      const FAMS: { key: string; color: string }[] = [
        { key: "OpenAI", color: "#1a6fd4" },
        { key: "Anthropic", color: "#e0620d" },
        { key: "Google", color: "#0f8f6f" },
        { key: "Moonshot", color: "#8a4fd0" },
        { key: "Other", color: "#c2185b" },
      ];
      const famColor = (f: string) =>
        FAMS.find((x) => x.key === f)?.color ?? "#c2185b";

      const benchSvg = document.querySelector<SVGSVGElement>("[data-bench-svg]");
      const benchTip = document.querySelector<HTMLElement>("[data-bench-tip]");
      const benchLegend = document.querySelector<HTMLElement>("[data-bench-legend]");
      const benchPlot = benchSvg?.closest<HTMLElement>(".bench-plot");
      // Empty = show every family; otherwise only the picked ones.
      const benchOn = new Set<string>();

      const NS = "http://www.w3.org/2000/svg";
      function el(tag: string, attrs: Record<string, string | number>) {
        const n = document.createElementNS(NS, tag);
        for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
        return n;
      }
      const shown = (fam: string) => benchOn.size === 0 || benchOn.has(fam);

      function showTip(cv: Curve, pt: Pt, ev: MouseEvent) {
        if (!benchTip || !benchPlot) return;
        // One point is one configuration, so every figure in the tip belongs
        // to that configuration — the effort level included, under its own
        // provider's name.
        benchTip.innerHTML =
          `<b style="color:${famColor(cv.fam)}">${cv.name}</b>` +
          `<span class="e">${pt.eff.toLowerCase()}</span>` +
          `<span class="r">${pt.rate.toFixed(1)}%<i>±${pt.ci.toFixed(1)}</i></span>` +
          `<span class="k">avg cost<b>$${pt.cost.toFixed(2)}</b></span>` +
          `<span class="k">output<b>${pt.tok}</b></span>` +
          `<span class="k">steps<b>${pt.steps}</b></span>`;
        benchTip.hidden = false;

        placeTip(benchTip, benchPlot, ev);
      }
      // Reveal SCALES the whole deck with a CSS transform, so a client rect is
      // in scaled pixels while `left`/`top` are in the plot's own unscaled
      // ones. Mixing the two used to drift the tip further from the cursor the
      // further right it went, and the old clamp guessed the tip was 210px
      // wide. Convert once, then measure the tip instead of guessing:
      // `offsetWidth` is already unscaled layout, the same units `left` is
      // written in. Both charts' tips place themselves through here.
      function placeTip(tip: HTMLElement, plot: HTMLElement, ev: MouseEvent) {
        const box = plot.getBoundingClientRect();
        const plotW = plot.offsetWidth;
        const plotH = plot.offsetHeight;
        const scale = box.width / plotW || 1;
        const x = (ev.clientX - box.left) / scale;
        const y = (ev.clientY - box.top) / scale;
        const tw = tip.offsetWidth;
        const th = tip.offsetHeight;

        // Right of the cursor by default; it flips to the left when it would
        // run off the plot, so the tip is always beside the point it explains
        // and never off the wall. The clamps catch the corner case where
        // neither side fits.
        const GAP = 16;
        let left = x + GAP;
        if (left + tw > plotW) left = x - GAP - tw;
        left = Math.max(0, Math.min(left, plotW - tw));
        const top = Math.max(0, Math.min(y - 12, plotH - th));
        tip.style.left = left + "px";
        tip.style.top = top + "px";
      }
      function hideTip() {
        if (benchTip) benchTip.hidden = true;
      }
      benchPlot?.addEventListener("mouseleave", hideTip);

      // Cost runs LEFT-to-RIGHT: $0 at the left edge, spend increasing
      // rightward — the conventional reading, and the same direction as the
      // stop-point slide that follows (Atil, 2026-08-02). "Cheap and good" is
      // the top-LEFT corner, which is where the "most efficient" pointer sits.
      // The cost axis is SQUARE-ROOT, not linear. Linear was right when the
      // board's cheapest model cost $2; v1.1 has one at $0.01 and one at
      // $26.40, so on a linear axis eleven of the eighteen models pile into
      // the leftmost eighth of the plot and the callouts sit on top of each
      // other. A root axis still starts at a true $0 and still reads
      // left-to-right as "more money", it just gives the cheap end the room
      // the argument needs. Ticks are uneven for the same reason, and they
      // carry their real dollar values, so nothing on screen is mis-stated.
      // The viewBox is shaped like the box the slide actually gives the chart
      // — a wide, shallow band under the headline — so the SVG fills it edge
      // to edge instead of letterboxing itself inside it. Everything below is
      // in viewBox units, and the whole thing scales with the slide.
      const VB = { w: 1400, h: 560 };
      const PLOT = { T: 42, B: 486, L: 110, R: 1388 };
      /** Re-shape the coordinate box to the box the slide is giving us, so the
          chart fills its space in BOTH directions without stretching its own
          type. Called before every draw; falls back to the 5:2 default when
          the element has no layout yet (first paint, hidden slide). */
      function fitPlot() {
        const box = benchPlot?.getBoundingClientRect();
        if (!box || box.width < 40 || box.height < 40) return;
        VB.h = Math.max(380, Math.min(900, (VB.w * box.height) / box.width));
        // 74 units under the axis carry the cost ticks and the axis title.
        PLOT.B = Math.round(VB.h - 74);
      }
      const COST_MAX = 27;
      const SCORE_MAX = 85; // headroom over the 80% tick for the top callouts
      const CX = (c: number) =>
        PLOT.L + 58 + Math.sqrt(Math.max(c, 0) / COST_MAX) * (PLOT.R - PLOT.L - 78);
      const CY = (s: number) =>
        PLOT.B - (s / SCORE_MAX) * (PLOT.B - PLOT.T);
      const COST_TICKS = [0, 0.5, 1, 2, 3, 5, 7.5, 10, 15, 20, 25];

      // ── Direct labels, placed by the code, not by hand ─────────────
      // Callout positions used to be a hand-tuned dx/dy per model. That solve
      // only held for one exact transcription of the data, and the data moves
      // every leaderboard revision, so it is now solved at draw time: try a
      // ring of candidate slots around the labelled point, take the first one
      // that hits nothing already placed. Curves are placed best-score first,
      // so the models the room looks for keep the closest slots.
      type Box = { x: number; y: number; w: number; h: number };
      const hits = (a: Box, b: Box) =>
        a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;
      // 12.5px display type, ~0.65em average advance, plus the effort line
      // under the name. The box is padded on every side, so two callouts that
      // "just miss" still end up in different slots — abutting labels read as
      // one run-on word, which is the failure this padding exists to stop.
      const PAD = 8;
      const labelBox = (name: string, x: number, y: number, anchor: string): Box => {
        const w = name.length * 8.1;
        const x0 =
          anchor === "end" ? x - w : anchor === "middle" ? x - w / 2 : x;
        return { x: x0 - PAD, y: y - 14, w: w + PAD * 2, h: 30 };
      };
      const SLOTS: [number, number, string][] = [
        [13, 4, "start"], [-13, 4, "end"],
        [13, -13, "start"], [-13, -13, "end"],
        [13, 22, "start"], [-13, 22, "end"],
        [0, -22, "middle"], [0, 36, "middle"],
        [34, 4, "start"], [-34, 4, "end"],
        [34, -26, "start"], [-34, -26, "end"],
        [34, 34, "start"], [-34, 34, "end"],
        [60, 16, "start"], [-60, 16, "end"],
        [60, -34, "start"], [-60, -34, "end"],
        [86, 44, "start"], [-86, 44, "end"],
      ];
      /** Pick the first free slot for one callout; fall back to the first. */
      function placeLabel(cv: Curve, x: number, y: number, taken: Box[]) {
        for (const [dx, dy, anchor] of SLOTS) {
          const box = labelBox(cv.name, x + dx, y + dy, anchor);
          if (box.x < PLOT.L || box.x + box.w > PLOT.R) continue;
          if (box.y < PLOT.T - 20 || box.y + box.h > PLOT.B) continue;
          if (taken.some((t) => hits(box, t))) continue;
          taken.push(box);
          return { dx, dy, anchor, box };
        }
        const [dx, dy, anchor] = SLOTS[0];
        const box = labelBox(cv.name, x + dx, y + dy, anchor);
        taken.push(box);
        return { dx, dy, anchor, box };
      }

      function drawCurves() {
        if (!benchSvg) return;
        const { T, B, L, R } = PLOT;
        for (let s = 0; s <= 80; s += 10) {
          benchSvg.append(el("line", { x1: L, x2: R, y1: CY(s), y2: CY(s), class: "grid" }));
          const t = el("text", { x: L - 10, y: CY(s) + 4, class: "tick end" });
          t.textContent = s + "%";
          benchSvg.append(t);
        }
        for (const c of COST_TICKS) {
          if (c) benchSvg.append(el("line", { x1: CX(c), x2: CX(c), y1: T, y2: B, class: "grid" }));
          const t = el("text", { x: CX(c), y: B + 22, class: "tick mid" });
          t.textContent = "$" + c;
          benchSvg.append(t);
        }
        benchSvg.append(el("line", { x1: L, x2: R, y1: B, y2: B, class: "axis" }));

        // THE CEILING (#33). One of the chart's two proofs — the other, the
        // stop-point, belongs to the next slide, so nothing here draws it.
        // Read off the data rather than typed in, so a re-transcription can
        // never leave the line under a point that now sits above it.
        const CEIL = Math.max(
          ...CURVES.flatMap((cv) => cv.pts.map((pt) => pt.rate)),
        );
        benchSvg.append(
          el("line", { x1: L, x2: R, y1: CY(CEIL), y2: CY(CEIL), class: "ceiling" }),
        );
        // Right-anchored: the top-LEFT band belongs to the "most efficient"
        // pointer, and two annotations in one corner read as clutter. The
        // expensive end of the ceiling is also the more damning place to say it.
        const ceilLbl = el("text", { x: R - 8, y: CY(CEIL) - 12, class: "ceiling-lbl end" });
        ceilLbl.textContent = "nothing clears this";
        benchSvg.append(ceilLbl);
        const xl = el("text", { x: (L + R) / 2, y: B + 44, class: "axis-label mid" });
        xl.textContent = "avg cost per task (square-root axis)";
        // The score used to be named in a corner title, which read as a chart
        // heading rather than as the axis it labels. It now sits ON the axis,
        // rotated, opposite the cost title — so each axis says what it is and
        // the top-left corner belongs to the "most efficient" pointer alone.
        const yl = el("text", {
          x: 26, y: (T + B) / 2, class: "axis-label mid",
          transform: `rotate(-90 26 ${(T + B) / 2})`,
        });
        yl.textContent = "DeepSWE score";
        // Cheap AND good is the top-LEFT corner, so the pointer sits there. It
        // names the quadrant the whole slide asks the room to look at, so it
        // carries the deck's accent rather than a whispered muted italic.
        const eff = el("text", { x: L + 10, y: 50, class: "efficient" });
        eff.textContent = "↖ most efficient";
        benchSvg.append(xl, yl, eff);

        // The ceiling label and the efficiency pointer are furniture the
        // callouts must not land on, so they seed the occupied list.
        const taken: Box[] = [
          { x: R - 170, y: CY(CEIL) - 28, w: 170, h: 24 },
          { x: L, y: 34, w: 200, h: 28 },
        ];
        // Best score first: the models the room hunts for get the tightest
        // slots, and the also-rans take the long leader lines.
        const order = [...CURVES].sort(
          (a, z) => z.pts[z.at].rate - a.pts[a.at].rate,
        );
        const marks = el("g", {}) as SVGGElement;
        // Labels are painted OVER the marks, so without this they swallow the
        // hover of any point they cover — the callout for the dearest model
        // sits right on its own dot. They are annotation, not a target.
        const labels = el("g", { "pointer-events": "none" }) as SVGGElement;

        for (const cv of order) {
          const on = shown(cv.fam);
          const g = el("g", { class: "curve", opacity: on ? 1 : 0.12 }) as SVGGElement;
          const color = famColor(cv.fam);
          if (cv.pts.length > 1) {
            g.append(
              el("path", {
                d: cv.pts
                  .map((pt, i) => `${i ? "L" : "M"} ${CX(pt.cost)} ${CY(pt.rate)}`)
                  .join(" "),
                fill: "none", stroke: color, "stroke-width": 2.5,
                "stroke-linecap": "round", "stroke-linejoin": "round", opacity: 0.75,
              }),
            );
          }
          cv.pts.forEach((pt, i) => {
            g.append(
              el("circle", {
                cx: CX(pt.cost), cy: CY(pt.rate), r: i === cv.at ? 4.5 : 3.5,
                fill: color, class: "dot",
              }),
            );
          });
          // One generous hit target per point, over the top of the marks.
          if (on) {
            cv.pts.forEach((pt) => {
              const hit = el("circle", {
                cx: CX(pt.cost), cy: CY(pt.rate), r: 11, fill: "transparent",
              });
              hit.addEventListener("mousemove", (ev) =>
                showTip(cv, pt, ev as MouseEvent),
              );
              hit.addEventListener("mouseleave", hideTip);
              g.append(hit);
            });
          }
          marks.append(g);

          const best = cv.pts[cv.at];
          const x = CX(best.cost), y = CY(best.rate);
          const { dx, dy, anchor } = placeLabel(cv, x, y, taken);
          const lg = el("g", { opacity: on ? 1 : 0.12 }) as SVGGElement;
          lg.append(
            el("line", {
              x1: x, y1: y,
              x2: x + dx - (anchor === "start" ? 3 : anchor === "end" ? -3 : 0),
              y2: y + dy - 4,
              stroke: color, "stroke-width": 1, opacity: 0.35,
            }),
          );
          const name = el("text", {
            x: x + dx, y: y + dy, "text-anchor": anchor,
            fill: color, class: "curve-label",
          });
          name.textContent = cv.name;
          // The effort level under the name is the level of THAT point — the
          // provider's own word, so the room can type it into an API call.
          const e2 = el("text", {
            x: x + dx, y: y + dy + 11, "text-anchor": anchor,
            fill: color, class: "curve-eff",
          });
          e2.textContent = best.eff;
          lg.append(name, e2);
          labels.append(lg);
        }
        // Labels last, so no curve is ever drawn over its own callout.
        benchSvg.append(marks, labels);
      }

      function drawBench() {
        if (!benchSvg) return;
        hideTip();
        benchSvg.textContent = "";
        fitPlot();
        benchSvg.setAttribute("viewBox", `0 0 ${VB.w} ${Math.round(VB.h)}`);
        drawCurves();
      }

      // Legend doubles as the family filter (click to isolate, click to release).
      FAMS.forEach((f) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "chip";
        b.style.setProperty("--c", f.color);
        b.textContent = f.key;
        b.addEventListener("click", () => {
          if (benchOn.has(f.key)) benchOn.delete(f.key);
          else benchOn.add(f.key);
          benchLegend
            ?.querySelectorAll<HTMLElement>(".chip")
            .forEach((c) =>
              c.classList.toggle("on", benchOn.has(c.textContent ?? "")),
            );
          benchLegend?.classList.toggle("filtered", benchOn.size > 0);
          drawBench();
        });
        benchLegend?.append(b);
      });
      drawBench();
      // The coordinate box follows the slide's box, so a resized window (or a
      // projector at a different aspect) has to redraw, not just rescale.
      let benchResize = 0;
      window.addEventListener("resize", () => {
        window.clearTimeout(benchResize);
        benchResize = window.setTimeout(drawBench, 150);
      });

      /* ══════════ CHAPTER 03 — the stop-point (#33) ═══════════════════════
         The bench chart reduced to one line and five prices. It reads off the
         SAME `CURVES` array as the slide before it, deliberately: there is no
         second dataset to keep in sync, and if the chart's numbers ever move,
         this slide moves with them — labels, tooltip and turn-over included.

         The whole argument is MARGINAL, not cumulative — "this level cost you
         €X more and bought you Y" — because cumulative spend is the claim the
         previous slide already made. The last level is the slide: 61% more
         money, 0.2 points less.

         NOTHING HERE IS A BUILD AND NOTHING IS INTERACTIVE. The chart draws
         once, complete, on entry, and the slide holds still while the room
         reads it. Every number on screen is DERIVED from the curve, so nobody
         has to re-transcribe a label when the data moves. */
      const STOP_CURVE = CURVES.find((c) => c.name === "claude-fable-5")!;
      const STOP = {
        VB: { w: 1240, h: 600 },
        X0: 120, XN: 1194, Y0: 520, YN: 70,
        // The plot is framed on this curve alone, so the shape of ONE model's
        // diminishing return fills the slide; the bench chart's shared scale
        // would squash it into the top-right corner. The y-range is tight on
        // purpose — the whole slide turns on a 0.2-point drop, and on the
        // previous slide's 0–80% axis that drop is under three pixels. The
        // axis is labelled and starts at a non-zero score, which is honest
        // here because the slide compares levels of one curve, not models.
        cMin: 0, cMax: 24, sMin: 58, sMax: 71,
      };
      const stopEur = (usd: number) => usd / USD_PER_EUR;
      const SX = (c: number) =>
        STOP.X0 + ((c - STOP.cMin) / (STOP.cMax - STOP.cMin)) * (STOP.XN - STOP.X0);
      const SY = (s: number) =>
        STOP.Y0 - ((s - STOP.sMin) / (STOP.sMax - STOP.sMin)) * (STOP.Y0 - STOP.YN);
      /** What level `i` cost ON TOP of level i−1, in euro, points and percent. */
      function stopStep(i: number) {
        const p = STOP_CURVE.pts;
        return {
          eur: stopEur(p[i].cost) - stopEur(p[i - 1].cost),
          pts: p[i].rate - p[i - 1].rate,
          pct: Math.round((p[i].cost / p[i - 1].cost - 1) * 100),
        };
      }
      const stopPtsLabel = (d: number) =>
        `${d > 0 ? "+" : "−"}${Math.abs(d).toFixed(1)} pts`;

      function buildStop(slide: HTMLElement) {
        const svg = slide.querySelector<SVGSVGElement>("[data-stop-svg]");
        if (!svg || svg.dataset.built) return;
        const pts = STOP_CURVE.pts;
        const last = pts.length - 1;

        // Axis furniture, deliberately thin: no grid on x, a light one on y.
        // The slide is a shape, not a chart to read values off. The x ticks
        // carry ROUND EURO values and sit at their true dollar position, so
        // nothing on screen is a converted-and-rounded number.
        for (const eur of [0, 5, 10, 15, 20]) {
          const t = el("text", { x: SX(eur * USD_PER_EUR), y: STOP.Y0 + 30, class: "tick mid" });
          t.textContent = "€" + eur;
          svg.append(t);
        }
        for (const sc of [58, 60, 62, 64, 66, 68, 70]) {
          svg.append(
            el("line", { x1: STOP.X0, x2: STOP.XN, y1: SY(sc), y2: SY(sc), class: "grid" }),
          );
          const t = el("text", { x: STOP.X0 - 14, y: SY(sc) + 6, class: "tick end" });
          t.textContent = sc + "%";
          svg.append(t);
        }
        svg.append(
          el("line", {
            x1: STOP.X0, x2: STOP.XN, y1: STOP.Y0, y2: STOP.Y0, class: "axis",
          }),
        );
        const xl = el("text", {
          x: (STOP.X0 + STOP.XN) / 2, y: STOP.Y0 + 58, class: "axis-label mid",
        });
        xl.textContent = "cost per task";
        // Both axes say what they are, the same way the bench chart says it —
        // the score rotated onto its own axis, opposite the cost title. Same
        // furniture, same room: the room has read this pair once already.
        const ym = (STOP.Y0 + STOP.YN) / 2;
        const yl = el("text", {
          x: 32, y: ym, class: "axis-label mid",
          transform: `rotate(-90 32 ${ym})`,
        });
        yl.textContent = "DeepSWE score";
        svg.append(yl);
        const head = el("text", { x: STOP.X0, y: 34, class: "plot-title" });
        // Spelled, not a numeral: it is prose on a wall, and the count comes
        // off the data so a re-transcribed curve can never make the title lie.
        const WORD = ["no", "one", "two", "three", "four", "five", "six"];
        head.textContent =
          `${STOP_CURVE.name} — one model, ${WORD[pts.length] ?? pts.length} levels of effort`;
        svg.append(xl, head);

        // Two paths, not one: the climb, then the level that turns over. The
        // dip is the slide's whole argument, so it is inked in the accent
        // rather than left to the eye to find in a single-colour line.
        const dOf = (from: number, to: number) =>
          pts
            .slice(from, to + 1)
            .map((pt, i) => `${i ? "L" : "M"} ${SX(pt.cost)} ${SY(pt.rate)}`)
            .join(" ");
        svg.append(el("path", { d: dOf(0, last - 1), fill: "none", class: "stop-line",
          "stroke-linecap": "round", "stroke-linejoin": "round" }));
        svg.append(el("path", { d: dOf(last - 1, last), fill: "none", class: "stop-line is-down",
          "stroke-linecap": "round", "stroke-linejoin": "round" }));

        // One label per point: what that level cost on top of the one before
        // it. Level 0 has no "before", so it carries its absolute price and
        // score instead — the baseline the rest is read against. The level's
        // NAME is not on the wall (low/medium/high…): the room reads the
        // shape and the prices, and the presenter says the names. Every label
        // sits DOWN AND RIGHT of its point, the one quarter the curve never
        // enters: it climbs left-to-right, so the space under the next
        // segment is always empty. The last one turns back to the left,
        // because there is no wall to its right.
        pts.forEach((pt, i) => {
          const down = i === last;
          // The last label hangs off the RIGHT WALL rather than off its own
          // point: the curve is flat by then, so a label under the point would
          // sit on the one before it. Anchored right, it clears the block
          // before it and still reads as the last point's own line.
          const x = down ? STOP.XN : SX(pt.cost) + 18;
          // Every number sits one short drop under its own dot — the name
          // line used to push it further away, and the last label further
          // still. The cheapest point sits low, close to the cost axis, so
          // its label rides beside the dot instead of under it.
          const y = SY(pt.rate) + (down ? 34 : i === 0 ? 26 : 34);
          const g = el("text", {
            x, y, class: "stop-label" + (down ? " is-down" : ""),
            "text-anchor": down ? "end" : "start",
          });
          const val = el("tspan", { x, class: "delta" });
          val.textContent = i
            ? `+${fmtEur(stopStep(i).eur)} → ${stopPtsLabel(stopStep(i).pts)}`
            : `${fmtEur(stopEur(pt.cost))} · ${pt.rate}%`;
          g.append(val);
          // The turn is the slide: the last level gets the sentence the other
          // four don't need, so nobody has to do the arithmetic on the wall.
          if (down) {
            const why = el("tspan", { x, dy: 26, class: "why" });
            why.textContent = `${stopStep(i).pct}% more money, less score`;
            g.append(why);
          }
          svg.append(g);
        });

        pts.forEach((pt, i) => {
          svg.append(el("circle", {
            cx: SX(pt.cost), cy: SY(pt.rate), r: 7,
            class: "stop-dot" + (i === last ? " is-down" : ""), "data-stop-dot": i,
          }));
        });
        // The ring marks WHERE THE SPENDING STOPS PAYING — the one point the
        // slide is about — so it is parked on the last level, not walked.
        svg.append(el("circle", {
          cx: SX(pts[last].cost), cy: SY(pts[last].rate), r: 14, class: "stop-marker",
        }));


        svg.dataset.built = "1";
      }

      // Sanity net: this slide's entire argument is that the LAST level costs
      // more and scores less. If the chart's data is ever re-transcribed and
      // that stops being true, the text is wrong and the slide must be redone.
      if (import.meta.env.DEV) {
        const p = STOP_CURVE.pts;
        const last = p[p.length - 1], prev = p[p.length - 2];
        if (!(last.cost > prev.cost && last.rate < prev.rate))
          console.warn("#33's stop-point slide: the curve no longer turns over");
      }

      // ── Chapter wash on entering a chapter divider ────────────────
      function runWash() {
        if (!wash) return;
        wash.classList.remove("run");
        void wash.offsetWidth;
        wash.classList.add("run");
      }

      // ── Scroll-driven narrative reveals ───────────────────────────
      document.querySelectorAll<HTMLElement>("[data-scroll-frame]").forEach((frame) => {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) =>
              e.target.classList.toggle("in", e.isIntersecting),
            );
          },
          { root: frame, threshold: 0.55 },
        );
        frame
          .querySelectorAll("[data-scroll-step]")
          .forEach((s) => io.observe(s));
      });

      /* ══════════════════════════════════════════════════════════════════
         CHAPTER A — tokens, credits, the cost dial (wayfinder #27)

         Three vanilla-TS islands, no new runtime dependency. Every one is a
         pure function of its markup plus module constants, so slide entry
         replays them identically with no stored state.
         ══════════════════════════════════════════════════════════════════ */

      const escapeHtml = (s: string) =>
        s.replace(/[<>&"]/g, (c) =>
          ({ "<": "&lt;", ">": "&gt;", "&": "&amp;", '"': "&quot;" })[c]!,
        );
      const reducedMotion = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /** Count a number into place. Formatter is fixed by the caller so the
          decimal width can't change mid-animation. */
      const countShown = new WeakMap<HTMLElement, number>();
      function countUp(
        el: HTMLElement,
        target: number,
        fmt: (n: number) => string,
        dur = 420,
      ) {
        const from = countShown.get(el) ?? 0;
        countShown.set(el, target);
        if (reducedMotion()) {
          el.textContent = fmt(target);
          return;
        }
        const t0 = performance.now();
        const step = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          el.textContent = fmt(from + (target - from) * (1 - Math.pow(1 - p, 3)));
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }

      // ── The input-billing ladder ──────────────────────────────────
      // Text lives in components/deck/BillLadder.astro; only the figures come
      // from here, so the ladder can never disagree with the bill table two
      // slides later. One ladder now — the vocabulary slide's only fragment
      // — but the write stays a querySelectorAll, so a second copy would fill
      // itself.
      (() => {
        const model = RATES[1]; // GPT-5.4 — the middle of the lineup
        const tokens = 1240;
        const aic = (tokens * model.input) / 1e6;
        const eur = eurOfAic(aic);
        const set = (sel: string, v: string) =>
          document
            .querySelectorAll<HTMLElement>(sel)
            .forEach((el) => (el.textContent = v));
        set("[data-bill-tokens]", fmtInt(tokens));
        set("[data-bill-rate]", `× ${fmtInt(model.input)} AIC per 1M · ${model.name}`);
        set("[data-bill-aic]", aic.toFixed(2));
        // Well below the capped decimal rule, so this uses the uncapped one —
        // same reasoning as slide 3's euro column.
        set("[data-bill-eur]", fmtEur(eur, eurSigDecimals(eur)));
      })();

      // ── A3: the vocabulary slide's chips + counter ─────────────────
      // The right panel is static markup (see the frontmatter): no renderer,
      // no rAF loop. All this controller does is break the visible prompt into
      // chips and put the token count above them.
      const tkSwap = document.querySelector<HTMLElement>("[data-tk-swap]");
      const tkChips = document.querySelector<HTMLElement>("[data-tk-chips]");
      const tkLiveN = document.querySelector<HTMLElement>("[data-tk-live-n]");

      // The billed prompt of the next slide, to the token. The question itself
      // is ~15 tokens; the rest is the attached report, which this slide
      // counts but never shows — the chips only ever show what is on screen.
      const TK_ATTACHED_TOTAL = 1240;

      /**
       * Draw whichever prompt the fragment currently shows. There is no entry
       * animation and no typing: the slide arrives finished, and the one
       * fragment swaps the sentence for the real prompt.
       */
      function renderLive() {
        if (!tkChips || !tkLiveN) return;
        const swapped = !!tkSwap?.classList.contains("visible");
        const msg = swapped ? tkSwap : document.querySelector<HTMLElement>("[data-tk-msg]");
        const raw = msg?.querySelector(".tk-msg-text")?.textContent || "";
        const toks = tokenize(raw.replace(/\s+/g, " ").trim());
        tkChips.innerHTML = toks
          .slice(-60)
          .map((t) => {
            const sp = t.text.startsWith(" ") ? " data-sp" : "";
            return `<span class="tk-chip"${sp}><span class="t">${escapeHtml(
              t.text.trimStart(),
            )}</span><span class="id">${t.id}</span></span>`;
          })
          .join("");
        const n = swapped ? TK_ATTACHED_TOTAL : toks.length;
        tkLiveN.textContent = fmtInt(n);
        countShown.set(tkLiveN, n);
      }

      // ── A5: the bill table ────────────────────────────────────────
      // Twelve rates and three token counts in one grid. The knob cells span
      // all four rows because the token count IS shared — the span is the
      // argument, so never render a knob per row.
      type DialKey = "input" | "cached" | "output";
      const DIAL_KEYS: DialKey[] = ["input", "cached", "output"];
      const DIAL_MAX: Record<DialKey, number> = {
        input: 400_000,
        cached: 2_000_000,
        output: 200_000,
      };
      // An afternoon of agent work, not one prompt (#25). Cached is the biggest
      // pile on screen on purpose: it's the chapter's thesis, visible before a
      // word is said. Every knob arrives near half travel so the room can push
      // it either way. Costs on arrival: EUR 0.37 / 1.85 / 2.00 / 3.33.
      const DIAL_PRESET: Record<DialKey, number> = {
        input: 200_000,
        cached: 1_200_000,
        output: 80_000,
      };
      const dial = { ...DIAL_PRESET };
      /** Which row the presenter is holding the room on. -1 is none. */
      let dialLit = -1;

      const billRows = document.querySelector<HTMLElement>("[data-bill-rows]");
      if (billRows) {
        // One knob cell per group, written into the FIRST row with rowspan=4.
        const knobCell = (k: DialKey) =>
          `<td class="bt-knob" rowspan="${RATES.length}">` +
          `<div class="bk" data-knob="${k}">` +
          `<div class="bk-track"><div class="bk-fill" data-knob-fill></div></div>` +
          `<b class="bk-val" data-knob-val>0</b>` +
          `<span class="bk-lab">tokens</span></div></td>`;
        billRows.innerHTML = RATES.map((m, i) => {
          const rate = (k: DialKey) =>
            `<td class="bt-rate">${fmtInt(m[k])}</td>` + (i === 0 ? knobCell(k) : "");
          return (
            `<tr data-bill-row="${i}">` +
            `<td class="bt-model">${m.name}</td>` +
            DIAL_KEYS.map(rate).join("") +
            `<td class="bt-aic" data-row-aic>0</td>` +
            `<td class="bt-eur" data-row-eur>&euro;0.00</td>` +
            `<td class="bt-mult" data-row-mult></td>` +
            `</tr>`
          );
        }).join("");
      }

      // Clicking a row lifts it and nothing else — the arithmetic is already on
      // screen four times over. It exists so the presenter's "start on Flash,
      // then reach for Opus" has something to click.
      billRows?.querySelectorAll<HTMLElement>("[data-bill-row]").forEach((tr) => {
        tr.addEventListener("click", () => {
          const i = Number(tr.dataset.billRow);
          dialLit = dialLit === i ? -1 : i;
          paintBillLit();
        });
      });
      function paintBillLit() {
        const host = document.querySelector<HTMLElement>("[data-bill-table]");
        host?.classList.toggle("has-lit", dialLit >= 0);
        host?.querySelectorAll<HTMLElement>("[data-bill-row]").forEach((tr) => {
          tr.classList.toggle("is-lit", Number(tr.dataset.billRow) === dialLit);
        });
      }

      /** AIC for one model at the current knob mix. */
      const billAic = (m: (typeof RATES)[number]) =>
        (dial.input * m.input + dial.cached * m.cached + dial.output * m.output) / 1e6;

      /** "1×", "9×" — trailing .0 dropped so the cheapest reads as a clean 1. */
      const fmtMult = (n: number) => n.toFixed(1).replace(/\.0$/, "") + "×";

      // The knobs are pointer-only by design (#25 round 3): no tab stop and no
      // key handling, so reveal keeps every arrow and the clicker never fights
      // a focused control. A keyboard reader gets the table at its arrival
      // state, which is a complete slide on its own.
      document.querySelectorAll<HTMLElement>("[data-knob]").forEach((el) => {
        const key = el.dataset.knob as DialKey;
        const step = DIAL_MAX[key] / 100;
        let dragging = false;
        let startY = 0;
        let startV = 0;
        el.addEventListener("pointerdown", (e) => {
          dragging = true;
          startY = e.clientY;
          startV = dial[key];
          el.setPointerCapture(e.pointerId);
          e.stopPropagation();
        });
        el.addEventListener("pointermove", (e) => {
          if (!dragging) return;
          const delta = ((startY - e.clientY) / 220) * DIAL_MAX[key];
          dial[key] = Math.max(
            0,
            Math.min(DIAL_MAX[key], Math.round((startV + delta) / step) * step),
          );
          renderDial(key);
        });
        el.addEventListener("pointerup", () => (dragging = false));
        el.addEventListener("pointercancel", () => (dragging = false));
        // A drag that starts on a track must not also count as a row click.
        el.addEventListener("click", (e) => e.stopPropagation());
      });

      let dialLitTimer = 0;
      /**
       * Repaint every live figure. `touched` names the knob the hand is on, so
       * its track and its term in the formula row glow for a moment.
       *
       * `animate` is off during a drag: the numbers stay glued to the hand,
       * which is the coupling that teaches. It's on once, on slide entry, where
       * the money climbs into place from zero.
       */
      function renderDial(touched?: DialKey, animate = false) {
        const costs = RATES.map(billAic);
        const cheapest = Math.min(...costs);

        document.querySelectorAll<HTMLElement>("[data-knob]").forEach((el) => {
          const key = el.dataset.knob as DialKey;
          const frac = dial[key] / DIAL_MAX[key];
          el.querySelector<HTMLElement>("[data-knob-fill]")!.style.height =
            `${frac * 100}%`;
          el.querySelector<HTMLElement>("[data-knob-val]")!.textContent = fmtInt(dial[key]);
          el.toggleAttribute("data-hot", touched === key);
        });
        document.querySelectorAll<HTMLElement>("[data-term]").forEach((el) => {
          el.classList.toggle("lit", (el.dataset.term as DialKey) === touched);
        });

        billRows?.querySelectorAll<HTMLElement>("[data-bill-row]").forEach((tr, i) => {
          const aic = costs[i];
          const eur = eurOfAic(aic);
          const dp = eurDecimals(eur);
          const aicEl = tr.querySelector<HTMLElement>("[data-row-aic]")!;
          const eurEl = tr.querySelector<HTMLElement>("[data-row-eur]")!;
          if (animate) {
            countUp(aicEl, aic, fmtAicWhole);
            countUp(eurEl, eur, (n) => fmtEur(n, dp));
          } else {
            countShown.set(aicEl, aic);
            countShown.set(eurEl, eur);
            aicEl.textContent = fmtAicWhole(aic);
            eurEl.textContent = fmtEur(eur, dp);
          }
          // Every knob at zero makes every model free and the ratio undefined —
          // show nothing rather than a made-up 1×.
          tr.querySelector<HTMLElement>("[data-row-mult]")!.textContent =
            cheapest > 0 ? fmtMult(aic / cheapest) : "";
        });

        window.clearTimeout(dialLitTimer);
        dialLitTimer = window.setTimeout(() => {
          document
            .querySelectorAll(".bt-formula .lit")
            .forEach((e) => e.classList.remove("lit"));
          document
            .querySelectorAll("[data-knob]")
            .forEach((e) => e.removeAttribute("data-hot"));
        }, 900);
      }
      function resetDial() {
        Object.assign(dial, DIAL_PRESET);
        dialLit = -1;
        paintBillLit();
        document
          .querySelectorAll<HTMLElement>("[data-row-aic],[data-row-eur]")
          .forEach((el) => countShown.set(el, 0));
        renderDial(undefined, true);
      }

      /* ══════════ CHAPTER 03 (2nd half) — context primitives ══════════════
         Fragment index selects the block: -1 is the summary panel, 0-7 pick a
         block. That makes the clicker's → walk the eight blocks with no custom
         binding, and clicking a block simply navigates to its fragment — so
         pointer and clicker share one state and can never disagree. ────── */

      function paintPrimitives(slide: HTMLElement, index: number) {
        slide.querySelectorAll<HTMLElement>("[data-prim-block]").forEach((b) => {
          const on = Number(b.dataset.primBlock) === index;
          b.classList.toggle("is-on", on);
          b.setAttribute("aria-pressed", String(on));
        });
        const key = index < 0 ? "summary" : String(index);
        slide
          .querySelectorAll<HTMLElement>("[data-prim-card]")
          .forEach((c) => c.classList.toggle("is-on", c.dataset.primCard === key));
        slide.classList.toggle("has-selection", index >= 0);
      }

      function syncPrimitives(slide: HTMLElement) {
        const shown = slide.querySelectorAll(
          "[data-prim-frag-row] .fragment.visible",
        ).length;
        paintPrimitives(slide, shown - 1);
      }

      /** Move reveal to the fragment that selects `index` (-1 = summary). */
      function selectPrimitive(slide: HTMLElement, index: number) {
        const idx = deck.getIndices(slide);
        deck.slide(idx.h, idx.v, index);
      }

      document.querySelectorAll<HTMLElement>("[data-primitives]").forEach((slide) => {
        slide.querySelectorAll<HTMLElement>("[data-prim-block]").forEach((b) =>
          b.addEventListener("click", () =>
            selectPrimitive(slide, Number(b.dataset.primBlock)),
          ),
        );
        slide
          .querySelector("[data-prim-clear]")
          ?.addEventListener("click", () => selectPrimitive(slide, -1));
      });

      /* ══════════ CHAPTER 03 (2nd half) — the session ═══════════════════
         Three turns, three presses. The bar starts PRE-FILLED with the harness
         baseline and grows downward; a bracket beside it spans everything sent
         on this turn, which is everything above the fill line.

         The turn is DERIVED from reveal's fragment state, never counted — that
         is what makes stepping back and re-entering replay correctly. There is
         NO other state: the sweep that once ran over the bar on a forward press
         is gone (Atil, 2026-08-27), and with it the last-painted-turn bookkeep
         it needed. The bracket carries the re-send on its own.
         ────────────────────────────────────────────────────────────────────── */

      function paintSession(slide: HTMLElement, turn: number) {
        slide.querySelectorAll<HTMLElement>("[data-se-row]").forEach((row) => {
          row.classList.toggle("is-on", Number(row.dataset.seRow) <= turn);
        });

        const col = slide.querySelector<HTMLElement>("[data-se-column]");
        if (!col) return;

        // Heights are solved against THIS frame, in pixels, so the pixel floor
        // under the small blocks is part of the sum rather than an error added
        // on top of it — and the floor itself shrinks on a short frame, so the
        // document never collapses to the height of a one-line turn. See
        // segSizer() in lib/asml-ai/session.ts.
        const sizeOf = segSizer(col.clientHeight);
        let fill = 0;
        col.querySelectorAll<HTMLElement>("[data-se-seg]").forEach((seg) => {
          // Baseline segments carry .base and are never switched off — the
          // session is part full before anyone types, which is half the lesson.
          const on =
            seg.classList.contains("base") ||
            Number(seg.dataset.seSegTurn) <= turn;
          const h = sizeOf(
            Number(seg.dataset.seSegTokens),
            seg.dataset.seSegKind as any,
          );
          seg.classList.toggle("is-on", on);
          seg.style.height = on ? `${h}px` : "0px";
          if (on) fill += h;
        });

        // Both of these are the SAME sum the loop just made, so the bracket
        // cannot drift from the fill and the hairline cannot drift from the
        // top of the conversation — no reading of a layout mid-transition.
        const hair = slide.querySelector<HTMLElement>("[data-se-hairline]");
        if (hair) {
          const segs = [...col.querySelectorAll<HTMLElement>("[data-se-seg]")];
          const base = segs
            .slice(0, Number(hair.dataset.seBaseline))
            .reduce(
              (n, sg) =>
                n + sizeOf(Number(sg.dataset.seSegTokens), sg.dataset.seSegKind as any),
              0,
            );
          hair.style.top = `${Math.round(base)}px`;
        }

        const bracket = slide.querySelector<HTMLElement>("[data-se-bracket]");
        if (bracket) {
          // At rest (turn -1) no Turn has happened, so the bracket is absent —
          // the bar is pre-filled, but nothing has been SENT yet.
          bracket.classList.toggle("is-on", turn >= 0);
          bracket.style.height = `${Math.round(fill)}px`;
        }
      }

      function syncSession(slide: HTMLElement) {
        const shown = slide.querySelectorAll(
          "[data-se-frag-row] .fragment.visible",
        ).length;
        paintSession(slide, shown - 1);
      }

      // The bracket is a pixel height, so a resized window (or a projector at a
      // different aspect) has to re-measure it, not just rescale it.
      let sessionResize = 0;
      window.addEventListener("resize", () => {
        window.clearTimeout(sessionResize);
        sessionResize = window.setTimeout(() => {
          document
            .querySelectorAll<HTMLElement>("[data-session]")
            .forEach(syncSession);
        }, 150);
      });

      // Sanity net for the figure the slide's whole argument rests on: the
      // pasted document has to stay the great majority of what is on screen.
      if (import.meta.env.DEV && TOTAL_TOKENS !== 16425)
        console.warn("session model drifted — re-check the document's share");
      if (import.meta.env.DEV && TURN_COUNT !== 3)
        console.warn("session turn count drifted from the slide three presses");

      // ══════════════════════════════════════════════════════════════════════
      //  Chapter 2 — the hallucination slide (#35). Two frames: the slide
      //  opens on four answers in one centred pile, and folds ONCE into two
      //  lanes. The fold is a measured transform, never a layout swap — see
      //  layoutStoch() and the note in theme-asml.css.
      // ══════════════════════════════════════════════════════════════════════

      function stochEl(tag: string, cls?: string, txt?: string) {
        const n = document.createElement(tag);
        if (cls) n.className = cls;
        if (txt != null) n.textContent = txt;
        return n;
      }

      function buildStoch(slide: HTMLElement) {
        if (slide.dataset.built === "1") return;
        const set = (sel: string, txt: string) => {
          const n = slide.querySelector<HTMLElement>(sel);
          if (n) n.textContent = txt;
        };
        set("[data-stoch-eyebrow]", STOCH.TEXT.eyebrow);
        set("[data-stoch-headline]", STOCH.TEXT.headline);
        set("[data-stoch-dek]", STOCH.TEXT.dek);
        set("[data-stoch-close-line]", STOCH.TEXT.closeLine);
        set("[data-stoch-q]", '"' + STOCH.PROMPT + '"');

        // The trace, with the frame the faithfulness answer contradicts
        // wrapped so it can light up on the fold. It must NOT be marked up
        // front — that would tell the room which answer to distrust.
        const t = slide.querySelector<HTMLElement>("[data-stoch-trace]");
        if (t) {
          t.textContent = "";
          STOCH.TRACE.forEach((ln, i) => {
            if (i) t.append(document.createTextNode("\n"));
            const hit = "manifest.ts:42";
            if (ln.includes(hit)) {
              const [pre, post] = ln.split(hit);
              t.append(document.createTextNode(pre));
              t.append(stochEl("b", undefined, hit));
              t.append(document.createTextNode(post));
            } else t.append(document.createTextNode(ln));
          });
        }

        const heads = slide.querySelector<HTMLElement>("[data-stoch-lane-heads]");
        if (heads) {
          heads.textContent = "";
          heads.append(stochEl("span", undefined, STOCH.TEXT.lanes.legit));
          heads.append(stochEl("span", "bad", STOCH.TEXT.lanes.halluc));
        }

        const wrap = slide.querySelector<HTMLElement>("[data-stoch-sorted]");
        if (wrap) {
          wrap.textContent = "";
          STOCH.ANSWERS.forEach((a, i) => {
            const bad = a.kind !== "legit";
            const card = stochEl("div", "card" + (bad ? " bad" : ""));
            card.dataset.bad = bad ? "1" : "";
            // One slot, two occupants that never coexist: the rank bar while
            // the four are a pile, the category once they are sorted.
            const slot = stochEl("div", "slot");
            const bar = stochEl("span", "bar");
            const fill = stochEl("i");
            fill.style.setProperty("--r", Math.round(STOCH.RANK[i] * 100) + "%");
            bar.append(fill);
            slot.append(bar, stochEl("span", "tag", STOCH.KINDS[a.kind]));
            card.append(slot);
            card.append(stochEl("p", undefined, a.text));
            card.append(stochEl("span", "tell", a.tell));
            card.style.transitionDelay = i * 80 + "ms";
            wrap.append(card);
          });
        }
        slide.dataset.built = "1";
        // Measures itself, so it must run after the browser has laid the
        // cards out — one frame later, not in this tick.
        requestAnimationFrame(() => layoutStoch(slide));
      }

      /**
       * The fold is the slide's whole argument, so it cannot be a grid-column
       * swap — that is a hard cut. Every card is half-width and absolutely
       * placed from the start; this measures both states and writes them as
       * CSS vars, so a single transform transition carries a centred pile
       * into two packed lanes.
       *
       * TWO measurements, because the states are different heights: the pile
       * with the tells collapsed (they don't exist on that frame) and the
       * lanes with them expanded, so an opening tell can never overlap the
       * card beneath it. Absolutely placed cards cannot push each other.
       */
      function layoutStoch(slide: HTMLElement) {
        const wrap = slide.querySelector<HTMLElement>("[data-stoch-sorted]");
        if (!wrap) return;
        const cards = [...wrap.querySelectorAll<HTMLElement>(".card")];
        if (!cards.length) return;
        const half = wrap.clientWidth / 2 + 11; // lane width + the gutter

        const measure = (expanded: boolean) => {
          if (expanded) slide.classList.add("is-measuring");
          const h = cards.map((c) => c.offsetHeight);
          slide.classList.remove("is-measuring");
          return h;
        };
        const hPile = measure(false);
        const hLane = measure(true);

        // The pile is tighter than the lanes: the stacked cards have to
        // clear the bottom edge at 900, and there is nothing between them to
        // read anyway.
        const gapPile = 7;
        const gapLane = 16;
        let pile = 0;
        const lane = [0, 0];
        cards.forEach((c, i) => {
          c.style.setProperty("--x0", half / 2 + "px");
          c.style.setProperty("--y0", pile + "px");
          pile += hPile[i] + gapPile;
          // Grounded left, hallucinated right, each packed from the top so
          // neither lane carries a hole where the other has a card.
          const l = c.dataset.bad ? 1 : 0;
          c.style.setProperty("--x1", (l ? half : 0) + "px");
          c.style.setProperty("--y1", lane[l] + "px");
          lane[l] += hLane[i] + gapLane;
        });
        wrap.style.setProperty("--h0", pile - gapPile + "px");
        wrap.style.setProperty("--h1", Math.max(lane[0], lane[1]) - gapLane + "px");
      }

      /** Derive the frame from reveal's fragment state — never from a counter. */
      function syncStoch(slide: HTMLElement) {
        // The answers are present from the moment the slide opens; `is-in`
        // only arms the entry stagger and is not a frame.
        slide.classList.add("is-in");
        slide.classList.toggle(
          "is-sorted",
          slide.querySelectorAll(".stoch-fold.visible").length >= 1,
        );
      }

      // ══════════════════════════════════════════════════════════════════════
      //  Chapter 2 — the hallucination diagnosis (#41). ONE fragment: the slide
      //  has no fragments, because arriving on it IS the interaction. It is
      //  built once, painted once, and REPLAYED by the deck's own `.is-live`
      //  (armHeadline drops the class from every section, forces a reflow and
      //  re-adds it to the live slide), exactly as the rings slide does.
      //
      //  Do not put the replay on a timer or a rAF: an earlier version did,
      //  and it ran the animation against reveal's slide transition instead
      //  of after it, so arrowing onto the slide landed on a finished diagram
      //  and only a page load ever showed it move.
      // ══════════════════════════════════════════════════════════════════════

      function halEl(tag: string, cls?: string, txt?: string) {
        const n = document.createElement(tag);
        if (cls) n.className = cls;
        if (txt != null) n.textContent = txt;
        return n;
      }

      /** One branch block: the name, one sentence of cause, one of fix, and
       *  the small-type pointer at the chapter that owns the fix. */
      function halBranch(b: (typeof HAL.BRANCHES)[number]) {
        const box = halEl("div", "halluc-branch");
        box.dataset.branch = b.key;
        // The name alone. A condition line here would only repeat what the
        // No/Yes on the diagram already says.
        const k = halEl("span", "k");
        k.append(halEl("span", undefined, b.name));
        box.append(k);
        // A newline starts a new paragraph; `backticks` inside one mark the
        // term set apart from the prose.
        b.cause.split("\n").forEach((para) => {
          const p = halEl("p", "cause");
          para.split("`").forEach((part, i) => {
            p.append(i % 2 ? halEl("em", "term", part) : document.createTextNode(part));
          });
          box.append(p);
        });
        const fix = halEl("p", "fix");
        fix.append(halEl("span", undefined, b.fix));
        box.append(fix);
        if (b.forward) box.append(halEl("span", "fwd", b.forward));
        return box;
      }

      function buildHalluc(slide: HTMLElement) {
        if (slide.dataset.built === "1") return;
        const set = (sel: string, txt: string) => {
          const n = slide.querySelector<HTMLElement>(sel);
          if (n) n.textContent = txt;
        };
        set("[data-halluc-eyebrow]", HAL.TEXT.eyebrow);
        set("[data-halluc-headline]", HAL.TEXT.headline);
        set("[data-halluc-close-line]", HAL.TEXT.closeLine);
        // The hinge is set on two lines in the SVG: it is the longest string
        // on the diagram and one line would set the viewBox's width.
        const cut = HAL.HINGE.lastIndexOf(" ", HAL.HINGE.length / 2 + 6);
        set("[data-fork-hinge-1]", HAL.HINGE.slice(0, cut));
        set("[data-fork-hinge-2]", HAL.HINGE.slice(cut + 1));
        // The nodes keep the BARE names — "hallucinations" is understood from
        // the root node three rows above, and would not fit anyway.
        set("[data-fork-name-1]", HAL.BRANCHES[0].key.toUpperCase());
        set("[data-fork-name-2]", HAL.BRANCHES[1].key.toUpperCase());
        set("[data-fork-route-1]", HAL.BRANCHES[0].edge);
        set("[data-fork-route-2]", HAL.BRANCHES[1].edge);
        set("[data-fork-fixed]", HAL.TEXT.fixed);

        // Dash length per edge, measured — hand-computed lengths drift the
        // moment a coordinate moves.
        slide.querySelectorAll<SVGPathElement>(".fork .edge").forEach((p) => {
          p.style.setProperty("--len", p.getTotalLength() + "px");
        });

        const wrap = slide.querySelector<HTMLElement>("[data-halluc-branches]");
        if (wrap) {
          wrap.textContent = "";
          HAL.BRANCHES.forEach((b) => wrap.append(halBranch(b)));
        }
        slide.dataset.built = "1";

        // Force a reflow before lighting anything, so the FIRST visit
        // animates too: without it the cards are created and lit inside one
        // task, the browser computes style once, and it lands straight on the
        // final values.
        void slide.offsetWidth;
        paintHalluc(slide);
      }

      /** Paint the finished state once. The CSS holds it at the opening state
       *  while the section is not `.is-live`, which is what makes every entry
       *  replay without anything being scheduled here. */
      function paintHalluc(slide: HTMLElement) {
        slide.classList.add("is-done");
        slide
          .querySelectorAll<HTMLElement>(".halluc-branch")
          .forEach((n) => n.classList.add("is-lit", "is-fixed"));
        slide
          .querySelectorAll<SVGElement>(".fork .edge, .fork .head, .fork .g")
          .forEach((n) => n.classList.add("is-drawn"));
      }

      // ── Wire the per-slide lifecycle (deterministic replay on entry) ──
      function onShow(slide: HTMLElement) {
        armHeadline(slide);
        updateChrome();
        if (slide.hasAttribute("data-chapter")) runWash();
        if (slide.hasAttribute("data-viz")) {
          resetBars(slide);
          window.setTimeout(() => growBars(slide), 160);
        }
        if (slide.hasAttribute("data-one-number")) playCount(slide);
        if (slide.hasAttribute("data-terminal")) playTerminal(slide);
        // Chapter 3's stop-point lands whole — no build, so entering it from
        // either side shows the same finished chart.
        if (slide.hasAttribute("data-stop")) buildStop(slide);
        // Chapter 2's hallucination slide opens ON its answers and folds
        // once; the frame comes off the fragment, so backward re-entry lands
        // on the sorted state instead of replaying.
        if (slide.hasAttribute("data-stoch")) {
          buildStoch(slide);
          syncStoch(slide);
        }
        // Chapter 2's diagnosis slide: built once, then replayed by the
        // `.is-live` armHeadline already added at the top of this function.
        if (slide.hasAttribute("data-halluc")) buildHalluc(slide);
        if (slide.hasAttribute("data-lottery")) {
          buildLottery(slide);
          // Match the visual to reveal's fragment state. Entering forward the
          // collapse fragment isn't shown yet (→ scattered); entering backward
          // from the next slide it's already shown (→ collapsed). Forcing
          // "before" here would desync the arrows (right would find no
          // fragment and skip the slide).
          const frag = slide.querySelector<HTMLElement>("[data-lottery-collapse]");
          setLottery(slide, !!frag?.classList.contains("visible"));
        }
        // Chapter 3's vocabulary slide re-derives its chips and counter from
        // the fragment state, so it lands right entering from either side.
        if (slide.hasAttribute("data-token-live")) renderLive();
        if (slide.hasAttribute("data-cost-dial")) resetDial();
        // Chapter 3's two islands read reveal's fragment state on entry, so
        // they replay from fragment 0 forwards and from the last fragment backwards.
        if (slide.hasAttribute("data-primitives")) syncPrimitives(slide);
        if (slide.hasAttribute("data-session")) syncSession(slide);
        if (slide.hasAttribute("data-scrolly")) {
          const frame = slide.querySelector<HTMLElement>("[data-scroll-frame]");
          if (frame) frame.scrollTop = 0;
        }
        // Chapter 4's smart zone: same contract as the chapter-3 islands — the
        // whole visual is re-derived from the fragment count, so entering from
        // either direction lands on the right state.
        if (slide.hasAttribute("data-smartzone")) syncSmartZone(slide);
        // Chapter 5's stack. Same contract again: both islands re-derive
        // everything from the fragment count, so entering from either
        // direction lands on the right state.
        if (slide.hasAttribute("data-ch5-step")) syncCh5Step(slide);
        if (slide.hasAttribute("data-wayfinder")) syncWayfinder(slide);
        // Keep the inline notes overlay in sync while it's open.
        if (notesEl && !notesEl.hasAttribute("hidden")) syncNotes();
      }

      deck.on("slidechanged", (e: any) => onShow(e.currentSlide as HTMLElement));
      deck.on("ready", (e: any) => onShow(e.currentSlide as HTMLElement));

      // The reliability scatter collapses on a fragment, replays on step-back.
      // Chapter 3's islands re-derive their whole state from the fragments on
      // every change, in both directions.
      function onFragment(e: any, shown: boolean) {
        const f = e.fragment as HTMLElement;
        if (f?.hasAttribute("data-lottery-collapse"))
          setLottery(f.closest("section") as HTMLElement, shown);
        const section = f?.closest("section") as HTMLElement | null;
        if (section?.hasAttribute("data-stoch")) syncStoch(section);
        if (section?.hasAttribute("data-token-live")) renderLive();
        if (section?.hasAttribute("data-primitives")) syncPrimitives(section);
        if (section?.hasAttribute("data-session")) syncSession(section);
        if (section?.hasAttribute("data-smartzone")) syncSmartZone(section);
        if (section?.hasAttribute("data-ch5-step")) syncCh5Step(section);
        if (section?.hasAttribute("data-wayfinder")) syncWayfinder(section);
      }
      deck.on("fragmentshown", (e: any) => onFragment(e, true));
      deck.on("fragmenthidden", (e: any) => onFragment(e, false));

      /* ══════════════════════════════════════════════════════════════════════
       *  CHAPTER 4 — the smart zone (#52).
       *
       *  Four fragments: the session fills, the blocks lose their colour, the
       *  brief loses its lines, and the gauge stays green and correct. The
       *  closing line is SPOKEN (Atil, 2026-08-25) — the widget never shows
       *  it, so there is no fifth fragment.
       *
       *  Holds no state of its own: everything is re-derived from reveal's
       *  fragment count, so ← and → replay correctly in both directions.
       * ═══════════════════════════════════════════════════════════════════ */

      function syncSmartZone(slide: HTMLElement) {
        const rail = slide.querySelector("[data-sz-frag-row]");
        const shown = rail ? rail.querySelectorAll(".fragment.visible").length : 0;
        const i = Math.min(shown, SZ.STATES.length - 1);
        const s = SZ.STATES[i];
        const q = <T extends HTMLElement>(sel: string) => slide.querySelector<T>(sel)!;

        // LINEAR against the advertised window, and it has to stay linear: a
        // log scale made the tank read ~68% full while the gauge above it read
        // 21%, which contradicts the slide's own argument. The band sitting
        // close to the left edge IS the point — a session can be deep in the
        // dumb zone with most of the window still free.
        const pct = (n: number) => (n / SZ.WINDOW) * 100;

        q("[data-sz-turn]").textContent =
          `${s.turn} · ${s.tokens.toLocaleString("en-US")} tokens in the session`;
        q("[data-sz-gauge]").textContent = s.gauge;
        q<HTMLElement>("[data-sz-fill]").style.width = `${pct(s.tokens)}%`;

        // Turn 1 holds still: the same tokens against the same tank is the
        // same width, on every press. ⚠ Do not size it against the fill — that
        // is a different percentage each time and it animates.
        q<HTMLElement>("[data-sz-mine]").style.width = `${pct(s.mine)}%`;

        const band = q<HTMLElement>("[data-sz-band]");
        band.style.left = `${pct(SZ.SOFT)}%`;
        band.style.width = `${pct(SZ.HARD) - pct(SZ.SOFT)}%`;
        q<HTMLElement>("[data-sz-mark-soft]").style.left = `${pct(SZ.SOFT)}%`;
        q<HTMLElement>("[data-sz-mark-hard]").style.left = `${pct(SZ.HARD)}%`;
        // The dumb zone starts where the band ends and runs to the far edge.
        q<HTMLElement>("[data-sz-dumb]").style.left = `${pct(SZ.HARD)}%`;
        // The three causes sit under the zone they explain, from the same mark.
        q<HTMLElement>("[data-sz-causes]").style.left = `${pct(SZ.HARD)}%`;

        // The window's contents. Each block arrives in its own colour and is
        // mixed toward the theme's pale grey as the session grows, so by the
        // last fragment they are indistinguishable from one another.
        const mix = (hex: string, t: number) => {
          const rgb = (h: string) => [1, 3, 5].map((k) => parseInt(h.slice(k, k + 2), 16));
          const [r1, g1, b1] = rgb(hex);
          const [r2, g2, b2] = rgb(SZ.PALE);
          const c = (a: number, b: number) => Math.round(a * t + b * (1 - t));
          return `rgb(${c(r1, r2)}, ${c(g1, g2)}, ${c(b1, b2)})`;
        };
        const field = q("[data-sz-blocks]");
        field.textContent = "";
        for (let b = 0; b < s.blocks; b++) {
          const el = document.createElement("i");
          el.className = "sz-block";
          el.style.background = mix(SZ.PALETTE[b % SZ.PALETTE.length], s.vivid);
          el.style.animationDelay = `${Math.min(b, 30) * 10}ms`;
          field.append(el);
        }

        slide.querySelectorAll<HTMLElement>("[data-sz-line]").forEach((el, n) => {
          el.classList.toggle("dead", n >= s.live);
        });
      }

      /* ══════════════════════════════════════════════════════════════════════
       *  CHAPTER 5 — the four picture Slides in the stack (#105).
       *
       *  `questions`, `slices`, `implement` and `review` all draw a picture
       *  that CHANGES ON EVERY PRESS, and none of them needs data: the whole
       *  difference is which state the CSS is in. So one function serves all
       *  four — it counts the Slide's visible `.ch5-step` fragments and writes
       *  the number to `data-step`, and every picture rule keys off that.
       *
       *  WHY INVISIBLE COUNTERS RATHER THAN FRAGMENTS ON THE PICTURE ITSELF:
       *  a picture state is rarely "one more element appears" — the test bar
       *  TURNS, the holes FILL, the hourglass NARROWS. Those are transitions
       *  between states, and a state is far easier to write as one CSS rule
       *  per step than as a pile of elements that fade over each other.
       *
       *  Holds no state of its own, so ← walks every picture back exactly.
       * ═══════════════════════════════════════════════════════════════════ */

      function syncCh5Step(slide: HTMLElement) {
        slide.dataset.step = String(
          slide.querySelectorAll(".ch5-step.visible").length,
        );
      }

      /* ══════════════════════════════════════════════════════════════════════
       *  CHAPTER 5 — the `wayfinder` Slide's map (#98 comp E, built by #105).
       *
       *  Nine tickets move between four columns across four steps. The board
       *  is re-rendered from `wayfinder-map.ts` on every fragment change, then
       *  FLIP puts the motion back: each ticket is measured BEFORE the repaint
       *  and slides from where it was to where it now is, so the room watches a
       *  ticket LEAVE Blocked rather than watching a table re-draw. A ticket
       *  that did not exist rises in instead, which is what makes the spawn on
       *  step 1 read as a spawn.
       *
       *  ⚠ REVEAL SCALES THE CANVAS, so the measured pixels are divided by
       *  `deck.getScale()` before they drive the transform. A build that
       *  forgets this gets drift at every viewport except 1600×900 (#98).
       *
       *  ⚠ HISTORY COMPRESSES, and it is not decoration: nine full cards run
       *  off the bottom of the canvas. A ticket closed on an EARLIER step drops
       *  to a one-line ledger row, and only the ones closing NOW show their
       *  answer. Without this the last two steps overflow.
       * ═══════════════════════════════════════════════════════════════════ */

      function syncWayfinder(slide: HTMLElement) {
        const board = slide.querySelector<HTMLElement>("[data-wf-board]");
        if (!board) return;
        const step = slide.querySelectorAll(".ch5-step.visible").length;
        const T = WFM.TICKETS;
        const slot = (k: string) =>
          slide.querySelector<HTMLElement>(`[data-wf-slot='${k}']`)!;
        const closedAt = (id: number, at: number) =>
          (T.find((t) => t.id === id)?.closed ?? 99) <= at;

        // ── Measure, so the repaint below can be un-done into a slide ──
        const before = new Map<string, DOMRect>();
        board
          .querySelectorAll<HTMLElement>("[data-tid]")
          .forEach((e) => before.set(e.dataset.tid!, e.getBoundingClientRect()));
        const firstPaint = before.size === 0;

        const card = (t: (typeof T)[number], state: string) => {
          if (state === "done" && t.closed < step) {
            return `<p class="wf-row ty-${t.type}" data-tid="t${t.id}"><span class="tick">closed</span><span class="id">#${t.id}</span><span class="q">${t.q}</span></p>`;
          }
          const blocker =
            state === "blocked" ? `<span class="blk">waits on #${t.blockedBy}</span>` : "";
          // A freed ticket says which ticket freed it, on the step it moves.
          const freed =
            state === "open" && t.blockedBy && closedAt(t.blockedBy, step)
              ? `<span class="freed">#${t.blockedBy} closed</span>`
              : "";
          const born = t.born && t.from === step ? `<span class="born">${t.born}</span>` : "";
          const ans = state === "done" ? `<span class="a">${t.a}</span>` : "";
          return `<div class="wf-card ${state} ty-${t.type}" data-tid="t${t.id}"><span class="head"><span class="ty">${t.type}</span><span class="id">#${t.id}</span></span><span class="q">${t.q}</span>${blocker}${freed}${born}${ans}</div>`;
        };

        const cols: Record<string, string[]> = { done: [], open: [], blocked: [] };
        for (const t of T) {
          if (t.from > step) continue;
          const state =
            t.closed <= step
              ? "done"
              : t.blockedBy && !closedAt(t.blockedBy, step)
                ? "blocked"
                : "open";
          cols[state].push(card(t, state));
        }
        slot("done").innerHTML = cols.done.join("");
        slot("open").innerHTML = cols.open.join("");
        slot("blocked").innerHTML =
          cols.blocked.join("") || `<p class="wf-empty">nothing waiting</p>`;

        // Fog: in scope, written down, not sharp enough to ask. A patch leaves
        // the column either by graduating into a ticket or by being ruled out
        // of scope — the second one is why this filters against OUT as well.
        slot("fog").innerHTML = WFM.FOG.filter(
          (f) => f.graduates < 0 || f.graduates > step,
        )
          .filter((f) => !WFM.OUT.some((o) => o.text === f.text && o.from <= step))
          .map((f) => `<p class="wf-fog" data-tid="f${f.text}">${f.text}</p>`)
          .join("");
        slot("out").innerHTML = WFM.OUT.filter((o) => o.from <= step)
          .map((o) => `<p class="wf-out" data-tid="o${o.text}">${o.text}</p>`)
          .join("");

        const open = cols.open.length,
          blocked = cols.blocked.length,
          done = cols.done.length;
        slide.querySelector<HTMLElement>("[data-wf-tally]")!.textContent =
          `${done + open + blocked} tickets · ${done} closed · ${blocked} blocked`;
        // The last beat: nothing left to decide, so the map goes orange and
        // hands itself to /to-spec.
        const finished = open + blocked === 0;
        slide.querySelector<HTMLElement>("[data-wf-map]")!.classList.toggle("ready", finished);
        board.classList.toggle("clear", finished);
        slide
          .querySelector<HTMLElement>("[data-wf-col='open']")!
          .classList.toggle("lit", open > 0);
        slide.querySelector<HTMLElement>("[data-wf-step]")!.innerHTML =
          WFM.STEPS[Math.min(step, WFM.STEPS.length - 1)];

        // ── Play: every ticket travels from where it was; new ones rise in ──
        const k = (deck as any).getScale?.() || 1;
        board.querySelectorAll<HTMLElement>("[data-tid]").forEach((e) => {
          const was = before.get(e.dataset.tid!);
          if (!was) {
            if (!firstPaint) e.classList.add("wf-in");
            return;
          }
          const now = e.getBoundingClientRect();
          const dx = (was.left - now.left) / k;
          const dy = (was.top - now.top) / k;
          if (Math.abs(dx) < 1 && Math.abs(dy) < 1) return;
          e.style.transition = "none";
          e.style.transform = `translate(${dx}px, ${dy}px)`;
          e.classList.add("wf-moving");
          requestAnimationFrame(() => {
            e.style.transition = "transform 520ms cubic-bezier(.2,.72,.2,1)";
            e.style.transform = "";
            window.setTimeout(() => e.classList.remove("wf-moving"), 540);
          });
        });
      }
    </script>
  </body>
</html>
