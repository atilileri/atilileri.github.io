/**
 * Chapter 4's cache slide (#56). Static — no widget, no island, so there is no
 * src/lib file: the only thing worth holding still is the arithmetic, and it is
 * three lines.
 *
 * The two price tags are DERIVED from chapter 3's rate card rather than typed,
 * so the deck can never disagree with itself — same Opus row, same AIC-per-1M
 * figures the cost dial shows two chapters earlier.
 *
 * The 1.25x cache-WRITE premium is deliberately absent from rates.ts (#21/#23:
 * off-screen everywhere in chapter 3, presenter notes only) and map #42 leaves
 * that decision open for the chapter-3 widget. It lives here, page-local, on
 * purpose: this slide is the ONE place in the deck where a rebuild price goes on
 * the wall, and it goes up as a rebuild — a thing that happened to a session —
 * never as a rate the room is asked to learn.
 *
 * The 12.5x-vs-10x gap the two tags open up is a deliberate trap (#56 dec. 7),
 * not an oversight. The answer is in the presenter note; do not pre-empt it on
 * screen with a "+25% write" annotation.
 */
import { MODELS, fmtInt } from "../../../lib/asml-ai/rates";

const CACHE_PREFIX_TOKENS = 100_000;
const CACHE_WRITE_MULTIPLIER = 1.25;
const cacheModel = MODELS.find((m) => m.id === "opus")!;
const cachePerM = CACHE_PREFIX_TOKENS / 1_000_000;
/** re-read the cached prefix: 5 AIC */
const cacheReRead = cacheModel.cached * cachePerM;
/** rebuild it from scratch — fresh input, billed as a cache write: 62.5 AIC */
const cacheRebuild = cacheModel.input * CACHE_WRITE_MULTIPLIER * cachePerM;
/** credits read whole where they are whole; the .5 is half the point */
const fmtCredits = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));

/**
 * Chapter 4's guardrails slide (#55) — the "without" wall. Static, no island.
 *
 * The mechanic is WHAT COMES BACK: the same check on both sides of the slide,
 * and the only variable is what the agent receives. So the two halves must be
 * the SAME RUN — the verdict's three tokens (FAIL, line 14, type mismatch) are
 * all findable in the noise, and if you edit one side you edit the other.
 *
 * This is a wall to be seen, not read: it is set at a size the room cannot
 * follow on purpose, and the count under it ("400 lines to read") is the point.
 * Deliberately NO numbers of the evidential kind on this slide — 11% → 18% is
 * the presenter's answer when challenged, never a caption (#55 dec. 3).
 *
 * The lines below are ordinary Node/Jest output because a wall of test noise is
 * the one thing every seat in the room has already seen. Nothing here is an
 * ASML file or an ASML result; the TU Delft + ASML study stays in the mouth and
 * off the wall (#50).
 */
const GUARD_VERDICT = ["FAIL", "line 14", "type mismatch"];
/** One coherent run, in order — NOT a shuffle. An earlier version scattered a
 *  pool of lines and it read as gibberish to anyone who looked closely: stack
 *  frames detached from their errors. The wall has to be genuinely unreadable
 *  because there is too much of it, not because it is nonsense. */
const guardNoise = [
