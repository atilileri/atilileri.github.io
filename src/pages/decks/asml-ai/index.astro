---
/**
 * /decks/asml-ai — the REAL presentation deck ("Getting the Most from AI").
 *
 * A duplicate of the capability showcase (/decks/showcase-for-asml), taken as the
 * starting point for the real slides: same approach (thin Astro shell + embedded
 * reveal.js, single-deck structure — wayfinder #11) and the same "ASML Editorial"
 * light theme (#12). The showcase stays put as the reference gallery; this deck
 * is the one that gets presented, so edit slide text here, not there.
 *
 * Standalone, full-viewport, no site chrome — deliberately does NOT use
 * BaseLayout. Decks are first-class routes: src/pages/decks/<slug>. This is /decks/asml-ai.
 * Fully static: reveal.js@5 + plugins bundle into the Astro JS chunk via Vite;
 * fonts self-hosted under /public/fonts. No CDN, no server, no secrets.
 */

// reveal.js base + our fresh light theme (import order = cascade order).
import "reveal.js/dist/reveal.css";
import "./theme-asml.css";

const promptCode = `// Token-aware prompt assembly
export function assemblePrompt(sections: Section[], budget: number) {
  const ranked = sections.sort((a, b) => b.priority - a.priority);
  let used = 0;
  const kept: Section[] = [];
  for (const s of ranked) {
    const cost = estimateTokens(s.body);   // ~chars / 4
    if (used + cost > budget) continue;    // drop low-priority overflow
    kept.push(s);
    used += cost;
  }
  return { prompt: kept.map((s) => s.body).join("\\n\\n"), used, budget };
}`;

const helperCode = `// The estimate every budget leans on
export function estimateTokens(text: string): number {
  // Cheap client-side proxy: ~4 chars per token for English prose.
  // A shipping deck would swap in a real BPE tokenizer here.
  return Math.ceil(text.length / 4);
}`;
// Chapter 3, second half ("Where the tokens go" — the deck's former chapter
// 04, folded in by #30). The agent loop's move script and number
// model live in src/lib so the markup below and the controller at the bottom
// read the SAME table. See the file header for what is locked and why.
import {
  STRATA,
  LINES,
  TURNS,
  BASELINE,
} from "../../../lib/asml-ai/session";

// The deck's Roadmap (#29/#30): chapter 1's roadmap slide and the
// dividers entering chapters 2–5 are the SAME component, so the four factors
// can never drift apart. Their labels live in src/lib/asml-ai/roadmap.ts —
// edit them there, not in the markup below.
import RoadmapDivider from "../../../components/deck/RoadmapDivider.astro";

// Chapter 5's Rail and its summary Slide (#103). The seven Stops, their
// commands and their detail lines live in src/lib/asml-ai/pipeline.ts — edit
// them there, not in the markup below, so the small Rail and the enlarged one
// can never disagree.
import PipelineRail from "../../../components/deck/PipelineRail.astro";
import ProcessSummary from "../../../components/deck/ProcessSummary.astro";
// The `wayfinder` Stop's picture (#98 comp E, built by #105). Its nine tickets
// and four steps live in src/lib/asml-ai/wayfinder-map.ts; the island near the
// bottom of this file paints the board from them.
import WayfinderMap from "../../../components/deck/WayfinderMap.astro";
import BillLadder from "../../../components/deck/BillLadder.astro";

// Chapter 4's smart-zone widget (#52). The session script and everything that
// is a decision rather than a number live in src/lib — read that file's header
// before changing what is on screen here.
import * as SZ from "../../../lib/asml-ai/smart-zone";

// Chapter 4's roll-back widget (#53). Same split as the smart zone: everything
// that is a decision rather than markup lives in src/lib — read that file's
// header before changing what is on screen here.
import * as RB from "../../../lib/asml-ai/roll-back";
// Chapter 2's two islands. Their eyebrow and headline are painted by the
// controller at the bottom of this file, but the headline is ALSO rendered
// server-side below: the roadmap divider builds its contents list from the
// real <h2> of each slide, and an empty one would leave a hole in the list.
import * as STOCH_TEXT from "../../../lib/asml-ai/stochastic";
import * as HAL_TEXT from "../../../lib/asml-ai/halluc";

import TurnCard from "../../../components/deck/TurnCard.astro";

/**
 * Chapter 4's cache slide (#56). Static — no widget, no island, and since
 * 2026-08-26 no numbers of its own either: the two price tags (100k re-read at
 * 5 credits against a 100k rebuild at 62.5) came off the wall on Atil's call,
 * and with them the derived constants that used to sit here.
 *
 * If the tags ever return, rebuild them from chapter 3's rate card rather than
 * typing the figures, so the deck can never disagree with itself: the Opus row
 * of MODELS, a 100k prefix, and a 1.25x cache-WRITE premium that is deliberately
 * absent from rates.ts (#21/#23: off-screen everywhere in chapter 3, presenter
 * notes only). The 12.5x-vs-10x gap the tags opened is a deliberate trap
 * (#56 dec. 7); the answer stays in the presenter note either way.
 */
import { MODELS, fmtInt } from "../../../lib/asml-ai/rates";
import { hash32, tokenize } from "../../../lib/asml-ai/tokenize";

/**
 * Chapter 3's vocabulary slide, right panel (#24 revised, Atil 2026-08-23).
 *
 * The rotating hash cloud is gone: its placement was a hash, so it could never
 * show WHY a position carries meaning, and the room spent the slide watching
 * it turn. What replaces it is one word traced all the way down — token, its
 * ID, the numbers that ID points at, and the words that sit nearest. Static,
 * one screen, no motion.
 *
 * Both the ID and the numbers are derived here at build time from the same
 * `hash32` the chips use, so the ID on the right always matches the chip on
 * the left. The neighbours are written by hand: a hash cannot produce them,
 * and inventing them in code would be the same dishonesty the cloud had.
 */
const EMBED_DIMS = 1536;
/** Six numbers of the 1,536, five head and one tail — the vector is elided. */
function pseudoVector(word: string): { head: string[]; tail: string } {
  const v = (i: number) => {
    const h = hash32(word + ":" + i);
    return (((h % 2000) / 1000 - 1) * 0.92).toFixed(2).replace("-0.00", "0.00");
  };
  return { head: [0, 1, 2, 3, 4].map(v), tail: v(EMBED_DIMS - 1) };
}
const embedWord = (word: string, near: string[]) => ({
  word,
  id: tokenize(word)[0].id,
  vec: pseudoVector(word),
  near,
});
/** The word is `budget`, because it is in the prompt the room is reading. */
const EMBED_A = embedWord("budget", ["cost", "spend", "invoice"]);

/**
 * Slide 7 — the context primitives. Eight blocks in three groups, text taken
 * verbatim from wayfinder #23's resolution. Two things here are decisions, not
 * wording, and must survive edits:
 *
 * 1. The first block is `Harness bundle`, not "system prompt" — it echoes the
 *    deck's Model / Harness / Skills / Environment rings slide, so `Harness`
 *    joins `Skills` as a term appearing at two altitudes, both true. That
 *    double appearance is the bridge, not a contradiction to fix.
 * 2. Token cost is QUALITATIVE — framed by *when* you pay, never a number.
 *    No first-party figure exists for the size of a harness bundle, a tool
 *    definition or a skill (#22), and #21 publishes rates but never volumes.
 *    Any number here would be invented.
 */
type PrimBlock = {
  label: string;
  /** parenthetical qualifier, e.g. "incl. reasoning" */
  sub?: string;
  contains: string;
  why: string;
  cost: string;
};
const primitiveGroups: { group: string; note: string; blocks: PrimBlock[] }[] = [
  {
    group: "Static",
    note: "Loaded before you say a word, and re-sent unchanged every turn.",
    blocks: [
      {
        label: "Harness bundle",
        contains:
          "The instructions that turn a model into an agent — how to use tools, when to stop, house rules.",
        why: "Without it you have a model, not an agent.",
        cost: "Paid on every single turn.",
      },
      {
        label: "Tools",
        contains:
          "A written description of every tool the agent may call, with its parameters.",
        why: "The model can only call what it’s been described.",
        cost: "Paid every turn — whether you use them or not.",
      },
      {
        label: "Skills",
        contains:
          "Your team’s procedures, loaded so the agent works the same way twice.",
        why: "This is what makes the output consistent instead of a lottery.",
        cost: "Paid on every turn it stays loaded.",
      },
      {
        label: "Project prompt",
        contains:
          "Facts about this project — conventions, architecture, what not to touch.",
        why: "Stops the agent rediscovering your codebase from scratch.",
        cost: "Paid on every turn.",
      },
    ],
  },
  {
    group: "Dynamic",
    note: "Produced by the turns themselves. It only ever grows.",
    blocks: [
      {
        label: "User prompt",
        contains: "What you actually asked for.",
        why: "The only part most people think they’re paying for.",
        cost: "Almost always the smallest block here.",
      },
      {
        label: "The conversation",
        contains: "Every previous turn, question and answer, replayed in full.",
        why: "The model has no memory. The transcript <em>is</em> the memory.",
        cost: "Grows every turn. Never shrinks.",
      },
      {
        label: "Tool results",
        contains:
          "Every file read, search result and command output the agent pulled in.",
        why: "The agent has to see what it found.",
        cost: "Usually the largest block, and the fastest-growing.",
      },
    ],
  },
  {
    group: "Reserved",
    note: "Room held back, so there is somewhere to answer.",
    blocks: [
      {
        label: "The answer",
        sub: "incl. reasoning",
        contains:
          "Room held back for the reply — and for the thinking that precedes it.",
        why: "The window has to have space left to answer in.",
        cost: "Billed as output — 5–6× the price of input.",
      },
    ],
  },
];

// Flat, in click / fragment order — the panel cards and the fragment row are
// indexed off this, so the two can never drift apart.
const primitives = primitiveGroups.flatMap((g) =>
  g.blocks.map((b) => ({ ...b, group: g.group })),
);

// Slide 8 — the session. The blocks and the transcript are server-rendered;
// their HEIGHTS are not, because they are solved against the frame the
// projector actually gives us (see segSizer in lib/asml-ai/session.ts).
const baselineBlocks = BASELINE.length;

