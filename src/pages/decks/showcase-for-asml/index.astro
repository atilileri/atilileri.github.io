---
/**
 * /decks/showcase-for-asml — the CAPABILITY SHOWCASE deck.
 *
 * Every locked capability exercised once, at its best, in the decided approach
 * (thin Astro shell + embedded reveal.js, single-deck spine — wayfinder #11)
 * and the "ASML Editorial" light theme (#12). NOTHING here is real talk
 * content: every headline, figure and code sample is placeholder demo material
 * whose only job is to show what a slide kind looks like (#10). The real deck
 * lives at /decks/asml-ai — it is designed against this gallery, picking the
 * slide kinds it needs. Never present this deck; present from that one.
 *
 * Standalone, full-viewport, no site chrome — deliberately does NOT use
 * BaseLayout. Decks are first-class routes: src/pages/decks/<slug>. This is /decks/showcase-for-asml.
 * Fully static: reveal.js@5 + plugins bundle into the Astro JS chunk via Vite;
 * fonts self-hosted under /public/fonts. No CDN, no server, no secrets.
 */

// reveal.js base + our fresh light theme (import order = cascade order).
import "reveal.js/dist/reveal.css";
import "./theme-asml.css";

// DEMO SAMPLE — placeholder code, chosen only because it steps well under
// data-line-numbers. Swap it for whatever the real deck needs to walk through.
const sampleCode = `// Sample: fit items into a fixed budget, highest priority first
export function fitToBudget(items: Item[], budget: number) {
  const ranked = items.sort((a, b) => b.priority - a.priority);
  let used = 0;
  const kept: Item[] = [];
  for (const it of ranked) {
    const cost = weigh(it);                // see the sub-slide below
    if (used + cost > budget) continue;    // drop low-priority overflow
    kept.push(it);
    used += cost;
  }
  return { kept, used, budget };
}`;

// DEMO SAMPLE — the helper the sub-slide drills into.
const sampleHelperCode = `// The one-line estimate the loop above leans on
export function weigh(item: Item): number {
  // Placeholder heuristic — a real deck swaps in the actual measure.
  return Math.ceil(item.body.length / 4);
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capability Showcase · Atil Ilerialkan</title>
    <meta
      name="description"
      content="Reference capability deck — every slide kind this web-presentation system can build, exercised once on placeholder demo content."
    />
  </head>
  <body>
    <!-- Persistent mono "instrument" chrome + keyboard legend + chapter wash.
         Populated / driven by the controller below. -->
    <div class="deck-chrome" aria-hidden="true">
      <div class="chrome-section">
        <b>&#9632;</b> <span data-chrome-section>Capability showcase</span>
      </div>
      <div class="chrome-progress">
        <span class="now" data-chrome-now>01</span> / <span data-chrome-total>00</span>
      </div>
    </div>
    <div class="deck-legend">
      <kbd>&larr;</kbd><kbd>&rarr;</kbd> move ·
      <kbd>&darr;</kbd> sub-slide ·
      <kbd>ESC</kbd> overview ·
      <kbd>s</kbd> notes ·
      <kbd>p</kbd> presenter ·
      <kbd>f</kbd> full ·
      <kbd>q</kbd> quit
    </div>
    <div class="chapter-wash" data-wash aria-hidden="true"></div>

    <!-- Inline presenter-notes overlay (native-proto style), toggled by "s".
         Shows the current slide's <aside class="notes"> text without leaving
         the deck. reveal's separate presenter window moves to "p". -->
