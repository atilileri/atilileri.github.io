---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("garden");

// Featured entries fill the bento at the top, in the order they declare.
const featured = entries
  .filter((e) => e.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// Everything else flows into the grid below: declared order first, then the
// most recently touched.
const rest = entries
  .filter((e) => !e.data.featured)
  .sort(
    (a, b) =>
      a.data.order - b.data.order ||
      b.data.lastUpdated.getTime() - a.data.lastUpdated.getTime()
  );

const statusLabel = {
  seedling: "Seedling",
  budding: "Budding",
  evergreen: "Evergreen",
};

const kindLabel = {
  project: "Project",
  deck: "Deck",
  note: "Note",
};

const monthYear = (d: Date) =>
  d.toLocaleDateString("en-GB", { month: "short", year: "numeric" });
---

<BaseLayout title="Digital Garden" currentPath="/garden">
  <div class="px-6 md:px-12 max-w-[1440px] mx-auto w-full min-w-0 overflow-x-clip">
    <!-- Hero Section -->
    <section class="mb-32 min-w-0">
      <div
        class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20 items-end min-w-0 [&>*]:min-w-0"
      >
        <div>
          <span class="block text-[0.75rem] uppercase tracking-[0.2em] font-bold mb-4 text-primary">Digital Garden</span>
          <h1 class="max-w-full text-[clamp(2.5rem,8vw,3.75rem)] md:text-8xl font-black tracking-tighter leading-[0.9] text-on-surface whitespace-nowrap">
            COLLECTED <br /> THOUGHTS
          </h1>
        </div>
        <div class="pb-2">
          <p class="text-on-surface-variant text-lg leading-relaxed w-full">
            Projects, decks and notes, at whatever stage they have reached. Some
            ship, some are still being argued with. Nothing here claims to be
            finished.
          </p>
        </div>
      </div>
    </section>

    <!-- Featured: Bento -->
    {
      featured.length > 0 && (
        <section class="mb-24 min-w-0">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-1 bg-surface-container-highest p-1 min-w-0 [&>*]:min-w-0">
            {featured.map((entry, i) => (
              <a
                href={entry.data.link ?? entry.data.github}
                class:list={[
                  "p-6 md:p-12 flex flex-col justify-between group min-w-0 transition-colors",
                  i === 0
                    ? "md:col-span-2 min-h-[420px] bg-surface-container-low"
                    : "bg-primary text-on-primary",
                ]}
              >
                <div class="flex justify-between items-start gap-4">
                  <span
                    class:list={[
                      "text-xs font-black tracking-widest",
                      i === 0 ? "text-primary" : "text-[rgba(255,255,255,0.7)]",
                    ]}
                  >
                    {String(i + 1).padStart(2, "0")} // {kindLabel[entry.data.kind].toUpperCase()}
                  </span>
                  <span
                    class:list={[
                      "material-symbols-outlined transition-opacity",
                      i === 0
                        ? "text-on-surface opacity-20 group-hover:opacity-100"
                        : "opacity-40 group-hover:opacity-100",
                    ]}
                  >
                    arrow_outward
                  </span>
                </div>
                <div class="mt-10">
                  <h2 class="text-2xl sm:text-3xl font-bold tracking-tight mb-4 max-w-full [overflow-wrap:break-word]">
                    {entry.data.title}
                  </h2>
                  <p
                    class:list={[
                      "text-sm leading-relaxed mb-6 max-w-2xl",
                      i === 0
                        ? "text-on-surface-variant"
                        : "text-[rgba(255,255,255,0.85)]",
                    ]}
                  >
                    {entry.data.description}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    <span
                      class:list={[
                        "text-[0.65rem] uppercase font-bold tracking-widest px-3 py-1",
                        i === 0
                          ? "bg-on-surface text-surface"
                          : "bg-[rgba(255,255,255,0.9)] text-primary",
                      ]}
                    >
                      {statusLabel[entry.data.status]}
                    </span>
                    {entry.data.tags.map((tag) => (
                      <span
                        class:list={[
                          "text-[0.65rem] uppercase font-bold tracking-widest border px-3 py-1",
                          i === 0
                            ? "border-on-surface/10"
                            : "border-[rgba(255,255,255,0.3)]",
                        ]}
                      >
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- The rest: uniform cards -->
    <section class="pb-32 min-w-0">
      <div class="mb-12">
        <h2 class="text-[0.75rem] uppercase font-black tracking-[0.3em] text-on-surface/40">
          Everything else
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-1 bg-surface-container-highest p-1 min-w-0 [&>*]:min-w-0">
        {
          rest.map((entry) => {
            const href = entry.data.link ?? entry.data.github;
            const Tag = href ? "a" : "div";
            return (
              <Tag
                href={href}
                class="bg-surface-container-low p-8 flex flex-col justify-between gap-8 group min-w-0 hover:bg-surface-container transition-colors"
              >
                <div class="min-w-0">
                  <div class="flex justify-between items-start gap-4 mb-6">
                    <span class="text-[0.65rem] font-black tracking-widest text-primary uppercase">
                      {kindLabel[entry.data.kind]}
                    </span>
                    {href && (
                      <span class="material-symbols-outlined text-on-surface opacity-20 group-hover:opacity-100 transition-opacity">
                        arrow_outward
                      </span>
                    )}
                  </div>
                  <h3 class="text-xl font-bold tracking-tight mb-4 max-w-full [overflow-wrap:break-word]">
                    {entry.data.title}
                  </h3>
                  <p class="text-sm leading-relaxed text-on-surface-variant">
                    {entry.data.description}
                  </p>
                </div>

                <div class="min-w-0">
                  <div class="flex flex-wrap gap-2 mb-4">
                    <span class="text-[0.65rem] uppercase font-bold tracking-widest px-3 py-1 bg-on-surface text-surface">
                      {statusLabel[entry.data.status]}
                    </span>
                    {entry.data.tags.map((tag) => (
                      <span class="text-[0.65rem] uppercase font-bold tracking-widest border border-on-surface/10 px-3 py-1">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <span class="text-[0.65rem] uppercase tracking-widest text-on-surface/40 font-bold">
                    Updated {monthYear(entry.data.lastUpdated)}
                  </span>
                </div>
              </Tag>
            );
          })
        }
      </div>
    </section>
  </div>
</BaseLayout>
