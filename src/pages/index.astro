---
import BaseLayout from "../layouts/BaseLayout.astro";

// Inline glyphs for the inventory tables; each value is the inside of a
// 24x24 stroke-only <svg>.
const icons: Record<string, string> = {
  snowboard: '<rect x="9" y="2" width="6" height="20" rx="3"/><path d="M9 8h6M9 16h6"/>',
  bindings: '<path d="M7 20V9a5 5 0 0 1 10 0v11"/><path d="M5 12h14M5 16h14"/>',
  boots: '<path d="M8 3v10l-3 3v5h13v-4l-6-3V3z"/><path d="M8 13h4"/>',
  pants: '<path d="M6 3h12l-1 18h-4l-1-10-1 10H7z"/><path d="M6 7h12"/>',
  suit: '<path d="M8 3h8l2 3-2 2v13h-3l-1-8-1 8H8V8L6 6z"/>',
  harness: '<rect x="3" y="9" width="18" height="6" rx="2"/><rect x="9" y="7" width="6" height="10" rx="1"/>',
  bar: '<path d="M3 9c3 5 15 5 18 0"/><path d="M3 9v4c3 5 15 5 18 0V9"/><path d="M12 14v2a2.5 2.5 0 1 0 2.5-2.5"/>',
  vest: '<path d="M8 3l4 3 4-3 3 2v16H5V5z"/><path d="M12 6v15"/>',
  wetsuit: '<path d="M8 3h8l2 3-2 2v13h-3l-1-8-1 8H8V8L6 6z"/><path d="M12 3v5"/>',
  helmet: '<path d="M4 16a8 8 0 0 1 16 0v2H4z"/><path d="M4 18h16"/><path d="M12 8v8"/>',
  shoes: '<path d="M3 16h8l4 2h6v3H3z"/><path d="M3 16v-5h4l2 3"/>',
  racket: '<ellipse cx="12" cy="8" rx="5" ry="6"/><path d="M12 14v7"/><path d="M7 8h10M12 2v12"/>',
  balls: '<circle cx="9" cy="14" r="5"/><path d="M4.2 12.5c3.2.6 5.7 3.1 6.4 6.3"/><circle cx="16.5" cy="7.5" r="4"/><path d="M12.8 6c2 .5 3.6 2.1 4.1 4.1"/>',
  case: '<rect x="6" y="2" width="12" height="20" rx="2"/><path d="M9 6h6M9 9h6"/>',
  cpu: '<rect x="7" y="7" width="10" height="10" rx="1"/><path d="M10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4"/>',
  gpu: '<rect x="2" y="7" width="20" height="10" rx="1"/><circle cx="8" cy="12" r="3"/><path d="M14 10h5M14 14h5"/>',
  ram: '<rect x="2" y="7" width="20" height="10" rx="1"/><path d="M6 7v10M10 7v10M14 7v10M18 7v10"/>',
};

const kits = [
  {
    name: "Alpine Kit_01",
    tag: "SNOWBOARD_SETUP",
    items: [
      { icon: "snowboard", component: "Snowboard", model: "Korua Apollo 157" },
      { icon: "bindings", component: "Bindings", model: "Rome Katana AW FASE" },
      { icon: "boots", component: "Boots", model: "Nidecker Kita (Ejack Camo)" },
      {
        icon: "pants",
        component: "Impact Pants",
        model: "Demon Zero RF Pants D3O",
      },
      {
        icon: "suit",
        component: "Snow Suit",
        model: "Oneskee Mark VI (Red/White, M)",
      },
    ],
  },
  {
    name: "Wave Kit_01",
    tag: "KITE_WAKE_SETUP",
    items: [
      {
        icon: "harness",
        component: "Harness",
        model: "Mystic Majestic 2024 (Trapeze, L, Black)",
      },
      {
        icon: "bar",
        component: "Spreader Bar",
        model: "Mystic Stealth Bar Gen 3 (320mm, L/XXL)",
      },
      {
        icon: "vest",
        component: "Impact Vest",
        model: "Prolimit Predator Impact Vest Frontzip (Navy, L)",
      },
      {
        icon: "wetsuit",
        component: "Wetsuit",
        model: "C-Skins NuWave Session 4/3 Frontzip (Black/Silver, M)",
      },
      {
        icon: "helmet",
        component: "Helmet",
        model: "Mystic Vandal Pro (M/L, Black)",
      },
    ],
  },
  {
    name: "Racquet Kit_01",
    tag: "PADEL_TENNIS_SETUP",
    items: [
      {
        icon: "shoes",
        component: "Shoes",
        model: "Asics Gel Resolution X All-Terrain (42.5, Black)",
      },
      {
        icon: "racket",
        component: "Racket",
        model: "Tecnifibre Wall Breaker 365 (Black)",
      },
      {
        icon: "balls",
        component: "Balls",
        model: "Tretorn Serie+ Padel Tour",
      },
    ],
  },
  {
    name: "Computation Unit_01",
    tag: "HOME_SERVER",
    items: [
      {
        icon: "case",
        component: "Case",
        model: "Fractal Design Meshify 2 Lite (White)",
      },
      {
        icon: "cpu",
        component: "CPU",
        model: "AMD Ryzen 5 7600 (6-Core/12-Thread)",
      },
      {
        icon: "gpu",
        component: "GPU",
        model: "RTX 4060 Ti 16GB (AI & Transcoding)",
      },
      { icon: "ram", component: "RAM", model: "Corsair Vengeance 32GB 5200MHz" },
    ],
  },
];
---

<BaseLayout title="Home" currentPath="/">
  <!-- Hero Section: Swiss Modernist Layout -->
  <section
    class="relative min-h-[max(calc(100vh-160px),700px)] flex items-center px-6 md:px-12 max-w-[1440px] mx-auto w-full min-w-0 overflow-x-clip overflow-y-visible"
  >
    <!-- Background Geometric Soul -->
    <div
      class="absolute right-[-10%] top-[10%] w-[600px] h-[600px] rounded-full geometric-accent opacity-90 mix-blend-multiply filter blur-[2px] dark:opacity-30"
    >
    </div>
    <div
      class="relative z-10 w-full min-w-0 grid grid-cols-12 gap-8 items-end [&>*]:min-w-0"
    >
      <div class="col-span-12 lg:col-span-8">
        <span
          class="label-md text-[0.75rem] uppercase tracking-[0.2em] text-primary font-bold mb-6 block"
          >01 / MANIFESTO</span
        >
        <h1
          class="max-w-[100%] text-[clamp(2.875rem,12vw,5rem)] md:text-[8rem] lg:text-[10rem] font-black leading-[0.85] tracking-[-0.05em] text-on-background mb-8 [overflow-wrap:anywhere]"
        >
          LESS IS<br />MORE.
        </h1>
        <p
          class="max-w-md text-lg leading-relaxed text-on-surface-variant font-medium"
        >
          A radical pursuit of objectivity and mathematical grid logic. We strip
          away the unnecessary to reveal the architectural soul of digital
          experiences.
        </p>
      </div>
      <!-- B&W Portrait with Sharp Edge -->
      <div
        class="col-span-12 lg:col-span-4 flex justify-end relative h-[500px]"
      >
        <div
          class="w-full h-full bg-surface-container-highest relative overflow-hidden border border-on-surface/15 group"
        >
          <img
            alt="Portrait of Atıl İlerialkan"
            class="w-full h-full object-cover object-[center_22%]"
            src="/prof.webp"
            width="1000"
            height="1334"
            fetchpriority="high"
            decoding="async"
          />
          <!-- Technical Overlay -->
          <div
            class="absolute top-4 left-4 bg-on-background text-surface text-[0.65rem] px-3 py-1 tracking-widest uppercase"
          >
            AUTHOR
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="bg-surface-container-highest py-32 px-6 md:px-12 border-y border-on-surface/5 overflow-x-clip"
  >
    <div class="max-w-[1440px] mx-auto w-full min-w-0">
      <div class="grid grid-cols-12 gap-8 md:gap-12 min-w-0 [&>*]:min-w-0">
      <div class="col-span-12 lg:col-span-4">
        <span
          class="label-md text-[0.75rem] uppercase tracking-[0.2em] text-primary font-bold mb-6 block"
          >02 / ETHOS</span
        >
        <h2 class="text-4xl font-black tracking-tighter uppercase mb-12">
          Core<br />Principles
        </h2>
      </div>

      <div
        class="col-span-12 lg:col-span-8 grid min-w-0 grid-cols-1 md:grid-cols-2 gap-16"
      >
        <!-- Principle 1: Fail Better -->
        <div class="space-y-6">
          <h3
            class="text-2xl font-bold tracking-tight uppercase border-b border-primary/20 pb-4"
          >
            Fail Better
          </h3>
          <blockquote
            class="text-xl italic font-serif text-on-surface-variant border-l-2 border-primary pl-6 py-2"
          >
            "Ever tried. Ever failed. No matter. Try again. Fail again. <span
              class="text-primary font-bold">Fail better.</span
            >"
            <footer
              class="text-sm font-sans uppercase tracking-widest mt-4 opacity-70"
            >
              — Samuel Beckett
            </footer>
          </blockquote>
          <p
            class="text-sm leading-relaxed text-on-surface-variant font-medium"
          >
            In an iterative world, failure is the most reliable data point. We
            don't view setbacks as terminal; we view them as essential
            refinements. By leaning into the discomfort of the "broken" and
            analyzing the wreckage, we ensure that every version of our work is
            more resilient and sophisticated than the last.
          </p>
        </div>

        <!-- Principle 2: Via Negativa -->
        <div class="space-y-6">
          <h3
            class="text-2xl font-bold tracking-tight uppercase border-b border-primary/20 pb-4"
          >
            Via Negativa
          </h3>
          <p class="text-xs font-bold tracking-[0.2em] text-primary uppercase">
            Excellence through Subtraction
          </p>
          <p
            class="text-sm leading-relaxed text-on-surface-variant font-medium"
          >
            Derived from the principle that we understand the world best by
            stripping away what is false or non-essential. In practice, this
            means focus is achieved not by adding features, but by removing the
            noise. We believe that the most robust systems are those that have
            been distilled to their core.
          </p>
        </div>

        <!-- Principle 3: The Pale Blue Dot -->
        <div
          class="col-span-1 md:col-span-2 space-y-6 pt-8 border-t border-on-surface/5"
        >
          <h3
            class="text-2xl font-bold tracking-tight uppercase border-b border-primary/20 pb-4"
          >
            The Pale Blue Dot
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
            <p
              class="text-xs font-bold tracking-[0.2em] text-primary uppercase"
            >
              Cosmic Perspective
            </p>
            <p
              class="text-sm leading-relaxed text-on-surface-variant font-medium"
            >
              Inspired by Carl Sagan’s reflection on our "mote of dust suspended
              in a sunbeam." This perspective is a reminder of our shared
              responsibility and the scale of our impact. In the vastness of the
              universe, our efforts should be directed toward building things
              that matter—fostering connection and preserving our only home.
            </p>
          </div>
        </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 03: SHOWCASE -->
  <section
    class="py-32 px-6 md:px-12 max-w-[1440px] mx-auto w-full min-w-0 overflow-x-clip border-b border-on-surface/5"
  >
      <div
        class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 gap-8"
      >
        <div>
          <span
            class="label-md text-[0.75rem] uppercase tracking-[0.2em] text-primary font-bold mb-6 block"
            >03 / SHOWCASE</span
          >
          <h2
            class="max-w-[100%] text-[clamp(2.25rem,8vw,3rem)] md:text-7xl font-black tracking-tighter uppercase leading-[0.9] [overflow-wrap:anywhere]"
          >
            Technical<br />Inventory
          </h2>
        </div>
        <p
          class="max-w-xs text-xs uppercase tracking-widest leading-relaxed text-on-surface-variant opacity-70"
        >
          A curated selection of specialized instruments maintained for peak
          performance in high-stakes environments.
        </p>
      </div>

      <div class="grid grid-cols-12 gap-8 md:gap-12 min-w-0 [&>*]:min-w-0">
        {
          kits.map((kit) => (
            <div class="col-span-12 lg:col-span-6 space-y-8">
              <div class="flex items-center gap-4">
                <h3 class="text-xl font-bold tracking-tight uppercase">
                  {kit.name}
                </h3>
                <span class="h-[1px] flex-1 bg-on-surface/10" />
                <span class="text-[0.7rem] font-mono opacity-50">
                  {kit.tag}
                </span>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-left text-[0.7rem] font-mono border-collapse">
                  <thead>
                    <tr
                      class="border-b border-on-surface/20 uppercase tracking-widest text-on-surface/60"
                    >
                      <th class="py-3 pr-4">Component</th>
                      <th class="py-3 pl-4">Model</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-on-surface/5">
                    {kit.items.map((item) => (
                      <tr>
                        <td class="py-4 pr-4 font-bold">
                          <span class="flex items-center gap-3">
                            <svg
                              class="w-4 h-4 shrink-0 text-primary"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                              set:html={icons[item.icon]}
                            />
                            <span>{item.component}</span>
                          </span>
                        </td>
                        <td class="py-4 pl-4">{item.model}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))
        }
      </div>
  </section>
</BaseLayout>
