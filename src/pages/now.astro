---
import BaseLayout from "../layouts/BaseLayout.astro";

// Everything on this page traces to docs/dutch/PROFILE.md, which is written
// with the learner in the room and corrected in place. If a claim here has no
// line there, it does not belong here.

const threads = [
  {
    icon: "language",
    period: "Ongoing",
    title: ["LEARNING", "DUTCH"],
    dot: "bg-tertiary",
    icon_color: "text-tertiary",
    rule: "border-tertiary",
    body: "An online course twice a week, on Monday and Thursday evenings, working through A0 to A2 material. The target is B1 — Staatsexamen NT2, Programma I. No exam booked, and no certificate yet.",
  },
  {
    icon: "smart_toy",
    period: "Since August 2026",
    title: ["BUILDING A", "TUTOR"],
    dot: "bg-primary",
    icon_color: "text-primary",
    rule: "border-primary",
    body: "Designing an agent-run Dutch practice that lives in this repository: one skill that teaches, reviews and publishes, a curriculum spine taken from the official CEFR descriptors, and a learner profile that grows only by asking first. Planned in public, one issue at a time.",
    link: { href: "/garden/", label: "See it in the garden" },
  },
  {
    icon: "sports_tennis",
    period: "Since 2026",
    title: ["PADEL,", "PROPERLY"],
    dot: "bg-primary-container",
    icon_color: "text-primary-container",
    rule: "border-primary-container",
    body: "Ten lessons in at Peakz Padel in Eindhoven, rating somewhere around 7–8, with a couple of weeks of classes still to run. Joining David Lloyd this month for the courts, the pool and whatever else is in there.",
  },
];

const sports = [
  {
    name: "Kitesurfing",
    level: "Intermediate",
    note: "Waterstarts, riding independently, starting to jump. Mostly Urla in Turkey; once at Ouddorp, near the Natural High surf shop.",
  },
  {
    name: "Snowboarding",
    level: "Confident",
    note: "On and off piste, and jumping. Korua Apollo 157, Rome Katana bindings, Nidecker Kita boots.",
  },
  {
    name: "Skiing",
    level: "Intermediate",
    note: "Learned in 2025. Comfortable on red pistes.",
  },
  {
    name: "Wakeboarding",
    level: "Intermediate",
    note: "Rides with either foot forward.",
  },
  {
    name: "Padel",
    level: "Rating 7–8",
    note: "Peakz Padel in Eindhoven, and Jack's Hustle. Currently taking classes.",
  },
  {
    name: "Football",
    level: "Sundays",
    note: "With a club in the Netherlands, when enough people turn up.",
  },
  {
    name: "Basketball",
    level: "Street, occasional",
    note: "Played at Karşıyaka Spor Kulübü in İzmir until university, and in the high-school team.",
  },
  {
    name: "American football",
    level: "Retired, 2009–2024",
    note: "Two seasons with the Eindhoven Raptors. National champion in 2010, 2011 and 2016.",
  },
];

const facts = [
  { label: "National titles", value: "3" },
  { label: "Years of American football", value: "15" },
  { label: "Dutch classes a week", value: "2" },
  { label: "Eindhoven 20K, once", value: "2:01" },
];
---

<BaseLayout title="Now" currentPath="/now">
  <div
    class="px-6 md:px-12 max-w-[1440px] mx-auto w-full min-w-0 overflow-x-clip overflow-y-visible"
  >
    <!-- Hero -->
    <header class="mb-32 grid grid-cols-12 gap-8 items-end min-w-0 [&>*]:min-w-0">
      <div class="col-span-12 md:col-span-8">
        <span class="text-[0.75rem] font-bold uppercase tracking-[0.2em] text-primary mb-6 block">STATUS REPORT / CURRENT PHASE</span>
        <h1 class="text-[clamp(3.5rem,10vw,8rem)] leading-[0.9] font-black tracking-tighter uppercase mb-8">
          ACTIVE<br />EVOLUTION
        </h1>
      </div>
      <div class="col-span-12 md:col-span-4 flex flex-col items-end pb-4 border-l-0 md:border-l border-on-surface/10 md:pl-12">
        <p class="text-on-surface-variant font-body text-lg leading-relaxed mb-6 text-right max-w-xs">
          What has my attention at the moment — a language I am behind on, a
          tutor I am building to fix that, and a long list of sports.
        </p>
        <div class="w-16 h-1 bg-primary"></div>
      </div>
    </header>

    <!-- Current threads -->
    <section class="relative grid grid-cols-1 md:grid-cols-12 gap-0 mb-40 min-w-0 [&>*]:min-w-0">
      <div class="hidden md:block absolute left-[50%] top-0 bottom-0 w-[1px] bg-on-surface/10 translate-x-[-0.5px]"></div>

      {
        threads.map((t, i) => {
          const right = i % 2 === 0;
          return (
            <>
              {!right && <div class="md:col-span-7 hidden md:block" />}
              <div
                class:list={[
                  "md:col-span-5 mb-24 relative",
                  right ? "md:text-right" : "pt-12",
                  i > 0 && right ? "pt-12" : "",
                ]}
              >
                <div
                  class:list={[
                    "hidden md:block absolute w-4 h-4 rounded-full z-10 ring-4 ring-background",
                    t.dot,
                    right
                      ? "right-[-24px] translate-x-[50%]"
                      : "left-[-24px] translate-x-[-50%]",
                    i === 0 ? "top-4" : "top-16",
                  ]}
                />
                <div
                  class:list={[
                    "flex items-center gap-4 mb-4",
                    right ? "md:flex-row-reverse" : "",
                  ]}
                >
                  <span class:list={["material-symbols-outlined text-4xl", t.icon_color]}>
                    {t.icon}
                  </span>
                  <span class="text-[0.75rem] font-bold uppercase tracking-[0.1em] text-on-surface/40">
                    {t.period}
                  </span>
                </div>
                <h2 class="text-4xl md:text-6xl font-black tracking-tight mb-6 uppercase leading-tight">
                  {t.title[0]}<br />{t.title[1]}
                </h2>
                <div
                  class:list={[
                    "p-8 bg-surface-container-low",
                    right ? "" : `border-l-4 ${t.rule}`,
                  ]}
                >
                  <p
                    class:list={[
                      "text-lg leading-relaxed text-on-surface-variant font-medium",
                      right ? "text-left md:text-right" : "",
                    ]}
                  >
                    {t.body}
                  </p>
                  {t.link && (
                    <a
                      href={t.link.href}
                      class="inline-flex items-center gap-2 mt-6 text-[0.7rem] font-black uppercase tracking-[0.2em] text-primary"
                    >
                      {t.link.label}
                      <span class="material-symbols-outlined text-base">arrow_forward</span>
                    </a>
                  )}
                </div>
              </div>
              {right && <div class="md:col-span-7 hidden md:block" />}
            </>
          );
        })
      }
    </section>

    <!-- Sports -->
    <section class="mb-40 min-w-0">
      <div class="grid grid-cols-12 gap-8 mb-12 items-end [&>*]:min-w-0">
        <div class="col-span-12 md:col-span-6">
          <span class="text-[0.75rem] font-bold uppercase tracking-[0.2em] text-primary mb-4 block">THE LONG LIST</span>
          <h2 class="text-[clamp(2rem,6vw,3.5rem)] font-black tracking-tighter uppercase leading-[0.9]">
            SPORTS,<br />HONESTLY RATED
          </h2>
        </div>
        <div class="col-span-12 md:col-span-6 md:pb-2">
          <p class="text-on-surface-variant leading-relaxed max-w-md">
            Board sports on water and snow, a racket, a ball, and fifteen years
            of a game nobody in the Netherlands expects a Turk to have played.
            Levels as they actually are, not as they would look better.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-1 bg-surface-container-highest p-1 min-w-0 [&>*]:min-w-0">
        {
          sports.map((s) => (
            <div class="bg-surface-container-low p-8 flex flex-col gap-3 min-w-0">
              <div class="flex items-baseline justify-between gap-4 flex-wrap">
                <h3 class="text-xl font-bold tracking-tight">{s.name}</h3>
                <span class="text-[0.65rem] uppercase font-bold tracking-widest px-3 py-1 bg-on-surface text-surface shrink-0">
                  {s.level}
                </span>
              </div>
              <p class="text-sm leading-relaxed text-on-surface-variant">{s.note}</p>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <!-- Signature band -->
  <section class="mt-40 bg-[#1b1b1b] px-6 py-14 md:p-24 relative overflow-x-clip overflow-y-hidden">
    <div
      class="absolute right-0 top-0 w-2/3 h-full opacity-20 pointer-events-none"
      style="background: conic-gradient(from 180deg at 50% 50%, #00327d 0deg, #651f00 360deg); filter: blur(100px);"
    >
    </div>
    <div class="relative z-10 max-w-3xl mx-auto md:mx-0 w-full min-w-0">
      <span class="text-[var(--color-primary-container)] font-bold tracking-[0.3em] text-xs uppercase mb-8 block">THE ARCHITECTURAL CORE</span>
      <h3 class="text-[#f9f9f9] text-4xl md:text-7xl font-black tracking-tighter mb-12 uppercase leading-[0.9]">
        EVERY UPDATE IS A <span class="text-[var(--color-primary)]">STRUCTURE</span> IN PROGRESS.
      </h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {
          facts.map((f) => (
            <div class="p-6 bg-white/5 backdrop-blur-md">
              <p class="text-[rgba(249,249,249,0.4)] text-[0.6rem] uppercase tracking-widest mb-2">
                {f.label}
              </p>
              <p class="text-[#f9f9f9] text-3xl font-black">{f.value}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
