---
import { getCollection, render } from "astro:content";
import Page from "../../../components/dutch/Page.astro";
import Reveal from "../../../components/dutch/Reveal.astro";
import HideColumn from "../../../components/dutch/HideColumn.astro";
import Split from "../../../components/dutch/Split.astro";
import Word from "../../../components/dutch/Word.astro";
import { formatDate, numbered, sessionNumbers } from "../../../lib/dutch/session";

export async function getStaticPaths() {
  const lessons = await getCollection("dutchLessons");
  return lessons.map((lesson) => ({ params: { slug: lesson.id }, props: { lesson } }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const number = (await sessionNumbers()).lesson.get(lesson.id);
---

<Page title={numbered(lesson.data.title, number)} description={lesson.data.description} kicker={`Ders · ${formatDate(lesson.data.date)}`}>
  <Content components={{ Reveal, HideColumn, Split, Word }} />
</Page>
