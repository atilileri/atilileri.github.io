---
import { getCollection, getEntry, render } from "astro:content";
import Page from "../../../components/dutch/Page.astro";
import { formatDate, inline, numbered } from "../../../lib/dutch/session";

export async function getStaticPaths() {
  const teksten = await getCollection("dutchTeksten");
  return teksten.map((tekst) => ({ params: { slug: tekst.id }, props: { tekst } }));
}

const { tekst } = Astro.props;
const { Content } = await render(tekst);
const words = (await Promise.all(tekst.data.items.map((id) => getEntry("dutchItems", id)))).filter(Boolean);
const session = await getEntry("dutchSessions", tekst.data.session);
const questions = (session?.data.prompts ?? []).filter((p) => tekst.data.prompts.includes(p.id));
---

<Page title={numbered(tekst.data.title, session?.data.number)} kicker={`Tekst · ${formatDate(tekst.data.date)}`}>
  <h2>Kelimeler</h2>
  <table>
    <thead><tr><th>Hollandaca</th><th>Türkçe</th><th>English</th></tr></thead>
    <tbody>
      {words.map((w) => (
        <tr>
          <td lang="nl">{w!.data.article && `${w!.data.article} `}{w!.data.nl}</td>
          <td>{w!.data.tr}</td>
          <td lang="en">{w!.data.en}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Metin</h2>
  <div lang="nl"><Content /></div>

  <h2>Özet</h2>
  <p set:html={inline(tekst.data.gist)} />

  {questions.length > 0 && (
    <>
      <h2>Sorular</h2>
      <ol>{questions.map((q) => <li set:html={inline(q.ask)} />)}</ol>
      <p>Cevaplar <a href={`/nederlands/session/${tekst.data.session}/`}>Session sayfasında</a>.</p>
    </>
  )}
</Page>
