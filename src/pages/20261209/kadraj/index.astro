---
/**
 * /20261209/kadraj/ — photo framing, "Kadraj" (#203; spec #192 "Photo
 * framing", stories 71–73; feel from the prototype #184, which Atıl played:
 * "defaults as built, forgiving radius").
 *
 * WHAT SHE SEES. Five of our photos, always the same five (the ones with a
 * Subject point, `subject` in `photos.json`), in a new order each Round
 * (`roundOrder`, review E4; the spec had them in a fixed order). Each fills a
 * dark stage with a white crop box over it, the whole photo at first, the
 * rule-of-thirds lines on. She moves and sizes the box and confirms with
 * Enter or "Kırp". There is no live score: the Subject point (*Odak
 * noktası*) stays hidden while she crops. On confirm the crop zooms to fill
 * the stage and the reveal draws the Subject point (orange dot), the
 * nearest thirds point (white ring) and the green 95% ring around it, with
 * the photo's score under the stage. Enter goes on; after the fifth, the
 * shell's result card shows the Round score and the five crops, each with
 * its score, the weakest tagged as the one that counts only 5%
 * (`FRAMING_WORST_SHARE`).
 *
 * KEYS (keyboard-first; the mouse works too):
 *   - arrows move the box (Shift: 5× faster);
 *   - Q or − shrinks, E or + grows, around the box's centre (Shift: faster);
 *   - X turns the box between landscape and portrait;
 *   - T hides or shows the thirds lines; R puts the whole photo back;
 *   - Enter crops; on the reveal, Enter or Space goes to the next photo;
 *   - mouse: drag inside the box to move it, a corner or an edge to resize
 *     it, the wheel zooms around its centre.
 *   Esc is the shell's (it asks first; a left Round scores nothing).
 *
 * HOW IT IS BUILT. Three layers:
 *   - `src/lib/bday26/kadraj.ts`: the crop box (every move, resize, turn and
 *     the 30% floor) and the score of one crop, pure and pinned under
 *     `node --test`. `framingScore` in `src/lib/bday26/scores.ts` makes the
 *     Round of five: 0.95 × mean of the best four + 0.05 × the worst.
 *   - `GameShell`: the start, confirm-leave and result screens, and the one
 *     `recordRound`. The five crops go in its `result` slot.
 *   - This page: one <img> placed in stage pixels, and an SVG overlay over
 *     it repainted from the core's box on every change (shade, thirds,
 *     handles; on the reveal the Subject point and rings). The script maps
 *     screen pixels to photo pixels and back and owns no rule.
 *
 * Photos come from `src/lib/bday26/photos.ts`; all five are fetched when the
 * page opens, so a photo is ready the moment it is needed. Sizes are read
 * off the loaded images, never hardcoded.
 */
import BdayLayout from "../../../layouts/BdayLayout.astro";
import GameShell from "../../../components/bday26/GameShell.astro";
import { gameById, PRIZE_BAR } from "../../../lib/bday26/catalogue";
import { PHOTOS } from "../../../lib/bday26/photos";
import { FRAMING_BEST, FRAMING_WORST_SHARE } from "../../../lib/bday26/scores";

const game = gameById("kadraj");
/** Photos in a Round: every photo with a Subject point. */
const PHOTO_COUNT = PHOTOS.filter((p) => p.subject).length;

const KEYS = [
  { key: "Fare", does: "İçinden sürükle: taşı · köşe ve kenardan: boyutlandır" },
  { key: "Tekerlek", does: "Büyüt / küçült" },
  { key: "← ↑ → ↓", does: "Taşı (Shift ile hızlı)" },
  { key: "Q / −  ·  E / +", does: "Küçült · büyüt" },
  { key: "X", does: "Yatay / dikey çevir" },
  { key: "T", does: "Üçte bir çizgileri" },
  { key: "R", does: "Kutuyu sıfırla" },
  { key: "Enter", does: "Kırp" },
  { key: "Esc", does: "Turdan çık" },
];

/** The Round formula, as she reads it on both cards. */
const RULE = `Skor: en iyi ${FRAMING_BEST} fotoğrafın ortalamasının %${100 - FRAMING_WORST_SHARE}'i + en düşük fotoğrafın %${FRAMING_WORST_SHARE}'i.`;
---

<BdayLayout title={`${game.name} · İyi ki doğdun Çağla!`}>
  <GameShell game="kadraj" keys={KEYS}>
    <span slot="hud" class="hud-line"><span>Fotoğraf <b data-index>1</b>/{PHOTO_COUNT}</span><span class="dots" data-dots></span></span>

    <div slot="start" class="note">
      <p>
        Beş fotoğrafımızı kırp. Her fotoğrafın bir <b>odak noktası</b> var: fotoğrafın asıl konusu. Onu üçte bir
        çizgilerinin dört kesişiminden birine ne kadar yaklaştırırsan puanın o kadar yüksek.
      </p>
      <p class="formula">{RULE}</p>
    </div>

    <div class="kadraj" data-kadraj>
      <div class="stage" data-stage>
        <img class="photo" data-photo alt="" draggable="false" />
        <svg class="overlay" data-overlay aria-hidden="true"></svg>
      </div>

      <div class="bar">
        <div class="legend" data-legend>
          <span><kbd>← ↑ → ↓</kbd> taşı</span>
          <span><kbd>Q</kbd> <kbd>E</kbd> boyut</span>
          <span><kbd>X</kbd> çevir</span>
          <span><kbd>T</kbd> çizgiler</span>
          <span><kbd>R</kbd> sıfırla</span>
        </div>
        <div class="reveal" data-reveal hidden>
          <b class="photo-score" data-photo-score>%0</b>
          <p class="why" data-why></p>
        </div>
        <button class="bd-btn primary" type="button" tabindex="-1" data-go>Kırp <kbd>Enter</kbd></button>
      </div>
    </div>

    <div slot="result" class="note">
      <div class="thumbs" data-thumbs></div>
      <p class="verdict" data-verdict></p>
      <p class="formula">{RULE}</p>
    </div>
  </GameShell>
</BdayLayout>

<script>
  import { one } from "../../../lib/bday26/dom";
  import { openLedger } from "../../../lib/bday26/browser";
  import { mountGameShell } from "../../../lib/bday26/shell";
  import { FRAMING_BEST, FRAMING_WORST_SHARE, framingScore } from "../../../lib/bday26/scores";
  import { PRIZE_BAR } from "../../../lib/bday26/catalogue";
  import { PHOTOS, photoUrl } from "../../../lib/bday26/photos";
  import {
    cropWord,
    drag,
    grabAt,
    grow,
    moveBy,
    nudge,
    reset,
    ringRadius,
    roundOrder,
    scoreCrop,
    shrink,
    startFraming,
    thirdsPoints,
    turn,
    zoom,
    type Crop,
    type CropScore,
    type Framing,
    type Handle,
    type Point,
    type Size,
  } from "../../../lib/bday26/kadraj";

  /** The wheel's zoom per notch (the prototype's). */
  const WHEEL_ZOOM = 1.03;
  /** How near a corner or edge a press must be to grab it, in screen pixels. */
  const CORNER_REACH = 16;
  const EDGE_REACH = 10;
  /** The space kept around the photo inside the stage, in screen pixels. */
  const MARGIN = 24;
  /** The reveal's zoom takes this long (CSS `.photo.zooming` matches). */
  const ZOOM_MS = 460;

  /** The five framing photos, in `photos.json` order; each Round deals them
   *  shuffled (`order`). */
  const FRAMING_PHOTOS = PHOTOS.flatMap((p) => (p.subject ? [{ file: p.file, subject: p.subject }] : []));

  const stage = one("[data-stage]");
  const img = one<HTMLImageElement>("[data-photo]");
  const overlay = one<SVGSVGElement>("[data-overlay]");
  const legend = one("[data-legend]");
  const revealBox = one("[data-reveal]");
  const photoScore = one("[data-photo-score]");
  const why = one("[data-why]");
  const go = one<HTMLButtonElement>("[data-go]");
  const indexEl = one("[data-index]");
  const dots = one("[data-dots]");
  const thumbs = one("[data-thumbs]");
  const verdict = one("[data-verdict]");

  // ---------------------------------------------------------- the photos
  // All five load as the page opens; a photo's size is its natural size.

  const loaded = new Map<string, Promise<Size>>();
  for (const { file } of FRAMING_PHOTOS) {
    const pre = new Image();
    pre.src = photoUrl(file);
    loaded.set(
      file,
      pre.decode().then(
        () => ({ w: pre.naturalWidth, h: pre.naturalHeight }),
        () => new Promise<Size>((ok) => (pre.onload = () => ok({ w: pre.naturalWidth, h: pre.naturalHeight }))),
      ),
    );
  }

  // ------------------------------------------------------------ the Round

  type Done = { file: string; photo: Size; crop: Crop; subject: Point; scored: CropScore };

  /** This Round's photos, in the order she meets them. */
  let order = FRAMING_PHOTOS;
  let idx = 0;
  let results: Done[] = [];
  /** The box on the current photo; undefined while the photo loads. */
  let framing: Framing | undefined;
  /** The current photo's Subject point, in its pixels. */
  let subject: Point = { x: 0, y: 0 };
  /** Confirmed: the reveal is up and the box takes no input. */
  let revealing = false;
  let thirdsOn = true;
  /** Bumped by every new photo and Round, so a late image load is dropped. */
  let ticket = 0;
  let zoomTimer = 0;

  async function beginPhoto() {
    const mine = ++ticket;
    const { file, subject: s } = order[idx]!;
    framing = undefined;
    revealing = false;
    window.clearTimeout(zoomTimer);
    overlay.classList.remove("hidden");
    revealBox.hidden = true;
    legend.hidden = false;
    go.innerHTML = "Kırp <kbd>Enter</kbd>";
    // Until the photo is in, there is no box: keys are dropped, and the
    // button says so by being disabled.
    go.disabled = true;
    paintHud();
    const photo = await loaded.get(file)!;
    if (mine !== ticket) return;
    img.src = photoUrl(file);
    subject = { x: s.x * photo.w, y: s.y * photo.h };
    framing = startFraming(photo);
    go.disabled = false;
    layout(false);
    paint();
  }

  function startRound() {
    order = roundOrder(FRAMING_PHOTOS, Math.random);
    idx = 0;
    results = [];
    thirdsOn = true;
    void beginPhoto();
  }

  function set(next: Framing) {
    if (revealing || !framing) return;
    framing = next;
    paint();
  }

  function confirmCrop() {
    if (revealing || !framing || shell.phase !== "playing") return;
    const scored = scoreCrop(framing.crop, subject);
    results[idx] = { file: order[idx]!.file, photo: framing.photo, crop: framing.crop, subject, scored };
    revealing = true;
    dragging = undefined;

    // The crop zooms to fill the stage; the marks come back once it lands.
    overlay.classList.add("hidden");
    layout(true);
    zoomTimer = window.setTimeout(() => {
      overlay.classList.remove("hidden");
      paint();
    }, ZOOM_MS);

    photoScore.textContent = `%${scored.score}`;
    photoScore.classList.toggle("win", scored.score >= PRIZE_BAR);
    why.innerHTML = `<b>${cropWord(scored.score)}.</b> ${
      scored.inside
        ? `Turuncu nokta odak noktası, beyaz halka en yakın kesişim. Yeşil alanın içi %${PRIZE_BAR} ve üstü.`
        : "Odak noktası kadrajın dışında kaldı."
    }`;
    legend.hidden = true;
    revealBox.hidden = false;
    go.innerHTML = `${idx + 1 < order.length ? "Sonraki fotoğraf" : "Sonuç"} <kbd>Enter</kbd>`;
    paint();
  }

  function next() {
    if (!revealing || shell.phase !== "playing") return;
    if (idx + 1 < order.length) {
      idx += 1;
      void beginPhoto();
      return;
    }
    revealing = false;
    const scores = results.map((r) => r.scored.score);
    const total = framingScore(scores);
    const n95 = scores.filter((s) => s >= PRIZE_BAR).length;
    paintThumbs(scores);
    // Under the bar the shell's card says what %95 asks (the prize hint).
    verdict.textContent = total >= PRIZE_BAR ? `${FRAMING_BEST} kare neredeyse kusursuz: %${PRIZE_BAR} tamam!` : "";
    verdict.hidden = total < PRIZE_BAR;
    verdict.classList.toggle("win", total >= PRIZE_BAR);
    shell.finish(total, { detail: `${n95}/${order.length} fotoğraf %${PRIZE_BAR} ve üstü` });
  }

  // ------------------------------------------------- photo ↔ stage pixels

  /** Stage pixels per photo pixel, and where the photo's (0, 0) sits. */
  let map = { s: 1, ox: 0, oy: 0 };
  const sx = (x: number) => map.ox + x * map.s;
  const sy = (y: number) => map.oy + y * map.s;

  /** Fit the whole photo (cropping) or the crop (reveal) into the stage. */
  function layout(animate: boolean) {
    if (!framing) return;
    const { width, height } = stage.getBoundingClientRect();
    const view = revealing ? framing.crop : { x: 0, y: 0, ...framing.photo };
    const aw = width - 2 * MARGIN;
    const ah = height - 2 * MARGIN;
    const s = Math.min(aw / view.w, ah / view.h);
    map = { s, ox: MARGIN + (aw - view.w * s) / 2 - view.x * s, oy: MARGIN + (ah - view.h * s) / 2 - view.y * s };
    img.classList.toggle("zooming", animate);
    img.style.left = `${map.ox}px`;
    img.style.top = `${map.oy}px`;
    img.style.width = `${framing.photo.w * s}px`;
    img.style.height = `${framing.photo.h * s}px`;
  }

  function toPhoto(event: PointerEvent | WheelEvent): Point {
    const r = stage.getBoundingClientRect();
    return { x: (event.clientX - r.left - map.ox) / map.s, y: (event.clientY - r.top - map.oy) / map.s };
  }

  // ----------------------------------------------------------- the paint

  function paintHud() {
    indexEl.textContent = String(idx + 1);
    dots.innerHTML = order.map((_, i) => {
      const r = results[i];
      const cls = r ? (r.scored.score >= PRIZE_BAR ? "dot hi" : "dot done") : i === idx ? "dot now" : "dot";
      return `<span class="${cls}">${r ? r.scored.score : i + 1}</span>`;
    }).join("");
  }

  function paint() {
    paintHud();
    if (!framing) {
      overlay.innerHTML = "";
      return;
    }
    const { width, height } = stage.getBoundingClientRect();
    const c = framing.crop;
    const x0 = sx(c.x);
    const y0 = sy(c.y);
    const w = c.w * map.s;
    const h = c.h * map.s;
    let g =
      `<defs><mask id="kadraj-hole"><rect width="100%" height="100%" fill="#fff"/>` +
      `<rect x="${x0}" y="${y0}" width="${w}" height="${h}" fill="#000"/></mask></defs>` +
      `<rect width="${width}" height="${height}" style="fill:var(--darkroom)" fill-opacity="${revealing ? 1 : 0.62}" mask="url(#kadraj-hole)"/>`;
    if (thirdsOn || revealing) {
      for (const f of [1 / 3, 2 / 3]) {
        g += `<line x1="${x0 + w * f}" y1="${y0}" x2="${x0 + w * f}" y2="${y0 + h}" class="third"/>`;
        g += `<line x1="${x0}" y1="${y0 + h * f}" x2="${x0 + w}" y2="${y0 + h * f}" class="third"/>`;
      }
    }
    g += `<rect x="${x0}" y="${y0}" width="${w}" height="${h}" class="frame"/>`;

    if (!revealing) {
      // Corner L-marks and edge ticks: where the mouse can take hold.
      const L = Math.min(24, w / 4, h / 4);
      const t = 4;
      for (const [cx, cy, dx, dy] of [
        [x0, y0, 1, 1],
        [x0 + w, y0, -1, 1],
        [x0, y0 + h, 1, -1],
        [x0 + w, y0 + h, -1, -1],
      ] as const) {
        g += `<path d="M${cx - (dx * t) / 2} ${cy + dy * L} V${cy - (dy * t) / 2} H${cx + dx * L}" class="handle"/>`;
      }
      const E = Math.min(18, w / 6, h / 6);
      g += `<line x1="${x0 + w / 2 - E}" y1="${y0}" x2="${x0 + w / 2 + E}" y2="${y0}" class="handle"/>`;
      g += `<line x1="${x0 + w / 2 - E}" y1="${y0 + h}" x2="${x0 + w / 2 + E}" y2="${y0 + h}" class="handle"/>`;
      g += `<line x1="${x0}" y1="${y0 + h / 2 - E}" x2="${x0}" y2="${y0 + h / 2 + E}" class="handle"/>`;
      g += `<line x1="${x0 + w}" y1="${y0 + h / 2 - E}" x2="${x0 + w}" y2="${y0 + h / 2 + E}" class="handle"/>`;
    } else {
      // The reveal: thirds points, the nearest ringed, its 95% zone, the Subject point.
      const r = results[idx]!.scored;
      const nx = sx(r.nearest.x);
      const ny = sy(r.nearest.y);
      for (const p of thirdsPoints(c)) {
        const isNear = p.x === r.nearest.x && p.y === r.nearest.y;
        g += `<circle cx="${sx(p.x)}" cy="${sy(p.y)}" r="${isNear ? 10 : 5}" class="point${isNear ? " near" : ""}"/>`;
      }
      g += `<circle cx="${nx}" cy="${ny}" r="${ringRadius(c) * map.s}" class="ring"/>`;
      const px = sx(subject.x);
      const py = sy(subject.y);
      g += `<line x1="${nx}" y1="${ny}" x2="${px}" y2="${py}" style="stroke: var(--bd-orange)" stroke-width="2.5" stroke-dasharray="6 5"/>`;
      g += `<circle cx="${px}" cy="${py}" r="11" style="fill: var(--bd-orange)" stroke="#fff" stroke-width="3"/>`;
    }
    overlay.innerHTML = g;
  }

  /** The five crops on the result card, each cut as she cut it. */
  function paintThumbs(scores: number[]) {
    const worst = scores.indexOf(Math.min(...scores));
    thumbs.innerHTML = results
      .map((r, i) => {
        const c = r.crop;
        const lines = [1 / 3, 2 / 3]
          .map(
            (f) =>
              `<line x1="${c.x + c.w * f}" y1="${c.y}" x2="${c.x + c.w * f}" y2="${c.y + c.h}"/>` +
              `<line x1="${c.x}" y1="${c.y + c.h * f}" x2="${c.x + c.w}" y2="${c.y + c.h * f}"/>`,
          )
          .join("");
        const dot = Math.hypot(c.w, c.h) * 0.03;
        return (
          `<figure class="thumb${i === worst ? " worst" : ""}">` +
          `<svg viewBox="${c.x} ${c.y} ${c.w} ${c.h}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Fotoğraf ${i + 1}">` +
          `<image href="${photoUrl(r.file)}" width="${r.photo.w}" height="${r.photo.h}"/>` +
          `<g class="thumb-thirds">${lines}</g>` +
          `<circle cx="${r.subject.x}" cy="${r.subject.y}" r="${dot}" class="thumb-dot"/></svg>` +
          `<figcaption><b class="${r.scored.score >= PRIZE_BAR ? "win" : ""}">%${r.scored.score}</b>` +
          `<span>${i === worst ? `en düşük · %${FRAMING_WORST_SHARE}` : ""}</span></figcaption></figure>`
        );
      })
      .join("");
  }

  const shell = mountGameShell({
    game: "kadraj",
    ledger: openLedger(),
    hooks: {
      startRound,
      abandonRound: () => {
        ticket += 1;
        window.clearTimeout(zoomTimer);
      },
    },
  });

  // ---------------------------------------------------------------- mouse

  let dragging: { grab: Handle | "move"; start: Point; from: Framing } | undefined;
  const CURSOR: Record<string, string> = {
    "1,1": "nwse-resize",
    "-1,-1": "nwse-resize",
    "1,-1": "nesw-resize",
    "-1,1": "nesw-resize",
    "1,0": "ew-resize",
    "-1,0": "ew-resize",
    "0,1": "ns-resize",
    "0,-1": "ns-resize",
  };
  const grabbing = (p: Point) =>
    framing && !revealing ? grabAt(framing.crop, p, CORNER_REACH / map.s, EDGE_REACH / map.s) : null;

  stage.addEventListener("pointerdown", (event) => {
    if (event.button !== 0 || !framing) return;
    const p = toPhoto(event);
    const grab = grabbing(p);
    if (!grab) return;
    event.preventDefault();
    stage.setPointerCapture(event.pointerId);
    dragging = { grab, start: p, from: framing };
  });
  stage.addEventListener("pointermove", (event) => {
    const p = toPhoto(event);
    if (!dragging) {
      const grab = grabbing(p);
      stage.style.cursor = !grab ? "default" : grab === "move" ? "move" : CURSOR[`${grab.dx},${grab.dy}`]!;
      return;
    }
    const { grab, start, from } = dragging;
    set(grab === "move" ? moveBy(from, p.x - start.x, p.y - start.y) : drag(from, from.crop, grab, p));
  });
  const endDrag = () => (dragging = undefined);
  stage.addEventListener("pointerup", endDrag);
  stage.addEventListener("pointercancel", endDrag);
  stage.addEventListener(
    "wheel",
    (event) => {
      if (!framing || revealing) return;
      event.preventDefault();
      set(zoom(framing, event.deltaY < 0 ? WHEEL_ZOOM : 1 / WHEEL_ZOOM));
    },
    { passive: false },
  );
  go.addEventListener("click", () => (revealing ? next() : confirmCrop()));

  window.addEventListener("resize", () => {
    layout(false);
    paint();
  });

  // ----------------------------------------------------------------- keys
  // The shell has taken Esc, and every key on its own screens; what arrives
  // here during a Round is hers.

  const ARROWS: Record<string, [number, number]> = {
    ArrowLeft: [-1, 0],
    ArrowRight: [1, 0],
    ArrowUp: [0, -1],
    ArrowDown: [0, 1],
  };
  window.addEventListener("keydown", (event) => {
    if (event.altKey || event.ctrlKey || event.metaKey) return;
    if (shell.phase !== "playing" || !framing) return;
    const key = event.key;
    if (revealing) {
      if ((key === "Enter" || key === " ") && !event.repeat) {
        event.preventDefault();
        next();
      }
      return;
    }
    const arrow = ARROWS[key];
    const k = key.toLowerCase();
    const fast = event.shiftKey;
    let handled = true;
    if (arrow) set(nudge(framing, arrow[0], arrow[1], fast));
    else if (k === "e" || k === "+" || k === "=") set(grow(framing, fast));
    else if (k === "q" || k === "-" || k === "_") set(shrink(framing, fast));
    else if (k === "x") set(turn(framing));
    else if (k === "r") set(reset(framing));
    else if (k === "t") {
      thirdsOn = !thirdsOn;
      paint();
    } else if (key === "Enter" && !event.repeat) confirmCrop();
    else handled = false;
    if (handled) event.preventDefault();
  });
</script>

<style>
  .kadraj {
    /* Viewport units, like the other photo Games: the playfield's grid row is
       `auto`, so a percentage height would let the photo set the size. 104 px
       is the HUD (64) and the playfield's padding (20 + 20). */
    width: 100%;
    height: calc(100vh - 104px);
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 14px;
  }

  /* ── the darkroom ────────────────────────────────────────────── */
  .stage {
    --darkroom: #221c1b;
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    background: var(--darkroom);
    user-select: none;
    touch-action: none;
  }
  .photo {
    position: absolute;
    display: block;
    max-width: none;
    pointer-events: none;
  }
  .photo.zooming {
    transition:
      left 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      top 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      width 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      height 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.2s;
  }
