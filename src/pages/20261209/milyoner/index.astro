---
/**
 * /20261209/milyoner/ — the Milyoner quiz (#198; spec #192 "Milyoner quiz",
 * stories 41–49; keys and jokers grilled on #182, the pool and the Round on
 * #185). Twelve questions, easy to hard, climbing a 12-rung ladder; one
 * wrong answer ends the Round.
 *
 * WHAT SHE SEES. The question on the left with its topic and band, the four
 * choices A–D under it; on the right the two jokers, the audience's bar
 * chart once she asks, and the ladder — rung 1 at the bottom, rung 12 at the
 * top, each with the score it is worth (`milyonerScore`: %8 … %100). No safe
 * levels, no timer, no walk-away (story 49).
 *
 * HOW SHE ANSWERS (#182, "Simple Games, shared keys" + the Milyoner lock):
 *   - 1–4, A–D or a click MARKS a choice; she may change it freely.
 *   - Enter asks "Son kararın mı?"; a second Enter (or "Evet") locks it.
 *     Esc, "Vazgeç" or another choice takes the question back. Clicking the
 *     marked choice again asks too, for the mouse.
 *   - The lock shows green or red at once; on a miss the right answer turns
 *     green beside her red one. The next question comes after 1.5 s, or at
 *     once on any key or click. After a miss that next step is the result:
 *     a wrong answer ends the Round (story 48).
 *   - Y = "Yarı yarıya", S = "Seyirciye sor", or their buttons; each once
 *     per Round. They work while she is choosing, not after the lock.
 *
 * HOW IT IS BUILT. Three layers, like "Bu nerede?":
 *   - `src/lib/bday26/milyoner.ts` is the quiz with no DOM: it reads the
 *     approved pool document, draws the Round (bands and topic mix of #185),
 *     and answers both jokers. Pinned under `node --test`.
 *   - `GameShell` is everything around the Round, and the one call that
 *     records it. Its Esc asks "Turdan çıkılsın mı?" — except while "Son
 *     kararın mı?" is open, where Esc means "Vazgeç": this page's capture
 *     listener is registered before the shell's, so it sees Esc first and
 *     keeps it only in that one state.
 *   - This page is the painter and the little state machine of one question
 *     (choosing → confirming → answered).
 *
 * THE POOL REACHES THE PAGE as the Markdown file itself:
 * `docs/bday26/milyoner-questions.md` is imported with Vite's `?raw` and
 * read by `parsePool` in the browser, so the approved document is the only
 * copy of the questions.
 */
import BdayLayout from "../../../layouts/BdayLayout.astro";
import GameShell from "../../../components/bday26/GameShell.astro";
import { gameById } from "../../../lib/bday26/catalogue";
import { milyonerScore } from "../../../lib/bday26/scores";

const game = gameById("milyoner");

const KEYS = [
  { key: "1 2 3 4", does: "Şıkkı işaretle" },
  { key: "A B C D", does: "Harfle de işaretleyebilirsin" },
  { key: "Enter", does: "Son kararını ver (iki kez)" },
  { key: "Y", does: "Yarı yarıya: iki yanlış gider" },
  { key: "S", does: "Seyirciye sor" },
  { key: "Herhangi bir tuş", does: "Sonraki soruya geç" },
  { key: "Esc", does: "Vazgeç ya da salona dön" },
];

const LETTERS = ["A", "B", "C", "D"];
/** Rung 12 at the top, as on the show. */
const RUNGS = Array.from({ length: 12 }, (_, i) => 12 - i);
---

<BdayLayout title={`${game.name} · İyi ki doğdun Çağla!`}>
  <GameShell game="milyoner" keys={KEYS}>
    <span slot="hud">Soru <b data-number>1</b>/12</span>
    <div class="stage" data-stage>
      <div class="main">
        <article class="question">
          <p class="tag"><span data-topic></span> · <span data-band></span></p>
          <h2 class="text" data-text></h2>
        </article>
        <ol class="choices" aria-label="Şıklar">
          {
            LETTERS.map((letter, i) => (
              <li>
                <button class="choice" type="button" tabindex="-1" data-choice={i}>
                  <kbd aria-hidden="true">{letter}</kbd>
                  <span class="label" data-label />
                </button>
              </li>
            ))
          }
        </ol>
        <div class="prompt" data-prompt>
          <p data-say="choose">Bir şık işaretle: <kbd>1</kbd>–<kbd>4</kbd> ya da <kbd>A</kbd>–<kbd>D</kbd></p>
          <p data-say="marked">İşaretledin. Kilitlemek için <kbd>Enter</kbd></p>
          <div data-say="confirm" class="confirm">
            <strong>Son kararın mı?</strong>
            <button class="bd-btn primary" type="button" tabindex="-1" data-act="lock">Evet <kbd>Enter</kbd></button>
            <button class="bd-btn ghost" type="button" tabindex="-1" data-act="cancel">Vazgeç <kbd>Esc</kbd></button>
          </div>
          <p data-say="right" class="verdict right">Doğru! <span>Devam için bir tuşa bas</span></p>
          <p data-say="wrong" class="verdict wrong">Yanlış… <span>Bitirmek için bir tuşa bas</span></p>
        </div>
      </div>

      <aside class="side">
        <div class="jokers">
          <button class="joker" type="button" tabindex="-1" data-joker="halve">
            <kbd>Y</kbd><span>Yarı yarıya</span>
          </button>
          <button class="joker" type="button" tabindex="-1" data-joker="audience">
            <kbd>S</kbd><span>Seyirciye sor</span>
          </button>
        </div>
        <figure class="audience" data-audience aria-label="Seyircinin oyları">
          {
            LETTERS.map((letter, i) => (
              <div class="bar">
                <span class="pct" data-pct={i}>0%</span>
                <span class="track">
                  <span class="fill" data-fill={i} />
                </span>
                <span class="who">{letter}</span>
              </div>
            ))
          }
        </figure>
        <ol class="ladder" aria-label="Basamaklar">
          {
            RUNGS.map((n) => (
              <li class="rung" data-rung={n}>
                <span class="n">{n}</span>
                <span class="worth">%{milyonerScore(n)}</span>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
  </GameShell>
</BdayLayout>

<script>
  import poolDocument from "../../../../docs/bday26/milyoner-questions.md?raw";
  import { openLedger } from "../../../lib/bday26/browser";
  import { mountGameShell } from "../../../lib/bday26/shell";
  import { askAudience, buildRound, halve, parsePool, type Question } from "../../../lib/bday26/milyoner";
  import { milyonerScore } from "../../../lib/bday26/scores";
  import { createAnswerStep } from "../../../lib/bday26/choice-quiz";

  const POOL = parsePool(poolDocument);

  const $ = <T extends Element = HTMLElement>(selector: string) => {
    const el = document.querySelector<T>(selector);
    if (!el) throw new Error(`bday26 milyoner: ${selector} is missing`);
    return el;
  };
  const stage = $("[data-stage]");
  const numberEl = $("[data-number]");
  const topicEl = $("[data-topic]");
  const bandEl = $("[data-band]");
  const textEl = $("[data-text]");
  const prompt = $("[data-prompt]");
  const audienceEl = $("[data-audience]");
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-choice]"));
  const rungs = Array.from(document.querySelectorAll<HTMLElement>("[data-rung]"));
  const halveButton = $<HTMLButtonElement>('[data-joker="halve"]');
  const audienceButton = $<HTMLButtonElement>('[data-joker="audience"]');

  /** One question's life: she picks, she is asked, she sees the answer. */
  type Step = "choosing" | "confirming" | "answered";

  let round: Question[] = [];
  let current = 0;
  let step: Step = "choosing";
  let marked: number | null = null;
  /** The choices "Yarı yarıya" took away from this question. */
  let gone: number[] = [];
  let hit = false;
  let halveUsed = false;
  let audienceUsed = false;
  /** The coloured answer stays a moment, then the next step (#182). */
  const answerStep = createAnswerStep(next, () => step === "answered");

  const question = () => round[current]!;

  /** Paints everything from the state above; every change calls it. */
  function paint() {
    const q = question();
    numberEl.textContent = String(q.number);
    topicEl.textContent = q.topic;
    bandEl.textContent = q.band;
    textEl.textContent = q.text;
    buttons.forEach((button, i) => {
      button.querySelector("[data-label]")!.textContent = q.choices[i] ?? "";
      button.classList.toggle("marked", marked === i);
      button.classList.toggle("gone", gone.includes(i));
      button.disabled = gone.includes(i);
      button.classList.toggle("right", step === "answered" && i === q.answer);
      button.classList.toggle("wrong", step === "answered" && !hit && i === marked);
    });
    stage.classList.toggle("answered", step === "answered");
    const say = step === "answered" ? (hit ? "right" : "wrong") : step === "confirming" ? "confirm" : marked == null ? "choose" : "marked";
    for (const el of prompt.querySelectorAll<HTMLElement>("[data-say]")) el.hidden = el.dataset.say !== say;
    halveButton.disabled = halveUsed;
    audienceButton.disabled = audienceUsed;
    for (const rung of rungs) {
      const n = Number(rung.dataset.rung);
      rung.classList.toggle("done", n < q.number || (n === q.number && step === "answered" && hit));
      rung.classList.toggle("now", n === q.number);
      rung.classList.toggle("missed", n === q.number && step === "answered" && !hit);
    }
  }

  function showAudience(bars: number[] | null) {
    audienceEl.classList.toggle("shown", bars != null);
    (bars ?? [0, 0, 0, 0]).forEach((pct, i) => {
      $(`[data-pct="${i}"]`).textContent = `${pct}%`;
      $(`[data-fill="${i}"]`).style.height = `${pct}%`;
    });
  }

  function startRound() {
    answerStep.cancel();
    round = buildRound(POOL, Math.random);
    current = 0;
    halveUsed = false;
    audienceUsed = false;
    newQuestion();
  }

  function newQuestion() {
    step = "choosing";
    marked = null;
    gone = [];
    hit = false;
    showAudience(null);
    paint();
  }

  function mark(i: number) {
    if (step === "answered" || gone.includes(i)) return;
    // On "Son kararın mı?" a click on the marked choice changes nothing.
    if (step === "confirming" && i === marked) return;
    // Clicking or pressing the marked choice again asks, like Enter.
    if (step === "choosing" && i === marked) return confirm();
    marked = i;
    step = "choosing";
    paint();
  }

  function confirm() {
    if (step !== "choosing" || marked == null) return;
    step = "confirming";
    paint();
  }

  function cancel() {
    if (step !== "confirming") return;
    step = "choosing";
    paint();
  }

  function lock() {
    if (step !== "confirming" || marked == null) return;
    hit = marked === question().answer;
    step = "answered";
    paint();
    answerStep.wait();
  }

  function next() {
    answerStep.cancel();
    if (step !== "answered") return;
    // Rungs climbed: every question before this one, and this one if right.
    const correct = question().number - (hit ? 0 : 1);
    if (!hit || current === round.length - 1) {
      shell.finish(milyonerScore(correct), {
        detail: correct === 12 ? "12/12 · Milyoner oldun!" : `${correct}/12 doğru`,
      });
      return;
    }
    current += 1;
    newQuestion();
  }

  function useHalve() {
    if (halveUsed || step === "answered") return;
    halveUsed = true;
    gone = halve(question(), Math.random);
    if (marked != null && gone.includes(marked)) marked = null;
    step = "choosing";
    paint();
  }

  function useAudience() {
    if (audienceUsed || step === "answered") return;
    audienceUsed = true;
    showAudience(askAudience(question(), Math.random, gone));
    paint();
  }

  // Esc on "Son kararın mı?" is "Vazgeç", not the shell's leave question.
  // Registered before `mountGameShell`, so on the same target and phase this
  // listener runs first; it keeps Esc only in that one state.
  window.addEventListener(
    "keydown",
    (event) => {
      if (event.key !== "Escape" || shell.phase !== "playing" || step !== "confirming") return;
      event.preventDefault();
      event.stopImmediatePropagation();
      cancel();
    },
    { capture: true },
  );

  const shell = mountGameShell({
    game: "milyoner",
    ledger: openLedger(),
    hooks: {
      startRound,
      abandonRound: answerStep.cancel,
      // The confirm-leave card over a coloured answer: the next step waits.
      pause: answerStep.pause,
      resume: answerStep.resume,
    },
  });

  // Buttons never take focus, so Enter is always the page's, never a
  // focused button's second click.
  stage.addEventListener("mousedown", (event) => event.preventDefault());
  stage.addEventListener("click", (event) => {
    if (step === "answered") return next();
    const target = event.target as Element;
    const choice = target.closest<HTMLElement>("[data-choice]");
    if (choice) return mark(Number(choice.dataset.choice));
    const act = target.closest<HTMLElement>("[data-act]")?.dataset.act;
    if (act === "lock") return lock();
    if (act === "cancel") return cancel();
    const joker = target.closest<HTMLElement>("[data-joker]")?.dataset.joker;
    if (joker === "halve") return useHalve();
    if (joker === "audience") return useAudience();
  });

  // The shell has already taken Esc (outside "Son kararın mı?") and every
  // key on its own screens; what arrives here is hers to play with.
  const CHOICE_KEY: Record<string, number> = { "1": 0, "2": 1, "3": 2, "4": 3, a: 0, b: 1, c: 2, d: 3 };
  window.addEventListener("keydown", (event) => {
    if (event.altKey || event.ctrlKey || event.metaKey || event.repeat) return;
    if (step === "answered") {
      event.preventDefault();
      next();
      return;
    }
    const key = event.key.toLowerCase();
    const i = CHOICE_KEY[key];
    if (i != null) mark(i);
    else if (key === "enter" && step === "confirming") lock();
    else if (key === "enter") confirm();
    else if (key === "y") useHalve();
    else if (key === "s") useAudience();
    else return;
    event.preventDefault();
  });
</script>

<style>
  .stage {
    /* Answer colours as on "Bu nerede?"; the gold of the show for "now". */
    --right: var(--bd-won);
    --right-bg: var(--bd-won-bg-2);
    --right-ink: var(--bd-won-deep);

    /* Viewport units for the same reason as "Bu nerede?": 104 px is the HUD
       (64) and the playfield's padding (20 + 20). */
    width: 100%;
    height: calc(100vh - 104px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 28px;
  }

  /* ── question and choices ───────────────────────────────────── */
  .main {
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto 72px;
    gap: 20px;
  }
  .question {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 22px;
    padding: 40px 72px;
    text-align: center;
    border-radius: 24px;
    background: var(--bd-paper);
    box-shadow:
      0 0 0 1px var(--bd-line),
      0 24px 60px -36px rgb(58 45 42 / 0.45);
  }
  .tag {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--bd-accent-deep);
  }
  .text {
    margin: 0;
    font-family: var(--bd-display);
    font-size: 54px;
    line-height: 1.2;
    text-wrap: balance;
    font-weight: 800;
    color: var(--bd-ink);
  }

  .choices {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .choices li {
    min-width: 0;
  }
  .choice {
    width: 100%;
    min-height: 96px;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 16px 22px;
    border: 0;
    border-radius: 18px;
    background: var(--bd-paper);
    box-shadow: 0 0 0 1.5px var(--bd-line);
    text-align: left;
    cursor: pointer;
    outline: none;
    transition:
      box-shadow 0.12s ease,
      background 0.12s ease,
      opacity 0.2s ease;
  }
  .choice:hover {
    box-shadow: 0 0 0 2px var(--bd-accent);
  }
  .choice kbd {
    flex: none;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    font-family: var(--bd-display);
    font-weight: 800;
    font-size: 24px;
    background: var(--bd-accent-soft);
    color: var(--bd-accent-deep);
  }
  .label {
    min-width: 0;
    font-size: 26px;
    line-height: 1.25;
    font-weight: 800;
    color: var(--bd-ink);
  }

  /* Marked, not locked: the show's gold. */
  .choice.marked {
    background: var(--bd-gift-bg);
    box-shadow: 0 0 0 3px var(--bd-gold);
  }
  .choice.marked kbd {
    background: var(--bd-gold);
    color: #fff;
  }
  /* Taken away by "Yarı yarıya": the slot stays, the words go. */
  .choice.gone {
    pointer-events: none;
    opacity: 0.25;
  }
  .choice.gone .label {
    visibility: hidden;
  }

  .stage.answered .choice {
    cursor: default;
    opacity: 0.45;
  }
  .stage.answered .choice.right,
  .stage.answered .choice.wrong {
    opacity: 1;
  }
  .choice.right {
    background: var(--right-bg);
    box-shadow: 0 0 0 3px var(--right);
  }
  .choice.right kbd {
    background: var(--right);
    color: #fff;
  }
  .choice.right .label {
    color: var(--right-ink);
  }
  .choice.wrong {
    background: var(--bd-wrong-bg);
    box-shadow: 0 0 0 3px var(--bd-wrong);
  }
  .choice.wrong kbd {
    background: var(--bd-wrong);
    color: #fff;
  }
  .choice.wrong .label {
    color: var(--bd-wrong-ink);
  }

  /* One line under the choices that says what Enter does now. */
  .prompt {
    display: grid;
    place-items: center;
    font-size: 22px;
    font-weight: 700;
    color: var(--bd-ink-soft);
  }
  .prompt > * {
    margin: 0;
  }
  .prompt [hidden] {
    display: none;
  }
  .prompt p kbd {
    padding: 2px 8px;
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.85em;
    background: var(--bd-track);
  }
  .confirm {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .confirm .bd-btn {
    font-size: 20px;
    padding: 10px 20px;
  }
  .confirm strong {
    font-family: var(--bd-display);
    font-size: 30px;
    color: var(--bd-ink);
  }
  .verdict {
    font-family: var(--bd-display);
    font-size: 32px;
    font-weight: 800;
  }
  .verdict span {
    margin-left: 12px;
    font-family: var(--bd-font);
    font-size: 18px;
    font-weight: 700;
    color: var(--bd-muted);
  }
  .verdict.right {
    color: var(--right-ink);
  }
  .verdict.wrong {
    color: var(--bd-wrong-ink);
  }

  /* ── jokers, audience, ladder ───────────────────────────────── */
  .side {
    min-height: 0;
    display: grid;
    grid-template-rows: auto 200px minmax(0, 1fr);
    gap: 16px;
  }
  .jokers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .joker {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border: 0;
    border-radius: 14px;
    background: var(--bd-paper);
    box-shadow: 0 0 0 1.5px var(--bd-line);
    font: inherit;
    font-size: 17px;
    font-weight: 800;
    color: var(--bd-ink);
    cursor: pointer;
    outline: none;
  }
  .joker:hover:not(:disabled) {
    box-shadow: 0 0 0 2px var(--bd-accent);
  }
  .joker kbd {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    font-family: var(--bd-display);
    font-size: 18px;
    background: var(--bd-accent-soft);
    color: var(--bd-accent-deep);
  }
  /* Used: crossed out, as on the show. */
  .joker:disabled {
    cursor: default;
    opacity: 0.4;
    text-decoration: line-through;
  }

  .audience {
    margin: 0;
    padding: 14px 18px 10px;
    border-radius: 16px;
    background: var(--bd-paper);
    box-shadow: 0 0 0 1.5px var(--bd-line);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    visibility: hidden;
  }
  .audience.shown {
    visibility: visible;
  }
  .bar {
    min-height: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    justify-items: center;
    gap: 6px;
  }
  .pct {
    font-size: 15px;
    font-weight: 800;
    color: var(--bd-ink-soft);
  }
  .track {
    width: 36px;
    height: 100%;
    display: flex;
    align-items: flex-end;
    border-radius: 8px;
    background: var(--bd-track);
    overflow: hidden;
  }
  .fill {
    width: 100%;
    height: 0;
    background: var(--bd-accent);
    border-radius: 8px 8px 0 0;
    transition: height 0.6s ease;
  }
  .who {
    font-family: var(--bd-display);
    font-weight: 800;
    font-size: 18px;
    color: var(--bd-accent-deep);
  }

  .ladder {
    list-style: none;
    margin: 0;
    padding: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: repeat(12, minmax(0, 1fr));
    gap: 4px;
  }
  .rung {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    border-radius: 10px;
    font-weight: 800;
    font-size: 19px;
    color: var(--bd-muted);
  }
  .rung .n {
    font-family: var(--bd-display);
    width: 2ch;
    text-align: right;
  }
  .rung[data-rung="12"] {
    color: var(--bd-gift-fg);
  }
  .rung.done {
    color: var(--right-ink);
    background: var(--bd-won-bg);
  }
  .rung.now {
    color: #fff;
    background: var(--bd-gold);
  }
  .rung.now.done {
    background: var(--right);
  }
  .rung.missed {
    background: var(--bd-wrong);
  }
</style>
