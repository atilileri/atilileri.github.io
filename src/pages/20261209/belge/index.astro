---
/**
 * /20261209/belge/ — the Proof, "Belge" (#197; spec #192 stories 91–95; the
 * shape was decided on #175). The page she prints, or saves as a PDF, to
 * claim what she holds: Atıl hands over what the Proof lists (glossary,
 * "Proof").
 *
 * WHAT IS ON THE PAPER, top to bottom, all Turkish: a greeting and today's
 * date written out ("9 Aralık 2026"); the Gifts she holds, each with its one
 * line; the Small prizes she won, each with the Game that gave it; the
 * Gifted points Atıl gave her with their sum ("Atıl'dan hediye puan: 500"),
 * only when there are any; the check
 * code in large letters with one line for Atıl on how he checks it; and the
 * full Save code in small monospace letters. Nothing else, so it reads at a
 * glance and fits one A4 page (story 92).
 *
 * HOW ATIL CHECKS IT (story 93, #175). There is no server and no check page:
 * he puts the paper next to her live screen, opens this page there, and
 * compares the two check codes — the same six characters mean the same
 * facts. The full Save code is on the paper so the paper is also her last
 * backup (story 94): pasted into "Geri yükle" it restores this very state.
 * The Proof is optional; a Small prize won in front of him needs no paper
 * (story 95).
 *
 * HOW IT IS BUILT. The markup is the paper's fixed text, rendered at build
 * time; everything that comes from HER progress is filled by the client
 * script from one call, `proofOf(openLedger(), new Date())`
 * (`src/lib/bday26/proof.ts`). The script lays out what that returns — a
 * list item per Gift and per prize, the date, the check code, the code — and
 * computes no rule of its own: which Gifts are held and which prizes are won
 * are the ledger's answers, and the Save code is the ledger's `toSaveCode()`,
 * so the code here is character for character the code Yedekle shows on the
 * hub. The lists are built on the client rather than rendered whole and
 * hidden, so a slow script shows an empty list for a moment, never a wrong
 * one.
 *
 * PRINT RULES (spec, "Save code and Proof"). `@media print` hides the UI (the
 * back link and the "Yazdır" button, class `ui`) and drops the screen's card
 * and cream ground, so the paper is the page; `@page { size: A4 portrait }`
 * with margins; every block carries `break-inside: avoid`; no meaning rides
 * on a background colour — the headings say what each list is, and a won
 * prize is simply listed, not coloured. The Save code is small monospace
 * with `overflow-wrap: anywhere`, since base64url has no natural break and
 * must wrap, never overflow. To keep the paper to ONE A4 page however much
 * she won (review H1), print sets every item on one line without its
 * description (a gift from Atıl keeps its note on that line), the Small
 * prizes in two columns, and the Save code smaller. The smoke prints the
 * fullest Proof (4 Gifts, 9 Small prizes, a gift from Atıl) to PDF and
 * counts one page.
 *
 * EMPTY STATE. Nothing held, nothing won: each list gives way to one line
 * ("Henüz …"), and the date, the check code and the code still print — a
 * fresh start is a state worth backing up too.
 */
import BdayLayout from "../../../layouts/BdayLayout.astro";
---

<BdayLayout title="Belge · İyi ki doğdun Çağla!">
  <div class="page">
    <nav class="tools ui" aria-label="Araçlar">
      <a class="bd-btn ghost" href="/20261209/">← Salona dön</a>
      <button class="bd-btn primary" type="button" data-print>Yazdır</button>
    </nav>

    <main class="paper">
      <header class="head">
        <p class="eyebrow">Belge</p>
        <h1 class="title">İyi ki doğdun, Çağla!</h1>
        <p class="date">
          <span class="label">Tarih</span>
          <span class="date-value" data-date></span>
        </p>
        <p class="greeting">
          Bu kâğıt, oyun salonunda kazandıklarının listesi. Burada ne yazıyorsa Atıl onu teslim eder.
        </p>
      </header>

      <section class="block" aria-labelledby="gifts-heading">
        <h2 class="h2" id="gifts-heading">Sendeki hediyeler</h2>
        <ul class="items" aria-labelledby="gifts-heading" data-gifts></ul>
        <p class="empty" data-gifts-empty hidden>Henüz hediye yok — dükkân seni bekliyor.</p>
      </section>

      <section class="block" aria-labelledby="prizes-heading">
        <h2 class="h2" id="prizes-heading">Kazandığın küçük ödüller</h2>
        <ul class="items" aria-labelledby="prizes-heading" data-prizes></ul>
        <p class="empty" data-prizes-empty hidden>Henüz küçük ödül yok — bir oyunda %95 yapınca buraya yazılır.</p>
      </section>

      <section class="block" aria-labelledby="gifted-heading" data-gifted hidden>
        <h2 class="h2" id="gifted-heading">Hediye puanlar</h2>
        <ul class="items" aria-labelledby="gifted-heading" data-gifted-list></ul>
        <p class="gifted-total" data-gifted-total></p>
      </section>

      <section class="block check" aria-labelledby="check-heading">
        <div class="check-text">
          <h2 class="h2" id="check-heading">Kontrol kodu</h2>
          <p class="for-atil">
            Atıl için: bu kodu Çağla'nın ekranındaki Belge sayfasının koduyla karşılaştır. Aynıysa kâğıt geçerli.
          </p>
        </div>
        <p class="check-code" data-check></p>
      </section>

      <section class="block" aria-labelledby="code-heading">
        <h2 class="h2" id="code-heading">Yedek kodu</h2>
        <p class="note">
          Bu kâğıt aynı zamanda son yedeğin: kodu salondaki "Geri yükle"ye yazarsan buradaki ilerlemen geri gelir.
        </p>
        <p class="code" data-code></p>
      </section>
    </main>
  </div>
</BdayLayout>

<script>
  // The Proof's one job on the client: lay out what `proofOf` returns. No
  // rule is computed here; every name, the date and both codes come from the
  // ledger through that one function (spec #192 "Modules").
  import { openLedger } from "../../../lib/bday26/browser";
  import { proofOf, type Proof } from "../../../lib/bday26/proof";

  function $(selector: string): HTMLElement {
    const el = document.querySelector<HTMLElement>(selector);
    if (!el) throw new Error(`bday26 proof: missing ${selector}`);
    return el;
  }

  /** One item on the paper: the name, a tag beside it (the Game, for a
   *  Small prize), and its one line under. Built with textContent: the
   *  catalogue text is ours, but the DOM never parses it as markup. */
  function item(name: string, desc: string, tag?: string): HTMLLIElement {
    const li = document.createElement("li");
    const head = document.createElement("div");
    head.className = "item-head";
    const strong = document.createElement("b");
    strong.textContent = name;
    head.append(strong);
    if (tag) {
      const span = document.createElement("span");
      span.className = "item-tag";
      span.textContent = tag;
      head.append(span);
    }
    const line = document.createElement("p");
    line.className = "item-desc";
    line.textContent = desc;
    li.append(head, line);
    return li;
  }

  /** A list, or, when it has nothing to list, its one "Henüz …" line. */
  function fill(list: HTMLElement, empty: HTMLElement, items: HTMLLIElement[]) {
    list.replaceChildren(...items);
    list.hidden = items.length === 0;
    empty.hidden = items.length > 0;
  }

  function paint(proof: Proof) {
    fill($("[data-gifts]"), $("[data-gifts-empty]"), proof.gifts.map((g) => item(g.name, g.desc)));
    fill($("[data-prizes]"), $("[data-prizes-empty]"), proof.prizes.map((p) => item(p.name, p.desc, p.game)));
    // Gifted points only when Atıl gave some: a section that only ever says
    // "none" would be noise on the paper.
    $("[data-gifted]").hidden = proof.gifted.items.length === 0;
    $("[data-gifted-list]").replaceChildren(
      ...proof.gifted.items.map((g) => item(`+${g.points.toLocaleString("tr-TR")} puan`, g.note ?? "Atıl'dan hediye")),
    );
    // Their sum, the number Atıl checks against the hub's "+N hediye puan".
    $("[data-gifted-total]").textContent =
      proof.gifted.total > 0 ? `Atıl'dan hediye puan: ${proof.gifted.total.toLocaleString("tr-TR")}` : "";
    $("[data-date]").textContent = proof.date;
    $("[data-check]").textContent = proof.check;
    $("[data-code]").textContent = proof.code;
  }

  $("[data-print]").addEventListener("click", () => window.print());
  void proofOf(openLedger(), new Date()).then(paint);
</script>

<style is:global>
  /* The paper: A4, portrait, with margins the printer will not eat. On
     paper the cream ground goes; Chrome prints no backgrounds by default
     and nothing here should depend on it printing one. */
  @page {
    size: A4 portrait;
    margin: 16mm 18mm;
  }
  @media print {
    body {
      background: #fff;
    }
  }
</style>

<style>
  .page {
    max-width: 210mm;
    margin: 0 auto;
    padding: 20px 16px 48px;
  }
  .tools {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .paper {
    display: grid;
    gap: 26px;
    padding: 40px 44px;
    background: var(--bd-paper);
    border-radius: var(--bd-radius);
    box-shadow:
      0 30px 80px -40px rgb(58 45 42 / 0.45),
      0 0 0 1px var(--bd-line);
  }
  .block {
    break-inside: avoid;
  }

  /* ── head: title left, date right, the greeting under both ─────────── */
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 4px 24px;
    padding-bottom: 18px;
    border-bottom: 2px dashed var(--bd-dash);
    break-inside: avoid;
  }
  .eyebrow {
    grid-column: 1;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bd-muted-2);
  }
  .title {
    grid-column: 1;
    font-family: var(--bd-display);
    font-weight: 800;
    font-size: 30px;
    line-height: 1.1;
    color: var(--bd-accent-deep);
  }
  .date {
    grid-column: 2;
    grid-row: 1 / 3;
    text-align: right;
  }
  .label {
    display: block;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bd-muted-2);
  }
  .date-value {
    font-size: 15px;
    font-weight: 800;
  }
  .greeting {
    grid-column: 1 / -1;
    margin-top: 6px;
    font-size: 14.5px;
    color: var(--bd-ink-soft);
  }

  .h2 {
    margin-bottom: 8px;
    font-family: var(--bd-display);
    font-weight: 800;
    font-size: 19px;
    color: var(--bd-accent-deep);
  }

  /* ── the two lists ──────────────────────────────────────────────────── */
  .items {
    display: grid;
    gap: 8px;
  }
  .items :global(li) {
    display: grid;
    gap: 2px;
    padding: 8px 12px;
    border: 1.5px solid var(--bd-line);
    border-radius: var(--bd-radius-sm);
    break-inside: avoid;
  }
  .items :global(.item-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    font-size: 15px;
  }
  .items :global(.item-tag) {
    font-size: 12px;
    font-weight: 700;
    color: var(--bd-muted);
  }
  .items :global(.item-tag::before) {
    content: "· ";
  }
  .items :global(.item-desc) {
    font-size: 12.5px;
    color: var(--bd-ink-soft);
  }
  .gifted-total {
    margin-top: 8px;
    font-size: 15px;
    font-weight: 800;
  }
  .empty {
    font-size: 14px;
    font-style: italic;
    color: var(--bd-muted);
  }

  /* ── the check code, large, with Atıl's line beside it ──────────────── */
  .check {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 24px;
  }
  .for-atil {
    font-size: 12.5px;
    color: var(--bd-ink-soft);
  }
  .check-code {
    padding: 10px 18px;
    border: 2px solid var(--bd-ink);
    border-radius: var(--bd-radius-sm);
    font: 700 46px/1 ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    letter-spacing: 0.14em;
    color: var(--bd-ink);
    min-width: 7ch;
    text-align: center;
  }
  /* On a phone the code goes under Atıl's line instead of squeezing it. */
  @media screen and (max-width: 600px) {
    .check {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }
  }

  /* ── the full Save code, small, wrapping anywhere ───────────────────── */
  .note {
    margin-bottom: 8px;
    font-size: 12.5px;
    color: var(--bd-ink-soft);
  }
  .code {
    font: 10.5px/1.55 ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
    word-break: break-all;
    color: var(--bd-ink);
  }

  /* ── on paper ───────────────────────────────────────────────────────── */
  @media print {
    .ui {
      display: none !important;
    }
    .page {
      max-width: none;
      margin: 0;
      padding: 0;
    }
    .paper {
      gap: 7mm;
      padding: 0;
      background: #fff;
      border-radius: 0;
      box-shadow: none;
    }
    .head {
      padding-bottom: 4mm;
    }
    .title {
      font-size: 24px;
    }
    .greeting {
      font-size: 12.5px;
    }
    .h2 {
      margin-bottom: 2mm;
      font-size: 15px;
    }
    /* One line per item, no description: the name (and, for a Small prize,
       its Game) is what Atıl hands over; the shop and the hub carry the
       rest. A gift from Atıl keeps its note on the same line, since there
       the note is the only thing that says what it was for. */
    .items {
      gap: 0;
    }
    .items :global(li) {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 3mm;
      padding: 1.2mm 0;
      border: 0;
      border-bottom: 0.5pt solid #ccc;
      border-radius: 0;
    }
    .items :global(.item-head) {
      font-size: 12.5px;
    }
    .items :global(.item-tag) {
      font-size: 11px;
    }
    .items :global(.item-desc) {
      display: none;
    }
    [data-gifted-list] :global(.item-desc) {
      display: block;
      font-size: 11px;
    }
    /* Up to 14 Small prizes: two columns keep them to half the height. */
    [data-prizes] {
      grid-template-columns: 1fr 1fr;
      column-gap: 8mm;
    }
    .gifted-total {
      margin-top: 2mm;
      font-size: 12.5px;
    }
    .for-atil,
    .note {
      font-size: 11px;
    }
    .check-code {
      padding: 6px 14px;
      font-size: 32px;
    }
    .code {
      font-size: 8px;
      line-height: 1.4;
    }
  }
</style>
