---
/**
 * GEÇİCİ TEST SAYFASI — YAYINDAN ÖNCE SİLİNECEK.
 * TEMPORARY: delete this folder (src/pages/20261209/test-sarkilar/) before
 * the birthday site is deployed. It is on the launch-check list.
 *
 * /20261209/test-sarkilar/ — Atıl's listening bench for the "Şarkıyı bil"
 * hooks (#204, after his play test): all 20 songs of `src/lib/bday26/songs.ts`,
 * least certain first (by `confidence`, pool order within a level), each with
 * its confidence and source link beside the play/stop button, its group,
 * title, bpm, the `unsure` note when the hook still needs his ear, and the
 * note string as typed. One hook sounds at a time (the engine's guarantee: `play` cancels
 * whatever still sounds or waits queued ahead). Nothing links here; the
 * layout already sets `noindex, nofollow` and the sitemap filter drops every
 * /20261209/ URL.
 */
import BdayLayout from "../../../layouts/BdayLayout.astro";
import { SONGS } from "../../../lib/bday26/songs";
import { PIANO_CREDIT } from "../../../lib/bday26/piano";

/** Least certain first; `i` stays the song's index in SONGS for the player. */
const ROWS = SONGS.map((s, i) => ({ s, i })).sort((a, b) => a.s.confidence - b.s.confidence || a.i - b.i);
const LEVEL = { 1: "yer tutucu", 2: "kaynaklı, duyulmadı", 3: "kaynaklı, iki kaynak / insan", 4: "Atıl onayladı" } as const;
---

<BdayLayout title="Geçici test sayfası · Şarkılar">
  <main class="bench">
    <p class="temp" role="note">Geçici test sayfası — yayından önce silinecek</p>
    <h1>Şarkıyı bil · kancaları dinle</h1>
    <p class="lead">
      Her şarkının kancası, oyunda çaldığı gibi. Bir seferde tek kanca çalar; yenisine basınca eskisi durur.
      <span data-state>Piyano ilk tıklamada yüklenir.</span>
    </p>
    <ol class="songs">
      {
        ROWS.map(({ s, i }) => (
          <li class:list={[{ unsure: s.unsure }]} data-row={i}>
            <div class="side">
              <button class="play" type="button" data-play={i} aria-label={`Çal: ${s.title}`}>
                <span class="tri" aria-hidden="true" />
              </button>
              <span class={`conf c${s.confidence}`} title={LEVEL[s.confidence]} data-confidence={s.confidence}>
                {s.confidence}/4
              </span>
              {s.source ? (
                <a class="src" href={s.source} target="_blank" rel="noopener noreferrer">
                  kaynak
                </a>
              ) : (
                <span class="src none">kaynak yok</span>
              )}
            </div>
            <div class="meta">
              <p class="head">
                <b>{s.title}</b> <span class="artist">{s.artist}</span>
              </p>
              <p class="facts">
                <span>{s.group}</span> · <span>{s.bpm} bpm</span> · <span>{s.part}</span>
              </p>
              <p class="facts">güven {s.confidence}/4: {LEVEL[s.confidence]}</p>
              {s.unsure ? <p class="flag">unsure: {s.unsure}</p> : <p class="ok">emin (unsure işareti yok)</p>}
              <pre class="hook">{s.hook.replace(/\n\s+/g, "\n")}</pre>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="credit">{PIANO_CREDIT}</p>
  </main>
</BdayLayout>

<script>
  import { SONGS } from "../../../lib/bday26/songs";
  import { createPiano } from "../../../lib/bday26/piano";
  import { parseSong, timeSong } from "../../../lib/bday26/song";

  const stateEl = document.querySelector<HTMLElement>("[data-state]");
  const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-row]"));
  // Rows are sorted by confidence, so a row's place is not its song's index: match by data-row.
  const piano = createPiano({
    onState: (state) => {
      if (stateEl) {
        stateEl.textContent = {
          locked: "Piyano ilk tıklamada yüklenir.",
          loading: "Piyano yükleniyor…",
          ready: "Piyano hazır.",
          failed: "Piyano sesi yüklenemedi.",
        }[state];
      }
    },
  });

  let playing: number | undefined;
  let timer = 0;

  function mark(i: number | undefined) {
    playing = i;
    window.clearTimeout(timer);
    rows.forEach((row) => row.classList.toggle("playing", Number(row.dataset.row) === i));
  }

  async function toggle(i: number) {
    piano.unlock();
    if (playing === i) {
      piano.stop();
      mark(undefined);
      return;
    }
    const song = SONGS[i]!;
    const parsed = parseSong(song.hook);
    mark(i);
    await piano.play(parsed, { bpm: song.bpm });
    if (playing !== i) return;
    timer = window.setTimeout(() => mark(undefined), timeSong(parsed, song.bpm).seconds * 1000 + piano.latencyMs);
  }

  document.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLElement>("[data-play]");
    if (button) void toggle(Number(button.dataset.play));
  });
</script>

<style>
  .bench {
    max-width: 960px;
    margin: 0 auto;
    padding: 24px 16px 48px;
    color: var(--bd-ink);
  }
  .temp {
    margin: 0 0 16px;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--bd-wrong-bg);
    color: var(--bd-wrong-ink);
    font-weight: 800;
    text-align: center;
  }
  h1 {
    margin: 0 0 6px;
    font-family: var(--bd-display);
    color: var(--bd-accent-deep);
  }
  .lead {
    margin: 0 0 20px;
    color: var(--bd-ink-soft);
  }
  .songs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .songs li {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 14px;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--bd-paper);
    box-shadow: 0 0 0 1.5px var(--bd-line);
  }
  .songs li.playing {
    box-shadow: 0 0 0 2.5px var(--bd-accent);
  }
  .side {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 6px;
  }
  .conf {
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
    background: var(--bd-track);
    color: var(--bd-ink);
  }
  .conf.c1 {
    background: var(--bd-wrong-bg);
    color: var(--bd-wrong-ink);
  }
  .conf.c4 {
    color: var(--bd-won-ink);
  }
  .src {
    font-size: 12px;
    color: var(--bd-accent-deep);
  }
  .src.none {
    color: var(--bd-muted);
    text-align: center;
  }
  .meta {
    min-width: 0;
  }
  .meta p {
    margin: 0 0 4px;
  }
  .artist,
  .facts {
    color: var(--bd-muted);
    font-size: 14px;
  }
  .flag {
    color: var(--bd-wrong-ink);
    font-size: 13px;
    font-weight: 700;
  }
  .ok {
    color: var(--bd-won-ink);
    font-size: 13px;
  }
  .hook {
    margin: 6px 0 0;
    padding: 8px 10px;
    border-radius: 8px;
    background: var(--bd-track);
    font-size: 13px;
    overflow-x: auto;
  }
  .play {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--bd-accent-soft);
    cursor: pointer;
  }
  .tri {
    width: 0;
    height: 0;
    margin-left: 4px;
    border-style: solid;
    border-width: 8px 0 8px 13px;
    border-color: transparent transparent transparent var(--bd-accent-deep);
  }
  li.playing .tri {
    margin-left: 0;
    width: 14px;
    height: 14px;
    border: 0;
    border-radius: 2px;
    background: var(--bd-accent-deep);
  }
  .credit {
    margin-top: 24px;
    font-size: 12px;
    color: var(--bd-muted);
  }
</style>
