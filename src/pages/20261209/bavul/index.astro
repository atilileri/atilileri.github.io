---
/**
 * /20261209/bavul/ — "Bavul hazırla", a Prize Game (#219; verdict on #214).
 * She packs an 8×6 suitcase for a trip card: fill every cell, put the
 * card's 4 must-haves in, keep it at 23 kg or under so it closes. Score =
 * 100 − 5 × empty cells − 10 × missing must-haves; 95% wins Hafta sonu
 * gezisi. No Points, no time limit.
 *
 * HOW IT IS BUILT. Like every Game, three layers:
 *   - `src/lib/bday26/bavul.ts` holds every rule: the items, the trip cards,
 *     the score, and THE INPUT STATE MACHINE `step(state, action)`. It has
 *     no DOM and is pinned under `node --test` (with each card's stored
 *     perfect pack and heavy trap as test data).
 *   - `GameShell` is everything around the Round (start, leave question,
 *     result) and the one `recordRound`.
 *   - This page is the painter and the input layer. Mouse, keyboard and the
 *     buttons only turn her events into actions for `step`; the events that
 *     come back (sounds, a toast, the leave question, the end of the Round)
 *     are played here. Nothing else changes a Round.
 *
 * INPUT, as the prototype Atıl played (`prototype/214-bavul`): click a list
 * row to take an item, click the bag to put it down (click-click, nothing
 * is dragged); a second click on the held row, or on the background, lets
 * it go back where it came from; right click turns it. Keys: Tab / ⇧Tab
 * pick, arrows move, R turns, Enter puts down (or, empty-handed, picks up the
 * packed item under the cursor), Backspace takes out, K closes. Esc lets go
 * of the held item first; with an empty hand it is the shell's leave
 * question. The buttons under the bag do the same and are the legend.
 *
 * Sound: the "Yolculuk" track (`music-dom.ts`, given to the shell) and the
 * effects through `effects-dom.ts`, both under the HUD's switches.
 */
import BdayLayout from "../../../layouts/BdayLayout.astro";
import GameShell from "../../../components/bday26/GameShell.astro";
import { gameById } from "../../../lib/bday26/catalogue";

const game = gameById("bavul");

const KEYS = [
  { key: "Tık / Tab", does: "Listeden eşya seç (⇧ Tab: önceki)" },
  { key: "Fare / ← ↑ → ↓", does: "Eşyayı bavulda gezdir" },
  { key: "Tık / Enter", does: "Bavula koy · elin boşken: bavuldaki eşyayı al" },
  { key: "Sağ tık / R", does: "Döndür" },
  { key: "⌫ / listeye tık", does: "Çıkar: bavuldaki eşyayı listeye geri koy" },
  { key: "K", does: "Bavulu kapat (elin boşken)" },
  { key: "Esc", does: "Bırak ya da turdan çık" },
];
---

<BdayLayout title={`${game.name} · İyi ki doğdun Çağla!`}>
  <GameShell game="bavul" keys={KEYS} music="bavul" resultAside>
    <span slot="hud" class="hud-time">Süre <b data-time>0:00</b></span>

    <div class="bavul" data-bavul>
      <div class="side">
        <section class="panel trip" aria-label="Gezi kartı">
          <div class="lbl">Gezi kartı</div>
          <div class="trip-name" data-trip-name></div>
          <div class="musts" data-musts></div>
        </section>
        <section class="panel items" data-items aria-label="Eşyalar"></section>
      </div>

      <div class="board">
        <div class="toast" data-toast role="status" aria-live="polite"></div>
        <div class="canvas-box" data-canvas-box>
          <canvas data-canvas aria-label="Bavul"></canvas>
        </div>
        <div class="hold" data-hold></div>
        <div class="actions">
          <button class="act" type="button" tabindex="-1" data-act="rotate">Döndür <kbd>R</kbd></button>
          <button class="act main" type="button" tabindex="-1" data-act="place">Bavula koy <kbd>Enter</kbd></button>
          <button class="act" type="button" tabindex="-1" data-act="out">Çıkar <kbd>⌫</kbd></button>
          <button class="act" type="button" tabindex="-1" data-act="next">Sonraki eşya <kbd>Tab</kbd></button>
          <button class="act" type="button" tabindex="-1" data-act="cancel">Bırak <kbd>Esc</kbd></button>
          <button class="act" type="button" tabindex="-1" data-act="close">Bavulu kapat <kbd>K</kbd></button>
        </div>
        <p class="mhint">
          Fare: listeden eşyaya tıkla, bavulda yerine tıkla · aynı eşyaya ya da boşluğa tıkla: bırak · bavuldaki eşyaya tıkla: al · sağ tık: döndür
        </p>
      </div>

      <div class="side score-col">
        <section class="panel score" aria-label="Bu turun skoru">
          <div class="hand" data-hand>Elin boş</div>
          <div class="lbl">Doluluk</div>
          <div class="big" data-big>0 / 48 kare</div>
          <div class="live">Bu turun skoru <b data-live-score>%0</b></div>
          <div class="rows" data-rows></div>
          <p class="note">Skor = 100 − 5 × boş kare − 10 × eksik olmazsa olmaz. 23 kg'ı aşan bavul kapanmaz.</p>
        </section>
      </div>

      <div class="close-veil" data-close hidden>
        <div class="close-card" role="dialog" aria-labelledby="bavul-close-title">
          <h2 id="bavul-close-title">Bavulu kapatıyor musun?</h2>
          <p>Kapatınca tur biter ve bu skor yazılır.</p>
          <div class="rows" data-close-rows></div>
          <div class="close-foot">
            <span>Skor <b data-close-score></b></span>
            <span class="close-buttons">
              <button class="bd-btn secondary" type="button" tabindex="-1" data-close-act="cancel">Devam et <kbd>Esc</kbd></button>
              <button class="bd-btn primary" type="button" tabindex="-1" data-close-act="act">Kapat <kbd>Enter</kbd></button>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div slot="result" class="result-extra">
      <div class="rows" data-result-rows></div>
      <p class="verdict" data-verdict></p>
    </div>
  </GameShell>
</BdayLayout>

<script>
  import { formatTenths } from "../../../lib/bday26/format";
  import { one } from "../../../lib/bday26/dom";
  import { openLedger } from "../../../lib/bday26/browser";
  import { mountGameShell } from "../../../lib/bday26/shell";
  import { effects } from "../../../lib/bday26/effects-dom";
  import type { SoundName } from "../../../lib/bday26/effects";
  import {
    BAG_H,
    BAG_W,
    CARDS,
    ITEM_INFO,
    KG_LIMIT,
    breakdown,
    can,
    cellsAt,
    dims,
    drawCard,
    itemsCovering,
    newRound,
    probe,
    shapeOf,
    step,
    type Action,
    type Breakdown,
    type BavulSound,
    type Cell,
    type Point,
    type Round,
    type Verb,
  } from "../../../lib/bday26/bavul";
  import { PRIZE_BAR } from "../../../lib/bday26/catalogue";
  import { BAVUL_EMPTY_PENALTY, BAVUL_MUST_PENALTY } from "../../../lib/bday26/scores";

  const playfield = one("[data-shell-playfield]");
  const itemsEl = one("[data-items]");
  const cv = one<HTMLCanvasElement>("[data-canvas]");
  const canvasBox = one("[data-canvas-box]");
  const holdEl = one("[data-hold]");
  const toastEl = one("[data-toast]");
  const timeEl = one("[data-time]");
  const closeEl = one("[data-close]");
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-act]"));
  const ctx = cv.getContext("2d")!;

  /** Every sound of the machine, as the site's effects name them. */
  const SOUND: Record<BavulSound, SoundName> = {
    pick: "pick",
    rotate: "flip",
    place: "place",
    out: "take-out",
    refuse: "row-wrong",
    gate: "gate",
    must: "row-good",
  };

  /** The Round in play; null before the first and after she leaves one. */
  let round: Round | null = null;
  let t0 = 0;
  /** The Round's time once it is over (the clock stops at "Kapat"). */
  let endedAt: number | null = null;
  let toastTimer = 0;

  const fmtKg = (x: number) => `${formatTenths(x)} kg`;
  const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
  const elapsed = () => ((endedAt ?? performance.now()) - t0) / 1000;

  // ── the one door into the machine ─────────────────────────────────

  function dispatch(a: Action) {
    if (shell.phase !== "playing" || !round) return;
    const { state, events } = step(round, a);
    round = state;
    for (const e of events) {
      if (e.kind === "sound") {
        const name = SOUND[e.sound];
        if (e.delay) window.setTimeout(() => effects.sound(name), e.delay);
        else effects.sound(name);
      } else if (e.kind === "toast") toast(e.text);
      else if (e.kind === "leave") shell.askLeave();
      else if (e.kind === "finish") finishRound();
    }
    paint();
  }

  /** The last Round's trip card, kept for the tab so "Salona dön" or a
   *  reload does not deal it straight again (#214: never the same twice in
   *  a row). Not progress: a browser that refuses storage only forgets it. */
  const LAST_CARD_KEY = "bday26:bavul:last";
  function lastCard(): number | undefined {
    try {
      const n = JSON.parse(sessionStorage.getItem(LAST_CARD_KEY) ?? "null");
      return Number.isInteger(n) && n >= 0 && n < CARDS.length ? (n as number) : undefined;
    } catch {
      return undefined;
    }
  }
  function rememberCard(card: number) {
    try {
      sessionStorage.setItem(LAST_CARD_KEY, JSON.stringify(card));
    } catch {
      // Storage refused: the next Round may repeat this card after a reload.
    }
  }

  function startRound() {
    const card = drawCard(lastCard(), Math.random);
    rememberCard(card);
    round = newRound(card);
    t0 = performance.now();
    endedAt = null;
    lastPoint = "";
    paint();
  }

  function finishRound() {
    if (!round) return;
    const b = breakdown(round);
    endedAt = performance.now();
    one("[data-result-rows]").innerHTML = rowsHtml(b) + `<div class="row dim"><span>Süre</span><b>${mmss(elapsed())}</b></div>`;
    one("[data-verdict]").textContent =
      b.score >= PRIZE_BAR ? "" : b.missing.length ? `${b.missing.length} olmazsa olmaz eksik kaldı.` : `${b.empty} kare boş kaldı.`;
    one("[data-verdict]").hidden = b.score >= PRIZE_BAR;
    effects.sound("zip");
    // At 95 or more the shell celebrates the Small prize, won now or before.
    shell.finish(b.score, { detail: CARDS[round.card]!.name });
    paint();
  }

  // Esc during a Round goes through the machine first: it lets go of the
  // held item, answers the close question, and only with an empty hand asks
  // to leave. Registered before `mountGameShell`, so it runs before the
  // shell's own listener on the same target.
  window.addEventListener(
    "keydown",
    (event) => {
      if (event.key !== "Escape" || shell.phase !== "playing" || !round) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      if (!event.repeat) dispatch({ t: "cancel", leave: true });
    },
    { capture: true },
  );

  const shell = mountGameShell({
    game: "bavul",
    ledger: openLedger(),
    hooks: {
      startRound,
      abandonRound() {
        round = null;
        window.clearTimeout(toastTimer);
      },
    },
  });

  // ── keyboard layer: keys → actions ───────────────────────────────

  const ARROWS: Record<string, [number, number]> = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
  window.addEventListener("keydown", (event) => {
    if (shell.phase !== "playing" || event.altKey || event.ctrlKey || event.metaKey) return;
    const k = event.key;
    const arrow = ARROWS[k];
    let a: Action | null = null;
    if (arrow) a = { t: "move", dx: arrow[0], dy: arrow[1] };
    else if (k === "Tab") a = { t: "cycle", dir: event.shiftKey ? -1 : 1 };
    else if (event.repeat) return;
    else if (k === "Enter") a = { t: "act" };
    else if (k === "r" || k === "R") a = { t: "rotate" };
    else if (k === "Backspace") a = { t: "takeOut" };
    else if (k === "k" || k === "K") a = { t: "close" };
    if (!a) return;
    event.preventDefault();
    dispatch(a);
  });

  // ── mouse layer: clicks → the same actions ───────────────────────

  let cellPx = 80;
  const PAD = 26;
  const TOPH = 34;
  let dpr = 1;
  const OX = PAD;
  const OY = PAD + TOPH;
  const pointOf = (event: MouseEvent): Point => ({ fx: (event.offsetX - OX) / cellPx, fy: (event.offsetY - OY) / cellPx });
  const inBag = (p: Point) => p.fx >= 0 && p.fx < BAG_W && p.fy >= 0 && p.fy < BAG_H;
  let lastPoint = "";

  cv.addEventListener("pointermove", (event) => {
    if (shell.phase !== "playing" || !round) return;
    const p = pointOf(event);
    if (!inBag(p)) return;
    // Only a change of where the item would land is an action.
    let where = `${Math.floor(p.fx)},${Math.floor(p.fy)}`;
    if (round.hand) {
      const it = round.items[round.hand.i]!;
      const d = dims(shapeOf(it));
      where = `${round.hand.i}:${it.rot}:${round.hand.origin === "list" ? `${Math.round(p.fx - d.w / 2)},${Math.round(p.fy - d.h / 2)}` : where}`;
    }
    if (where !== lastPoint) {
      lastPoint = where;
      dispatch({ t: "point", at: p });
    }
    cv.style.cursor = round.hand || itemsCovering(round, [{ x: Math.floor(p.fx), y: Math.floor(p.fy) }]).length ? "pointer" : "default";
  });
  cv.addEventListener("pointerleave", () => (lastPoint = ""));
  cv.addEventListener("pointerdown", (event) => {
    if (event.button !== 0) return;
    event.preventDefault();
    const p = pointOf(event);
    // The case around the bag counts as background.
    dispatch(inBag(p) ? { t: "act", at: p } : { t: "cancel" });
  });
  itemsEl.addEventListener("pointerdown", (event) => {
    if (event.button !== 0) return;
    event.preventDefault();
    const row = (event.target as Element).closest<HTMLElement>("[data-i]");
    dispatch({ t: "list", i: row ? Number(row.dataset.i) : null });
  });
  // The background: anything in the playfield that is not the bag, the
  // list, a button or the close card lets the held item go back.
  playfield.addEventListener("pointerdown", (event) => {
    if (event.button !== 0) return;
    // The path as it was at dispatch: a list row the list handler just
    // re-rendered is detached by now.
    if (event.composedPath().some((el) => el instanceof Element && el.matches("canvas, [data-items], button, [data-close]"))) return;
    dispatch({ t: "cancel" });
  });
  playfield.addEventListener("contextmenu", (event) => {
    event.preventDefault();
    dispatch({ t: "rotate" });
  });
  for (const el of [itemsEl, cv]) el.addEventListener("dragstart", (e) => e.preventDefault());

  // The buttons never take focus, so Enter and the keys stay the Game's.
  const BUTTON: Record<Verb, Action> = {
    rotate: { t: "rotate" },
    place: { t: "act" },
    out: { t: "takeOut" },
    next: { t: "cycle", dir: 1 },
    cancel: { t: "cancel" },
    close: { t: "close" },
  };
  for (const b of buttons) {
    b.addEventListener("mousedown", (e) => e.preventDefault());
    b.addEventListener("click", () => dispatch(BUTTON[b.dataset.act as Verb]));
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-close-act]")) {
    b.addEventListener("mousedown", (e) => e.preventDefault());
    b.addEventListener("click", () => dispatch({ t: b.dataset.closeAct === "act" ? "act" : "cancel" }));
  }

  // ── painting ─────────────────────────────────────────────────────

  function toast(text: string) {
    toastEl.textContent = text;
    toastEl.classList.add("on");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toastEl.classList.remove("on"), 1600);
  }

  /** The score's lines; `filled: false` leaves out the fill, for the live
   *  panel, which leads with it. */
  function rowsHtml(b: Breakdown, filled = true) {
    return (
      [
        ...(filled ? ([["Dolu", `${b.filled} / ${BAG_W * BAG_H} kare`, ""]] as const) : []),
        [`Boş kalan (${b.empty})`, b.empty ? `−${b.empty * BAVUL_EMPTY_PENALTY}` : "0", b.empty ? "neg" : "ok"],
        [
          `Eksik olmazsa olmaz (${b.missing.length})`,
          b.missing.length ? `−${b.missing.length * BAVUL_MUST_PENALTY}` : "0",
          b.missing.length ? "neg" : "ok",
        ],
        ["Ağırlık", `${fmtKg(b.kg)} / ${KG_LIMIT} kg`, b.heavy ? "neg" : ""],
        ["Bavul", b.heavy ? `kapanmaz: ${KG_LIMIT} kg'ı aştın` : "kapanır", b.heavy ? "neg" : "ok"],
      ] as const
    )
      .map(([label, value, cls]) => `<div class="row ${cls}"><span>${label}</span><b>${value}</b></div>`)
      .join("");
  }

  function paintSide(r: Round) {
    const card = CARDS[r.card]!;
    one("[data-trip-name]").textContent = card.name;
    one("[data-musts]").innerHTML = card.musts
      .map((k) => {
        const ok = r.items.find((it) => it.key === k)!.placed;
        return `<span class="chip ${ok ? "ok" : ""}">${ok ? "✓" : ITEM_INFO[k].emoji} ${ITEM_INFO[k].name}</span>`;
      })
      .join("");
    const packed = r.items.filter((it) => it.placed).length;
    itemsEl.innerHTML =
      `<div class="head"><span>Bavulun yanında</span><span>${packed} / ${r.items.length} bavulda</span></div>` +
      r.items
        .map((it) => {
          const info = ITEM_INFO[it.key];
          const o = info.shapes[0]!;
          const d = dims(o);
          const on = new Set(o.map((c) => c.y * d.w + c.x));
          let mini = "";
          for (let i = 0; i < d.w * d.h; i++) mini += `<i style="background:${on.has(i) ? info.color : "transparent"}"></i>`;
          const held = r.hand?.i === it.i;
          const meta = held ? (r.hand!.origin === "list" ? "elinde" : "elinde (bavuldan)") : it.placed ? "bavulda" : `${info.cells} kare`;
          const star = card.musts.includes(it.key) ? `<span class="star" aria-label="olmazsa olmaz">★</span>` : "";
          return `<div class="it ${held ? "sel" : ""} ${it.placed ? "in" : ""}" data-i="${it.i}">
            <div class="mini" style="grid-template-columns:repeat(${d.w},8px)">${mini}</div>
            <div><div class="nm"><span class="e">${info.emoji}</span><span>${info.name}</span>${star}</div><div class="meta">${meta}</div></div>
            <div class="tag">${fmtKg(info.kg)}</div></div>`;
        })
        .join("");
  }

  function paintHud(r: Round) {
    const playing = shell.phase === "playing";
    holdEl.style.visibility = playing ? "visible" : "hidden";
    if (!r.hand) {
      const under = itemsCovering(r, [r.cursor])[0];
      holdEl.innerHTML = under
        ? `<span>Elin boş · imleç: ${ITEM_INFO[under.key].emoji} ${ITEM_INFO[under.key].name}</span><span class="st">Enter / tık: al</span>`
        : `<span>Elin boş: listeden bir eşya seç</span>`;
    } else {
      const info = ITEM_INFO[r.items[r.hand.i]!.key];
      const p = probe(r)!;
      const st = !p.ok ? `<span class="st bad">${p.why}</span>` : p.warn ? `<span class="st warn">${p.warn}</span>` : `<span class="st">Sığıyor</span>`;
      holdEl.innerHTML = `<span class="e">${info.emoji}</span><span>${info.name}</span><span class="kg">${fmtKg(info.kg)}</span>${st}`;
    }
    for (const b of buttons) b.disabled = !(playing && can(r, b.dataset.act as Verb));
    const b = breakdown(r);
    const hand = one("[data-hand]");
    hand.textContent = r.hand ? `Elinde: ${ITEM_INFO[r.items[r.hand.i]!.key].name} (${r.hand.origin === "list" ? "listeden" : "bavuldan"})` : "Elin boş";
    hand.classList.toggle("on", !!r.hand);
    // The fill leads while she packs (review F6: an empty bag opened on
    // "%0" and a long minus); the score is the line under it.
    const big = one("[data-big]");
    big.textContent = `${b.filled} / ${BAG_W * BAG_H} kare`;
    big.classList.toggle("win", b.filled === BAG_W * BAG_H);
    const live = one("[data-live-score]");
    live.textContent = `%${b.score}`;
    live.classList.toggle("win", b.score >= PRIZE_BAR);
    one("[data-rows]").innerHTML = rowsHtml(b, false);
    closeEl.hidden = !r.closing;
    if (r.closing) {
      one("[data-close-rows]").innerHTML = rowsHtml(b);
      one("[data-close-score]").textContent = `%${b.score}`;
    }
  }

  function paint() {
    if (!round) return;
    paintSide(round);
    paintHud(round);
  }

  function resize() {
    const w0 = canvasBox.clientWidth;
    const h0 = canvasBox.clientHeight;
    if (!w0 || !h0) return;
    cellPx = Math.floor(Math.max(36, Math.min((w0 - 2 * PAD) / BAG_W, (h0 - 2 * PAD - TOPH) / BAG_H, 112)));
    const w = BAG_W * cellPx + 2 * PAD;
    const h = BAG_H * cellPx + 2 * PAD + TOPH;
    dpr = window.devicePixelRatio || 1;
    cv.style.width = `${w}px`;
    cv.style.height = `${h}px`;
    cv.width = Math.round(w * dpr);
    cv.height = Math.round(h * dpr);
  }
  new ResizeObserver(resize).observe(canvasBox);

  function shade(hex: string, f: number) {
    const n = parseInt(hex.slice(1), 16);
    const m = (v: number) => Math.max(0, Math.min(255, Math.round(f < 0 ? v * (1 + f) : v + (255 - v) * f)));
    return `rgb(${m(n >> 16)},${m((n >> 8) & 255)},${m(n & 255)})`;
  }

  /** A piece as merged cells, inset only on its outer edges. */
  function piece(cells: Cell[], color: string, opt: { alpha?: number; stroke?: string; dash?: number[]; emoji?: string } = {}) {
    const set = new Set(cells.map((c) => `${c.x},${c.y}`));
    const has = (x: number, y: number) => set.has(`${x},${y}`);
    const ins = Math.max(3, cellPx * 0.05);
    const rectOf = (x: number, y: number) => {
      const l = has(x - 1, y) ? 0 : ins;
      const r = has(x + 1, y) ? 0 : ins;
      const t = has(x, y - 1) ? 0 : ins;
      const b = has(x, y + 1) ? 0 : ins;
      return [OX + x * cellPx + l, OY + y * cellPx + t, cellPx - l - r, cellPx - t - b] as const;
    };
    ctx.save();
    ctx.globalAlpha = opt.alpha ?? 1;
    ctx.fillStyle = color;
    for (const c of cells) ctx.fillRect(...rectOf(c.x, c.y));
    ctx.beginPath();
    for (const { x, y } of cells) {
      const [a, b, w, h] = rectOf(x, y);
      if (!has(x, y - 1)) (ctx.moveTo(a, b), ctx.lineTo(a + w, b));
      if (!has(x, y + 1)) (ctx.moveTo(a, b + h), ctx.lineTo(a + w, b + h));
      if (!has(x - 1, y)) (ctx.moveTo(a, b), ctx.lineTo(a, b + h));
      if (!has(x + 1, y)) (ctx.moveTo(a + w, b), ctx.lineTo(a + w, b + h));
    }
    ctx.strokeStyle = opt.stroke ?? shade(color, -0.35);
    ctx.lineWidth = opt.stroke ? 3 : 1.5;
    if (opt.dash) ctx.setLineDash(opt.dash);
    ctx.stroke();
    ctx.setLineDash([]);
    if (opt.emoji) {
      const cx = cells.reduce((s, c) => s + c.x, 0) / cells.length;
      const cy = cells.reduce((s, c) => s + c.y, 0) / cells.length;
      const near = cells.slice().sort((p, q) => Math.hypot(p.x - cx, p.y - cy) - Math.hypot(q.x - cx, q.y - cy))[0]!;
      ctx.font = `${Math.round(cellPx * 0.48)}px "Segoe UI Emoji","Apple Color Emoji","Noto Color Emoji",sans-serif`;
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.fillText(opt.emoji, OX + (near.x + 0.5) * cellPx, OY + (near.y + 0.5) * cellPx + 1);
    }
    ctx.restore();
  }

  let shownSecond = -1;
  function frame(now: number) {
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const w = cv.width / dpr;
    const h = cv.height / dpr;
    ctx.clearRect(0, 0, w, h);
    // The suitcase: handle, shell, lining, the grid.
    const sx = PAD - 16;
    const sy = TOPH + PAD - 16;
    const sw = BAG_W * cellPx + 32;
    const sh = BAG_H * cellPx + 32;
    ctx.fillStyle = "#7a4b3a";
    ctx.beginPath();
    ctx.roundRect(w / 2 - 70, sy - 30, 140, 40, 14);
    ctx.fill();
    ctx.fillStyle = "#fffaf5";
    ctx.beginPath();
    ctx.roundRect(w / 2 - 48, sy - 18, 96, 22, 8);
    ctx.fill();
    ctx.fillStyle = "#c45a5a";
    ctx.beginPath();
    ctx.roundRect(sx, sy, sw, sh, 22);
    ctx.fill();
    ctx.fillStyle = "#a94646";
    ctx.fillRect(sx + 40, sy, 10, sh);
    ctx.fillRect(sx + sw - 50, sy, 10, sh);
    ctx.fillStyle = "#f6ece2";
    ctx.beginPath();
    ctx.roundRect(OX - 4, OY - 4, BAG_W * cellPx + 8, BAG_H * cellPx + 8, 10);
    ctx.fill();
    ctx.strokeStyle = "rgba(122,75,58,.16)";
    ctx.lineWidth = 1;
    for (let x = 0; x <= BAG_W; x++) {
      ctx.beginPath();
      ctx.moveTo(OX + x * cellPx + 0.5, OY);
      ctx.lineTo(OX + x * cellPx + 0.5, OY + BAG_H * cellPx);
      ctx.stroke();
    }
    for (let y = 0; y <= BAG_H; y++) {
      ctx.beginPath();
      ctx.moveTo(OX, OY + y * cellPx + 0.5);
      ctx.lineTo(OX + BAG_W * cellPx, OY + y * cellPx + 0.5);
      ctx.stroke();
    }
    if (round) {
      for (const it of round.items) if (it.placed) piece(cellsAt(it, it.placed.x, it.placed.y), ITEM_INFO[it.key].color, { emoji: ITEM_INFO[it.key].emoji });
      if (shell.phase === "playing" || shell.phase === "confirm") {
        if (round.hand) {
          const it = round.items[round.hand.i]!;
          const p = probe(round)!;
          // Where a bag item came from: a faint outline, so "Bırak" is predictable.
          if (typeof round.hand.origin === "object") {
            const o = round.hand.origin;
            piece(cellsAt({ ...it, rot: o.rot }, o.x, o.y), "#ffffff", { alpha: 0.5, stroke: "#b9a8a3", dash: [3, 4] });
          }
          piece(p.cells, ITEM_INFO[it.key].color, { alpha: 0.82, stroke: !p.ok ? "#d9453d" : p.warn ? "#b7791f" : "#2fb67c", dash: [7, 5], emoji: ITEM_INFO[it.key].emoji });
        } else if (!round.closing) {
          const pulse = 0.5 + 0.5 * Math.sin(now / 250);
          ctx.strokeStyle = `rgba(224,68,106,${0.5 + 0.5 * pulse})`;
          ctx.lineWidth = 3;
          ctx.setLineDash([6, 4]);
          ctx.strokeRect(OX + round.cursor.x * cellPx + 3, OY + round.cursor.y * cellPx + 3, cellPx - 6, cellPx - 6);
          ctx.setLineDash([]);
        }
      }
    }
    const s = round ? Math.floor(elapsed()) : 0;
    if (s !== shownSecond) {
      shownSecond = s;
      timeEl.textContent = mmss(s);
    }
    requestAnimationFrame(frame);
  }

  // Before the first Round the start card covers an empty bag and a card.
  paintSide(newRound(0));
  resize();
  requestAnimationFrame(frame);
</script>

