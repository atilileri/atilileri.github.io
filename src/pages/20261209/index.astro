  }

  /* ── main: tiles + shop ──────────────────────────────────────── */
  .main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 24px;
    align-items: stretch;
  }
  /* The tiles' column decides the grid's columns by its own width (3, 2, 1),
     so the shop beside it or below it needs no second set of numbers. */
  .games {
    display: grid;
    grid-template-rows: auto 1fr;
    container: games / inline-size;
  }
  .h2 {
    font-family: var(--bd-display);
    font-weight: 800;
    font-size: 21px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    color: var(--bd-ink);
  }
  .badge {
    font-family: var(--bd-font);
