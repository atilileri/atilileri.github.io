---
// PROTOTYPE — throwaway. Ticket #147 (stage 2): the learner's five liked NotebookLM styles,
// two realistic scenarios each, shown inside a mock Turkish Lesson. Switch styles via ?variant=.
// Reads prototypes/dutch-hook-images/sc/scenarios.json and run.txt, so results appear on reload.
import BaseLayout from "../../layouts/BaseLayout.astro";
import fs from "node:fs";

const dir = "prototypes/dutch-hook-images/sc";
const scenarios = JSON.parse(fs.readFileSync(`${dir}/scenarios.json`, "utf8"));
const log = fs.existsSync(`${dir}/run.txt`) ? fs.readFileSync(`${dir}/run.txt`, "utf8") : "";
const outcome = (id: string) => log.split("\n").find((l) => l.startsWith(id + " ")) ?? "";
const hasImage = (id: string) => fs.existsSync(`public/prototype/dutch-hook-images/sc/${id}.jpg`);

const styleOrder = ["sketch-note", "instructional", "editorial", "scientific", "auto"];
const keys = styleOrder;
const md = (s: string) =>
  s.replace(/`([^`]+)`/g, "<code>$1</code>").replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>").replace(/\*([^*]+)\*/g, "<em>$1</em>");
---

<BaseLayout title="PROTOTYPE — Scenario images" description="Throwaway prototype for ticket #147" currentPath="/prototype/">
  <div class="bg-[#fff3cd] text-[#664d03] text-xs font-bold uppercase tracking-widest text-center py-2">
    Prototype · ticket #147 · not a real Lesson
  </div>

  <article class="max-w-3xl mx-auto w-full min-w-0 px-6 py-16 sm:px-8">
    {keys.map((style) => (
      <section data-variant={style} hidden>
        <header class="mb-10">
          <span class="bg-[var(--color-primary-container)]/10 text-[var(--color-primary-container)] text-xs font-bold px-3 py-1 uppercase tracking-widest">Ders · Nederlands</span>
          <h1 class="font-[Space_Grotesk] text-[clamp(2rem,6vw,3rem)] font-bold tracking-tighter leading-[0.95] mt-6 mb-4">Haftanın kancaları</h1>
          <p class="text-lg text-[var(--color-on-surface-variant)] font-light">Stil: <code>{style}</code> — iki farklı durumda.</p>
        </header>

        {scenarios.filter((s: any) => s.style === style).map((s: any) => (
          <div class="my-10 rounded-xl border border-[var(--color-outline-variant)] bg-[var(--color-surface-container-lowest)] p-5 sm:p-6">
            <div class="text-xs font-bold uppercase tracking-widest text-[var(--color-outline)] mb-2">{s.kind}</div>
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-4">
              <span class="font-[Space_Grotesk] text-3xl font-bold">{s.nl}</span>
              <span class="text-[var(--color-on-surface-variant)]">{s.tr} · <em>{s.en}</em></span>
            </div>
            <p class="text-[15px] leading-relaxed mb-5" set:html={md(s.hook)} />
            {hasImage(s.id) ? (
              <img src={`/prototype/dutch-hook-images/sc/${s.id}.jpg`} alt={s.prompt} loading="lazy" class="w-full rounded-lg border border-[var(--color-outline-variant)] bg-white" />
            ) : (
              <div class="aspect-square rounded-lg border-2 border-dashed border-[var(--color-outline-variant)] grid place-items-center text-center p-6 text-sm text-[var(--color-outline)]">
                {outcome(s.id) ? "Görsel üretilemedi — kanca metinle öğretiliyor." : "Henüz üretilmedi (sırada)."}
              </div>
            )}
            <div class="mt-3 text-xs font-mono text-[var(--color-outline)]">{outcome(s.id) || "pending"}</div>
          </div>
        ))}
      </section>
    ))}
  </article>

  <div class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 rounded-full bg-[#111] text-white shadow-2xl px-3 py-2 text-sm font-mono">
    <button id="proto-prev" class="px-3 py-1 rounded-full hover:bg-white/15" aria-label="Previous style">←</button>
    <span id="proto-label" class="whitespace-nowrap text-center"></span>
    <button id="proto-next" class="px-3 py-1 rounded-full hover:bg-white/15" aria-label="Next style">→</button>
  </div>

  <script is:inline define:vars={{ keys }}>
    const params = new URLSearchParams(location.search);
    let i = Math.max(0, keys.indexOf(params.get("variant") ?? keys[0]));
    function show() {
      const k = keys[i];
      document.querySelectorAll("[data-variant]").forEach((el) => (el.hidden = el.dataset.variant !== k));
      document.getElementById("proto-label").textContent = `${k}  (${i + 1}/${keys.length})`;
      const u = new URL(location.href); u.searchParams.set("variant", k); history.replaceState(null, "", u);
    }
    const step = (d) => { i = (i + d + keys.length) % keys.length; show(); window.scrollTo({ top: 0 }); };
    document.getElementById("proto-prev").onclick = () => step(-1);
    document.getElementById("proto-next").onclick = () => step(1);
    addEventListener("keydown", (e) => {
      if (e.target.closest("input, textarea, [contenteditable]")) return;
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });
    show();
  </script>
</BaseLayout>
