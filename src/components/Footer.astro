---
// Footer component
import { contact } from "../data/contact";

const linkClass =
  "font-['Inter'] text-[0.75rem] uppercase tracking-[0.05em] text-[#1b1b1b]/50 dark:text-[#f9f9f9]/50 hover:text-[#00327d] dark:hover:text-[#0047AB] underline-offset-4 hover:underline transition-colors";

// The addresses come from src/data/contact.ts, which the CV reads too.
const byLabel = Object.fromEntries(contact.links.map((l) => [l.label, l.href]));

const links = [
  { text: "GITHUB", href: byLabel["github.com/atilileri"] },
  { text: "LINKEDIN", href: byLabel["linkedin.com/in/atililerialkan"] },
  { text: "RSS", href: "/rss.xml" },
];
---

<footer class="min-w-0 w-full shrink-0 py-16 border-t border-[#1b1b1b]/10 dark:border-[#f9f9f9]/10 bg-[#f9f9f9] dark:bg-[#1b1b1b]">
  <div class="flex flex-col md:flex-row flex-wrap justify-between items-center gap-8 px-6 md:px-12 max-w-[1440px] mx-auto w-full min-w-0">
    <div class="font-['Inter'] text-[0.75rem] uppercase tracking-[0.05em] text-[#1b1b1b]/50 dark:text-[#f9f9f9]/50">
      © {new Date().getFullYear()} ATILILERI
    </div>
    <div class="flex gap-12">
      {links.map((link) => <a class={linkClass} href={link.href}>{link.text}</a>)}
    </div>
  </div>
</footer>
