---
/**
 * ComingSoon — the placeholder page of a Prize Game whose build has not
 * landed yet (#213). Bavul hazırla (#219), Renk karıştır (#218) and Barista
 * (#217) each have a route from the day their tiles reach the hub, so the
 * tile's "Oyna" never leads to a 404. Each build replaces its page file and
 * stops using this component; when all three have landed, delete it.
 *
 * It shows the Game's name, rule and Small prize from the catalogue, one
 * line saying the Game is on its way, and the way back: a "Salona dön" link
 * and Esc, as on every Game (keyboard first). It touches no progress.
 */
import BdayLayout from "../../layouts/BdayLayout.astro";
import { gameById, PRIZE_BAR, type GameId } from "../../lib/bday26/catalogue";
import { GAME_ICON } from "../../lib/bday26/icons";
import { HUB_URL } from "../../lib/bday26/shell";

interface Props {
  game: GameId;
}

const game = gameById(Astro.props.game);
---

<BdayLayout title={game.name}>
  <main class="soon">
    <span class="icon" aria-hidden="true">{GAME_ICON[game.id]}</span>
    <h1 class="name">{game.name}</h1>
    <p class="rule">{game.rule}</p>
    <p class="line">Bu oyun hazırlanıyor, çok yakında burada!</p>
    <p class="prize">
      Küçük ödül: <b>{game.prize.name}</b> · %{PRIZE_BAR} yapınca senin
    </p>
    <a class="bd-btn primary" href={HUB_URL} data-hub>Salona dön <kbd>Esc</kbd></a>
  </main>
</BdayLayout>

<script>
  import { HUB_URL } from "../../lib/bday26/shell";
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") window.location.href = HUB_URL;
  });
</script>

<style>
  .soon {
    min-height: 100vh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    padding: 24px 16px;
    text-align: center;
  }
  .icon {
    font-size: 48px;
  }
  .name {
    font-family: var(--bd-display);
    font-weight: 800;
    font-size: 34px;
    color: var(--bd-accent-deep);
  }
  .rule {
    color: var(--bd-muted);
  }
  .line {
    font-weight: 700;
    font-size: 18px;
    margin-top: 8px;
  }
  .prize {
    color: var(--bd-ink-soft);
    margin-bottom: 8px;
  }
  kbd {
    font: inherit;
    font-size: 12px;
    opacity: 0.8;
    margin-left: 6px;
  }
</style>
