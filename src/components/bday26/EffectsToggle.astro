---
/**
 * EffectsToggle — "Efektler: Açık/Kapalı", the one switch for every sound
 * and visual effect: `PrefSwitch` with `kind="effects"`, kept under its own
 * name for GameShell and the hub. Bound by `bindEffectsToggles()` in
 * `src/lib/bday26/effects-dom.ts`. Pass `focusable` on the hub so Tab
 * reaches it; inside a Game leave it out (see `PrefSwitch.astro`).
 */
import PrefSwitch from "./PrefSwitch.astro";

interface Props {
  /** Reachable by Tab (the hub). Default false (a Game). */
  focusable?: boolean;
}
---

<PrefSwitch kind="effects" focusable={Astro.props.focusable} />
