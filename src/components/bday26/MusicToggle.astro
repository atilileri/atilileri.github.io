---
/**
 * MusicToggle — "Müzik: Açık/Kapalı", the background music's own switch:
 * `PrefSwitch` with `kind="music"`, kept under its own name for GameShell
 * (Games given `music`) and the hub. Bound by `bindMusicToggles()` in
 * `src/lib/bday26/music-dom.ts`. Pass `focusable` on the hub so Tab
 * reaches it; inside a Game leave it out (see `PrefSwitch.astro`).
 */
import PrefSwitch from "./PrefSwitch.astro";

interface Props {
  /** Reachable by Tab (the hub). Default false (a Game). */
  focusable?: boolean;
}
---

<PrefSwitch kind="music" focusable={Astro.props.focusable} />
