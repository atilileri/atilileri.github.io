---
/**
 * StopGlyph.astro — one small drawing per Stop, for chapter 5's summary Slide.
 *
 * WHAT IT IS: a 48×32 line drawing that sits above a Stop's name on the
 * enlarged Rail. Each glyph is a MINIATURE OF THAT STOP'S OWN SLIDE PICTURE,
 * so a room that walked the technical route recognises the picture it already
 * saw, and an executive room that never descends still reads seven distinct
 * shapes rather than seven words.
 *
 *   wayfinder    a board of tickets, the closed column filled  (WayfinderMap)
 *   questions    an outline with two holes in it               (.ch5-doc)
 *   to-spec      many lines converge into one document         (.ch5-hourglass, left half)
 *   to-tickets   one document fans out into thin tickets       (.ch5-hourglass, right half)
 *   implement    a test bar with the seam marked on it         (.ch5-bar)
 *   review       one diff, two sub-agents, one human           (.ch5-fan)
 *   reconcile    the code sends a diagram back to the requirement
 *
 * ⚠ ONLY THE SUMMARY SLIDE DRAWS THESE. The small Rail is locked (#91): a Dim
 * Stop there shows its name and nothing else, and seven glyphs riding the top
 * of six Slides would spend the Rail's 18% twice.
 *
 * ⚠ THE GLYPH NEVER CARRIES A CLAIM. It is a mark that helps the eye find a
 * Stop; the detail line under the name is what argues. Keep the drawings at one
 * weight, one colour, and no text — a labelled glyph competes with the name.
 *
 * ⚠ `reconcile` IS DRAWN LIKE THE OTHER SIX. The Slide in the stack marks it
 * "Not built yet"; the summary Slide does not, and the presenter carries that
 * sentence instead (#93). Do not grey this glyph to say it.
 */
interface Props {
  /** The Stop's id, from pipeline.ts. */
  id: string;
}
const { id } = Astro.props;
---

<svg
  class="ch5-glyph"
  viewBox="0 0 48 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {/* A BOARD OF TICKETS: nine, the closed ones filled. */}
  {
    id === "wayfinder" && (
      <g>
        <rect x="1.5" y="2" width="12" height="7" rx="1.5" fill="currentColor" stroke="none" />
        <rect x="1.5" y="12.5" width="12" height="7" rx="1.5" fill="currentColor" stroke="none" />
        <rect x="1.5" y="23" width="12" height="7" rx="1.5" fill="currentColor" stroke="none" />
        <rect x="18" y="2" width="12" height="7" rx="1.5" />
        <rect x="18" y="12.5" width="12" height="7" rx="1.5" />
        <rect x="18" y="23" width="12" height="7" rx="1.5" />
        <rect x="34.5" y="2" width="12" height="7" rx="1.5" opacity="0.4" />
        <rect x="34.5" y="12.5" width="12" height="7" rx="1.5" opacity="0.4" />
        <rect x="34.5" y="23" width="12" height="7" rx="1.5" opacity="0.4" />
      </g>
    )
  }

  {/* AN OUTLINE WITH HOLES: two lines break, and the gap is marked. */}
  {
    id === "questions" && (
      <g>
        <path d="M4,4 H40" />
        <path d="M4,11 H14" />
        <circle cx="22" cy="11" r="3.4" stroke-dasharray="2.2 2.4" />
        <path d="M30,11 H44" />
        <path d="M4,18 H36" />
        <path d="M4,25 H10" />
        <circle cx="18" cy="25" r="3.4" stroke-dasharray="2.2 2.4" />
        <path d="M26,25 H40" />
      </g>
    )
  }

  {/* MANY INTO ONE: the hourglass, left half. */}
  {
    id === "to-spec" && (
      <g>
        <path d="M2,3 H12" /><path d="M2,9.5 H12" /><path d="M2,16 H12" />
        <path d="M2,22.5 H12" /><path d="M2,29 H12" />
        <path d="M17,2 L28,16 M17,30 L28,16" opacity="0.55" />
        <rect x="31" y="5" width="15" height="22" rx="1.5" />
        <path d="M34.5,11 H42.5 M34.5,16 H42.5 M34.5,21 H39" opacity="0.55" />
      </g>
    )
  }

  {/* ONE INTO MANY: the hourglass, right half — thin tickets, each crossing
      every layer. The layer bands stay faint and are never named. */}
  {
    id === "to-tickets" && (
      <g>
        <rect x="1.5" y="8" width="11" height="16" rx="1.5" />
        <path d="M17,16 L26,3 M17,16 L26,29" opacity="0.55" />
        <path d="M29,9 H46.5 M29,16 H46.5 M29,23 H46.5" opacity="0.28" />
        <path d="M31.5,3 V29 M36,3 V29 M40.5,3 V29 M45,3 V29" />
      </g>
    )
  }

  {/* THE TEST BAR, with the seam marked on it. */}
  {
    id === "implement" && (
      <g>
        <rect x="1.5" y="10.5" width="45" height="11" rx="3" />
        <path d="M4.5,16 H20" stroke-width="5" opacity="0.55" />
        <path d="M24,5 V27" />
      </g>
    )
  }

  {/* THE FAN: one diff, two sub-agents, one human. */}
  {
    id === "review" && (
      <g>
        <rect x="1.5" y="11.5" width="9" height="9" rx="1.5" />
        <path d="M11,14 L19,7 M11,18 L19,25" opacity="0.55" />
        <rect x="19.5" y="2.5" width="12" height="9" rx="1.5" />
        <rect x="19.5" y="20.5" width="12" height="9" rx="1.5" />
        <path d="M32,7 L38,14 M32,25 L38,18" opacity="0.55" />
        <circle cx="42" cy="16" r="4.5" fill="currentColor" stroke="none" />
      </g>
    )
  }

  {/* SENT BACK: the code returns a diagram to the requirement. */}
  {
    id === "reconcile" && (
      <g>
        <path d="M9,10 L4,16 L9,22 M15,10 L20,16 L15,22" />
        <rect x="29" y="4" width="17" height="24" rx="1.5" />
        <path d="M32.5,10 H42.5 M32.5,15 H42.5 M32.5,20 H38.5" opacity="0.55" />
        <path d="M12.5,27.5 C19,29 23.5,28 26,24.5" opacity="0.55" />
        <path d="M26,24.5 L21.7,25.4 M26,24.5 L25.6,29" opacity="0.55" />
      </g>
    )
  }
</svg>
