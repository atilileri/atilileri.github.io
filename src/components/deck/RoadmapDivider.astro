---
/**
 * RoadmapDivider.astro — the ASML AI deck's Roadmap and Roadmap dividers (wayfinder #30).
 *
 * One component, two jobs, driven by whether `chapter` is set:
 *
 *   - `chapter` given (2–5): a DIVIDER. Same four factors, same positions, the
 *     one you are entering lit and the rest dim. This replaces the full
 *     `.chapter` wash for chapters 2–5 — the wash is now reserved for chapters
 *     1 and 6 only, so it keeps its impact (map #29, resolving #20's fog).
 *   - `chapter` omitted: chapter 1's ROADMAP slide — all four at equal weight,
 *     and the only instance that renders each factor's `gloss` (#34). It is
 *     the roadmap, not a divider; every later divider is a callback to it, and
 *     the dividers stay bare so the callback reads as recognition, not a
 *     re-read.
 *
 * The bridge is never explained, only walked: the room learns the shape once,
 * then recognises it four times.
 *
 * Labels come from src/lib/asml-ai/roadmap.ts and are edited THERE.
 * Chapters 4 and 5 have no slides yet (out of scope on map #29) — their
 * instances are one `<RoadmapDivider chapter={4} … />` away.
 *
 * Notes go in as the default slot, so each instance keeps its own
 * <aside class="notes">.
 */
import { FACTORS } from "../../lib/asml-ai/roadmap";

interface Props {
  /** Value for `data-section` — the on-screen section indicator. */
  section: string;
  /** 2–5 lights that chapter's factor. Omit for chapter 1's roadmap slide. */
  chapter?: number;
  /** Overrides the headline (defaults to the lit factor's own label). */
  heading?: string;
  /** Kicker above the headline. Defaults to `CHAPTER 0n` when `chapter` is set. */
  eyebrow?: string;
}

const { section, chapter, heading, eyebrow } = Astro.props;
const lit = FACTORS.find((f) => f.chapter === chapter);
const kicker =
  eyebrow ?? (chapter ? `CHAPTER ${String(chapter).padStart(2, "0")}` : "THE ROUTE");
---

<section
  class:list={["roadmap", !chapter && "is-all"]}
  data-section={section}
  data-roadmap
  style={lit ? `--rm-lit: ${FACTORS.indexOf(lit) + 1};` : undefined}
>
  <span class="chapter-no">{kicker}</span>
  <h2 class="h-set">
    <span class="h-line"><span>{heading ?? lit?.label}</span></span>
  </h2>
  <ol class="roadmap-factors">
    {
      FACTORS.map((f) => (
        <li class:list={["roadmap-factor", chapter === f.chapter && "on"]}>
          <span class="k">{f.label}</span>
          {!chapter && <span class="g">{f.gloss}</span>}
        </li>
      ))
    }
  </ol>
  {
    /* The chapter's contents, filled in by the script below from the real
       slides. Empty in the HTML on purpose: nothing here is typed twice, so
       a slide headline edited in the deck changes this list too. Dividers
       only — chapter 1's roadmap opens no chapter and gets no list. */
    chapter && <ol class="roadmap-slides" data-roadmap-slides />
  }
  <slot />
</section>

<script>
  /**
   * Fills every Roadmap divider's contents list from the slides themselves.
   *
   * The deck marks each slide with `data-section`, and a divider carries the
   * same `data-section` as the slides it opens. So the list is a lookup, not
   * a second copy of the titles: rename a slide's <h2> and the divider that
   * opens it says the new name on the next build.
   *
   * Runs once for the whole deck — Astro hoists this script and includes it a
   * single time, however many dividers the page holds.
   */
  const clean = (t: string) => t.replace(/\s+/g, " ").trim();

  /**
   * A slide's title: its first <h2>, at whatever depth the slide's layout put
   * it, but never a heading that belongs to a slide nested inside this one.
   */
  function titleOf(slide: Element): string {
    const h = [...slide.querySelectorAll("h2")].find(
      (n) => n.closest("section") === slide,
    );
    return h ? clean(h.textContent ?? "") : "";
  }

  /**
   * Titles of one section's MAIN slides, in deck order.
   *
   * Main means horizontal: one title per press of →. A vertical stack sits at
   * one horizontal position, so the stack gives one title — the title of its
   * first slide. The slides below it are deep dives, and the list drops them:
   * the divider says where the chapter goes, not everything it holds.
   *
   * ONE EXCEPTION, and chapter 5 is it. When the divider itself opens the
   * stack, the slides under the divider are not deep dives under a main
   * slide — they are the chapter's own route, walked with ↓. That stack
   * gives every one of its titles.
   */
  function titlesOf(section: string): string[] {
    const tops = document.querySelectorAll<HTMLElement>(".reveal .slides > section");
    const out: string[] = [];

    const push = (slide: HTMLElement) => {
      if (slide.hasAttribute("data-roadmap")) return; // the divider itself
      const t = titleOf(slide);
      if (t) out.push(t);
    };

    tops.forEach((top) => {
      const kids = [...top.querySelectorAll<HTMLElement>(":scope > section")];
      if (!kids.length) {
        if (top.dataset.section === section) push(top);
        return;
      }
      const opensHere =
        kids[0].hasAttribute("data-roadmap") && kids[0].dataset.section === section;
      const wanted = opensHere ? kids : kids.slice(0, 1);
      for (const k of wanted) {
        if ((k.dataset.section ?? top.dataset.section) === section) push(k);
      }
    });
    return out;
  }

  document.querySelectorAll<HTMLElement>("[data-roadmap-slides]").forEach((list) => {
    const divider = list.closest<HTMLElement>("[data-roadmap]");
    const section = divider?.dataset.section;
    if (!section) return;
    for (const t of titlesOf(section)) {
      const li = document.createElement("li");
      li.textContent = t;
      list.append(li);
    }
  });
</script>
